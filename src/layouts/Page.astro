---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	active?: 'home' | 'blog' | 'tools';
}

const { title, description, image, type, active } = Astro.props;
---

{/*
	Nav.astro 持有 <mdui-layout> 骨架（top-app-bar / navigation-rail /
	layout-main / navigation-bar）。页面内容与页脚都通过具名插槽送进
	layout-main 内部 —— 写在 Nav 之外会脱离布局定位（曾导致页脚置顶）。
*/}
<Base title={title} description={description} image={image} type={type}>
	<Nav active={active}>
		<div class="page" slot="content">
			<slot />
		</div>
		<Footer slot="footer" />
	</Nav>

	<style is:global>
		.page {
			width: 100%;
			max-width: 72rem;
			margin-inline: auto;
			padding: 2rem 1.25rem 2.5rem;
		}

		@media (min-width: 840px) {
			.page {
				padding: 2.5rem 2rem 3rem;
			}
		}
	</style>

	<script>
		/*
			图标模块必须在客户端引入：放在 front matter 会被判定为仅服务端依赖
			并被 tree-shake 掉（同 mdui 组件 JS 的问题）。

			未注册的 mdui 元素由 global.css 的 `:not(:defined)` 隐藏，
			其余内容（文字、标题、页脚）立即可见，无需等待组件就绪。
		*/
		import '../lib/icons';
	</script>
</Base>
