---
const year = new Date().getFullYear();
const days = Math.floor((Date.now() - new Date('2019-08-22').getTime()) / 86_400_000);
---

<footer class="site-footer">
	<div class="footer-bottom">
		<p class="text-sm muted">
			© {year} 915P的小站 ·
			<a
				href="https://github.com/915P/915P.github.io"
				class="footer-link"
				target="_blank"
				rel="noopener noreferrer">源代码</a
			>
		</p>

		{/*
			首页/工具/博客不在此重复列出：顶栏与桌面侧边导航已经常驻，
			页脚再放一遍是冗余。只留列表型入口与运行信息。
		*/}
		<div class="footer-meta">
			<a
				href="https://forms.cloud.microsoft/r/BLSwj4xUVW"
				class="footer-link"
				target="_blank"
				rel="noopener noreferrer">反馈与建议</a
			>
			<a href="/sitemap-index.xml" class="footer-link">网站地图</a>
			<a href="/rss.xml" class="footer-link">RSS</a>
			<span class="faint">建站 {days.toLocaleString('zh-CN')} 天</span>

			{/*
				边缘节点：**运行时**从 Cloudflare 的同源端点 /cdn-cgi/trace 读 colo
				（随访问者接入的机房变化），SW 已对 /cdn-cgi/ 放行，不会读到陈旧缓存。
				取不到时（开发服务器、绕过 CDN 直连源站、断网）整段隐藏，不摆假数据。
				完整的链路说明放进 title，正文只留最要紧的节点代码。
				隐私：trace 里的访问者 IP 只在本地解析，不写进页面。
			*/}
			<span
				class="faint cdn-info cdn-colo"
				data-cdn-colo
				title="Cloudflare 边缘节点（取自 /cdn-cgi/trace）；回源 GitHub Pages（Fastly 边缘），源站 915p.github.io"
			>
				节点 <b data-cdn-colo-code></b>
			</span>

			{/*
				PWA 版本信息（时间戳即版本号）。内容由 lib/pwa-client 填充：
				「版本」取自 /version.json（服务器上的最新构建），
				「本机」取自当前控制页面的 Service Worker（已缓存/已安装的那份）。
				拿不到最新版本时（开发环境没有 version.json、或离线首访）整块不显示。
			*/}
			<span class="pwa-version" data-pwa-version>
				<span class="faint" title="服务器上的最新构建">版本 <b data-pwa-latest>—</b></span>
				<span class="faint" title="本机已缓存的版本">本机 <b data-pwa-installed>—</b></span>
				<button type="button" class="pwa-update" data-pwa-action>检查更新</button>
			</span>
		</div>
	</div>

	<p class="disclaimer">
		免责声明：本站内容与工具结果仅供学习、研究和参考，可能存在遗漏或误差；
		历史纪年、历法换算、字符编码等请以权威资料为准。
	</p>
</footer>

<style is:global>
	.site-footer {
		margin-top: 3rem;
		padding: 2rem 1.25rem 3rem;
		border-top: 1px solid rgb(var(--mdui-color-outline-variant));
		width: 100%;
		max-width: 72rem;
		margin-inline: auto;
	}

	@media (min-width: 840px) {
		.site-footer {
			padding: 2.5rem 2rem 3.5rem;
		}
	}

	.footer-bottom {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.25rem;
	}

	.footer-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 1rem;
		font-size: var(--mdui-typescale-body-small-size);
	}

	.footer-link {
		color: rgb(var(--mdui-color-primary));
		text-decoration: none;
	}

	.footer-link:hover {
		text-decoration: underline;
	}

	/*
		CDN 节点：默认整段隐藏，拿到 /cdn-cgi/trace 的 colo 才显示；
		本地开发、直连源站、断网时都不会出现空占位。
		与建站天数同级的运行信息，仅比 faint 多一点权重。
		不做成链接 —— 915p.github.io 会 301 回本域，点了也只是绕一圈。
	*/
	.cdn-info b {
		font-weight: 600;
		color: rgb(var(--mdui-color-on-surface-variant));
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.02em;
	}

	.cdn-colo {
		display: none;
	}

	.cdn-colo[data-ready] {
		display: inline;
	}

	/* PWA 版本信息：默认隐藏，拿到版本数据后由脚本加 data-ready 显示 */
	.pwa-version {
		display: none;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.75rem;
	}

	.pwa-version[data-ready] {
		display: inline-flex;
	}

	.pwa-version b {
		font-weight: 600;
		/* 数字等宽，版本号变化时不会左右跳动 */
		font-variant-numeric: tabular-nums;
	}

	.pwa-update {
		font: inherit;
		color: rgb(var(--mdui-color-primary));
		background: none;
		border: 0;
		padding: 0;
		cursor: pointer;
	}

	.pwa-update:hover:not(:disabled) {
		text-decoration: underline;
	}

	.pwa-update:disabled {
		color: rgb(var(--mdui-color-outline));
		cursor: default;
	}


	.disclaimer {
		margin: 1rem 0 0;
		font-size: var(--mdui-typescale-body-small-size);
		line-height: 1.6;
		color: rgb(var(--mdui-color-outline));
	}
</style>

<script>
	import {
		formatVersionTime,
		getPwaState,
		initPwa,
		manualUpdate,
		onPwaState,
	} from '../lib/pwa-client';

	const root = document.querySelector<HTMLElement>('[data-pwa-version]');
	const latestEl = root?.querySelector<HTMLElement>('[data-pwa-latest]');
	const installedEl = root?.querySelector<HTMLElement>('[data-pwa-installed]');
	const action = root?.querySelector<HTMLButtonElement>('[data-pwa-action]');

	if (root && latestEl && installedEl && action) {
		let current = getPwaState();
		let busy = false;

		const render = () => {
			root.toggleAttribute('data-ready', Boolean(current.latest));

			latestEl.textContent = current.latest ? formatVersionTime(current.latest.time) : '—';
			latestEl.title = current.latest ? `构建 ${current.latest.id}` : '';

			if (current.installed) {
				installedEl.textContent = formatVersionTime(current.installed.time);
				installedEl.title = `构建 ${current.installed.id}`;
			} else {
				installedEl.textContent = current.supported ? '未缓存' : '不支持';
				installedEl.title = current.supported ? '本机还没有缓存任何版本' : '浏览器不支持离线缓存';
			}

			if (!busy) {
				action.textContent = current.updateReady ? '立即更新' : '检查更新';
			}
			action.disabled = busy || !current.supported;
		};

		void initPwa();

		onPwaState((state) => {
			current = state;
			render();
		});

		action.addEventListener('click', async () => {
			if (busy) return;

			busy = true;
			action.disabled = true;
			action.textContent = '检查中…';

			// 有等待中的新版本会直接切换并刷新，否则查一次并弹结果提示
			await manualUpdate();

			busy = false;
			render();
		});
	}

	/*
		Cloudflare 边缘节点：从同源端点 /cdn-cgi/trace 读实时值。
		它返回 `key=value` 逐行文本，我们只取 colo（边缘机房的 IATA 代码）和
		fl（本次请求的 ray id，放进 title 当排障线索）——访问者 IP 不写进页面。
		开发服务器上没有这个端点、直连源站时也会 404，一律静默隐藏该段。
	*/
	const coloRoot = document.querySelector<HTMLElement>('[data-cdn-colo]');

	if (coloRoot) {
		const readField = (text: string, key: string) =>
			new RegExp(`^${key}=(.*)$`, 'm').exec(text)?.[1]?.trim();

		fetch('/cdn-cgi/trace', { cache: 'no-store' })
			.then((response) => (response.ok ? response.text() : ''))
			.then((text) => {
				const code = text && readField(text, 'colo');
				if (!code) return;

				const codeEl = coloRoot.querySelector<HTMLElement>('[data-cdn-colo-code]');
				if (codeEl) codeEl.textContent = code;

				const ray = text && readField(text, 'fl');
				if (ray) {
					coloRoot.title = `Cloudflare 边缘节点 ${code} · ray ${ray}（取自 /cdn-cgi/trace）`;
				}

				coloRoot.setAttribute('data-ready', '');
			})
			.catch(() => {
				/* 静默：没有 CDN 或离线时保持隐藏 */
			});
	}
</script>

