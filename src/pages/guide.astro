---
import Base from '../layouts/Base.astro';
import { guideTabs } from '../data/guide';

/*
 * /guide/ —— 浏览器起始页。
 *
 * 刻意**不用** Page.astro：那一层会套上 Nav（顶栏 + 侧栏 + 底栏）与页脚，
 * 而起始页要的是整屏、只剩搜索框和磁贴。Base.astro 提供 head / 主题 / mdui 加载，
 * 正好是需要的全部。
 *
 * 交互对标 Firefox 新标签页：
 *   - 顶部一个输入框，判断是网址还是搜索词
 *   - 下面按分类分标签页，每页一屏磁贴，点开即走
 *   - 右下角铅笔进入编辑态，可增删、可拖动排序
 *   - 左下角小框显示网络连通性推断
 *   - 布局存 localStorage，只存在本机
 */
---

<Base
	title="起始页"
	description="浏览器起始页：搜索或直接输网址，下方是常用站点磁贴。"
>
	<main class="guide">
		<div class="guide-search-wrap">
			<div class="guide-search-row">
				{/*
				 * 引擎按钮在搜索框**外面**、左侧独立成一个圆按钮。
				 * 塞进输入框的 prefix slot 会被 text-field 的内边距挤偏、
				 * 胶囊左侧多出一块凹，看着不像一个整体。
				 */}
				<mdui-button-icon
					id="engineButton"
					class="engine-button"
					aria-label="选择搜索引擎"
					aria-haspopup="menu"
					aria-expanded="false"
				>
					<span class="engine-mark" id="engineMark"></span>
				</mdui-button-icon>
				<form class="guide-search" id="guideForm" role="search">
					<mdui-text-field
						id="guideInput"
						variant="filled"
						type="search"
						name="q"
						placeholder="搜索，或者输入网址"
						autocomplete="off"
						aria-label="搜索或输入网址"
					>
					</mdui-text-field>
				</form>
			</div>

			{/*
			 * 引擎列表。用 mdui-menu 而不是 mdui-select：
			 * 要的是「点图标弹出一张浮层」，而 select 天生带个长条框。
			 * menu-item 自带 selected 状态和 change 事件，正好对得上「当前用哪个」。
			 * 放在 form **外面**，免得菜单项被当成表单控件参与提交。
			*/}
			<div class="engine-pop" id="enginePop" hidden>
				{/*
				 * ⚠️ 必须显式写 selects="single"。
				 * mdui-menu 默认是**多选**模式，此时点菜单项不会改变
				 * 选中状态、也不会 emit change（实测 click 后 selectedKeys
				 * 仍为空、change 一次都不触发），表现就是「点了没反应」。
				 */}
				<mdui-menu class="engine-menu" id="engineMenu" selects="single">
					<mdui-list-subheader>搜索引擎</mdui-list-subheader>
				</mdui-menu>
				<p class="engine-pop-note" id="engineNote"></p>
				<mdui-button id="engineReset" variant="text" class="engine-pop-reset">
					恢复自动选择
				</mdui-button>
			</div>
		</div>

		{/*
		 * 分类标签页。
		 *
		 * 一屏铺 40 多个磁贴太挤，按分类拆开更像「常用入口」而不是图标墙。
		 * 面板在服务端就渲染好空网格，具体磁贴由脚本按 group 填 ——
		 * 磁贴存在 localStorage 里，本来就得客户端渲染。
		*/}
		{/*
		 * value 必须显式给第一个 tab —— 不写的话 mdui-tabs 不知道该激活谁，
		 * 表现是「一个 tab 都没选中」，下划线指示器整个不出现（看起来像样式坏了）。
		 *
		 * 下面这份只作**首屏兜底**；脚本会用 localStorage 里的标签页
		 * （默认即这里的默认分类）把整个 <mdui-tabs> 重建一次，
		 * 以支持新建 / 删除 / 拖动排序。
		*/}
		<div class="guide-tabbar">
			<div class="guide-tabs-host" id="guideTabsHost">
				<mdui-tabs class="guide-tabs" id="guideTabs" value={guideTabs[0].key}>
					{
						guideTabs.map((tab) => (
							<mdui-tab value={tab.key}>{tab.label}</mdui-tab>
						))
					}
					{
						guideTabs.map((tab) => (
							<mdui-tab-panel slot="panel" value={tab.key}>
								<div class="guide-tiles" data-group={tab.key} role="list"></div>
							</mdui-tab-panel>
						))
					}
				</mdui-tabs>
			</div>
			<button
				type="button"
				class="guide-tab-add"
				id="tabAdd"
				title="新建标签页"
				aria-label="新建标签页"><mdui-icon-add></mdui-icon-add></button
			>
		</div>

		{/*
		 * 导入 / 导出。
		 *
		 * 公开站点的链接表里**不放**校内裸 IP 这类敏感条目 ——
		 * 需要的人自己导出、传给自己想给的人，再导入即可。
		 * 所以导入导出的载体就是一个 JSON 文件，不经过任何服务器。
		 * 入口在右下角「编辑与设置」里，不占起始页的地盘。
		 */}
	</main>

	{/*
	 * 设置面板。
	 *
	 * 做成对话框而不是常驻面板：外观类设置本质是「偶尔调一次」，
	 * 常驻一排控件只会让起始页变复杂。
	 */}
	{/*
	 * 三个对话框都显式加上 close-on-esc / close-on-overlay-click。
	 * ⚠️ mdui 这两个属性**默认 false**，不写就等于「只能点按钮关」——
	 * 用户 Esc、点遮罩全都试过之后会觉得这弹窗关不掉。
	 * warnDialog 是例外：它问的是「确定要打开吗」，误触遮罩不该算回答。
	 */}
	<mdui-dialog id="setDialog" class="guide-set-dialog" close-on-esc close-on-overlay-click>
		<div slot="headline">编辑与设置</div>

		<div class="set-group">
			<p class="set-group-title">主题色</p>
			<div class="set-swatches" id="setSwatches" role="group" aria-label="主题色"></div>
		</div>

		<div class="set-group">
			<p class="set-group-title">外观模式</p>
		<mdui-segmented-button-group
			class="set-modes"
			id="setModes"
			selects="single"
			aria-label="外观模式"
		></mdui-segmented-button-group>
		</div>

		<div class="set-group">
			<p class="set-group-title">壁纸</p>
			<div class="set-walls" id="setWalls" role="group" aria-label="壁纸"></div>
			<div class="set-row">
				<mdui-button id="setWallShuffle" variant="text" size="small">再抽一张</mdui-button>
				<mdui-button id="setWallUpload" variant="text" size="small" class="set-upload">
					自定义壁纸…
				</mdui-button>
			</div>
			<input id="setWallFile" type="file" accept="image/*" hidden />
			<p class="set-note faint text-xs" id="setWallNote"></p>
		</div>

		<div class="set-group">
			<p class="set-group-title">
				背景遮罩
				<span class="faint text-xs" id="setScrubValue"></span>
			</p>
			<mdui-slider id="setScrub" min={0.3} max={0.92} step={0.02}></mdui-slider>
			<p class="set-note faint text-xs">
				遮罩太浅字会看不清，太厚壁纸就白设了。
			</p>
		</div>

		<div class="set-group">
			<p class="set-group-title">网络</p>
			<div class="set-row">
				<label class="set-switch" for="setAssume">
					<span>
						默认在校园网环境下
						<span class="faint text-xs">
							打开后不再探测校内网站，一律当作已接入。
						</span>
					</span>
					<mdui-switch id="setAssume"></mdui-switch>
				</label>
			</div>
			<mdui-button id="setNetCheck" variant="text" size="small">重新检测网络</mdui-button>
			<p class="set-note faint text-xs" id="setNetState"></p>
		</div>

		<div class="set-group">
			<p class="set-group-title">磁贴</p>
			<p class="set-note faint text-xs">
				拖动磁贴可以调整位置；右键磁贴可以改名称、网址、图标或删除。
			</p>
		</div>

		<div class="set-group">
			<p class="set-group-title">备份与恢复</p>
			<div class="set-row">
				<mdui-button id="setExport" variant="text" size="small">导出配置</mdui-button>
				<mdui-button id="setImport" variant="text" size="small">导入配置</mdui-button>
			</div>
			{/* 选文件用的隐藏 input，跟着导入按钮走；label 兼容读屏 */}
			<input id="ioFile" type="file" accept="application/json,.json" hidden aria-hidden="true" />
			<p class="set-note faint text-xs" id="setIoNote">
				导出的文件包含磁贴、搜索引擎和全部外观设置；自定义壁纸太大时不会带上。
			</p>
		</div>

		<div class="set-group set-danger">
			<mdui-button id="setReset" variant="text" size="small">恢复默认链接与外观</mdui-button>
		</div>

		<div slot="action">
			<mdui-button id="setDone" variant="filled">完成</mdui-button>
		</div>
	</mdui-dialog>

	{/*
	 * 「这类资源现在可能打不开」的确认框。
	 *
	 * 文案由 accessNotice() 按资源类型生成（校内 / 图书馆订购 / 境外三种说法），
	 * **只讲资源本身的前提，不讲探测推测** —— 「当前推测：…」「你可能开着
	 * VPN」这类话用户明确要求删掉了：探测本来就是 no-cors 打一个状态码，
	 * 结论不硬，把它写成断言是误导。
	 *
	 * 关键点是**只提示、不阻拦**：用户可能有 VPN、流量按量走、或者只是这次
	 * 校园网抽风。所以必须让他自己决定，而且默认焦点放在「仍然打开」上，
	 * 想快点的人回车就行。
	*/}
	<mdui-dialog id="warnDialog" class="guide-warn-dialog">
		<div slot="headline">可能打不开</div>
		<div slot="description" id="warnText"></div>
		<div slot="action">
			<mdui-button id="warnCancel" variant="text">算了</mdui-button>
			<mdui-button id="warnGo" variant="filled">仍然打开</mdui-button>
		</div>
	</mdui-dialog>

	{/*
	 * 导入前的确认框。
	 * 导入是**整份替换**，会覆盖现有的磁贴和排序 —— 得让人明确知道这一点，
	 * 而且得能反悔（导出过就还能导回去，但不问一声就覆盖太粗暴了）。
	*/}
	{/*
	 * 右键磁贴出来的编辑框。
	 *
	 * 字段是给「用户自己加的磁贴」用的：默认磁贴的名字和网址来自
	 * links.ts，在这里改只影响本机。删除按钮也放在这个框里而不是磁贴角上
	 * —— 角上常驻一个 × 会让页面看起来一直处在某个特殊状态，
	 * 而删除并不是高频操作。
	 */}
	<mdui-dialog id="tileDialog" class="guide-tile-dialog" close-on-esc close-on-overlay-click>
		<div slot="headline">编辑磁贴</div>
		<mdui-text-field
			id="tileTitle"
			label="名称"
			variant="outlined"
			maxlength="60"
			enterkeyhint="done"
		></mdui-text-field>
		<mdui-text-field
			id="tileUrl"
			label="网址"
			variant="outlined"
			maxlength="500"
			enterkeyhint="done"
		></mdui-text-field>

		<div class="tile-field">
			<p class="tile-field-label">图标</p>
			<mdui-segmented-button-group
				id="tileIconMode"
				selects="single"
				full-width
				aria-label="图标模式"
			>
				<mdui-segmented-button value="site">自动</mdui-segmented-button>
				<mdui-segmented-button value="url">图片</mdui-segmented-button>
				<mdui-segmented-button value="material">图标</mdui-segmented-button>
				<mdui-segmented-button value="text">文字</mdui-segmented-button>
			</mdui-segmented-button-group>
		</div>

		<div id="tileIconUrlWrap" class="tile-icon-input" hidden>
			<mdui-text-field
				id="tileIconUrl"
				label="图片 URL"
				variant="outlined"
				maxlength="500"
				placeholder="https://example.com/icon.png"
			></mdui-text-field>
		</div>
		<div id="tileIconMaterialWrap" class="tile-icon-input" hidden>
			<mdui-select id="tileIconMaterial" label="选择图标" variant="outlined"></mdui-select>
		</div>
		<div id="tileIconTextWrap" class="tile-icon-input" hidden>
			<mdui-text-field
				id="tileIconText"
				label="文字 / emoji"
				variant="outlined"
				maxlength="4"
			></mdui-text-field>
		</div>

		<mdui-select id="tileGroup" label="分类" variant="outlined">
			{guideTabs.map((tab) => (
				<mdui-menu-item value={tab.key}>{tab.label}</mdui-menu-item>
			))}
		</mdui-select>
		<p class="set-note faint text-xs" id="tileError" hidden></p>
		<mdui-button id="tileDelete" slot="action" variant="text" class="guide-tile-delete"
			>删除</mdui-button
		>
		<div slot="action" class="flex-grow"></div>
		<mdui-button id="tileCancel" slot="action" variant="text">取消</mdui-button>
		<mdui-button id="tileSave" slot="action" variant="filled">保存</mdui-button>
	</mdui-dialog>

	<mdui-dialog id="ioDialog" class="guide-io-dialog" close-on-esc close-on-overlay-click>
		<div slot="headline">导入配置</div>
		<div slot="description" id="ioSummary"></div>
		<div class="guide-io-detail faint text-xs" id="ioDetail"></div>
		<div slot="action">
			<mdui-button id="ioCancel" variant="text">取消</mdui-button>
			<mdui-button id="ioConfirm" variant="filled">覆盖导入</mdui-button>
		</div>
	</mdui-dialog>

	{/*
	 * 网络连通性探测**没有界面**了。
	 *
	 * 原来左下角有个小框常驻显示「已接入校园网 · 国际互联网通畅」这类结论，
	 * 它一直在替用户下判断、还要占一块视觉空间。现在改成：
	 *   - 后台照常探测（结果缓存 5 分钟）
	 *   - 只在**真的要打开某个打不开的站点时**才弹窗询问（见下面的 warnDialog）
	 *   - 需要手动重测的话，从「设置」里点
	 * 依据始终是「推测」——网页看不到 IP，只能靠地址可达性反推。
	 */}

	{/*
	 * 编辑与设置的**唯一入口**。
	 *
	 * 原来这里是「编辑磁贴」的 FAB，搜索行右侧另有一个设置齿轮，
	 * 两个入口分管一半功能 —— 调外观得找一个、改链接得找另一个。
	 * 现在合成一个面板（见下面 setDialog），入口留在 FAB 的位置：
	 * 它是整个页面唯一的悬浮控件，位置最显眼，又不跟搜索框抢那一行。
	 *
	 * ⚠️ 不要用 size="large"：MD3 的大号 FAB 是 96px 见方，配上默认图标
	 * 差不多占屏幕 1/16，在只有搜索框和磁贴的起始页上过于抢眼（实测很雷霆）。
	 * 用默认 medium，图标也调小一档。
	 */}
	<mdui-fab
		id="guideFab"
		class="guide-fab"
		variant="secondary"
		aria-label="编辑与设置"
		title="编辑与设置"
	>
		<mdui-icon-settings slot="icon" class="guide-fab-icon"></mdui-icon-settings>
	</mdui-fab>

	<style is:global>
		/*
		 * 起始页要「只有内容」。Base.astro 的 body 没有额外内边距，
		 * 这里自己接管整屏高度与背景层次。
		 *
		 * 背景是同济邮箱登录页那张校园风景照（从它的
		 * /coremail/s?func=lp:getImg&img_id=background_001 拿下来的，1920×1080），
		 * 存在 public/images/tongji-campus.jpg，已压到 1600px / 约 293K。
		 *
		 * 用**固定定位的伪元素**铺底，而不是 background-attachment: fixed ——
		 * 后者在移动端滚动时会明显卡顿，还会让 Safari 的 fixed 定位失效。
		 * 上面再盖一层半透明遮罩，不然照片太花、搜索框和磁贴标签读不清。
		 */
		body:has(.guide) {
			min-height: 100vh;
		}

		body:has(.guide)::before {
			content: '';
			position: fixed;
			inset: 0;
			z-index: -1;
			background-image: var(--guide-wall, none);
			background-size: cover;
			background-position: center;
			background-repeat: no-repeat;
		}

		/*
		 * 遮罩跟主题**解耦**：固定用近黑，深浅两套主题都是给背景压暗，
		 * 保证前景（不透明的搜索框 / 磁贴面板）对比度够。
		 *
		 * 原来浅色主题用的是 rgba(var(--mdui-color-surface), a)，也就是
		 * rgba(251,252,254,a) —— 一层近乎白纸的东西盖在白花照片上，
		 * 透明度加到 0.92 也还是亮的（实测樱花大道糊成灰白，字照样费劲）。
		 * 物理上只有深色遮罩能压暗背景，跟主题的前景色是两件事：
		 * 深色遮罩 + 浅色主题完全成立，就像给照片加了层墨镜，
		 * 前景该白的还是白。
		 *
		 * ⚠️ 必须写 rgb(分量) 而不是 var()：这是固定色，不跟主题走，
		 * 也就不需要（也不能）再拼 MDUI 令牌（MDUI 令牌是 `28, 27, 31`
		 * 这种逗号分量，直接 rgb() 拼会静默失效）。
		 *
		 * 浓度经 --guide-scrub 传进来（照片默认 0.58、渐变 0.5，见
		 * PHOTO_SCRUB_DEFAULT / SCRUB_RANGE），滑块可调。
		 */
		body:has(.guide)::after {
			content: '';
			position: fixed;
			inset: 0;
			z-index: -1;
			background: rgba(12, 14, 18, var(--guide-scrub, 0.5));
		}


		.guide {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 2.5rem;
			min-height: 100vh;
			padding: clamp(3rem, 12vh, 7rem) 1.25rem 6rem;
			box-sizing: border-box;
		}

		/* ---------------------------------------------------------- 搜索框 */

		/*
		 * Firefox 的搜索条是一个大圆角胶囊。
		 *
		 * 这里让**外层 .guide-search 只负责布局**（透明、无内边距），
		 * 胶囊本身交给 mdui-text-field 的容器（::part(container)）去画。
		 * 反过来做（外层画胶囊、text-field 用默认 filled 样式）会叠成两层：
		 * 灰底 + 白底 + 一道下划线，在页面上非常明显。
		 *
		 * 令牌要写成 rgb(var(--...)) 而不是 var(--...)：
		 * MDUI 的令牌值是 `28, 27, 31` 这样的逗号分量，直接 var() 会算不出颜色，
		 * 实测背景会静默变成透明。
		 */
		.guide-search {
			display: flex;
			align-items: center;
			flex: 1 1 auto;
			min-width: 0;
		}

		/* 设置按钮：和引擎按钮同款圆钮，贴在搜索框右侧 */
	.set-button {
			--mdui-comp-icon-button-icon-size: 1.2rem;
			min-width: 0;
			flex: 0 0 auto;
			width: 3rem;
			height: 3rem;
			padding: 0;
			border-radius: 50%;
			background: rgb(var(--mdui-color-surface-container-high));
			transition: background-color var(--mdui-motion-duration-short2);
		}

		.set-button:hover,
		.set-button:focus-visible {
			background: rgb(var(--mdui-color-surface-container-highest));
		}

		/* 引擎按钮 + 搜索框并排，整体仍居中 */
		.guide-search-row {
			display: flex;
			align-items: center;
			gap: 0.6rem;
		}

		/* 浮层的定位基准：贴着引擎按钮左上角往下展开 */
		.guide-search-wrap {
			position: relative;
			width: min(38rem, 100%);
		}

		.guide-search:focus-within mdui-text-field::part(container) {
			outline: 2px solid rgb(var(--mdui-color-primary));
			outline-offset: 2px;
		}

		.guide-search-icon {
			color: rgb(var(--mdui-color-primary));
			flex: 0 0 auto;
		}

		.guide-search mdui-text-field {
			flex: 1 1 auto;
		}

		.guide-search mdui-text-field::part(container) {
			background: rgb(var(--mdui-color-surface-container-high)) !important;
			border-radius: 999px !important;
			border: none !important;
			box-shadow: none !important;
			padding-inline: 1.15rem !important;
		}

		/* ------------------------------------------------------ 搜索引擎选择 */

		/*
		 * 引擎按钮：独立圆按钮，和搜索框胶囊并排。
		 * 底色用 surface-container-high，比胶囊略深一点以示「这是个按钮」。
		 */
		.engine-button {
			--mdui-comp-icon-button-icon-size: 1.4rem;
			min-width: 0;
			flex: 0 0 auto;
			width: 3rem;
			height: 3rem;
			padding: 0;
			border-radius: 50%;
			background: rgb(var(--mdui-color-surface-container-high));
			transition: background-color var(--mdui-motion-duration-short2);
		}

		.engine-button:hover,
		.engine-button:focus-visible {
			background: rgb(var(--mdui-color-surface-container-highest));
		}

		.engine-mark {
			display: grid;
			place-items: center;
			width: 100%;
			height: 100%;
		}

		/* 彩色 logo 给足尺寸才看得出细节（Google 的四色、DDG 的八色） */
		.engine-mark img {
			width: 1.5rem;
			height: 1.5rem;
			object-fit: contain;
		}

		/*
		 * 引擎浮层。
		 *
		 * 绝对定位在搜索框正下方、宽度与搜索框对齐，
		 * 视觉上就是「从搜索框里长出来的一张菜单」。
		 * z-index 要高于磁贴，否则会被下面的标签页盖住。
		 */
		.engine-pop {
			position: absolute;
			top: calc(100% + 0.5rem);
			left: 0;
			z-index: 4;
			/*
			 * 宽度**跟着内容走**，不要继承搜索框的 38rem。
			 * 菜单项本身只有十几个字宽，写死 100% 的话右侧会空掉一大半，
			 * 看起来像布局出错。min-width 兜住「恢复自动选择」那行按钮，
			 * max-width 防止窄屏溢出。
			 */
			display: flex;
			flex-direction: column;
			width: max-content;
			min-width: 14rem;
			max-width: min(100%, 20rem);
			box-sizing: border-box;
			padding: 0.35rem;
			border-radius: var(--mdui-shape-corner-medium);
			background: rgb(var(--mdui-color-surface-container-high));
			box-shadow: 0 0 1px rgb(var(--mdui-color-outline-variant)), 0 8px 24px rgb(0 0 0 / 0.18);
		}

		/* mdui-menu 自带 surface + 边框，这里跟浮层背景统一，避免两层壳 */
		.engine-menu {
			background: none;
			box-shadow: none;
			border: none;
		}

		/* MD3 把菜单项内边距交给使用者，这里给回常规间距 */
		.engine-menu mdui-menu-item {
			--mdui-comp-list-item-label-text-size: var(--mdui-typescale-body-medium-size);
			padding: 0.5rem 0.75rem;
			border-radius: var(--mdui-shape-corner-small);
		}

		/* 菜单里的 logo：彩色 logo 在深色下也需要一点余量才认得出 */
		.engine-menu .engine-item-icon {
			display: grid;
			place-items: center;
			width: 1.5rem;
			height: 1.5rem;
			margin-right: 0.75rem;
		}

		.engine-menu .engine-item-icon img {
			width: 1.4rem;
			height: 1.4rem;
			object-fit: contain;
		}

		.engine-pop-note {
			margin: 0.4rem 0.75rem 0;
			color: rgb(var(--mdui-color-on-surface-variant));
			font-size: var(--mdui-typescale-label-small-size);
			line-height: 1.5;
		}

		.engine-pop-reset {
			width: 100%;
			margin-top: 0.25rem;
			justify-content: flex-start;
		}

		/*
		 * ⚠️ `hidden` 属性对自定义元素**无效**。
		 * UA 样式表里的 `[hidden] { display: none }` 属于「用户代理」优先级，
		 * 而 mdui-button 自己的 `display: inline-flex` 是「作者」优先级，
		 * 作者样式赢 —— 结果就是设了 hidden 按钮照样显示。
		 * （这个坑之前在 mdui-button-icon 上也踩过一次。）
		 */
		[hidden] {
			display: none !important;
		}

		/* -------------------------------------------------------- 网络状态 */

		/*
		 * 左下角的小框。
		 *
		 * 之前是搜索框下方一条通栏状态条，实测很占地方：起始页的主角是磁贴，
		 * 而网络状态只是「参考信息」，不需要占一整行。改成 fixed 小框后，
		 * 点开对话框、编辑磁贴都不受影响，滚到哪儿都能看到。
		 */
		.net-box {
			position: fixed;
			left: 1.25rem;
			bottom: 1.25rem;
			z-index: 2;
			display: flex;
			align-items: center;
			gap: 0.55rem;
			max-width: calc(100vw - 2.5rem);
			padding: 0.3rem 0.4rem 0.3rem 0.85rem;
			border-radius: 999px;
			background: rgb(var(--mdui-color-surface-container-high));
			box-shadow: 0 0 1px rgb(var(--mdui-color-outline-variant));
			font-size: var(--mdui-typescale-label-small-size);
		}

		.net-overall {
			font-weight: var(--mdui-typescale-title-small-weight);
			/* 单行省略：结论最长是「已接入校园网 · 国际互联网通畅」 */
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.net-overall.tone-ok {
			color: rgb(var(--mdui-color-primary));
		}

		.net-overall.tone-warn {
			color: rgb(var(--mdui-color-error));
		}

		.net-items {
			display: flex;
			align-items: center;
			gap: 0.4rem;
			flex: 0 0 auto;
		}

		/* 每个目标只留一个点，文字全在 title 里 —— 小框塞不下三段文字 */
		.net-item {
			display: inline-flex;
			align-items: center;
			gap: 0.25rem;
			color: rgb(var(--mdui-color-on-surface-variant));
			white-space: nowrap;
		}

		/* 小圆点用 currentColor，省掉按状态各写一套色 */
		.net-dot {
			width: 0.5rem;
			height: 0.5rem;
			border-radius: 50%;
			background: currentColor;
			flex: 0 0 auto;
		}

		.net-item.state-ok {
			color: rgb(var(--mdui-color-primary));
		}

		.net-item.state-fail {
			color: rgb(var(--mdui-color-error));
		}

		.net-item.state-checking .net-dot {
			animation: net-pulse 1s ease-in-out infinite;
		}

		@keyframes net-pulse {
			50% {
				opacity: 0.25;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			.net-item.state-checking .net-dot {
				animation: none;
			}
		}

		/*
		 * 窄屏上「结论 + 三个点」还是太宽，只留结论。
		 * 三个点的信息在点一下标题栏也能看到，不算丢。
		 */
		@media (max-width: 559px) {
			.net-items {
				display: none;
			}
		}

	/* ---------------------------------------------------------- 磁贴 */

		/* 标签栏：标签 + 右侧「新建标签页」按钮 */
	.guide-tabbar {
		display: flex;
		align-items: flex-start;
		gap: 0.4rem;
		width: 100%;
		max-width: 60rem;
	}

	.guide-tabs-host {
		flex: 1 1 auto;
		min-width: 0;
	}

	.guide-tab-add {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-top: 0.35rem;
		border: none;
		border-radius: 50%;
		background: rgb(var(--mdui-color-surface));
		color: rgb(var(--mdui-color-on-surface-variant));
		box-shadow: 0 0 1px rgb(var(--mdui-color-outline-variant));
		cursor: pointer;
	}

	.guide-tab-add:hover {
		background: rgb(var(--mdui-color-surface-container-high));
	}

	/* 标签页拖动中的提示（mdui-tab 内部布局，只做轻量反馈） */
	.guide-tabs mdui-tab.is-dragging {
		opacity: 0.5;
	}

	/* 标签页右键菜单（重命名 / 删除）—— 自绘小浮层，不动 mdui 组件 */
	.guide-tab-menu {
		position: fixed;
		z-index: 2000;
		display: grid;
		min-width: 8rem;
		padding: 0.25rem;
		border-radius: var(--mdui-shape-corner-medium);
		background: rgb(var(--mdui-color-surface-container-high));
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.24);
	}

	.guide-tab-menu button {
		border: none;
		background: none;
		color: rgb(var(--mdui-color-on-surface));
		font: inherit;
		text-align: left;
		padding: 0.5rem 0.85rem;
		border-radius: var(--mdui-shape-corner-small);
		cursor: pointer;
	}

	.guide-tab-menu button:hover {
		background: rgb(var(--mdui-color-surface-container-highest));
	}

	.guide-tab-menu button.is-danger {
		color: rgb(var(--mdui-color-error));
	}

		/* 标签页：整页宽，磁贴网格居中在下面 */
	.guide-tabs {
		width: 100%;
		max-width: 60rem;
		/*
		 * 标签栏要**不透明**。
		 * mdui-tabs 默认背景带 alpha，铺在校园风景照上就成了一条灰蒙蒙的
		 * 脏带子，标签文字对比度也不够（实测很明显）。这里给回实心 surface，
		 * 外面一圈描边分隔，视觉上就是一条清爽的导航条。
		 */
		--mdui-comp-tabs-container-color: rgb(var(--mdui-color-surface));
		background: rgb(var(--mdui-color-surface));
		border-radius: var(--mdui-shape-corner-medium);
		box-shadow: 0 0 1px rgb(var(--mdui-color-outline-variant));
		overflow: hidden;
	}

		/*
		 * 8 列上限、整体居中 —— 和 Firefox 一致。磁贴尺寸用固定值而不是
		 * minmax()，否则宽屏上会被拉得参差不齐。
		 */
		.guide-tiles {
			display: grid;
			grid-template-columns: repeat(auto-fill, 6.5rem);
			justify-content: center;
			gap: 1.25rem 0.75rem;
			max-width: 60rem;
			width: 100%;
		}

		.guide-tile {
			position: relative;
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.5rem;
			width: 6.5rem;
			padding: 0.5rem 0.25rem;
			border-radius: var(--mdui-shape-corner-medium);
			color: inherit;
			text-decoration: none;
			transition: background-color var(--mdui-motion-duration-short2);
		}

		.guide-tile:hover,
		.guide-tile:focus-visible {
			background: rgb(var(--mdui-color-surface-container-high));
		}

		.guide-tile:focus-visible {
			outline: 2px solid rgb(var(--mdui-color-primary));
			outline-offset: -2px;
		}

		/* 「添加磁贴」方块：外观同普通磁贴，只是图标是一个 ＋ */
		.guide-tile-add {
			border: none;
			background: none;
			font: inherit;
			color: rgb(var(--mdui-color-on-surface-variant));
			cursor: pointer;
		}

		/*
		 * 图标容器：固定方形 + 大圆角，favicon 铺满、emoji 居中。
		 * Firefox 用的是「圆角方块 + 站点自己的图标」，这里保持同一比例。
		 */
		.guide-tile-icon {
			display: grid;
			place-items: center;
			width: 3.75rem;
			height: 3.75rem;
			border-radius: 1.1rem;
			background: rgb(var(--mdui-color-surface-container-highest));
			overflow: hidden;
			font-size: 1.6rem;
			line-height: 1;
		}

		.guide-tile-icon img {
			width: 2.25rem;
			height: 2.25rem;
			object-fit: contain;
		}

		/*
		 * 用 mask 上色的图标（见 data/site-icons.ts 的 siteIconMasks）。
		 * 形状来自 SVG，填充色是 currentColor —— 继承磁贴的文字色，
		 * 于是深浅主题自动正确，不需要两份图。
		 */
		.guide-tile-mask {
			width: 2.25rem;
			height: 2.25rem;
			background-color: currentColor;
			-webkit-mask: center / contain no-repeat;
			mask: center / contain no-repeat;
		}

		/*
		 * 主站工具磁贴：Material Icons，跟 /tools 页面上画的一模一样。
		 * 用 currentColor，两套主题都对。
		 */
		.guide-tile-icon .mdui-icon {
			font-size: 2.25rem;
			width: 2.25rem;
			height: 2.25rem;
		}

		/*
		 * 兜底徽标（构建期没抓到 favicon 的站点）。
		 * 底色由 siteFallbackColor() 按域名散列给出，这里只管排版。
		 */
		.guide-tile-icon.is-monogram {
			color: #fff;
			font-weight: 600;
			font-size: 1.5rem;
		}

		.guide-tile-label {
			width: 100%;
			/* 两行截断，和 Firefox 一致（长标题不至于把网格撑开） */
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
			text-align: center;
			font-size: var(--mdui-typescale-body-small-size);
			line-height: 1.3;
			overflow-wrap: anywhere;
		}

		/*
		 * 网络前提标记（「需校园网」/「境外」）。
		 *
		 * 绝对定位到图标右上角，不占磁贴高度 —— 标签位置留给用户看标题。
		 * 只有真的需要时才出现：不在校园网就不显示「需校园网」，
		 * 探测还没跑完（unknown）也不显示，不给用户添堵。
		 */
		.guide-tile-flag {
			position: absolute;
			top: -0.15rem;
			right: -0.15rem;
			padding: 0.1rem 0.35rem;
			border-radius: 999px;
			background: rgb(var(--mdui-color-tertiary-container));
			color: rgb(var(--mdui-color-on-tertiary-container));
			font-size: 0.6rem;
			line-height: 1.4;
			white-space: nowrap;
			pointer-events: none;
		}

		/* --------------------------------------------------- 拖动排序 */

		/*
		 * 磁贴**始终**可拖（见 render() 里 item.draggable = true）。
		 * grab 是「按住就能挪」的暗示，比 default 更能让人发现这个能力。
		 */
		.guide-tile[draggable='true'] {
			cursor: grab;
		}

		.guide-tile.is-dragging {
			opacity: 0.45;
		}

		.guide-tile.is-dropzone {
			outline: 2px dashed rgb(var(--mdui-color-primary));
			outline-offset: -2px;
		}

		.guide-fab {
			position: fixed;
			right: 1.25rem;
			bottom: 1.25rem;
			z-index: 2;
			--mdui-comp-fab-icon-size: 1.25rem;
		}

		/* 编辑与设置是个次要操作，不该用满色抢注意力 */
		.guide-fab-icon {
			--mdui-comp-icon-size: 1.25rem;
		}

		/* ------------------------------------------------------ 磁贴编辑弹窗 */

	/*
	 * ⚠️ 不要给 mdui-dialog 自身写 display: grid。
	 * 组件的 :host 默认是 display:none，靠它控制显隐；
	 * 一旦用类选择器覆盖成 grid，`open = false` 也照样显示 ——
	 * 表现就是「一打开页面，关着的编辑框浮在那儿」，而且它的遮罩
	 * 还会吞掉点掉的点击（“点击毫无反应”就是这么来的）。
	 *
	 * 要排版就用 ::part() 或者 slotted 内容自己的类：
	 * 下面只改 panel 和内部间距，不动 host 的 display。
	 */
	.guide-tile-dialog::part(panel) {
		width: min(24rem, calc(100vw - 2rem));
		/* 左右内边距收窄：分段按钮组（4 个）需要 ~253px，
		   mdui 默认 24px 内边距会让窄屏下的内容宽度不够，撑出横向滚动条 */
		padding-inline: 0.75rem;
	}

	/*
	 * body 默认是 display:block，gap 不生效（设了也白设）。改成纵向 flex，
	 * 才能靠 gap 给字段之间留出稳定间距 —— 否则字段紧贴，
	 * 下一个字段浮起的标签（如「分类」）会压到上一个控件上。
	 * 顶部再留出约一个浮起标签的高度，避免第一个字段的标签被滚动裁剪。
	 */
	.guide-tile-dialog::part(body) {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding-block-start: 0.85rem;
		/* 任何子项都不该再撑出横向滚动条 */
		overflow-x: hidden;
	}

	/* 磁贴编辑弹窗：压缩字段高度，让布局更紧凑 */
	.guide-tile-dialog mdui-text-field,
	.guide-tile-dialog mdui-select {
		--mdui-comp-text-field-container-height: 3rem;
	}

	.guide-tile-dialog .tile-field {
		display: grid;
		gap: 0.35rem;
	}

	.guide-tile-dialog .tile-field-label {
		margin: 0;
		color: rgb(var(--mdui-color-on-surface-variant));
		font-size: var(--mdui-typescale-label-medium-size);
		font-weight: 500;
	}

	/* 分段按钮组用 mdui 的 full-width（见 HTML 属性），四等分撑满整行，
	   不再靠 overflow:hidden 把超出的按钮硬裁掉 */
	.guide-tile-dialog mdui-segmented-button-group {
		width: 100%;
		min-width: 0;
	}

	/* 允许分段按钮收缩，避免四等分时把容器撑宽 */
	.guide-tile-dialog mdui-segmented-button {
		min-width: 0;
	}

	.guide-tile-dialog .tile-icon-input {
		display: grid;
	}

	/* 文字 / emoji 图标样式 */
	.guide-tile-icon.is-text {
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.1rem;
		font-weight: 600;
		line-height: 1;
	}

	/* 「删除」放动作行最左侧（用弹性 spacer 把它和取消/保存分开）—— 减少误触 */
	.guide-tile-dialog .guide-tile-delete {
		color: rgb(var(--mdui-color-error));
	}

	/* ------------------------------------------------------ 设置面板 */

	.guide-set-dialog .set-group {
		display: grid;
		gap: 0.5rem;
		margin-bottom: 1.1rem;
	}

	.set-group-title {
		margin: 0;
		color: rgb(var(--mdui-color-on-surface-variant));
		font-size: var(--mdui-typescale-label-medium-size);
		font-weight: 500;
	}

	.set-note {
		margin: 0;
		line-height: 1.5;
	}

	.set-row {
		display: flex;
		gap: 0.4rem;
	}

	/*
	 * 「默认在校园网环境下」开关：左文字右开关。
	 * 说明文字走 body-small + on-surface-variant，跟 set-note 一致，
	 * 免得在面板里显得比标题还重。
	 */
	.set-switch {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		cursor: pointer;
	}

	.set-switch > span {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		color: rgb(var(--mdui-color-on-surface));
		font-size: var(--mdui-typescale-body-medium-size);
		line-height: 1.5;
	}

	.set-switch > span > span {
		max-width: 26rem;
		color: rgb(var(--mdui-color-on-surface-variant));
		font-size: var(--mdui-typescale-body-small-size);
	}

	/* 主题色色板 */
	.set-swatches {
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.set-swatch {
		width: 2rem;
		height: 2rem;
		padding: 0;
		border: 2px solid transparent;
		border-radius: 50%;
		cursor: pointer;
		box-shadow: inset 0 0 0 1px rgb(var(--mdui-color-outline-variant));
		transition: transform var(--mdui-motion-duration-short2);
	}

	.set-swatch:hover {
		transform: scale(1.08);
	}

	.set-swatch.is-on {
		border-color: rgb(var(--mdui-color-on-surface));
	}

	.set-swatch:focus-visible {
		outline: 2px solid rgb(var(--mdui-color-primary));
		outline-offset: 2px;
	}

	.set-modes {
		justify-self: start;
	}

	/* 壁纸缩略图 */
	.set-walls {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(3.6rem, 1fr));
		gap: 0.5rem;
	}

	/*
	 * 壁纸分组小标题（校园照片·春 / 渐变 / 基础）。
	 * 占满整行：标题下面是它自己的那一排缩略图，
	 * 不然会和下一组的图混在同一 grid 行里对不齐。
	 */
	.set-wall-group {
		grid-column: 1 / -1;
		margin: 0.4rem 0 0.1rem;
		color: rgb(var(--mdui-color-on-surface-variant));
		font-size: var(--mdui-typescale-label-small-size);
		font-weight: 600;
	}

	.set-wall-group:first-child {
		margin-top: 0;
	}

	.set-wall {
		aspect-ratio: 1;
		padding: 0;
		border: 2px solid transparent;
		border-radius: var(--mdui-shape-corner-small);
		background-color: rgb(var(--mdui-color-surface-container-highest));
		background-size: cover;
		background-position: center;
		cursor: pointer;
		box-shadow: inset 0 0 0 1px rgb(var(--mdui-color-outline-variant));
	}

	.set-wall.is-on {
		border-color: rgb(var(--mdui-color-primary));
	}

	.set-wall:focus-visible {
		outline: 2px solid rgb(var(--mdui-color-primary));
		outline-offset: 2px;
	}

	.set-upload {
		justify-self: start;
	}

	.set-danger {
		padding-top: 0.4rem;
		border-top: 1px solid rgb(var(--mdui-color-outline-variant));
	}

	

	/* 导入/导出条：只在编辑态出现 */
	.guide-io {
		display: flex;
		gap: 0.5rem;
		margin-top: -1.5rem;
	}

	.guide-io-detail {
		max-width: 32rem;
		margin-bottom: 0.75rem;
		line-height: 1.6;
		white-space: pre-wrap;
		word-break: break-word;
	}
	</style>

	<script>
		import '../lib/icons';
		import '@mdui/icons/search.js';
		import '@mdui/icons/edit.js';
		import '@mdui/icons/done-all.js';
		import '@mdui/icons/refresh.js';
		import '@mdui/icons/settings.js';
		import {
			defaultTiles,
			guideCatalog,
			guideTabs,
			FALLBACK_GROUP,
			siteIcon,
			siteFallback,
			siteFallbackColor,
			serializeConfig,
			parseConfig,
			configFilename,
			type TileConfig,
			normalizeUrl,
			resolveTarget,
			tileAccess,
			accessWarning,
			accessNotice,
			readAssumeCampus,
			writeAssumeCampus,
			applyAssumeCampus,
			SEARCH_ENGINES,
			pickEngine,
			intlAvailable,
			type SearchEngine,
			netTargets,
			parseSnapshot,
			isStale,
			describeOverall,
			THEME_COLORS,
			THEME_MODES,
			WALLPAPERS,
			MAX_CUSTOM_WALLPAPER_BYTES,
			sanitizeScrub,
			isUsableUrl,
			pickWallByTime,
			defaultScrubFor,
			type AppearanceConfig,
			type ThemeMode,
			type NetSnapshot,
			type GuideTab,
			parseTabs,
			nextTabTone,
			makeTabKey,
			MAX_TABS,
			MAX_TAB_LABEL,
		} from '../data/guide';
		import { siteIconMasks } from '../data/site-icons';

		const $ = <T extends HTMLElement = HTMLElement>(id: string): T => {
			const el = document.getElementById(id);
			if (!el) throw new Error(`缺少元素 #${id}`);
			return el as T;
		};
		type TextField = HTMLInputElement & { value: string };
		/** mdui-select 同理：选中值只在 value 上 */
		type SelectEl = HTMLElement & { value: string };
		/** mdui-button 没有原生 button 的 disabled/focus 那套，这里只用得到 label */
		type ButtonEl = HTMLElement;
		/*
		 * mdui-dialog **没有** show() / close() 方法，只能读写 open 属性 ——
		 * 照着别的组件想当然地调 dialog.close() 会抛 "close is not a function"。
		 * 关闭事件是 `closed`，不是 `close`。
		 */
		type DialogEl = HTMLElement & { open: boolean };
		/*
		 * mdui-menu-item 的 selected 在类型里是 **protected**（组件内部状态），
		 * value 也是自定义属性，HTMLElement 上都不存在。
		 * 这两处只能按组件的实际契约断言 —— 它确实支持这两个属性，
		 * 见 node_modules/mdui/components/menu/menu-item.d.ts。
		 */
		type MenuItemEl = HTMLElement & { value: string; selected: boolean };

		const STORE_KEY = 'jwwl:tiles';
		const TAB_KEY = 'jwwl:tabs';

	interface Tile {
		id: string;
		title: string;
		url: string;
		/**
		 * 图标值。含义由 iconMode 决定：
		 * - 'url' → 图片 URL
		 * - 'material' → Material Icons 组件名
		 * - 'text' → emoji 或短文字
		 * - 未设置 → 按网址自动取站点 favicon（向后兼容）
		 */
		icon: string;
		iconMode?: 'url' | 'material' | 'text';
		group: string;
		/** Material Icons 组件名（如 'swap-horiz'）；有值就不走 favicon */
		materialIcon?: string;
	}

		/*
		 * 标签页（用户可新建 / 删除 / 拖动排序），存 localStorage。
		 * 读不到或存坏就退回 links.ts 里的默认分类。
		 */
		const defaultTabList = (): GuideTab[] => guideTabs.map((tab) => ({ ...tab }));

		function loadTabs(): GuideTab[] {
			try {
				const raw = localStorage.getItem(TAB_KEY);
				if (!raw) return defaultTabList();
				return parseTabs(JSON.parse(raw)) ?? defaultTabList();
			} catch {
				return defaultTabList();
			}
		}

		let tabs: GuideTab[] = loadTabs();
		if (!tabs.length) tabs = defaultTabList();

		function saveTabs(): void {
			try {
				localStorage.setItem(TAB_KEY, JSON.stringify(tabs));
			} catch {
				showHint('浏览器不允许本地存储，这次的改动不会被记住。');
			}
		}

		/** 当前激活的标签页 key */
		let activeTab: string = tabs[0]?.key ?? '';

		/** group 是否是当前存在的标签页 key */
		const knownGroup = (value: unknown): value is string =>
			typeof value === 'string' && tabs.some((tab) => tab.key === value);

		/** 归置磁贴时的兜底标签页（第一个） */
		const fallbackGroup = (): string => tabs[0]?.key ?? FALLBACK_GROUP;

		/*
		 * 读取本地磁贴。
		 * 存坏数据 / 隐私模式 / 配额满都退回默认集合 —— 起始页不能因为
		 * 读不到 localStorage 就白屏，那比没有自定义功能更糟。
		 */
		function load(): Tile[] {
			try {
				const raw = localStorage.getItem(STORE_KEY);
				if (!raw) return [...defaultTiles];
				const parsed = JSON.parse(raw) as unknown;
				if (!Array.isArray(parsed)) return [...defaultTiles];
				const clean = parsed.filter(
					(item): item is Tile =>
						!!item &&
						typeof (item as Tile).id === 'string' &&
						typeof (item as Tile).url === 'string',
				);
				/*
				 * 老版本存的磁贴没有 group 字段（分 tabs 之前加的）。
				 * 这里就地补上 —— 尽量按网址回查目录拿到原分类，
				 * 查不到就丢进兜底标签页，别让磁贴凭空消失。
				 */
				return clean.map((tile) => {
					if (knownGroup(tile.group)) return tile;
					const matched = guideCatalog.find(
						(link) => link.url.replace(/\/+$/, '') === tile.url.replace(/\/+$/, ''),
					);
					const group = matched && knownGroup(matched.group) ? matched.group : fallbackGroup();
					return { ...tile, group };
				});
			} catch {
				return [...defaultTiles];
			}
		}

		function save(tiles: Tile[]): void {
			try {
				localStorage.setItem(STORE_KEY, JSON.stringify(tiles));
			} catch {
				showHint('浏览器不允许本地存储，这次的改动不会被记住。');
			}
		}

		let tiles = load();

		/** 标签页 key → 该标签页的网格容器（renderTabs 里重建） */
		const grids = new Map<string, HTMLElement>();

		/*
		 * 「最后一次操作」提示不再展示 —— 起始页底下不写这些。
		 * 保留同名空函数，省得逐个删调用点。
		 */
		function showHint(_text: string): void {
			void _text;
		}

		// ─────────────────────────────────────────────── 渲染

		function render(): void {
			for (const grid of grids.values()) grid.textContent = '';

			for (const tile of tiles) {
				const grid = grids.get(tile.group);
				if (!grid) continue;

				const item = document.createElement('a');
				item.className = 'guide-tile';
				item.href = normalizeUrl(tile.url);
				/*
				 * 起始页的磁贴一律**新标签页打开**。
				 *
				 * 起始页本身要一直留着 —— 用户是把它当浏览器主页用的，
				 * 点开一个站点就把主页替换掉，等于毁掉这个页面的存在意义。
				 *
				 * noopener 是必须的：没有它，新页面能用 window.opener 反向
				 * 操作本站（改 localStorage、跳转 location）。
				 * noreferrer 是少把 Referer 泄露给对方。
				 */
				item.target = '_blank';
				item.rel = 'noopener noreferrer';
				item.setAttribute('role', 'listitem');

				/*
				 * **始终**可拖，不需要先进某个「编辑模式」。
				 *
				 * 原来拖动要先点右下角 FAB 切到编辑态才能用，而「调整位置」
				 * 本来就是想到才做的事 —— 为了挪一下磁贴先切一遍模式，
				 * 挪完还得切回来，太多余。现在拖动是磁贴的固有能力，
				 * 右键菜单负责改内容和删除，两者都不需要显式进入编辑态。
				 */
				item.draggable = true;
				item.dataset.id = tile.id;

				const box = document.createElement('span');
				box.className = 'guide-tile-icon';
				/*
				 * 图标分两种，按 tile.materialIcon 有无分流：
				 *
				 * 1) materialIcon —— 主站自己的工具（/tools/*）。照抄 /tools 页面的画法，
				 *    <mdui-icon-swap-horiz> 这种组件名由 src/lib/icons.ts 注册，
				 *    跟主站完全一致。**不能走 favicon**：这些工具全在同一个域名下，
				 *    按 host 取 favicon 会让 16 个磁贴显示成同一个站点图标
				 *    （实测一排金色奖杯），用户明确说过别这样。
				 *
				 * 2) 其余一律用**本地** favicon（构建期抓好的，见 siteIcon）。
				 *
				 * favicon 之前是「先摆 emoji，favicon 加载成功再盖住」，现在整段删了：
				 *  - 运行时读 https://站点/favicon.ico 失败率极高，
				 *    每失败一次就在控制台留一条红色报错，一屏十几条；
				 *  - 而且 emoji 和站点八竿子打不着（谁分得清 💻 是哪个系统），
				 *    用户明确要求别用。
				 * 拿不到本地图时，退回「标题首字 + 域名配色」的徽标。
				 */
				/*
				 * 有 materialIcon 就到此为止 —— **绝不能**再往下走兜底分支。
				 * 兜底那几行是 `box.textContent = ...`，赋值即清空所有子节点，
				 * 会把刚插进去的 <mdui-icon-*> 抹掉（表现就是图标全变首字徽标）。
				 */
				/*
				 * 用户自定义图标模式（优先级最高，主站小工具除外）：
				 * - 'url' → 图片 URL
				 * - 'material' → Material Icons 组件名
				 * - 'text' → emoji 或短文字
				 * 这些都不走 siteIcon 兜底，只有 iconMode 为空时
				 * 才按网址自动取 favicon。
				 */
				let icon: string | null = null;
				const materialName =
					tile.materialIcon && /^[a-z0-9-]{1,40}$/.test(tile.materialIcon)
						? tile.materialIcon
						: null;
				if (tile.iconMode === 'url' && tile.icon) {
					const img = document.createElement('img');
					img.src = tile.icon;
					img.alt = '';
					img.loading = 'lazy';
					img.decoding = 'async';
					img.addEventListener('error', () => {
						img.remove();
						box.textContent = siteFallback(tile.title, tile.url);
						box.style.background = siteFallbackColor(tile.url);
						box.classList.add('is-monogram');
					});
					box.appendChild(img);
				} else if (tile.iconMode === 'material' && tile.icon) {
					const glyph = document.createElement(`mdui-icon-${tile.icon}`);
					glyph.setAttribute('aria-hidden', 'true');
					box.appendChild(glyph);
				} else if (tile.iconMode === 'text' && tile.icon) {
					box.textContent = tile.icon;
					box.style.background = siteFallbackColor(tile.url);
					box.classList.add('is-text');
				} else if (materialName) {
					const glyph = document.createElement(`mdui-icon-${materialName}`);
					glyph.setAttribute('aria-hidden', 'true');
					box.appendChild(glyph);
				} else if ((icon = siteIcon(tile.id, tile.url)) && siteIconMasks.includes(tile.id)) {
					/*
					 * 用 CSS mask 渲染，颜色跟着页面主题走。
					 *
					 * 这类 SVG 自带 `@media (prefers-color-scheme: dark)` 想自动适配，
					 * 但 `<img>` 加载的 SVG 里，媒体查询是按**操作系统**配色方案算的，
					 * 跟页面主题（.mdui-theme-dark）无关 —— 系统浅色 + 页面深色时，
					 * 图标会是一团黑的、看不见。mask 则由 currentColor 决定，
					 * 而 currentColor 继承自磁贴的文字色，两套主题都对。
					 */
					const mark = document.createElement('span');
					mark.className = 'guide-tile-mask';
					// 只写标准 mask：webkitMaskImage 已废弃，且站点本来
					// 就依赖较新的浏览器特性（:has、MDUI 的现代色彩），老 Safari 无关紧要
					mark.style.maskImage = `url("${icon}")`;
					box.appendChild(mark);
				} else if (icon) {
					const img = document.createElement('img');
					img.src = icon;
					img.alt = '';
					img.loading = 'lazy';
					img.decoding = 'async';
					// 图标已经统一成 128px 白底方图，加载基本是瞬时的
					img.addEventListener('error', () => {
						img.remove();
						box.textContent = siteFallback(tile.title, tile.url);
						box.style.background = siteFallbackColor(tile.url);
						box.classList.add('is-monogram');
					});
					box.appendChild(img);
				} else {
					box.textContent = siteFallback(tile.title, tile.url);
					box.style.background = siteFallbackColor(tile.url);
					box.classList.add('is-monogram');
				}

				const label = document.createElement('span');
				label.className = 'guide-tile-label';
				label.textContent = tile.title;

				/*
				 * 网络前提标记。
				 *
				 * **只提示、不拦截** —— 校外点「需校园网」的磁贴照样跳过去，
				 * 用户可能自己有 VPN、或者正开着移动热点。挡一下反而添堵。
				 * 另外 unknown（还没测出来）不提示：不能因为没数据就吓人。
				 */
				const warning = accessWarning(tileAccess(tile.url), snapshot, tile.url);
				/*
				 * 当前网络打不开时，点开前先问一句。
				 *
				 * 原本只是磁贴角标上一句「需校园网」，太容易被忽略；而真正需要
				 * 提醒的时刻就是「正要打开的时候」。
				 *
				 * ⚠️ 只在探测**已经出结果**时才拦 —— snapshot.at 为 0 表示还没测完，
				 * 这时候拦人纯属添堵（accessWarning 对 unknown 本来就返回 null）。
				 */
				if (warning) {
					item.addEventListener('click', (event) => {
						event.preventDefault();
						askToOpen(tile, item.href);
					});
				}
				if (warning) {
					const flag = document.createElement('span');
					flag.className = 'guide-tile-flag';
					flag.textContent = warning;
					item.appendChild(flag);
				}

				item.append(box, label);

				/*
				 * 右键 = 编辑这块磁贴。
				 *
				 * 浏览器自己的右键菜单在这里没有意义（「另存为」对起始页磁贴
				 * 没用途），所以拦掉换成编辑框。
				 * ⚠️ 拖拽中松开的右键也会触发 contextmenu，但那时的
				 * event.target 已是落点磁贴，不会误开被拖的那一块。
				 */
				item.addEventListener('contextmenu', (event) => {
					event.preventDefault();
					openTileEditor(tile);
				});

				grid.appendChild(item);
			}

			// 每个标签页末尾放一个「添加磁贴」方块：点开就是新建表单
			for (const [group, grid] of grids) {
				grid.appendChild(createAddTile(group));
			}
		}

		function createAddTile(group: string): HTMLElement {
			const btn = document.createElement('button');
			btn.type = 'button';
			btn.className = 'guide-tile guide-tile-add';
			btn.setAttribute('role', 'listitem');
			btn.title = '添加磁贴';
			btn.setAttribute('aria-label', '添加磁贴');
			const box = document.createElement('span');
			box.className = 'guide-tile-icon';
			const glyph = document.createElement('mdui-icon-add');
			glyph.setAttribute('aria-hidden', 'true');
			box.appendChild(glyph);
			const label = document.createElement('span');
			label.className = 'guide-tile-label';
			label.textContent = '添加';
			btn.append(box, label);
			btn.addEventListener('click', () => openNewTile(group));
			return btn;
		}

		// ─────────────────────────────────────────────── 搜索引擎

		/*
		 * 用户显式选的引擎。null = 没选过，走按网络自动挑。
		 * 单独存一个 key，而不是存「当前引擎」—— 因为「自动」和「Bing」
		 * 长得一样但意思完全不同：存了引擎就再也回不到自动模式。
		 */
		const ENGINE_KEY = 'jwwl:engine';

		let chosenEngineId: string | null = ((): string | null => {
			try {
				const raw = localStorage.getItem(ENGINE_KEY);
				return raw && SEARCH_ENGINES.some((e) => e.id === raw) ? raw : null;
			} catch {
				return null;
			}
		})();

		function currentEngine(): SearchEngine {
			return pickEngine(snapshot, chosenEngineId);
		}

		const engineButton = $('engineButton');
		const enginePop = $('enginePop');
		const engineMark = $('engineMark');
		const engineNote = $('engineNote');
		const engineMenu = $('engineMenu');

		/*
		 * ⚠️ 这里**不再**用 mdui-select：程序化写 .value 会异步派发 change
		 * （实测赋值后约 2ms 到达，比微任务晚），于是 renderEngine() 里的赋值
		 * 会反过来触发 change 监听，把自动挑出来的引擎当成「用户手动选的」
		 * 写进存储 —— 自动模式第一帧就固化了，之后再也不跟着网络变。
		 *
		 * 改用 mdui-menu：选中状态交给 menu-item 的 selected 自己管，
		 * 根本不存在「程序化赋值被当成用户操作」这个问题。
		 */
		function renderEngineMenu(): void {
			const active = currentEngine().id;
			const header = engineMenu.querySelector('mdui-list-subheader');
			engineMenu.textContent = '';
			if (header) engineMenu.appendChild(header);
			for (const engine of SEARCH_ENGINES) {
				const item = document.createElement('mdui-menu-item') as unknown as MenuItemEl;
				item.value = engine.id;
				item.selected = engine.id === active;

				const icon = document.createElement('span');
				icon.className = 'engine-item-icon';
				icon.slot = 'icon';
				const img = document.createElement('img');
				img.src = engine.icon;
				img.alt = '';
				icon.appendChild(img);

				item.append(icon, engine.name);
				engineMenu.appendChild(item);
			}
		}

		function renderEngine(): void {
			const engine = currentEngine();

			engineMark.textContent = '';
			const mark = document.createElement('img');
			mark.src = engine.icon;
			mark.alt = engine.name;
			engineMark.appendChild(mark);

			/*
			 * placeholder 跟着当前引擎走（Firefox 就是「使用Bing搜索，或者输入网址」），
			 * 用户不用点开浮层也知道现在搜的是哪家。
			 */
			($('guideInput') as unknown as TextField).placeholder = `使用${engine.name}搜索，或者输入网址`;

			const blocked = Boolean(engine.intl && !intlAvailable(snapshot) && snapshot.at);
			engineButton.setAttribute(
				'aria-label',
				blocked ? `搜索引擎：${engine.name}，当前网络可能打不开` : `搜索引擎：${engine.name}`,
			);
			engineButton.title = blocked ? `${engine.name} 需要国际互联网` : engine.name;

			// 提示文字：说清楚「为什么是这个引擎」
			if (chosenEngineId) {
				engineNote.textContent = blocked
					? `${engine.name} 需要国际互联网，当前网络可能打不开`
					: `已手动选择 ${engine.name}`;
			} else {
				engineNote.textContent = intlAvailable(snapshot)
					? '国际互联网可用，默认 Google'
					: snapshot.at
						? '国际互联网不畅，默认 Bing'
						: '默认 Bing（检测后可能改用 Google）';
			}
			// 自动模式下没必要给「恢复自动」这个按钮
			$('engineReset').toggleAttribute('hidden', !chosenEngineId);
			renderEngineMenu();
		}

		function setEnginePop(open: boolean): void {
			enginePop.toggleAttribute('hidden', !open);
			engineButton.setAttribute('aria-expanded', String(open));
		}

		engineButton.addEventListener('click', () => {
			setEnginePop(enginePop.hasAttribute('hidden'));
		});

		/*
		 * ⚠️ mdui-menu 的 change 是从 **menu 自己**发出来的
		 * （源码里是 `this.emit('change')`，见 menu.js 的 onSelectedKeysChange），
		 * 事件目标是 menu 而不是被点的 menu-item。所以引擎要从
		 * **menu 自身的 value** 上读，读 event.target.value 永远是 undefined。
		 *
		 * 另外 menu 在初始同步 value 时不会 emit（源码里的 isInitial 判断），
		 * 所以「程序化渲染列表」不会误触发这里。
		 */
		type MenuEl = HTMLElement & { value: string };

		engineMenu.addEventListener('change', () => {
			const picked = (engineMenu as MenuEl).value;
			if (!picked || !SEARCH_ENGINES.some((e) => e.id === picked)) return;
			chosenEngineId = picked;
			try {
				localStorage.setItem(ENGINE_KEY, picked);
			} catch {
				// 存不住只是下次要重选，不影响这次能用
			}
			setEnginePop(false);
			renderEngine();
			// 焦点还给按钮，否则连按 Tab 会跳到磁贴、跳不回搜索框
			engineButton.focus();
		});

		$('engineReset').addEventListener('click', () => {
			chosenEngineId = null;
			try {
				localStorage.removeItem(ENGINE_KEY);
			} catch {
				// 同上
			}
			renderEngine();
		});

		// 点浮层外面就关掉；Esc 也关。少了这一步浮层会一直挂在屏幕上。
		document.addEventListener('click', (event) => {
			if (enginePop.hasAttribute('hidden')) return;
			const target = event.target as Node | null;
			if (target && !enginePop.contains(target) && !engineButton.contains(target)) {
				setEnginePop(false);
			}
		});

		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || enginePop.hasAttribute('hidden')) return;
			setEnginePop(false);
			engineButton.focus();
		});

		// ─────────────────────────────────────────────── 设置

		/*
		 * 外观偏好全部存 localStorage，键名带 jwwl: 前缀，与主站分开 ——
		 * 将来这个页面拆成独立仓库、单独部署时互不干扰。
		 */
		const PREF = {
			color: 'jwwl:color',
			mode: 'jwwl:mode',
			wall: 'jwwl:wall',
			scrub: 'jwwl:scrub',
			customWall: 'jwwl:wall-custom',
		} as const;

		const readPref = (key: string): string | null => {
			try {
				return localStorage.getItem(key);
			} catch {
				return null;
			}
		};
		const writePref = (key: string, value: string | null): void => {
			try {
				if (value === null) localStorage.removeItem(key);
				else localStorage.setItem(key, value);
			} catch {
				// 隐私模式：设置这次生效，刷新后不保留
			}
		};

		let themeMode: ThemeMode = 'auto';
		if ((['auto', 'light', 'dark'] as const).includes(readPref(PREF.mode) as ThemeMode)) {
			themeMode = readPref(PREF.mode) as ThemeMode;
		}
		let themeColor = THEME_COLORS[0].value;
		if (THEME_COLORS.some((c) => c.value === readPref(PREF.color))) themeColor = readPref(PREF.color)!;
		/*
		 * 默认设为 'random'：白天按当前季节、晚上按「夜」抽一张照片。
		 * 之前默认 'none'（纯色）—— 起始页一片灰，用户看到的就是「什么都没有」。
		 */
		let wallpaper: string =
			readPref(PREF.wall) === 'random' || WALLPAPERS.some((w) => w.value === readPref(PREF.wall))
				? (readPref(PREF.wall) ?? 'random')
				: 'random';
		/*
		 * 遮罩：存过就用存的值，没存过按**当前壁纸**给起点值 ——
		 * 照片比渐变更吃遮罩（樱花大道那张白得发亮，0.72 白遮罩盖上去
		 * 搜索框和标签还是费劲），所以照片走更厚的那档。
		 */
		let scrubLight = readPref(PREF.scrub)
			? sanitizeScrub(readPref(PREF.scrub))
			: defaultScrubFor(wallpaper);

		/** 自定义壁纸是 data URL，只存在本机，不外传 */
		const customWall = (): string | null => {
			const value = readPref(PREF.customWall);
			return value && value.startsWith('data:image/') ? value : null;
		};

		/**
		 * 真正要画上去的背景。
		 *
		 * `random` 在**这一层**就解析成一张具体的图：抽哪张由 pickWallByTime 按
		 * 当前季节/时段决定，抽完写回 wallpaper，之后所有读取都看到具体那张。
		 * 不每次渲染现抽 —— 否则一改遮罩、一切主题，背景就跟着换一张，
		 * 用户根本不知道发生了什么。
		 */
		function effectiveWall(): string {
			if (wallpaper === 'random') {
				wallpaper = pickWallByTime(new Date());
				// 不写 localStorage：记的是「随机」这个意图，不是某一张具体的图，
				// 否则下次打开永远停在第一次抽到的那张
				writePref(PREF.wall, null);
			}
			if (wallpaper === 'custom' && customWall()) return `url("${customWall()}")`;
			return WALLPAPERS.find((w) => w.value === wallpaper)?.css ?? '';
		}

		/*
		 * 遮罩浓度只跟**壁纸**有关，跟主题无关 —— 遮罩色是固定近黑，
		 * 深浅两套主题都要它把背景压暗（见 CSS 里 body::after 的注释）。
		 * 之前这里还按主题降一档（深色 0.55 封顶），那是因为浅色遮罩
		 * 用的是浅灰白、深色用近黑；现在两套同色，再按主题分档只会
		 * 出现「同一张照片两个主题两个亮度」的怪事。
		 */
		function effectiveScrub(): number {
			return scrubLight;
		}

		/**
		 * 把背景与遮罩真正应用到页面上。
		 *
		 * 用 CSS 变量而不是每次去改 background-image，好处是切换主题模式时
		 * 只需要更新一个变量，壁纸不必重算。
		 */
		function applyWallpaper(): void {
			const root = document.documentElement;
			root.style.setProperty('--guide-wall', effectiveWall() || 'none');
			root.style.setProperty('--guide-scrub', String(effectiveScrub()));
			$('setScrubValue').textContent = `${Math.round(effectiveScrub() * 100)}%`;
		}

		function applyTheme(): void {
			const root = document.documentElement;
			root.classList.remove('mdui-theme-auto', 'mdui-theme-light', 'mdui-theme-dark');
			root.classList.add(`mdui-theme-${themeMode}`);
			// 种子色交给 mdui 生成整套 MD3 色调板，别手写每组色值
			// mdui 由 /vendor/mdui/mdui.global.js 挂到 window 上，没有类型声明
			const api = (window as unknown as { mdui?: { setColorScheme?: (c: string) => void } }).mdui;
			api?.setColorScheme?.(themeColor);
		}

		// 主题色色板
		const swatches = $('setSwatches');
		for (const color of THEME_COLORS) {
			const btn = document.createElement('button');
			btn.type = 'button';
			btn.className = 'set-swatch';
			btn.style.background = color.value;
			btn.dataset.value = color.value;
			btn.title = color.label;
			btn.setAttribute('aria-label', `主题色 ${color.label}`);
			btn.addEventListener('click', () => {
				themeColor = color.value;
				writePref(PREF.color, color.value);
				applyTheme();
				syncSettings();
			});
			swatches.appendChild(btn);
		}

		/*
		 * 外观模式：选中态**完全交给 group 自己管**，我们只监听它的 change。
		 *
		 * 之前是给每个按钮挂 click，并在里面 syncSettings() 回写 group.value。
		 * 那样会跟 mdui 处理这次点击的时机打架：真实鼠标点击时，mdui 正在
		 * 更新选中，我们在同一拍把 value 又写回去，结果两边互相覆盖，选中的
		 * 那一项反而被清空（合成 .click() 不触发指针逻辑，所以一直没发现）。
		 * 正确做法：不碰按钮事件，只听 group 的 change，value 从 group 读。
		 */
		const modes = $('setModes') as unknown as SelectEl;
		for (const mode of THEME_MODES) {
			const btn = document.createElement('mdui-segmented-button');
			btn.value = mode.value;
			btn.textContent = mode.label;
			modes.appendChild(btn);
		}
		modes.addEventListener('change', () => {
			const value = modes.value;
			if (!THEME_MODES.some((m) => m.value === value)) return;
			themeMode = value as ThemeMode;
			writePref(PREF.mode, value);
			applyTheme();
			applyWallpaper();
		});

		/*
		 * 壁纸缩略图，**按 group 分段**渲染。
		 *
		 * 照片那十几个按季节分成五段，每段前面加一行小标题；
		 * 渐变和「纯色 / 随机」各占一段。全挤成一排的话，15 个方块摆在一起
		 * 分不出谁是谁，只有 hover 出 title 才知道。
		 */
		const walls = $('setWalls');
		const wallGroups = [...new Set(WALLPAPERS.map((w) => w.group))];
		for (const group of wallGroups) {
			const title = document.createElement('p');
			title.className = 'set-wall-group';
			title.textContent = group;
			walls.appendChild(title);
			for (const wall of WALLPAPERS.filter((w) => w.group === group)) {
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'set-wall';
				btn.dataset.value = wall.value;
				btn.dataset.group = wall.group;
				btn.title = wall.label;
				btn.setAttribute('aria-label', `壁纸 ${wall.label}`);
				// 渐变直接当背景，照片用 background-image 也一样（值是 url(...)）
				if (wall.css) btn.style.backgroundImage = wall.css;
				btn.addEventListener('click', () => {
					wallpaper = wall.value;
					/*
					 * 手动点「随机」时**当场抽一张**，而不是等下次刷新。
					 * 存 null：记下「要随机」这个意图，具体哪张下次打开重新抽。
					 */
					if (wall.value === 'random') {
						wallpaper = pickWallByTime(new Date());
						writePref(PREF.wall, null);
					} else {
						writePref(PREF.wall, wall.value);
					}
					applyWallpaper();
					syncSettings();
					if (wall.value === 'random') showHint('已按当前季节/时段换了一张。');
				});
				walls.appendChild(btn);
			}
		}

		/** 「再抽一张」：只在用随机模式时才有意义 */
		$('setWallShuffle').addEventListener('click', () => {
			const previous = wallpaper;
			wallpaper = pickWallByTime(new Date());
			writePref(PREF.wall, null);
			applyWallpaper();
			syncSettings();
			if (wallpaper === previous) showHint('这次抽到的还是同一张，再点一次试试。');
			else showHint('换了一张。');
		});

		// 自定义壁纸
		$('setWallUpload').addEventListener('click', () => {
			($('setWallFile') as unknown as HTMLInputElement).click();
		});
		($('setWallFile') as unknown as HTMLInputElement).addEventListener('change', async (event) => {
			const input = event.target as HTMLInputElement;
			const file = input.files?.[0];
			input.value = '';
			if (!file) return;
			if (file.size > MAX_CUSTOM_WALLPAPER_BYTES) {
				showHint(`这张图 ${(file.size / 1024 / 1024).toFixed(1)}MB 太大了，限 2MB。`);
				return;
			}
			const dataUrl = await new Promise<string>((resolve, reject) => {
				const reader = new FileReader();
				reader.onload = () => resolve(String(reader.result));
				reader.onerror = () => reject(reader.error);
				reader.readAsDataURL(file);
			});
			writePref(PREF.customWall, dataUrl);
			wallpaper = 'custom';
			writePref(PREF.wall, 'custom');
			applyWallpaper();
			syncSettings();
		});

		// 遮罩浓度：change 是失焦才触发，拖动过程要用 input 才跟手
		const scrubSlider = $('setScrub') as unknown as { value: number; addEventListener: Function };
		const onScrub = (save: boolean) => {
			scrubLight = sanitizeScrub(scrubSlider.value);
			writePref(PREF.scrub, save ? String(scrubLight) : null);
			applyWallpaper();
		};
		scrubSlider.addEventListener('input', () => onScrub(false));
		scrubSlider.addEventListener('change', () => onScrub(true));

		/** 设置面板的当前值要反映到控件上（打开面板、切主题后都会调） */
		function syncSettings(): void {
			for (const btn of swatches.querySelectorAll<HTMLElement>('.set-swatch')) {
				const on = btn.dataset.value === themeColor;
				btn.classList.toggle('is-on', on);
				btn.setAttribute('aria-pressed', String(on));
			}
			/*
			 * 外观模式：设 group 的 value，别去逐个按钮设 checked。
			 *
			 * mdui-segmented-button 的高亮看的是 **selected** 属性
			 * （内建样式 :host([selected]) 给 secondary-container 底色，
			 * 还会在按钮里显示一个 ✓），而我们最早在这儿给按钮设
			 * checked —— 那是个 HTML 原生属性，mdui 根本不看，
			 * 于是「选中哪一项」在界面上毫无提示。
			 *
			 * group 自己监听 value 变化（onValueChange）并回填 selectedKeys、
			 * 再给对应按钮打上 selected，这条路才真的会亮。点击同理：
			 * 组内部同步，不需要我们再插手。
			 */
			modes.value = themeMode;
			for (const btn of walls.querySelectorAll<HTMLElement>('.set-wall')) {
				/*
				 * 随机模式下当前那张也高亮 —— 否则面板看起来「什么都没选」，
				 * 而背景明明有图。这不代表用户选了它，只是告诉人现在用的是哪张。
				 */
				const on = btn.dataset.value === wallpaper;
				btn.classList.toggle('is-on', on);
				btn.setAttribute('aria-pressed', String(on));
			}
			// 「随机」那一格在「当前正是随机抽出来的」时也亮
			const randomBtn = walls.querySelector<HTMLElement>('.set-wall[data-value="random"]');
			const isRandom = readPref(PREF.wall) === null || readPref(PREF.wall) === 'random';
			randomBtn?.classList.toggle('is-on', isRandom);
			scrubSlider.value = effectiveScrub();
			const custom = customWall();
			$('setWallNote').textContent = custom
				? `已使用自定义壁纸（${(custom.length / 1024).toFixed(0)}KB，存于本机）。`
				: '照片建议选暗一点的，否则文字会看不清；也可以调高遮罩。';
			($('setAssume') as unknown as { checked: boolean }).checked = assumeCampus;
			$('setNetState').textContent = snapshot.at
				? `上次检测：${new Date(snapshot.at).toLocaleString('zh-CN')}　${netVerdict().text}`
				: '还没有检测记录。';
		}

		const setDialog = $('setDialog') as DialogEl;
		/*
		 * 弹窗**互斥**：开一个就把另一个关上。
		 * mdui-dialog 之间没有这层约定，同时开两个会叠在一起 ——
		 * 后开的盖住前一个，而前一个的遮罩还在，看起来像卡死了。
		 * close-on-overlay-click 又让点任何一处遮罩都可能命中下面那个，
		 * 行为完全没法预测。所以在每一处 open = true 前先清掉别的。
		 */
		const closeOtherDialogs = (keep: string): void => {
			for (const id of ['setDialog', 'tileDialog', 'ioDialog', 'warnDialog']) {
				if (id === keep) continue;
				const el = document.getElementById(id);
				if (el && (el as unknown as { open: boolean }).open) {
					(el as unknown as { open: boolean }).open = false;
				}
			}
		};
		const openSettings = (): void => {
			closeOtherDialogs('setDialog');
			syncSettings();
			setDialog.open = true;
		};
		/*
		 * 编辑与设置的唯一入口。原来这个 FAB 是「编辑磁贴」的开关，
		 * 设置齿轮在搜索行右侧；现在两者合成一个面板，入口只有这一处。
		 */
		$('guideFab').addEventListener('click', openSettings);
		$('setDone').addEventListener('click', () => {
			setDialog.open = false;
		});
		$('setNetCheck').addEventListener('click', async () => {
			$('setNetState').textContent = '检测中…';
			await runNetCheck();
			syncSettings();
		});

		/*
		 * 「默认在校园网环境下」。
		 *
		 * 用 change 而不是 click：mdui-switch 的状态由键盘（空格）也能切，
		 * click 事件照样会派发，但 change 语义更准，少一层「点的是 label 文字
		 * 也算点开关」的歧义。开关本身是 controlled 组件，状态由 assumeCampus 说话。
		 */
		$('setAssume').addEventListener('change', async (event: Event) => {
			const on = (event.currentTarget as unknown as { checked: boolean }).checked;
			applyCampusAssumption(on);
			if (on) {
				showHint('已按校园网环境处理，校内站点不再提示。');
			} else {
				/*
				 * 关掉就得重新探：快照里的 campus 可能还是开关开着时留下的
				 * 陈旧结论（或者 checking），直接拿它给人看是误导。
				 * 顺手把界面切到「检测中」，跟手动重测一个体验。
				 */
				$('setNetState').textContent = '检测中…';
				await runNetCheck();
				syncSettings();
				showHint('恢复按实际探测结果处理。');
			}
		});
		// 设置里的导入/导出与编辑态共用同一套逻辑
		$('setReset').addEventListener('click', () => {
			for (const key of [PREF.color, PREF.mode, PREF.wall, PREF.scrub, PREF.customWall]) {
				writePref(key, null);
			}
			writeAssumeCampus(false);
			themeMode = 'auto';
			themeColor = THEME_COLORS[0].value;
			wallpaper = 'none';
			scrubLight = sanitizeScrub(null);
			assumeCampus = false;
			snapshot = applyAssumeCampus(snapshot, false);
			tiles = [...defaultTiles];
			tabs = defaultTabList();
			activeTab = tabs[0]?.key ?? '';
			chosenEngineId = null;
			try {
				localStorage.removeItem(STORE_KEY);
				localStorage.removeItem(ENGINE_KEY);
				localStorage.removeItem(TAB_KEY);
			} catch {
				// 存不住就算了
			}
			applyTheme();
			applyWallpaper();
			renderEngine();
			renderTabs();
			syncSettings();
			showHint('已恢复默认磁贴、标签页与外观。');
		});

		/** 当前外观设置的快照，导出时整份带走 */
		function currentAppearance(): AppearanceConfig {
			const custom = customWall();
			return {
				color: themeColor,
				mode: themeMode,
				wallpaper,
				scrub: scrubLight,
				assumeCampus,
				...(wallpaper === 'custom' && custom ? { customWall: custom } : {}),
			};
		}

		/** 按导入的外观设置整套应用下来 */
		function applyAppearance(a: AppearanceConfig): void {
			themeColor = THEME_COLORS.some((c) => c.value === a.color) ? a.color : THEME_COLORS[0].value;
			writePref(PREF.color, themeColor === THEME_COLORS[0].value ? null : themeColor);
			themeMode = THEME_MODES.some((m) => m.value === a.mode) ? a.mode : 'auto';
			writePref(PREF.mode, themeMode === 'auto' ? null : themeMode);
			/*
			 * 壁纸要跟 WALLPAPERS 对一遍：内置的几个 id 直接认，
			 * 'custom' 还得同时有 data 才算数（否则留着一个加载不出图的壁纸位）。
			 * ⚠️ 不能写成 `=== 'custom' && customWall ? 'custom' : 'none'` ——
			 * 那会把内置的 dawn / night 一起扫成纯色（实测就是这么错的，
			 * 导入后壁纸全丢）。
			 */
			wallpaper = WALLPAPERS.some((w) => w.value === a.wallpaper)
				? a.wallpaper
				: a.wallpaper === 'custom' && a.customWall
					? 'custom'
					: 'none';
			writePref(PREF.wall, wallpaper === 'none' ? null : wallpaper);
			if (wallpaper === 'custom' && a.customWall) writePref(PREF.customWall, a.customWall);
			else writePref(PREF.customWall, null);
			scrubLight = sanitizeScrub(a.scrub);
			writePref(PREF.scrub, String(scrubLight));
			assumeCampus = a.assumeCampus === true;
			writeAssumeCampus(assumeCampus);
			snapshot = applyAssumeCampus(snapshot, assumeCampus);
			applyTheme();
			applyWallpaper();
		}

		// 首次进入就把偏好应用到页面（主题脚本在 <head> 里已跑过，这里补齐壁纸）
		applyTheme();
		applyWallpaper();

		// ─────────────────────────────────────── 打不开时的确认弹窗

		const warnDialog = $('warnDialog') as DialogEl;
		/** 待确认打开的网址 */
		let pendingUrl: string | null = null;

		function askToOpen(tile: Tile, href: string): void {
			pendingUrl = href;
			$('warnText').textContent =
				accessNotice(tileAccess(tile.url), tile.title, snapshot) ??
				`「${tile.title}」现在可能打不开。要试试吗？`;
			closeOtherDialogs('warnDialog');
			warnDialog.open = true;
		}

		$('warnCancel').addEventListener('click', () => {
			pendingUrl = null;
			warnDialog.open = false;
		});

		$('warnGo').addEventListener('click', () => {
			const url = pendingUrl;
			pendingUrl = null;
			warnDialog.open = false;
			if (url) window.open(url, '_blank', 'noopener,noreferrer');
		});

		// ─────────────────────────────────────────────── 导入 / 导出

		const ioDialog = $('ioDialog') as DialogEl;
		/** 待确认的导入结果；确认前绝不碰现有数据 */
		let pendingImport: Extract<ReturnType<typeof parseConfig>, { tiles: TileConfig[] }> | null = null;

		function exportConfig(): void {
			const json = serializeConfig(tiles, chosenEngineId, currentAppearance(), new Date(), tabs);
			// Blob + 临时 <a download>，全程本地，不上传任何东西
			const url = URL.createObjectURL(new Blob([json], { type: 'application/json' }));
			const link = document.createElement('a');
			link.href = url;
			link.download = configFilename(new Date());
			link.click();
			// 立刻 revoke 会让部分浏览器来不及开始下载
			setTimeout(() => URL.revokeObjectURL(url), 10_000);
			showHint(`已导出 ${tiles.length} 条磁贴与全部外观设置（不含图标文件，按网址匹配本地图标）。`);
		}

		function pickConfigFile(): void {
			($('ioFile') as unknown as HTMLInputElement).click();
		}

		/*
		 * 入口在「编辑与设置」面板里（setExport / setImport）。
		 * 原来起始页上还有一组悬浮的导入导出按钮，随编辑态显隐 ——
		 * 编辑态整个取消后那组按钮也一起没了，入口只留面板这一处。
		 */
		$('setExport').addEventListener('click', exportConfig);
		$('setImport').addEventListener('click', pickConfigFile);

		const ioFile = $('ioFile') as unknown as HTMLInputElement;
		ioFile.addEventListener('change', async () => {
			const file = ioFile.files?.[0];
			// 重置 value，否则连续导入同一个文件不会再触发 change
			ioFile.value = '';
			if (!file) return;
			if (file.size > 1024 * 1024) {
				showHint('这个文件超过 1MB，不像是我导出的配置。');
				return;
			}
			let text: string;
			try {
				text = await file.text();
			} catch {
				showHint('读不出这个文件。');
				return;
			}
			const result = parseConfig(text);
			if ('error' in result) {
				showHint(`导入失败：${result.error}`);
				return;
			}
			pendingImport = result;
			const when = result.exportedAt
				? new Date(result.exportedAt).toLocaleString('zh-CN')
				: '未知时间';
			$('ioSummary').textContent =
				`将用「${when}」导出的 ${result.tiles.length} 条磁贴，` +
				`**整份替换**掉当前的 ${tiles.length} 条（含顺序）。` +
				(result.tabs ? `标签页也会替换为文件里的 ${result.tabs.length} 个。` : '') +
				(result.appearance
					? '主题色、外观模式、壁纸、遮罩和校园网设置也会一起替换。'
					: '这份文件不含外观设置，外观保持现状。') +
				'此操作不可撤销。';
			const notes = [...result.dropped];
			/*
			 * 自定义壁纸超过体积上限时导出端就把它丢了，这里得说一声 ——
			 * 否则用户只会看到「壁纸变回纯色了」而不知道为什么。
			 */
			if (result.appearance?.wallpaper === 'custom' && !result.appearance.customWall) {
				notes.push('自定义壁纸没有随文件带过来（可能太大），已退回纯色背景。');
			}
			$('ioDetail').textContent = notes.length
				? `有 ${notes.length} 处被丢弃或调整：\n${notes.slice(0, 8).join('\n')}` +
					(notes.length > 8 ? `\n…… 另有 ${notes.length - 8} 处` : '')
				: '没有条目被丢弃。';
			closeOtherDialogs('ioDialog');
			ioDialog.open = true;
		});

		$('ioCancel').addEventListener('click', () => {
			pendingImport = null;
			ioDialog.open = false;
		});

		$('ioConfirm').addEventListener('click', () => {
			if (!pendingImport) return;
			if (pendingImport.tabs) {
				tabs = pendingImport.tabs.map((tab) => ({ ...tab }));
				activeTab = tabs[0]?.key ?? '';
			}
			tiles = pendingImport.tiles.map((tile) => ({ ...tile }) as Tile);
			chosenEngineId = pendingImport.engine;
			try {
				localStorage.setItem(STORE_KEY, JSON.stringify(tiles));
				if (pendingImport.tabs) localStorage.setItem(TAB_KEY, JSON.stringify(tabs));
				if (chosenEngineId) localStorage.setItem(ENGINE_KEY, chosenEngineId);
				else localStorage.removeItem(ENGINE_KEY);
			} catch {
				// 存不住也先把界面更新，刷新后会回到旧数据
			}
			// 外观：v1 文件里没有这块，此时保持现状不动
			if (pendingImport.appearance) applyAppearance(pendingImport.appearance);
			pendingImport = null;
			ioDialog.open = false;
			renderEngine();
			renderTabs();
			syncSettings();
			showHint('已导入。');
		});

		// ─────────────────────────────────────────────── 搜索 / 输网址

		function go(target: string): void {
			// 判定逻辑放在 data/guide.ts（纯函数，Node 里可测，见 scripts/guide-test.mjs）
			const next = resolveTarget(target, currentEngine());
			if (next) window.location.href = next;
		}

		$('guideForm').addEventListener('submit', (event) => {
			event.preventDefault();
			go(($('guideInput') as unknown as TextField).value);
		});

		// ─────────────────────────────────────────────── 网络检测

		const NET_KEY = 'jwwl:net';

		/** 当前网络快照。render() 要读它给磁贴打「需校园网 / 境外」标记 */
		let snapshot: NetSnapshot = applyAssumeCampus(
			parseSnapshot(
				((): string | null => {
					try {
						return localStorage.getItem(NET_KEY);
					} catch {
						return null;
					}
				})(),
			),
			readAssumeCampus(),
		);

		/**
		 * 「默认在校园网环境下」。
		 *
		 * 打开时 campus 一律当 ok：校内系统不再被提示，也不再探校内域名。
		 * GitHub / Google 照旧探 —— 那层跟在不在校园网无关。
		 */
		let assumeCampus = readAssumeCampus();

		function saveSnapshot(): void {
			try {
				localStorage.setItem(NET_KEY, JSON.stringify(snapshot));
			} catch {
				// 隐私模式：只是检测结果记不住，不影响使用
			}
		}

		/**
		 * 探一个地址。
		 *
		 * - `cors`：对方带 Access-Control-Allow-Origin，能明确区分「有响应」与
		 *   「网络不通」。返回 404 / 500 也算通 —— 说明服务器确实应答了。
		 * - `no-cors`：拿到不透明响应，但 resolve 同样代表「连上了」，reject 代表
		 *   根本没连到（DNS 解析失败 / 连不上 / TLS 失败）。
		 *
		 * 两种模式都要自己掐超时：校外访问校内地址解析失败会很快返回，
		 * 但若解析出一个不可路由的地址，TCP 握手会一直挂着。
		 */
		async function probe(url: string, mode: 'cors' | 'no-cors', timeoutMs: number): Promise<boolean> {
			const controller = new AbortController();
			const timer = setTimeout(() => controller.abort(), timeoutMs);
			try {
				await fetch(url, {
					method: 'GET',
					mode,
					cache: 'no-store',
					redirect: 'follow',
					referrerPolicy: 'no-referrer',
					signal: controller.signal,
				});
				return true;
			} catch {
				return false;
			} finally {
				clearTimeout(timer);
			}
		}

		/** 按顺序试候选地址，任一通即可（个别站点宕机不至于误报） */
		async function probeTarget(target: (typeof netTargets)[number]): Promise<boolean> {
			for (const candidate of target.probes) {
				if (await probe(candidate.url, candidate.mode, target.timeoutMs)) return true;
			}
			return false;
		}

		/**
		 * 探测结果目前**只存在内存/缓存里，不常驻显示**。
		 *
		 * 它唯一的用途是：点击某个「当前网络打不开」的磁贴时，决定要不要先问一句。
		 * 需要手动重测的话，设置面板里有按钮。
		 */
		function netVerdict(): { text: string; tone: 'ok' | 'warn' | 'muted' } {
			return describeOverall(snapshot);
		}

		/** 把开关状态叠到探测结果上，存盘并重画 */
		function applyCampusAssumption(on: boolean): void {
			assumeCampus = on;
			writeAssumeCampus(on);
			snapshot = applyAssumeCampus(snapshot, on);
			syncSettings();
			render();
		}

		async function runNetCheck(): Promise<void> {
			/*
			 * 声明了默认在校园网就**跳过** campus 那一项。
			 *
			 * 探了也没用：判据是「校内域名解析不出就连不上」，而换过公共 DNS 的
			 * 机器在校内校外都解析不出，结论恒为 fail。既然用户已经自己声明了，
			 * 再发那三个请求只是浪费和误导。
			 */
			const targets = assumeCampus
				? netTargets.filter((target) => target.id !== 'campus')
				: netTargets;
			for (const target of netTargets) snapshot[target.id] = 'checking';
			const settled = await Promise.all(
				targets.map(async (target) => {
					const ok = await probeTarget(target);
					return [target.id, ok ? ('ok' as const) : ('fail' as const)] as const;
				}),
			);
			for (const [id, state] of settled) snapshot[id] = state;
			snapshot.at = Date.now();
			/*
			 * 声明了校内时，campus 那一项这次根本没探，快照里留着的是**上一次**
			 * 的结果（甚至还是 checking）。必须就地叠上假设再存，否则
			 * localStorage 里会永远存着一个假的 checking —— 用户回头把开关关掉，
			 * 会立刻看到一个陈旧的结论，而不是重新探一次。
			 */
			snapshot = applyAssumeCampus(snapshot, assumeCampus);
			saveSnapshot();
			// 引擎默认值取决于国际互联网通不通，得跟着更新
			renderEngine();
			/*
			 * 重画磁贴：「需校园网 / 境外」标记取决于刚测出来的结果。
			 * 不重画的话要等到下次刷新页面才看到。
			 */
			render();
		}


		// 只在缓存过期时自动测一次，避免每次打开都打三个外部请求
		renderEngine();
		if (isStale(snapshot, Date.now())) void runNetCheck();


		// ─────────────────────────────────────── 磁贴编辑（右键）

		const tileDialog = $('tileDialog') as DialogEl;
		const tileDelete = $('tileDelete') as ButtonEl;
		/** 正在编辑的磁贴 id；null 表示没开编辑框 */
		let editingId: string | null = null;

		function openTileEditor(tile: Tile): void {
			editingId = tile.id;
			($('tileTitle') as unknown as TextField).value = tile.title;
			($('tileUrl') as unknown as TextField).value = tile.url;
			($('tileGroup') as unknown as SelectEl).value = tile.group;

			const mode = tile.iconMode ?? 'site';
			($('tileIconMode') as unknown as SelectEl).value = mode;

			($('tileIconUrl') as unknown as TextField).value = mode === 'url' ? tile.icon : '';
			($('tileIconText') as unknown as TextField).value = mode === 'text' ? tile.icon : '';

			const materialSelect = $('tileIconMaterial') as unknown as SelectEl;
			if (mode === 'material') {
				// 选项在初始化时构建；选中值必须匹配已有 option
				materialSelect.value = /^[a-z0-9-]{1,40}$/.test(tile.icon) ? tile.icon : '';
			}

			tileIconModeChanged(mode);
			// 输入框的值在 dialog 首次升级后才稳定，延迟再同步一次
			requestAnimationFrame(() => tileIconModeChanged(mode));
			tileDelete.style.display = '';
			closeOtherDialogs('tileDialog');
			tileDialog.open = true;
			hideTileError();
		}

		/** 新建磁贴：空表单，分类预设为当前标签页，隐藏「删除」 */
		function openNewTile(group: string): void {
			editingId = null;
			($('tileTitle') as unknown as TextField).value = '';
			($('tileUrl') as unknown as TextField).value = '';
			($('tileGroup') as unknown as SelectEl).value = group;
			($('tileIconMode') as unknown as SelectEl).value = 'site';
			($('tileIconUrl') as unknown as TextField).value = '';
			($('tileIconText') as unknown as TextField).value = '';
			tileIconModeChanged('site');
			requestAnimationFrame(() => tileIconModeChanged('site'));
			tileDelete.style.display = 'none';
			closeOtherDialogs('tileDialog');
			tileDialog.open = true;
			hideTileError();
		}

		function tileIconModeChanged(mode: string): void {
			const urlWrap = $('tileIconUrlWrap');
			const materialWrap = $('tileIconMaterialWrap');
			const textWrap = $('tileIconTextWrap');
			urlWrap.toggleAttribute('hidden', mode !== 'url');
			materialWrap.toggleAttribute('hidden', mode !== 'material');
			textWrap.toggleAttribute('hidden', mode !== 'text');
		}

		// 填充 Material Icons 下拉选项
		const materialSelect = $('tileIconMaterial') as unknown as SelectEl;
		const materialIcons: Array<[string, string]> = [
			['home', '首页'],
			['article', '文章'],
			['apps', '应用'],
			['rss-feed', '订阅'],
			['image', '图片'],
			['video-file', '视频'],
			['audio-file', '音频'],
			['picture-as-pdf', 'PDF'],
			['code', '代码'],
			['functions', '函数'],
			['calculate', '计算'],
			['translate', '翻译'],
			['calendar-month', '日历'],
			['color-lens', '颜色'],
			['light-mode', '浅色'],
			['dark-mode', '深色'],
			['swap-horiz', '交换'],
			['memory', '内存'],
			['monitor-weight', '体重'],
			['qr-code-scanner', '二维码'],
			['font-download', '字体'],
			['account-tree', '账户树'],
			['water-drop', '水滴'],
			['arrow-back', '返回'],
			['arrow-downward', '向下'],
			['arrow-upward', '向上'],
			['arrow-drop-down', '下拉'],
			['check-circle', '完成'],
			['close', '关闭'],
			['delete', '删除'],
			['download', '下载'],
			['upload', '上传'],
			['content-copy', '复制'],
			['info', '信息'],
			['lock', '锁定'],
			['play-arrow', '播放'],
			['rotate-right', '旋转'],
			['stop', '停止'],
			['warning', '警告'],
		];
		for (const [value, label] of materialIcons) {
			const item = document.createElement('mdui-menu-item');
			item.value = value;
			item.textContent = label;
			materialSelect.appendChild(item);
		}

		// 模式切换
		($('tileIconMode') as unknown as SelectEl).addEventListener('change', (e) => {
			tileIconModeChanged((e.target as unknown as SelectEl).value);
		});

		function hideTileError(): void {
			const el = $('tileError');
			el.toggleAttribute('hidden', true);
			el.textContent = '';
		}

		function showTileError(text: string): void {
			const el = $('tileError');
			el.textContent = text;
			el.toggleAttribute('hidden', false);
		}

		$('tileCancel').addEventListener('click', () => {
			editingId = null;
			tileDialog.open = false;
		});

		tileDelete.addEventListener('click', () => {
			if (!editingId) return;
			const gone = tiles.find((t) => t.id === editingId);
			tiles = tiles.filter((t) => t.id !== editingId);
			editingId = null;
			tileDialog.open = false;
			save(tiles);
			render();
			showHint(`已删除「${gone?.title ?? ''}」。`);
		});

		$('tileSave').addEventListener('click', () => {
			const id = editingId;
			const title = ($('tileTitle') as unknown as TextField).value.trim();
			const url = ($('tileUrl') as unknown as TextField).value.trim();
			const iconMode = ($('tileIconMode') as unknown as SelectEl).value;
			const group = ($('tileGroup') as unknown as SelectEl).value;

			let icon = '';
			if (iconMode === 'url') {
				icon = ($('tileIconUrl') as unknown as TextField).value.trim();
			} else if (iconMode === 'text') {
				icon = ($('tileIconText') as unknown as TextField).value.trim();
			} else if (iconMode === 'material') {
				icon = ($('tileIconMaterial') as unknown as SelectEl).value.trim();
			}

			/*
			 * 校验跟 parseConfig 同一套标准（见 isUsableUrl / MAX_TITLE）：
			 * 手填的网址会直接变成磁贴的 href，而 href 是用户可点的东西，
			 * `javascript:` 开头的地址足够在别人浏览器里跑脚本。
			 */
			if (!title) {
				showTileError('名称不能为空。');
				return;
			}
			if (title.length > 60) {
				showTileError('名称太长（最多 60 个字符）。');
				return;
			}
			if (!url) {
				showTileError('网址不能为空。');
				return;
			}
			if (!isUsableUrl(url)) {
				showTileError('网址不合法，只支持 http(s) 或站内路径（/ 开头）。');
				return;
			}
			if (iconMode === 'url' && icon && !/^https?:\/\//i.test(icon)) {
				showTileError('图片 URL 必须以 http(s):// 开头。');
				return;
			}
			if (iconMode === 'text' && icon.length > 8) {
				showTileError('文字 / emoji 最多 8 个字符。');
				return;
			}
			if (iconMode === 'material' && !/^[a-z0-9-]{1,40}$/.test(icon)) {
				showTileError('请选择图标。');
				return;
			}
			if (!knownGroup(group)) {
				showTileError('分类不存在。');
				return;
			}

			const next: Tile = {
				id: id ?? `i-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 6)}`,
				title,
				url,
				iconMode: (iconMode === 'site' ? undefined : iconMode) as Tile['iconMode'],
				icon,
				group,
			};
			tiles = id
				? tiles.map((t) =>
						t.id === id
							? ({
									...t,
									...next,
									// 网址换了，原来按域名匹配到的图标就不再作数
									...(!icon && t.materialIcon ? { materialIcon: undefined } : {}),
								} as Tile)
							: t,
					)
				: [...tiles, next];
			editingId = null;
			tileDialog.open = false;
			save(tiles);
			render();
		});

		// ─────────────────────────────────────────────── 拖动排序（磁贴）

		let dragId: string | null = null;

		/*
		 * 排序只在**同一个标签页内**进行。
		 * tiles 是一个扁平数组，磁贴按标签页分散在各个面板里，
		 * 所以先取出这个标签页在数组里的槽位下标，在槽位内部重排 ——
		 * 直接对整个数组 splice 会把别的标签页的磁贴也搅乱。
		 */
		function reorderWithin(group: string, overId: string): void {
			const slots = tiles.reduce<number[]>((acc, tile, i) => {
				if (tile.group === group) acc.push(i);
				return acc;
			}, []);
			const inGroup = slots.map((slot) => tiles[slot]);
			const from = inGroup.findIndex((t) => t.id === dragId);
			const to = inGroup.findIndex((t) => t.id === overId);
			if (from < 0 || to < 0) return;
			const reordered = [...inGroup];
			const [moved] = reordered.splice(from, 1);
			reordered.splice(to, 0, moved);
			const next = [...tiles];
			slots.forEach((slot, i) => {
				next[slot] = reordered[i];
			});
			tiles = next;
			save(tiles);
			render();
		}

		function wireGridDnD(grid: HTMLElement): void {
			grid.addEventListener('dragstart', (event) => {
				const tile = (event.target as HTMLElement | null)?.closest('.guide-tile') as HTMLElement | null;
				if (!tile) return;
				dragId = tile.dataset.id ?? null;
				tile.classList.add('is-dragging');
				event.dataTransfer?.setData('text/plain', dragId ?? '');
				if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
			});

			grid.addEventListener('dragover', (event) => {
				if (!dragId) return;
				event.preventDefault();
				const over = (event.target as HTMLElement | null)?.closest('.guide-tile') as HTMLElement | null;
				for (const el of grid.querySelectorAll('.is-dropzone')) el.classList.remove('is-dropzone');
				// 「添加」按钮没有 data-id，别把它当落点
				if (over && over.dataset.id && over.dataset.id !== dragId) {
					over.classList.add('is-dropzone');
				}
			});

			grid.addEventListener('drop', (event) => {
				if (!dragId) return;
				event.preventDefault();
				const over = (event.target as HTMLElement | null)?.closest('.guide-tile') as HTMLElement | null;
				const targetId = over?.dataset.id;
				if (!targetId || targetId === dragId) return;
				const group = grid.dataset.group;
				if (!group || !knownGroup(group)) return;
				reorderWithin(group, targetId);
			});

			grid.addEventListener('dragend', () => {
				dragId = null;
				for (const el of grid.querySelectorAll('.is-dropzone, .is-dragging')) {
					el.classList.remove('is-dropzone', 'is-dragging');
				}
			});
		}

		// ─────────────────────────────────── 标签页：渲染 / 新建 / 删除 / 排序

		const tabsHost = $('guideTabsHost');
		type TabsEl = HTMLElement & { value: string };

		/*
		 * 每次重排 / 增删都**整块换新** <mdui-tabs>，而不是改现有元素的子节点 ——
		 * mdui-tabs 在连接时读取子标签，事后增删它未必能感知；
		 * 换新元素最省心，也顺带让内部选中态与数据天然一致。
		 */
		function renderTabs(): void {
			if (!tabs.length) tabs = defaultTabList();
			const keys = new Set(tabs.map((tab) => tab.key));

			// 磁贴归位：group 指向已不存在的标签页时，落到兜底标签页
			let moved = false;
			tiles = tiles.map((tile) => {
				if (keys.has(tile.group)) return tile;
				moved = true;
				return { ...tile, group: fallbackGroup() };
			});
			if (moved) save(tiles);
			if (!keys.has(activeTab)) activeTab = tabs[0].key;

			const tabsEl = document.createElement('mdui-tabs') as TabsEl;
			tabsEl.className = 'guide-tabs';
			tabsEl.id = 'guideTabs';
			tabsEl.setAttribute('value', activeTab);

			for (const tab of tabs) {
				const el = document.createElement('mdui-tab');
				el.setAttribute('value', tab.key);
				el.textContent = tab.label;
				el.setAttribute('draggable', 'true');
				el.title = '拖动可排序，右键可重命名 / 删除';
				el.addEventListener('contextmenu', (event) => {
					event.preventDefault();
					openTabMenu(tab, event);
				});
				wireTabDrag(el);
				tabsEl.appendChild(el);
			}
			for (const tab of tabs) {
				const panel = document.createElement('mdui-tab-panel');
				panel.setAttribute('slot', 'panel');
				panel.setAttribute('value', tab.key);
				const grid = document.createElement('div');
				grid.className = 'guide-tiles';
				grid.dataset.group = tab.key;
				grid.setAttribute('role', 'list');
				panel.appendChild(grid);
				tabsEl.appendChild(panel);
			}

			tabsHost.textContent = '';
			tabsHost.appendChild(tabsEl);

			grids.clear();
			for (const grid of tabsEl.querySelectorAll<HTMLElement>('.guide-tiles[data-group]')) {
				const key = grid.dataset.group;
				if (key && keys.has(key)) {
					grids.set(key, grid);
					wireGridDnD(grid);
				}
			}
			tabsEl.addEventListener('change', () => {
				activeTab = tabsEl.value;
			});

			renderTileGroupOptions();
			render();
		}

		// 标签页拖动排序
		let dragTabKey: string | null = null;

		function wireTabDrag(el: HTMLElement): void {
			el.addEventListener('dragstart', (event) => {
				dragTabKey = el.getAttribute('value');
				el.classList.add('is-dragging');
				event.dataTransfer?.setData('text/plain', dragTabKey ?? '');
				if (event.dataTransfer) event.dataTransfer.effectAllowed = 'move';
			});
			el.addEventListener('dragover', (event) => {
				if (!dragTabKey) return;
				event.preventDefault();
			});
			el.addEventListener('drop', (event) => {
				event.preventDefault();
				const overKey = el.getAttribute('value');
				if (!dragTabKey || !overKey || overKey === dragTabKey) return;
				const from = tabs.findIndex((t) => t.key === dragTabKey);
				const to = tabs.findIndex((t) => t.key === overKey);
				if (from < 0 || to < 0) return;
				const next = [...tabs];
				const [movedTab] = next.splice(from, 1);
				next.splice(to, 0, movedTab);
				tabs = next;
				saveTabs();
				renderTabs();
			});
			el.addEventListener('dragend', () => {
				dragTabKey = null;
				el.classList.remove('is-dragging');
			});
		}

		// mdui 的 prompt / confirm 函数（全局构建自带），拿不到时退回原生弹窗
		type MduiApi = {
			prompt?: (options: Record<string, unknown>) => Promise<string>;
			confirm?: (options: Record<string, unknown>) => Promise<void>;
		};
		const mduiApi = (window as unknown as { mdui?: MduiApi }).mdui;

		async function askTabName(headline: string, initial: string): Promise<string | null> {
			if (!mduiApi?.prompt) {
				const value = window.prompt(headline, initial);
				return value ? value.trim().slice(0, MAX_TAB_LABEL) || null : null;
			}
			try {
				const value = await mduiApi.prompt({
					headline,
					confirmText: '确定',
					cancelText: '取消',
					textFieldOptions: { value: initial, label: '标签页名称', maxlength: MAX_TAB_LABEL },
					validator: (v: string) => (v.trim() ? true : '名称不能为空'),
				});
				return value.trim().slice(0, MAX_TAB_LABEL) || null;
			} catch {
				return null;
			}
		}

		async function askConfirm(headline: string, description: string): Promise<boolean> {
			if (!mduiApi?.confirm) return window.confirm(`${headline}\n${description}`);
			try {
				await mduiApi.confirm({ headline, description, confirmText: '删除', cancelText: '取消' });
				return true;
			} catch {
				return false;
			}
		}

		async function addTab(): Promise<void> {
			if (tabs.length >= MAX_TABS) {
				showHint(`最多 ${MAX_TABS} 个标签页。`);
				return;
			}
			const name = await askTabName('新建标签页', '');
			if (!name) return;
			const tab: GuideTab = { key: makeTabKey(tabs), label: name, tone: nextTabTone(tabs) };
			tabs = [...tabs, tab];
			activeTab = tab.key;
			saveTabs();
			renderTabs();
			showHint(`已新建标签页「${name}」。`);
		}

		async function renameTab(tab: GuideTab): Promise<void> {
			const name = await askTabName('重命名标签页', tab.label);
			if (!name || name === tab.label) return;
			tabs = tabs.map((t) => (t.key === tab.key ? { ...t, label: name } : t));
			saveTabs();
			renderTabs();
		}

		async function deleteTab(tab: GuideTab): Promise<void> {
			if (tabs.length <= 1) {
				showHint('至少要保留一个标签页。');
				return;
			}
			const count = tiles.filter((t) => t.group === tab.key).length;
			const ok = await askConfirm(
				`删除标签页「${tab.label}」？`,
				count ? `其中的 ${count} 个磁贴也会一起删除。` : '这个标签页是空的。',
			);
			if (!ok) return;
			tabs = tabs.filter((t) => t.key !== tab.key);
			tiles = tiles.filter((t) => t.group !== tab.key);
			if (activeTab === tab.key) activeTab = tabs[0].key;
			saveTabs();
			save(tiles);
			renderTabs();
			showHint(`已删除标签页「${tab.label}」。`);
		}

		$('tabAdd').addEventListener('click', () => {
			void addTab();
		});

		// 标签页右键菜单（重命名 / 删除）—— 自绘小浮层，避免再引入一套组件
		let tabMenu: HTMLElement | null = null;
		function closeTabMenu(): void {
			tabMenu?.remove();
			tabMenu = null;
		}
		function openTabMenu(tab: GuideTab, event: MouseEvent): void {
			closeTabMenu();
			const menu = document.createElement('div');
			menu.className = 'guide-tab-menu';
			const add = (label: string, danger: boolean, run: () => void): void => {
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.textContent = label;
				if (danger) btn.classList.add('is-danger');
				btn.addEventListener('click', () => {
					closeTabMenu();
					run();
				});
				menu.appendChild(btn);
			};
			add('重命名', false, () => void renameTab(tab));
			add('删除', true, () => void deleteTab(tab));
			menu.style.left = `${event.clientX}px`;
			menu.style.top = `${event.clientY}px`;
			document.body.appendChild(menu);
			tabMenu = menu;
		}
		document.addEventListener('click', closeTabMenu);
		window.addEventListener('blur', closeTabMenu);

		// 磁贴编辑弹窗里的「分类」下拉：选项跟着标签页走
		function renderTileGroupOptions(): void {
			const sel = $('tileGroup') as unknown as SelectEl;
			const current = sel.value;
			sel.textContent = '';
			for (const tab of tabs) {
				const item = document.createElement('mdui-menu-item');
				item.setAttribute('value', tab.key);
				item.textContent = tab.label;
				sel.appendChild(item);
			}
			if (tabs.some((tab) => tab.key === current)) sel.value = current;
			else sel.value = tabs[0]?.key ?? '';
		}

		renderTabs();
	</script>
</Base>
