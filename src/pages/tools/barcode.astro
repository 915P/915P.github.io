---
import Page from '../../layouts/Page.astro';
---

<Page title="条码 / 二维码" description="生成 QR 码与 20 种一维条码" active="tools">
	<div class="tool-head">
		<h1>条码 / 二维码</h1>
		<p>QR 码与 20 种一维条码，纯浏览器生成，不上传任何数据</p>
	</div>

	<div class="tool-split">
		<div class="panel-lg">
			<div class="canvas">
				<svg id="svg" role="img" aria-label="生成的条码" style="max-width: 100%"></svg>
			</div>
			<p id="hint" class="text-sm muted" style="margin-top: 0.85rem; text-align: center"></p>
			<div class="btn-row" style="margin-top: 0.85rem">
				<mdui-button variant="filled" id="dl">下载 SVG</mdui-button>
				<mdui-button variant="outlined" id="png">下载 PNG</mdui-button>
			</div>
		</div>

		<div class="stack">
			<div class="field">
				<label for="text">内容</label>
				<mdui-text-field
					id="text"
					variant="outlined"
					rows="2"
					class="mono"
					value="Hello, 915P!"
				></mdui-text-field>
			</div>

			<div class="field">
				<label for="format">格式</label>
				<mdui-select id="format" variant="outlined" value="QRCode">
					<mdui-menu-item>二维码
						<mdui-menu-item slot="submenu" value="QRCode">QR 码</mdui-menu-item>
					</mdui-menu-item>
					<mdui-menu-item>商品条码
						<mdui-menu-item slot="submenu" value="EAN13">EAN-13（13 位）</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="EAN8">EAN-8（8 位）</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="UPC">UPC（12 位）</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="UPCE">UPC-E（8 位）</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="EAN5">EAN-5</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="EAN2">EAN-2</mdui-menu-item>
					</mdui-menu-item>
					<mdui-menu-item>通用
						<mdui-menu-item slot="submenu" value="CODE128">CODE 128</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="CODE39">CODE 39</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="CODE93">CODE 93</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="CODE93FullASCII">CODE 93 Full ASCII</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="ITF">ITF</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="ITF14">ITF-14</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="MSI">MSI</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="MSI10">MSI-10</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="MSI11">MSI-11</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="MSI1010">MSI-1010</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="MSI1110">MSI-1110</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="codabar">Codabar</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="pharmacode">Pharmacode</mdui-menu-item>
						<mdui-menu-item slot="submenu" value="GenericBarcode">Generic（按内容自动选型）</mdui-menu-item>
					</mdui-menu-item>
					<mdui-icon-arrow-drop-down slot="end-icon"></mdui-icon-arrow-drop-down>
				</mdui-select>			</div>

			<div id="qrOpts" class="panel stack">
				<div class="field">
					<label for="ec">
						纠错等级：<span id="ecVal" style="color: rgb(var(--mdui-color-primary))">M</span>
					</label>
					<mdui-slider id="ec" min="0" max="3" value="1" step="1"></mdui-slider>
					<div class="row-between text-xs faint" style="gap: 0">
						<span>L</span><span>M</span><span>Q</span><span>H</span>
					</div>
				</div>
				<div class="field">
					<label for="size">
						尺寸：<span id="szVal" class="mono" style="color: rgb(var(--mdui-color-primary))">240</span> px
					</label>
					<mdui-slider id="size" min="100" max="600" value="240" step="10"></mdui-slider>
				</div>
				<div class="field">
					<label for="mode">输入模式</label>
					<mdui-select id="mode" variant="outlined" value="">
						<mdui-menu-item value="">自动</mdui-menu-item>
						<mdui-menu-item value="NUMBER">仅数字</mdui-menu-item>
						<mdui-menu-item value="ALPHA_NUM">数字 + 字母</mdui-menu-item>
						<mdui-icon-arrow-drop-down slot="end-icon"></mdui-icon-arrow-drop-down>
					</mdui-select>
				</div>
			</div>

			<div id="barOpts" class="panel stack hidden">
				<div class="field">
					<label for="h">
						行高：<span id="hVal" class="mono" style="color: rgb(var(--mdui-color-primary))">100</span> px
					</label>
					<mdui-slider id="h" min="30" max="300" value="100" step="1"></mdui-slider>
				</div>
				<div class="field">
					<span style="display: block; margin-bottom: 0.35rem">显示数值</span>
					<mdui-radio-group id="dv" value="yes">
						<mdui-radio value="yes">是</mdui-radio>
						<mdui-radio value="no">否</mdui-radio>
					</mdui-radio-group>
				</div>
				<div class="field">
					<label for="color">前景色</label>
					<input type="color" id="color" value="#000000" style="height: 2.5rem" />
				</div>
			</div>
		</div>
	</div>

	<p class="footnote">
		本工具完全在浏览器本地运行，生成的内容不会离开你的设备。所用的
		<strong>JsBarcode 3.9.0</strong>（MIT）与 <strong>qrcode-generator 2.0.4</strong>（MIT）
		已随本站一同分发，详见仓库内的 <code class="mono">THIRD_PARTY_NOTICES.md</code>。
	</p>
</Page>

<script>
	// 两个库为 UMD 包，位于 public/ 下，用 script 标签在运行时加载
	// @ts-ignore qrcode-generator 暴露全局 qrcode
	declare const qrcode: any;

	async function loadScript(src: string): Promise<void> {
		await new Promise<void>((resolve, reject) => {
			const s = document.createElement('script');
			s.src = src;
			s.onload = () => resolve();
			s.onerror = () => reject(new Error('加载失败: ' + src));
			document.head.appendChild(s);
		});
	}

	type Select = HTMLElement & { value: string };
	type Slider = HTMLElement & { value: string };
	type RadioGroup = HTMLElement & { value: string };

	const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

	const text = $<HTMLTextAreaElement>('text');
	const format = $<Select>('format');
	const svg = $<HTMLElement>('svg');
	const hint = $('hint');
	const qrOpts = $('qrOpts');
	const barOpts = $('barOpts');
	const ec = $<Slider>('ec');
	const size = $<Slider>('size');
	const mode = $<Select>('mode');
	const h = $<Slider>('h');
	const color = $<HTMLInputElement>('color');
	const dv = $<RadioGroup>('dv');

	const EC = ['L', 'M', 'Q', 'H'];
	const MODE = ['Byte', 'Numeric', 'Alphanumeric'];

	function buildQR(text: string) {
		const s = Number(size.value);
		try {
			const qr = qrcode(0, EC[Number(ec.value)]!);
			qr.addData(text || ' ', MODE[Number(mode.value)] ?? 'Byte');
			qr.make();

			// 直接由模块矩阵生成 SVG path，避免 canvas 中转
			const count = qr.getModuleCount();
			const quiet = 4;
			let d = '';
			for (let y = 0; y < count; y++) {
				let x = 0;
				while (x < count) {
					if (!qr.isDark(y, x)) {
						x++;
						continue;
					}
					// 合并同一行连续的暗模块，减少 path 指令
					let w = 1;
					while (x + w < count && qr.isDark(y, x + w)) w++;
					d += `M${x + quiet} ${y + quiet}h${w}v1h-${w}z`;
					x += w;
				}
			}

			svg.innerHTML =
				`<g shape-rendering="crispEdges">` +
				`<rect width="${count + quiet * 2}" height="${count + quiet * 2}" fill="#fff"/>` +
				`<path d="${d}" fill="#000"/></g>`;
			svg.setAttribute('viewBox', `0 0 ${count + quiet * 2} ${count + quiet * 2}`);
			svg.setAttribute('width', String(s));
			svg.setAttribute('height', String(s));
			return true;
		} catch (e) {
			svg.replaceChildren();
			hint.textContent = `生成失败：${(e as Error).message}`;
			return false;
		}
	}

	function buildBar(text: string) {
		const opts: Record<string, unknown> = {
			format: format.value,
			height: Number(h.value),
			displayValue: dv.value !== 'no',
			lineColor: color.value,
			width: 2,
		};
		if (format.value === 'ITF' || format.value === 'ITF14') opts.margin = 0;
		try {
			// @ts-ignore JsBarcode 暴露全局，无类型声明
			JsBarcode(svg, text, opts);
			// 移除库生成的辅助文本节点，只留图形
			return true;
		} catch (e) {
			hint.textContent = `内容不符合 ${format.value} 格式要求：${(e as Error).message}`;
			svg.replaceChildren();
			return false;
		}
	}

	function render() {
		const t = text.value;
		const isQR = format.value === 'QRCode';
		qrOpts.classList.toggle('hidden', !isQR);
		barOpts.classList.toggle('hidden', isQR);
		if (!t) {
			hint.textContent = '请输入内容';
			svg.replaceChildren();
			return;
		}
		hint.textContent = '';
		const ok = isQR ? buildQR(t) : buildBar(t);
		if (ok) {
			const fmt = isQR ? 'QR 码' : format.value;
			hint.textContent = `已生成 ${fmt}`;
		}
	}

	$('ecVal')!.textContent = EC[+ec.value]!;
	ec.addEventListener('input', () => {
		$('ecVal')!.textContent = EC[+ec.value]!;
		render();
	});
	$('szVal')!.textContent = size.value;
	size.addEventListener('input', () => {
		$('szVal')!.textContent = size.value;
		render();
	});
	$('hVal')!.textContent = h.value;
	h.addEventListener('input', () => {
		$('hVal')!.textContent = h.value;
		render();
	});

	text.addEventListener('input', render);
	/*
	 * mdui-select 不读取 slot="submenu" 子项的文本作显示标签 —— 实测 5 种写法
	 * （父项有无 value、子项是否包 span、end-text）显示的都是 value 本身
	 * （CODE128 而非 CODE 128），只有不用 submenu 的平铺写法才显示标签。
	 * 既然要保留 submenu 分组，就在每次 change 后把显示文本补成标签。
	 */
	function syncFormatLabel(): void {
		const tf = format.shadowRoot?.querySelector('mdui-text-field') as
			| (HTMLElement & { value: string })
			| null;
		const item = format.querySelector(
			`mdui-menu-item[slot="submenu"][value="${format.value}"]`,
		);
		const label = item?.textContent?.trim();
		if (tf && label) tf.value = label;
	}

	format.addEventListener('change', () => {
		// select 在 change 之后还会异步刷新一次 text-field.value，
		// 所以同步要排到组件之后执行，否则会被它覆盖回 value。
		queueMicrotask(syncFormatLabel);
		render();
	});
	mode.addEventListener('change', render);
	color.addEventListener('input', render);
	dv.addEventListener('change', render);

	/**
	 * 序列化生成的图形。
	 *
	 * 注意 `#svg` **本身就是 `<svg>` 元素**，不是包裹 svg 的容器。
	 * 原写法 `svg.querySelector('svg')` 在 svg 元素内部找子 svg，永远返回
	 * null —— 导致 SVG/PNG 两个下载按钮自 Initial commit 起就静默失效
	 * （serialize 返回 ''，点击直接 return）。
	 */
	function serialize(): string {
		const node = svg.querySelector('svg') ?? svg;
		if (!node.isConnected) return '';
		let out = new XMLSerializer().serializeToString(node);
		// 独立成文件的 SVG 必须自带命名空间，否则 Image 加载与部分阅读器会失败
		if (!out.includes('xmlns=')) {
			out = out.replace('<svg', '<svg xmlns="http://www.w3.org/2000/svg"');
		}
		return out;
	}

	$('dl')!.addEventListener('click', () => {
		const s = serialize();
		if (!s) return;
		const url = URL.createObjectURL(
			new Blob([s], { type: 'image/svg+xml;charset=utf-8' }),
		);
		const a = document.createElement('a');
		a.href = url;
		a.download = `${format.value}-${Date.now()}.svg`;
		a.click();
		URL.revokeObjectURL(url);
	});

	$('png')!.addEventListener('click', () => {
		const s = serialize();
		if (!s) return;
		const size2 = svg.getBoundingClientRect();
		const img = new Image();
		img.onload = () => {
			const c = document.createElement('canvas');
			c.width = Math.max(1, Math.round(size2.width * 2));
			c.height = Math.max(1, Math.round(size2.height * 2));
			const ctx = c.getContext('2d')!;
			ctx.fillStyle = '#fff';
			ctx.fillRect(0, 0, c.width, c.height);
			ctx.drawImage(img, 0, 0, c.width, c.height);
			c.toBlob((b) => {
				if (!b) return;
				const url = URL.createObjectURL(b);
				const a = document.createElement('a');
				a.href = url;
				a.download = `${format.value}-${Date.now()}.png`;
				a.click();
				URL.revokeObjectURL(url);
			}, 'image/png');
		};
		// 用 TextEncoder 做 UTF-8 编码，避免过时的 escape/unescape
		const bytes = new TextEncoder().encode(s);
		let bin = '';
		for (const b of bytes) bin += String.fromCharCode(b);
		img.src = 'data:image/svg+xml;base64,' + btoa(bin);
	});

	(async () => {
		try {
			hint.textContent = '正在加载生成器…';
			await loadScript('/vendor/barcode/jsbarcode.js');
			await loadScript('/vendor/barcode/qrcode.js');
			/*
			 * qrcode-generator 自带的 stringToBytes 用 `charCodeAt(i) & 0xff`，
			 * 汉字码位 > 0xFF 会被截断成一个乱码字节，中文扫出来全是问号
			 * （实测「中文测试」被编码成 [45,135,75,213]）。
			 * 换成 TextEncoder 的 UTF-8 编码，符合 QR Code 标准的字节模式。
			 * 必须在脚本加载完成后再覆盖 —— qrcode 这时才是全局变量。
			 */
			qrcode.stringToBytes = (s: string) => Array.from(new TextEncoder().encode(s));
			syncFormatLabel();
			render();
		} catch (e) {
			hint.textContent = (e as Error).message + '，请检查网络后刷新重试。';
		}
	})();
</script>
