---
import Page from '../../layouts/Page.astro';

const EXAMPLES = [
'1 + 2 * 3',
'(1 + 2) * 3',
'10 / 3',
'-2 * (3 + 4)',
'1.5 * 2 + 0.5',
'(3 + 5) & 1',
'1 << 4',
'!0 || 1',
'10 > 3 && 2 < 4',
];
---

<Page
title="表达式求值"
description="输入 C/C++ 表达式，用操作数栈 + 运算符栈逐步展示计算过程，支持逐步与自动演示。"
active="tools"
>
<div class="tool-head">
<div>
<h1>表达式求值</h1>
<p class="lede">
输入 C/C++ 表达式，用操作数栈 + 运算符栈逐步展示计算过程。
</p>
</div>
<mdui-chip variant="tonal">
<mdui-icon-functions></mdui-icon-functions>
双栈法
</mdui-chip>
</div>

<div class="panel-lg">
<label class="field">
<span class="field-label">C/C++ 表达式</span>
<mdui-text-field
	id="expr"
	variant="outlined"
	rows="3"
	class="mono"
	spellcheck="false"
	placeholder="例如：(1 + 2) * 3 - 4 / 2"
	value="1 + 2 * 3 - (4 - 1)"
></mdui-text-field>
</label>

<div class="row" style="gap: 0.6rem; flex-wrap: wrap; align-items: center; margin-top: 0.8rem">
<mdui-button variant="filled" id="go">开始计算</mdui-button>
<mdui-button variant="outlined" id="clear">清空</mdui-button>
</div>

<div class="row" style="gap: 0.45rem; flex-wrap: wrap; margin-top: 0.9rem">
<span class="text-xs faint" style="align-self: center">试试：</span>
{EXAMPLES.map((e) => (
<mdui-chip class="example-chip" variant="outlined" data-expr={e}>{e}</mdui-chip>
))}
</div>
</div>

<div id="resultPanel" class="result-panel hidden" style="margin-top: 1rem" aria-live="polite">
<p class="text-sm">结果</p>
<p id="result" class="result-value"></p>
<p id="error" class="text-sm" style="color: rgb(var(--mdui-color-error)); margin-top: 0.3rem"></p>
</div>

<section id="stackPanel" class="panel" style="margin-top: 1.25rem" hidden>
<div class="row-between" style="align-items: baseline; margin-bottom: 0.6rem">
<h2 class="block-title">双栈演示</h2>
<span class="text-xs faint" id="stepLabel"></span>
</div>

<div class="stack-stage">
<div class="stack-box">
<h3 class="stack-title">操作数栈</h3>
<div id="valueStack" class="stack-lane" aria-label="操作数栈"></div>
</div>
<div class="stack-box">
<h3 class="stack-title">运算符栈</h3>
<div id="opStack" class="stack-lane" aria-label="运算符栈"></div>
</div>
</div>

<div id="stepAction" class="stack-action" aria-live="polite"></div>

<div class="row" style="gap: 0.5rem; flex-wrap: wrap; margin-top: 0.9rem">
<mdui-button variant="outlined" id="prevStep">上一步</mdui-button>
<mdui-button variant="filled" id="playStep">▶ 自动演示</mdui-button>
<mdui-button variant="outlined" id="nextStep">下一步</mdui-button>
<mdui-button variant="text" id="resetStep">回到开头</mdui-button>
</div>
</section>

<section id="stepsPanel" class="panel" style="margin-top: 1.25rem" hidden>
<div class="row-between" style="align-items: baseline; margin-bottom: 0.6rem">
<h2 class="block-title">逐步记录</h2>
<span class="text-xs faint" id="stepCount"></span>
</div>
<div class="table-wrap">
<table class="stack-table">
<thead>
<tr>
<th scope="col">步骤</th>
<th scope="col">读取</th>
<th scope="col">操作数栈</th>
<th scope="col">运算符栈</th>
<th scope="col">动作</th>
</tr>
</thead>
<tbody></tbody>
</table>
</div>
</section>

<p class="footnote">
支持算术 <code class="mono">+ - * / %</code>、关系 <code class="mono">&lt; &lt;= &gt; &gt;= == !=</code>、
逻辑 <code class="mono">&& || !</code>、位运算 <code class="mono">&amp; | ^ ~ &lt;&lt; &gt;&gt;</code>、括号、
一元正负号与小数。整数除法向零截断，位运算按 32 位整数处理。
</p>
</Page>

<style is:global>
.mono {
font-family: var(--mdui-font-family-mono, ui-monospace, monospace);
}

.stack-stage {
display: grid;
grid-template-columns: repeat(2, minmax(0, 1fr));
gap: 1rem;
margin-top: 0.5rem;
}

.stack-box {
min-width: 0;
}

.stack-title {
margin: 0 0 0.4rem;
font-size: var(--mdui-typescale-label-large-size);
color: rgb(var(--mdui-color-on-surface-variant));
}

.stack-lane {
display: flex;
flex-direction: column;
justify-content: flex-end;
gap: 0.3rem;
min-height: 12rem;
padding: 0.5rem;
border: 1px solid rgb(var(--mdui-color-outline-variant));
border-radius: var(--mdui-shape-corner-medium);
background-color: rgb(var(--mdui-color-surface-container-lowest));
}

.stack-item {
padding: 0.35rem 0.55rem;
border-radius: var(--mdui-shape-corner-small);
background-color: rgb(var(--mdui-color-primary-container));
color: rgb(var(--mdui-color-on-primary-container));
font-family: var(--mdui-font-family-mono, ui-monospace, monospace);
text-align: center;
word-break: break-all;
}

.stack-item.op {
background-color: rgb(var(--mdui-color-secondary-container));
color: rgb(var(--mdui-color-on-secondary-container));
}

.stack-empty {
color: rgb(var(--mdui-color-outline));
font-size: var(--mdui-typescale-body-small-size);
text-align: center;
}

.stack-action {
margin-top: 0.8rem;
padding: 0.6rem 0.8rem;
border-radius: var(--mdui-shape-corner-medium);
background-color: rgb(var(--mdui-color-surface-container-low));
font-size: var(--mdui-typescale-body-medium-size);
}

.table-wrap {
overflow-x: auto;
max-height: 40rem;
}

.stack-table {
width: 100%;
border-collapse: collapse;
font-size: var(--mdui-typescale-body-medium-size);
}

.stack-table th,
.stack-table td {
padding: 0.55rem 0.7rem;
text-align: left;
vertical-align: top;
border-bottom: 1px solid rgb(var(--mdui-color-outline-variant));
}

.stack-table th {
position: sticky;
top: 0;
z-index: 1;
background-color: rgb(var(--mdui-color-surface-container));
color: rgb(var(--mdui-color-on-surface-variant));
font-weight: 500;
}

.stack-table td:nth-child(3),
.stack-table td:nth-child(4) {
font-family: var(--mdui-font-family-mono, ui-monospace, monospace);
white-space: nowrap;
}

.stack-table tr {
cursor: pointer;
}

.stack-table tr.is-current {
background-color: rgb(var(--mdui-color-secondary-container));
color: rgb(var(--mdui-color-on-secondary-container));
}

.stack-table tr:hover {
background-color: rgb(var(--mdui-color-surface-container-low));
}

.example-chip {
cursor: pointer;
font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

@media (max-width: 599px) {
.stack-stage {
grid-template-columns: minmax(0, 1fr);
}
}
</style>

<script>
import { evaluateExpression, type Step } from '../../lib/stack-eval';

const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
document.getElementById(id) as T;

const expr = $<HTMLTextAreaElement>('expr');
const resultPanel = $('resultPanel');
const result = $('result');
const error = $('error');
const stackPanel = $('stackPanel');
const stepsPanel = $('stepsPanel');
const valueStack = $('valueStack');
const opStack = $('opStack');
const stepAction = $('stepAction');
const stepLabel = $('stepLabel');
const stepCount = $('stepCount');
const stepsBody = $<HTMLTableSectionElement>('stepsPanel').querySelector('tbody')!;

const esc = (s: string): string =>
s.replace(
/[&<>"']/g,
(c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!,
);

let currentSteps: Step[] = [];
let currentStep = 0;
let timer: number | null = null;

function stackHtml(items: string[], cls = ''): string {
if (!items.length) return '<div class="stack-empty">空</div>';
return [...items]
.reverse()
.map((v) => `<div class="stack-item ${cls}">${esc(v)}</div>`)
.join('');
}

function stopAuto() {
if (timer !== null) {
window.clearInterval(timer);
timer = null;
}
$('playStep').textContent = '▶ 自动演示';
}

function showStep(index: number) {
if (!currentSteps.length) return;
currentStep = Math.max(0, Math.min(index, currentSteps.length - 1));
const step = currentSteps[currentStep]!;
valueStack.innerHTML = stackHtml(step.operands.map((n) => String(n)));
opStack.innerHTML = stackHtml(step.operators, 'op');
stepAction.textContent = `读取「${step.token}」：${step.action}`;
stepLabel.textContent = `第 ${currentStep + 1} / ${currentSteps.length} 步`;
stepsBody.querySelectorAll<HTMLTableRowElement>('tr').forEach((tr, i) => {
tr.classList.toggle('is-current', i === currentStep);
});
}

function renderSteps(steps: Step[]) {
currentSteps = steps;
stepsPanel.hidden = steps.length === 0;
stackPanel.hidden = steps.length === 0;
stepCount.textContent = `${steps.length} 步`;
stepsBody.innerHTML = steps
.map(
(s, i) => `<tr data-step="${i}">
<td>${i + 1}</td>
<td class="mono">${esc(s.token)}</td>
<td>${esc(`[${s.operands.join(', ')}]`)}</td>
<td>${esc(s.operators.join(' '))}</td>
<td>${esc(s.action)}</td>
</tr>`,
)
.join('');
if (steps.length) showStep(0);
}

function run() {
stopAuto();
const source = expr.value.trim();
resultPanel.classList.add('hidden');
renderSteps([]);
if (!source) return;
const res = evaluateExpression(source);
resultPanel.classList.remove('hidden');
if (res.ok) {
result.textContent = String(res.result);
error.textContent = '';
} else {
result.textContent = '—';
error.textContent = res.error ?? '无法计算';
}
renderSteps(res.steps);
}

$('go').addEventListener('click', run);
$('clear').addEventListener('click', () => {
stopAuto();
expr.value = '';
resultPanel.classList.add('hidden');
renderSteps([]);
expr.focus();
});
expr.addEventListener('keydown', (e) => {
if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) run();
});
$('prevStep').addEventListener('click', () => {
stopAuto();
showStep(currentStep - 1);
});
$('nextStep').addEventListener('click', () => {
stopAuto();
showStep(currentStep + 1);
});
$('resetStep').addEventListener('click', () => {
stopAuto();
showStep(0);
});
$('playStep').addEventListener('click', () => {
if (!currentSteps.length) return;
if (timer !== null) {
stopAuto();
return;
}
if (currentStep >= currentSteps.length - 1) showStep(0);
$('playStep').textContent = '⏸ 暂停';
timer = window.setInterval(() => {
if (currentStep >= currentSteps.length - 1) {
stopAuto();
return;
}
showStep(currentStep + 1);
}, 700);
});
stepsBody.addEventListener('click', (e) => {
const tr = (e.target as Element | null)?.closest?.('tr[data-step]') as HTMLTableRowElement | null;
if (!tr) return;
stopAuto();
showStep(Number(tr.dataset.step));
});
document.querySelectorAll<HTMLElement>('[data-expr]').forEach((chip) => {
chip.addEventListener('click', () => {
expr.value = chip.dataset.expr ?? '';
run();
expr.focus();
});
});

run();
</script>
