	/** 页面 → canvas → PNG/JPEG 字节 */
	async function renderPageToImage(
		doc: PdfJsDocument,
		pageNumber: number,
		format: 'png' | 'jpeg',
		scale: number,
		background: string | null,
	): Promise<Uint8Array> {
		const page = await doc.getPage(pageNumber);
		// 页面可能被 /Rotate 转过，导出时要按可视方向出图
		const viewport = page.getViewport({ scale, rotation: page.getViewport({ scale: 1 }).rotation });
		const canvas = document.createElement('canvas');
		canvas.width = Math.ceil(viewport.width);
		canvas.height = Math.ceil(viewport.height);
		const context = canvas.getContext('2d');
		if (!context) throw new Error('无法创建画布');
		if (background) {
			context.fillStyle = background;
			context.fillRect(0, 0, canvas.width, canvas.height);
		}
		await page.render({ canvas, viewport, background: background ?? undefined }).promise;
		page.cleanup();
		const blob = await new Promise<Blob | null>((resolve) =>
			canvas.toBlob(resolve, format === 'png' ? 'image/png' : 'image/jpeg', 0.92),
		);
		if (!blob) throw new Error(`第 ${pageNumber} 页导出失败`);
		return new Uint8Array(await blob.arrayBuffer());
	}

	async function onImgRun(): Promise<void> {
		if (!exportBytes) return;
		beginProgress('渲染页面…');
		try {
			const pdfjs = await loadPdfJs((loaded, total, label) => setProgress(loaded, total, `${label}…`));
			const doc = await pdfjs.getDocument({
				data: exportBytes.slice(),
				cMapUrl: '/vendor/pdfjs/cmaps/',
				cMapPacked: true,
				standardFontDataUrl: '/vendor/pdfjs/standard_fonts/',
				useWasm: false,
				isEvalSupported: false,
			}).promise;
			const format = $<HTMLElement & { value: string }>('imgFormat').value as 'png' | 'jpeg';
			const scale = Number($<HTMLElement & { value: string }>('imgScale').value);
			const wantTransparent = $<HTMLElement & { value: string }>('imgBackground').value === 'transparent';
			const background = format === 'jpeg' || !wantTransparent ? '#ffffff' : null;
			const files: ops.NamedBytes[] = [];
			const ext = format === 'png' ? 'png' : 'jpg';
			for (let i = 1; i <= doc.numPages; i++) {
				setProgress(i - 1, doc.numPages, `渲染第 ${i} / ${doc.numPages} 页…`);
				files.push({
					name: `${baseName(exportName)}-${String(i).padStart(3, '0')}.${ext}`,
					bytes: await renderPageToImage(doc, i, format, scale, background),
				});
				await new Promise((resolve) => setTimeout(resolve, 0));
			}
			doc.cleanup();
			await downloadParts(files, exportName, '页面图片');
			$('imgSummary').textContent = `已导出 ${files.length} 张图片`;
		} catch (error) {
			fail(error);
		}
	}

	async function extractText(): Promise<string> {
		if (!exportBytes) throw new Error('请先选择 PDF');
		const pdfjs = await loadPdfJs((loaded, total, label) => setProgress(loaded, total, `${label}…`));
		const doc = await pdfjs.getDocument({
			data: exportBytes.slice(),
			cMapUrl: '/vendor/pdfjs/cmaps/',
			cMapPacked: true,
			standardFontDataUrl: '/vendor/pdfjs/standard_fonts/',
			useWasm: false,
			isEvalSupported: false,
		}).promise;
		const parts: string[] = [];
		for (let i = 1; i <= doc.numPages; i++) {
			setProgress(i - 1, doc.numPages, `读取第 ${i} / ${doc.numPages} 页文字…`);
			const page = await doc.getPage(i);
			const content = await page.getTextContent();
			const lines: string[] = [];
			let current = '';
			for (const item of content.items as { str?: string; hasEOL?: boolean }[]) {
				current += item.str ?? '';
				if (item.hasEOL) {
					lines.push(current);
					current = '';
				}
			}
			if (current) lines.push(current);
			parts.push(lines.join('\n').trim());
			page.cleanup();
			await new Promise((resolve) => setTimeout(resolve, 0));
		}
		doc.cleanup();
		return parts
			.map((part, index) => (index === 0 ? part : `——— 第 ${index + 1} 页 ———\n${part}`))
			.join('\n\n')
			.trim();
	}

	async function onTextRun(): Promise<void> {
		beginProgress('提取全文…');
