	async function onMetaRun(): Promise<void> {
		if (!metaBytes) return;
		beginProgress('写入元数据…');
		try {
			await loadPdfLib((loaded, total, label) => setProgress(loaded, total, `${label}…`));
			const bytes = await ops.writeMeta(
				metaBytes,
				{
					title: $<TextField>('metaTitle').value,
					author: $<TextField>('metaAuthor').value,
					subject: $<TextField>('metaSubject').value,
					keywords: $<TextField>('metaKeywords').value,
					producer: $<TextField>('metaProducer').value,
					creator: $<TextField>('metaCreator').value,
					language: $<TextField>('metaLanguage').value.trim(),
				},
				{ password: pdfPassword, updateProgress: fromOps() },
			);
			const name = baseName(metaBytes.length ? ($<TextField>('metaTitle').value || 'document') : 'document');
