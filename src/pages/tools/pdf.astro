	interface ImageItem {
		name: string;
		kind: ops.ImageKind;
		bytes: Uint8Array;
		url: string;
	}
	const imagesList = $<HTMLUListElement>('imagesList');
	let imageItems: ImageItem[] = [];

	function renderImageList(): void {
		imagesList.textContent = '';
		imageItems.forEach((item, index) => {
