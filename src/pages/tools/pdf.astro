	/** PDF 只认 PNG / JPEG，其余格式先用 canvas 转成 PNG */
	async function toSupportedImage(file: File): Promise<{ kind: ops.ImageKind; bytes: Uint8Array }> {
		const raw = await readBytes(file);
		const sniffed = ops.sniffImageKind(raw);
		if (sniffed) return { kind: sniffed, bytes: raw };
		const bitmap = await createImageBitmap(file);
		const canvas = document.createElement('canvas');
		canvas.width = bitmap.width;
		canvas.height = bitmap.height;
		canvas.getContext('2d')?.drawImage(bitmap, 0, 0);
		bitmap.close();
		const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, 'image/png'));
		if (!blob) throw new Error(`${file.name} 无法转换`);
		return { kind: 'png', bytes: new Uint8Array(await blob.arrayBuffer()) };
	}

	async function onImagesPick(files: File[]): Promise<void> {
		if (files.length === 0) return;
		beginProgress(`读取 ${files.length} 张图片…`);
		try {
			let done = 0;
			for (const file of files) {
				setProgress(++done, files.length, `转换 ${file.name}…`);
				const { kind, bytes } = await toSupportedImage(file);
				imageItems.push({ name: file.name, kind, bytes, url: URL.createObjectURL(file) });
			}
			renderImageList();
			endProgress(`已加入 ${files.length} 张图片`);
		} catch (error) {
			fail(error);
		}
	}

	async function onImagesRun(): Promise<void> {
		if (imageItems.length === 0) return;
		beginProgress('生成 PDF…');
		try {
			await loadPdfLib((loaded, total, label) => setProgress(loaded, total, `${label}…`));
			const pageSize = $<HTMLElement & { value: string }>('imagesSize').value as ops.ImageOptions['pageSize'];
			const bytes = await ops.imagesToPdf(
				imageItems.map(({ name, kind, bytes }) => ({ name, kind, bytes })),
				{
					pageSize,
					orientation: $<HTMLElement & { value: string }>('imagesOrient').value as ops.Orientation,
					margin: Number($<HTMLElement & { value: string }>('imagesMargin').value),
					title: baseName(imageItems[0].name),
				},
				fromOps(),
			);
			download(bytes, `${baseName(imageItems[0].name)}.pdf`);
			endProgress('PDF 已生成');
		} catch (error) {
			fail(error);
		}
	}

	/* ------------------------------------------------------------------ 元数据 */

	let metaBytes: Uint8Array | null = null;

	async function loadMetaFile(file: File): Promise<void> {
		beginProgress('读取元数据…');
		try {
			await loadPdfLib((loaded, total, label) => setProgress(loaded, total, `${label}…`));
			metaBytes = await readBytes(file);
			pdfPassword = undefined;
			const info = await loadDoc(metaBytes);
			$<TextField>('metaTitle').value = info.title;
			$<TextField>('metaAuthor').value = info.author;
			$<TextField>('metaSubject').value = info.subject;
			$<TextField>('metaKeywords').value = info.keywords;
			$<TextField>('metaProducer').value = info.producer;
			$<TextField>('metaCreator').value = info.creator;
			$<TextField>('metaCreated').value = info.creationDate;
			$<TextField>('metaModified').value = info.modificationDate;
			$('metaInfo').textContent = `${file.name} · ${ops.formatBytes(metaBytes.length)}`;
			$('metaSummary').textContent = '';
			setDisabled('metaRun', false);
			endProgress('元数据已读取');
		} catch (error) {
			metaBytes = null;
			setDisabled('metaRun', true);
			fail(error);
