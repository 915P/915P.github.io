---
import Page from '../../layouts/Page.astro';
---

<Page
	title="PDF 工具箱"
	description="在浏览器里合并、拆分、旋转与重排 PDF 页面，把图片转成 PDF，编辑文档元数据。文件不上传。"
	active="tools"
>
	<div class="tool-head head-split">
		<div class="head-title">
			<h1>PDF 工具箱</h1>
			<p class="lede">
				合并、拆分、页面管理与图片转 PDF，全部在浏览器本地完成，文件不会上传到任何服务器。
			</p>
		</div>
		<div class="head-tools">
			<mdui-chip variant="tonal">
				<mdui-icon-lock></mdui-icon-lock>
				本地处理
			</mdui-chip>
		</div>
	</div>

	<section class="panel-lg pdf-progress" id="progressPanel" hidden>
		<div class="row-between pdf-progress-head">
			<span class="text-sm" id="progressText" role="status">准备中…</span>
			<span class="text-xs faint" id="progressPercent"></span>
		</div>
		<mdui-linear-progress id="progressBar" value="0" max="1"></mdui-linear-progress>
	</section>

	<mdui-tabs value="merge" id="pdfTabs" class="pdf-tabs">
		<mdui-tab value="merge">合并</mdui-tab>
		<mdui-tab value="split">拆分</mdui-tab>
		<mdui-tab value="pages">页面管理</mdui-tab>
		<mdui-tab value="mark">水印 / 页码</mdui-tab>
		<mdui-tab value="form">表单</mdui-tab>
		<mdui-tab value="images">图片转 PDF</mdui-tab>
		<mdui-tab value="export">导出</mdui-tab>
		<mdui-tab value="meta">元数据</mdui-tab>
		<mdui-tab value="secure">安全</mdui-tab>

		<mdui-tab-panel slot="panel" value="merge">
			<section class="pdf-tab-body">
				<div class="pdf-picker">
					<div class="pdf-drop" id="mergeDrop">
						<mdui-button variant="outlined" id="mergePick">
							<mdui-icon-upload slot="icon"></mdui-icon-upload>
							选择 PDF 文件（可多选）
						</mdui-button>
						<span class="text-xs faint">也可以把文件直接拖到这里</span>
					</div>
					<p class="text-xs faint">
						按列表顺序合并，可用 ↑ ↓ 调整先后；文件名重复的会自动加序号。
					</p>
				</div>
				<ul class="pdf-list" id="mergeList"></ul>
				<div class="row pdf-actions">
					<mdui-button variant="filled" id="mergeRun">合并并下载</mdui-button>
					<mdui-button variant="text" id="mergeClear">清空列表</mdui-button>
					<span class="text-xs faint" id="mergeSummary"></span>
				</div>
			</section>
		</mdui-tab-panel>

		<mdui-tab-panel slot="panel" value="split">
			<section class="pdf-tab-body">
				<div class="pdf-picker">
					<div class="pdf-drop" id="splitDrop">
						<mdui-button variant="outlined" id="splitPick">
							<mdui-icon-upload slot="icon"></mdui-icon-upload>
							选择一个 PDF 文件
						</mdui-button>
						<span class="text-xs faint">也可以把文件直接拖到这里</span>
					</div>
					<p class="text-xs faint" id="splitInfo">支持加密文件：遇到密码会弹出输入框。</p>
				</div>

				<mdui-radio-group value="each" id="splitMode" class="pdf-modes">
					<mdui-radio value="each">每页一个文件</mdui-radio>
					<mdui-radio value="range">按区间拆分</mdui-radio>
					<mdui-radio value="pick">勾选需要的页面</mdui-radio>
				</mdui-radio-group>

				<div id="splitRangeBox" hidden>
					<mdui-text-field
						id="splitRanges"
						variant="outlined"
						label="页码区间"
						value="1-3,4-8"
						helper="逗号分隔；5 表示第 5 页，5- 表示第 5 页到末尾，-3 表示开头到第 3 页"
					></mdui-text-field>
				</div>

				<div id="splitPickBox" hidden>
					<div class="pdf-grid" id="splitGrid"></div>
				</div>

				<div class="row pdf-actions">
					<mdui-button variant="filled" id="splitRun">拆分并下载 ZIP</mdui-button>
					<mdui-button variant="text" id="splitAll">全选 / 全不选</mdui-button>
				</div>
			</section>
		</mdui-tab-panel>

		<mdui-tab-panel slot="panel" value="pages">
			<section class="pdf-tab-body">
				<div class="pdf-picker">
					<div class="pdf-drop" id="pagesDrop">
						<mdui-button variant="outlined" id="pagesPick">
							<mdui-icon-upload slot="icon"></mdui-icon-upload>
							选择一个 PDF 文件
						</mdui-button>
						<span class="text-xs faint">也可以把文件直接拖到这里</span>
					</div>
					<p class="text-xs faint" id="pagesInfo">
						拖动缩略图可以调整顺序，也可以用 ↑ ↓；旋转、复制、删除都在卡片上。
					</p>
				</div>
				<div class="pdf-grid" id="pagesGrid"></div>
				<div class="row pdf-actions">
					<mdui-button variant="filled" id="pagesRun">应用并下载</mdui-button>
					<mdui-button variant="text" id="pagesReset">重置</mdui-button>
					<span class="text-xs faint" id="pagesSummary"></span>
				</div>

				<h3 class="block-title" style="margin-top: 1.5rem">页面裁剪</h3>
				<div class="pdf-form">
					<mdui-text-field id="cropLeft" variant="outlined" label="左 (pt)" value="0" inputmode="numeric"></mdui-text-field>
					<mdui-text-field id="cropTop" variant="outlined" label="上 (pt)" value="0" inputmode="numeric"></mdui-text-field>
					<mdui-text-field id="cropRight" variant="outlined" label="右 (pt)" value="0" inputmode="numeric"></mdui-text-field>
					<mdui-text-field id="cropBottom" variant="outlined" label="下 (pt)" value="0" inputmode="numeric"></mdui-text-field>
				</div>
				<div class="row pdf-actions">
					<mdui-button variant="outlined" id="cropRun">裁剪全部页面</mdui-button>
				</div>

				<h3 class="block-title" style="margin-top: 1.5rem">尺寸归一</h3>
				<div class="pdf-form">
					<mdui-select id="normSize" variant="outlined" label="目标尺寸" value="a4">
						<mdui-menu-item value="a4">A4</mdui-menu-item>
						<mdui-menu-item value="letter">Letter</mdui-menu-item>
					</mdui-select>
					<mdui-select id="normOrient" variant="outlined" label="方向" value="auto">
						<mdui-menu-item value="auto">跟随原页</mdui-menu-item>
						<mdui-menu-item value="portrait">纵向</mdui-menu-item>
						<mdui-menu-item value="landscape">横向</mdui-menu-item>
					</mdui-select>
					<mdui-select id="normMode" variant="outlined" label="缩放方式" value="fit">
						<mdui-menu-item value="fit">留白居中</mdui-menu-item>
						<mdui-menu-item value="cover">铺满并裁掉溢出</mdui-menu-item>
					</mdui-select>
					<mdui-select id="normMargin" variant="outlined" label="边距" value="0">
						<mdui-menu-item value="0">无边距</mdui-menu-item>
						<mdui-menu-item value="18">小（18 pt）</mdui-menu-item>
						<mdui-menu-item value="36">中（36 pt）</mdui-menu-item>
						<mdui-menu-item value="72">大（72 pt）</mdui-menu-item>
					</mdui-select>
				</div>
				<div class="row pdf-actions">
					<mdui-button variant="outlined" id="normRun">统一尺寸并下载</mdui-button>
				</div>
			</section>
		</mdui-tab-panel>

		<mdui-tab-panel slot="panel" value="mark">
			<section class="pdf-tab-body">
				<div class="pdf-picker">
					<div class="pdf-drop" id="markDrop">
						<mdui-button variant="outlined" id="markPick">
							<mdui-icon-upload slot="icon"></mdui-icon-upload>
							选择一个 PDF 文件
						</mdui-button>
						<span class="text-xs faint">也可以把文件直接拖到这里</span>
					</div>
					<p class="text-xs faint" id="markInfo">水印与页码会直接画在页面上，建议先在「页面管理」里调好顺序。</p>
				</div>

				<h3 class="block-title">文字水印</h3>
				<div class="pdf-form">
					<mdui-text-field
						id="markText"
						variant="outlined"
						label="水印文字"
						value="内部资料 禁止外传"
						helper="中文会自动内嵌思源黑体子集"
					></mdui-text-field>
					<mdui-select id="markPos" variant="outlined" label="位置" value="diagonal">
						<mdui-menu-item value="diagonal">斜向居中</mdui-menu-item>
						<mdui-menu-item value="center">居中</mdui-menu-item>
						<mdui-menu-item value="tile">平铺满页</mdui-menu-item>
						<mdui-menu-item value="top">顶部</mdui-menu-item>
						<mdui-menu-item value="bottom">底部</mdui-menu-item>
					</mdui-select>
					<mdui-select id="markSize" variant="outlined" label="字号" value="42">
						<mdui-menu-item value="24">小（24 pt）</mdui-menu-item>
						<mdui-menu-item value="42">中（42 pt）</mdui-menu-item>
						<mdui-menu-item value="64">大（64 pt）</mdui-menu-item>
						<mdui-menu-item value="96">特大（96 pt）</mdui-menu-item>
					</mdui-select>
					<mdui-select id="markOpacity" variant="outlined" label="透明度" value="0.25">
						<mdui-menu-item value="0.1">很淡（10%）</mdui-menu-item>
						<mdui-menu-item value="0.25">淡（25%）</mdui-menu-item>
						<mdui-menu-item value="0.5">中（50%）</mdui-menu-item>
						<mdui-menu-item value="0.8">浓（80%）</mdui-menu-item>
					</mdui-select>
					<mdui-select id="markRange" variant="outlined" label="作用范围" value="all">
						<mdui-menu-item value="all">全部页面</mdui-menu-item>
						<mdui-menu-item value="first">仅第一页</mdui-menu-item>
						<mdui-menu-item value="even">仅偶数页</mdui-menu-item>
						<mdui-menu-item value="odd">仅奇数页</mdui-menu-item>
					</mdui-select>
				</div>
				<div class="row pdf-actions">
					<mdui-button variant="filled" id="markRun">加上文字水印</mdui-button>
					<span class="text-xs faint" id="markSummary"></span>
				</div>

				<h3 class="block-title" style="margin-top: 1.5rem">图片水印</h3>
				<div class="pdf-picker">
					<div class="pdf-drop" id="markImgDrop">
						<mdui-button variant="outlined" id="markImgPick">
						<mdui-icon-image slot="icon"></mdui-icon-image>
						选择水印图片（PNG / JPEG / WebP…）
						</mdui-button>
						<span class="text-xs faint" id="markImgName">还没有选择图片</span>
					</div>
				</div>
				<div class="row pdf-actions">
					<mdui-button variant="outlined" id="markImgRun">加上图片水印</mdui-button>
				</div>

				<h3 class="block-title" style="margin-top: 1.5rem">页码</h3>
				<div class="pdf-form">
					<mdui-select id="numPos" variant="outlined" label="位置" value="bottom-center">
						<mdui-menu-item value="bottom-center">底部居中</mdui-menu-item>
						<mdui-menu-item value="bottom-left">底部左侧</mdui-menu-item>
						<mdui-menu-item value="bottom-right">底部右侧</mdui-menu-item>
						<mdui-menu-item value="top-center">顶部居中</mdui-menu-item>
						<mdui-menu-item value="top-left">顶部左侧</mdui-menu-item>
						<mdui-menu-item value="top-right">顶部右侧</mdui-menu-item>
					</mdui-select>
					<mdui-select id="numFormat" variant="outlined" label="编号格式" value="arabic">
						<mdui-menu-item value="arabic">1, 2, 3</mdui-menu-item>
						<mdui-menu-item value="roman">i, ii, iii</mdui-menu-item>
						<mdui-menu-item value="alpha">A, B, C</mdui-menu-item>
					</mdui-select>
					<mdui-text-field
						id="numTemplate"
						variant="outlined"
						label="显示格式"
						value="{n} / {total}"
						helper="{n} 是页码，{total} 是总页数"
					></mdui-text-field>
					<mdui-select id="numStart" variant="outlined" label="起始编号" value="1">
						<mdui-menu-item value="1">1</mdui-menu-item>
						<mdui-menu-item value="0">0</mdui-menu-item>
						<mdui-menu-item value="01">01（补零）</mdui-menu-item>
					</mdui-select>
					<mdui-select id="numFrom" variant="outlined" label="从第几页开始" value="1">
						<mdui-menu-item value="1">第 1 页</mdui-menu-item>
						<mdui-menu-item value="2">跳过封面（第 2 页起）</mdui-menu-item>
						<mdui-menu-item value="3">前两页不显示</mdui-menu-item>
					</mdui-select>
				</div>
				<div class="row pdf-actions">
					<mdui-button variant="filled" id="numRun">加上页码</mdui-button>
					<span class="text-xs faint" id="numSummary"></span>
				</div>
			</section>
		</mdui-tab-panel>

		<mdui-tab-panel slot="panel" value="form">
			<section class="pdf-tab-body">
				<div class="pdf-picker">
					<div class="pdf-drop" id="formDrop">
						<mdui-button variant="outlined" id="formPick">
							<mdui-icon-upload slot="icon"></mdui-icon-upload>
							选择一个带表单的 PDF
						</mdui-button>
						<span class="text-xs faint">也可以把文件直接拖到这里</span>
					</div>
					<p class="text-xs faint" id="formInfo">读取后会列出所有可填写的字段。</p>
				</div>

				<div id="formFields" class="pdf-form-list"></div>

				<div class="row pdf-actions">
					<mdui-checkbox id="formFlatten">填完后压平表单（之后不能再编辑）</mdui-checkbox>
					<mdui-button variant="filled" id="formRun">保存并下载</mdui-button>
					<span class="text-xs faint" id="formSummary"></span>
				</div>
			</section>
		</mdui-tab-panel>

		<mdui-tab-panel slot="panel" value="images">
			<section class="pdf-tab-body">
				<div class="pdf-picker">
					<div class="pdf-drop" id="imagesDrop">
						<mdui-button variant="outlined" id="imagesPick">
							<mdui-icon-upload slot="icon"></mdui-icon-upload>
							选择图片（可多选）
						</mdui-button>
						<span class="text-xs faint">也可以把图片直接拖到这里</span>
					</div>
					<p class="text-xs faint">
						支持 PNG / JPEG / WebP / GIF / AVIF，其它格式会先在浏览器里转成 PNG 再嵌入；
						顺序即页序。
					</p>
				</div>
				<ul class="pdf-list pdf-list-images" id="imagesList"></ul>

				<div class="pdf-options">
					<mdui-select id="imagesSize" variant="outlined" label="页面尺寸" value="fit">
						<mdui-menu-item value="fit">适应图片</mdui-menu-item>
						<mdui-menu-item value="a4">A4</mdui-menu-item>
						<mdui-menu-item value="letter">Letter</mdui-menu-item>
					</mdui-select>

					<mdui-select id="imagesOrient" variant="outlined" label="方向" value="auto">
						<mdui-menu-item value="auto">自动</mdui-menu-item>
						<mdui-menu-item value="portrait">纵向</mdui-menu-item>
						<mdui-menu-item value="landscape">横向</mdui-menu-item>
					</mdui-select>

					<mdui-select id="imagesMargin" variant="outlined" label="边距" value="24">
						<mdui-menu-item value="0">无边距</mdui-menu-item>
						<mdui-menu-item value="12">小（12 pt）</mdui-menu-item>
						<mdui-menu-item value="24">中（24 pt）</mdui-menu-item>
						<mdui-menu-item value="48">大（48 pt）</mdui-menu-item>
					</mdui-select>
				</div>

				<div class="row pdf-actions">
					<mdui-button variant="filled" id="imagesRun">生成 PDF</mdui-button>
					<mdui-button variant="text" id="imagesClear">清空列表</mdui-button>
					<span class="text-xs faint" id="imagesSummary"></span>
				</div>
			</section>
		</mdui-tab-panel>

		<mdui-tab-panel slot="panel" value="meta">
			<section class="pdf-tab-body">
				<div class="pdf-picker">
					<div class="pdf-drop" id="metaDrop">
						<mdui-button variant="outlined" id="metaPick">
							<mdui-icon-upload slot="icon"></mdui-icon-upload>
							选择一个 PDF 文件
						</mdui-button>
						<span class="text-xs faint">也可以把文件直接拖到这里</span>
					</div>
					<p class="text-xs faint" id="metaInfo">读取后可编辑；留空的字段会被清空。</p>
				</div>

				<div class="pdf-form">
					<mdui-text-field id="metaTitle" variant="outlined" label="标题 Title"></mdui-text-field>
					<mdui-text-field id="metaAuthor" variant="outlined" label="作者 Author"></mdui-text-field>
					<mdui-text-field id="metaSubject" variant="outlined" label="主题 Subject"></mdui-text-field>
					<mdui-text-field
						id="metaKeywords"
						variant="outlined"
						label="关键词 Keywords"
						helper="用逗号分隔"
					></mdui-text-field>
					<mdui-text-field id="metaProducer" variant="outlined" label="生成工具 Producer"></mdui-text-field>
					<mdui-text-field id="metaCreator" variant="outlined" label="创建程序 Creator"></mdui-text-field>
					<mdui-text-field
					id="metaLanguage"
					variant="outlined"
					label="语言 Language"
					helper="BCP 47 标记，例如 zh-CN、en-US"
				></mdui-text-field>
				<mdui-text-field id="metaCreated" variant="outlined" label="创建时间" readonly></mdui-text-field>
					<mdui-text-field id="metaModified" variant="outlined" label="修改时间" readonly></mdui-text-field>
				</div>

				<div class="row pdf-actions">
					<mdui-button variant="filled" id="metaRun">保存并下载</mdui-button>
					<span class="text-xs faint" id="metaSummary"></span>
				</div>
			</section>
		</mdui-tab-panel>
		<mdui-tab-panel slot="panel" value="export">
			<section class="pdf-tab-body">
				<div class="pdf-picker">
					<div class="pdf-drop" id="exportDrop">
						<mdui-button variant="outlined" id="exportPick">
							<mdui-icon-upload slot="icon"></mdui-icon-upload>
							选择一个 PDF 文件
						</mdui-button>
						<span class="text-xs faint">也可以把文件直接拖到这里</span>
					</div>
					<p class="text-xs faint" id="exportInfo">导出全部在本地渲染，不会上传。</p>
				</div>

				<h3 class="block-title">导出为图片</h3>
				<div class="pdf-form">
					<mdui-select id="imgFormat" variant="outlined" label="格式" value="png">
						<mdui-menu-item value="png">PNG</mdui-menu-item>
						<mdui-menu-item value="jpeg">JPEG</mdui-menu-item>
					</mdui-select>
					<mdui-select id="imgScale" variant="outlined" label="分辨率" value="2">
						<mdui-menu-item value="1">1 倍（约 72 dpi）</mdui-menu-item>
						<mdui-menu-item value="2">2 倍（约 144 dpi）</mdui-menu-item>
						<mdui-menu-item value="3">3 倍（约 216 dpi）</mdui-menu-item>
					</mdui-select>
					<mdui-select id="imgBackground" variant="outlined" label="背景" value="white">
						<mdui-menu-item value="white">白色</mdui-menu-item>
						<mdui-menu-item value="transparent">透明（仅 PNG）</mdui-menu-item>
					</mdui-select>
				</div>
				<div class="row pdf-actions">
					<mdui-button variant="filled" id="imgRun">导出全部页面为 ZIP</mdui-button>
					<span class="text-xs faint" id="imgSummary"></span>
				</div>

				<h3 class="block-title" style="margin-top: 1.5rem">提取内容</h3>
				<div class="row pdf-actions" style="margin-top: 0.6rem">
					<mdui-button variant="outlined" id="textRun">提取全文（.txt）</mdui-button>
					<mdui-button variant="text" id="textCopy">复制全文</mdui-button>
					<mdui-button variant="outlined" id="extractImgRun">提取页面内嵌图片</mdui-button>
					<span class="text-xs faint" id="extractSummary"></span>
				</div>
				<pre id="textOut" class="pdf-text-out hidden"></pre>
			</section>
		</mdui-tab-panel>

		<mdui-tab-panel slot="panel" value="secure">
			<section class="pdf-tab-body">
				<div class="pdf-picker">
					<div class="pdf-drop" id="secureDrop">
						<mdui-button variant="outlined" id="securePick">
							<mdui-icon-upload slot="icon"></mdui-icon-upload>
