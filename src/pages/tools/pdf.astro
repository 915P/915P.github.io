	async function boot(): Promise<void> {
		wireFilePicker({
			buttonId: 'mergePick',
			dropId: 'mergeDrop',
			accept: 'application/pdf,.pdf',
			multiple: true,
			extensions: ['.pdf'],
			onFiles: (files) => void onMergePick(files),
		});
		wireFilePicker({
			buttonId: 'splitPick',
			dropId: 'splitDrop',
			accept: 'application/pdf,.pdf',
			multiple: false,
			extensions: ['.pdf'],
			onFiles: (files) => files[0] && void loadSplitFile(files[0]),
		});
		wireFilePicker({
			buttonId: 'pagesPick',
			dropId: 'pagesDrop',
			accept: 'application/pdf,.pdf',
			multiple: false,
			extensions: ['.pdf'],
			onFiles: (files) => files[0] && void loadPagesFile(files[0]),
		});
		wireFilePicker({
			buttonId: 'imagesPick',
			dropId: 'imagesDrop',
			accept: 'image/*',
			multiple: true,
			extensions: ['.png', '.jpg', '.jpeg', '.webp', '.gif', '.avif', '.bmp'],
			onFiles: (files) => void onImagesPick(files),
		});
		wireFilePicker({
			buttonId: 'metaPick',
			dropId: 'metaDrop',
			accept: 'application/pdf,.pdf',
			multiple: false,
			extensions: ['.pdf'],
			onFiles: (files) => files[0] && void loadMetaFile(files[0]),
		});
		await customElements.whenDefined('mdui-linear-progress');
		progressBar.value = 0;

		$('mergeRun').addEventListener('click', onMergeRun);
		$('mergeClear').addEventListener('click', () => {
			mergeFiles = [];
			renderMergeList();
		});

		$('splitMode').addEventListener('change', renderSplitMode);
		$('splitRun').addEventListener('click', onSplitRun);
		$('splitAll').addEventListener('click', () => {
			const view = splitPreview?.doc;
			if (!view) return;
			const all = pickedPages.size === view.numPages;
			pickedPages.clear();
			if (!all) for (let i = 1; i <= view.numPages; i++) pickedPages.add(i);
			renderSplitMode();
		});

		$('pagesRun').addEventListener('click', onPagesRun);
		$('pagesReset').addEventListener('click', () => {
			const view = pagesPreview?.doc;
			if (!view) return;
			pageState = Array.from({ length: view.numPages }, (_, i) => ({ origin: i + 1, rotation: 0 }));
			renderPageGrid();
		});
		wireDragReorder($('pagesGrid'));

		$('imagesRun').addEventListener('click', onImagesRun);
		$('imagesClear').addEventListener('click', () => {
			imageItems.forEach((item) => URL.revokeObjectURL(item.url));
			imageItems = [];
			renderImageList();
		});
		$('imagesSize').addEventListener('change', () => {
			const fit = $<HTMLElement & { value: string }>('imagesSize').value === 'fit';
			const orient = $<HTMLElement & { value: string }>('imagesOrient');
			orient.toggleAttribute('disabled', fit);
			if (fit) orient.value = 'auto';
		});

		$('metaRun').addEventListener('click', onMetaRun);
		$('cropRun').addEventListener('click', onCropRun);
		$('normRun').addEventListener('click', onNormRun);

		wireFilePicker({
			buttonId: 'markPick',
			dropId: 'markDrop',
			accept: 'application/pdf,.pdf',
			multiple: false,
			extensions: ['.pdf'],
			onFiles: (files) => files[0] && void loadMarkFile(files[0]),
		});
		wireFilePicker({
			buttonId: 'markImgPick',
			dropId: 'markImgDrop',
			accept: 'image/*',
			multiple: false,
			extensions: ['.png', '.jpg', '.jpeg', '.webp', '.gif', '.avif', '.bmp'],
			onFiles: (files) => void pickMarkImage(files[0]),
		});
		wireFilePicker({
			buttonId: 'formPick',
			dropId: 'formDrop',
			accept: 'application/pdf,.pdf',
			multiple: false,
			extensions: ['.pdf'],
			onFiles: (files) => files[0] && void loadFormFile(files[0]),
		});
		wireFilePicker({
			buttonId: 'exportPick',
			dropId: 'exportDrop',
			accept: 'application/pdf,.pdf',
			multiple: false,
			extensions: ['.pdf'],
			onFiles: (files) => files[0] && void loadExportFile(files[0]),
		});
		wireFilePicker({
			buttonId: 'securePick',
			dropId: 'secureDrop',
			accept: 'application/pdf,.pdf',
			multiple: false,
			extensions: ['.pdf'],
			onFiles: (files) => files[0] && void loadSecureFile(files[0]),
		});

		$('markRun').addEventListener('click', onMarkRun);
		$('markImgRun').addEventListener('click', onMarkImgRun);
		$('numRun').addEventListener('click', onNumRun);
		$('formRun').addEventListener('click', onFormRun);
		$('imgRun').addEventListener('click', onImgRun);
		$('textRun').addEventListener('click', onTextRun);
		$('textCopy').addEventListener('click', onTextCopy);
		$('extractImgRun').addEventListener('click', onExtractImgRun);
		$('secRun').addEventListener('click', onSecRun);
		$('pdfaRun').addEventListener('click', onPdfaRun);

		renderMergeList();
		renderImageList();
		renderPageGrid();
		setDisabled('mergeRun', true);
		setDisabled('splitRun', true);
		setDisabled('pagesRun', true);
		setDisabled('imagesRun', true);
		setDisabled('metaRun', true);
		for (const id of ['markRun', 'markImgRun', 'numRun', 'formRun', 'imgRun', 'textRun', 'textCopy', 'extractImgRun', 'secRun', 'pdfaRun']) {
			setDisabled(id, true);
		}
	}

	void boot();
</script>