	function watermarkPageFilter(kind: string, total: number): number[] | undefined {
		if (kind === 'all') return undefined;
		const out: number[] = [];
		for (let i = 0; i < total; i++) {
			if (kind === 'first' && i === 0) out.push(i);
			if (kind === 'even' && i % 2 === 1) out.push(i);
			if (kind === 'odd' && i % 2 === 0) out.push(i);
		}
		return out;
	}

