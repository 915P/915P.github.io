	/** 中文水印/页码需要 fontkit + 内置字体子集 */
	let fontsReady: Promise<void> | null = null;
	function prepareFonts(): Promise<void> {
		fontsReady ??= (async () => {
			await loadPdfLib((loaded, total, label) => setProgress(loaded, total, `${label}…`));
			await setupCjkFont((loaded, total, label) => setProgress(loaded, total, `${label}…`));
			const bytes = await loadCjkFont((loaded, total, label) => setProgress(loaded, total, `${label}…`));
			ops.registerFontEngine({
				fontkit: (window as unknown as { fontkit: unknown }).fontkit,
				cjkBytes: bytes,
			});
		})();
		return fontsReady;
	}

	/** 读页数（水印范围要用），失败返回 null */
	async function PDFDocumentProxyOf(bytes: Uint8Array): Promise<number | null> {
		try {
			const pdfjs = await loadPdfJs();
			const doc = await pdfjs.getDocument({ data: bytes.slice(), useWasm: false, isEvalSupported: false }).promise;
			const count = doc.numPages;
			doc.cleanup();
			return count;
		} catch {
			return null;
		}
	}

	/* ------------------------------------------------------------------ 表单 */

	let formBytes: Uint8Array | null = null;
	let formName = '';
	let formFields: ops.FormFieldInfo[] = [];

	function renderFormFields(): void {
		const box = $('formFields');
		box.textContent = '';
		for (const field of formFields) {
			const wrap = document.createElement('div');
			wrap.className = 'pdf-field';
			const id = `field-${field.name.replace(/[^\w-]/g, '_')}`;
			if (field.type === 'checkbox') {
				const check = document.createElement('mdui-checkbox');
				check.id = id;
				check.toggleAttribute('checked', field.value === 'true');
				wrap.append(check, labelFor(id, `${field.name}${field.required ? ' *' : ''}`));
			} else if (field.type === 'choice' && field.options?.length) {
				const select = document.createElement('mdui-select');
				select.id = id;
				select.setAttribute('variant', 'outlined');
				select.value = field.value || field.options[0];
				for (const option of field.options) {
					const item = document.createElement('mdui-menu-item');
					item.setAttribute('value', option);
					item.textContent = option;
					select.append(item);
				}
				wrap.append(select, labelFor(id, `${field.name}${field.required ? ' *' : ''}`));
			} else {
				const input = document.createElement('mdui-text-field');
				input.id = id;
				input.setAttribute('variant', 'outlined');
				input.value = field.value;
				if (field.maxLength) input.setAttribute('maxlength', String(field.maxLength));
				wrap.append(input, labelFor(id, `${field.name}${field.required ? ' *' : ''}`));
			}
			if (field.readOnly) {
				wrap.classList.add('is-readonly');
				wrap.title = '只读字段';
			}
			box.append(wrap);
		}
		setDisabled('formRun', formFields.length === 0);
		$('formSummary').textContent = formFields.length
			? `${formFields.length} 个字段${formFields.some((f) => f.readOnly) ? '（含只读）' : ''}`
			: '';
	}

	function labelFor(id: string, text: string): HTMLElement {
		const label = document.createElement('label');
		label.className = 'text-xs faint';
		label.setAttribute('for', id);
		label.textContent = text;
		return label;
	}

	function collectFormValues(): Record<string, string> {
		const values: Record<string, string> = {};
		for (const field of formFields) {
			const el = document.getElementById(`field-${field.name.replace(/[^\w-]/g, '_')}`) as
				| (HTMLElement & { value: string; checked?: boolean })
				| null;
			if (!el) continue;
			values[field.name] =
				field.type === 'checkbox' ? (el.checked ? 'true' : 'false') : (el.value ?? '');
		}
		return values;
	}

	async function loadFormFile(file: File): Promise<void> {
		beginProgress('读取表单…');
		try {
			await loadPdfLib((loaded, total, label) => setProgress(loaded, total, `${label}…`));
			formBytes = await readBytes(file);
			formName = file.name;
			formFields = await ops.readFormFields(formBytes, {
				password: pdfPassword,
				updateProgress: fromOps(),
			});
			$('formInfo').textContent = `${file.name} · ${ops.formatBytes(formBytes.length)}`;
			renderFormFields();
			endProgress(formFields.length ? `共 ${formFields.length} 个字段` : '这个 PDF 没有可填写的表单');
		} catch (error) {
			formBytes = null;
			formFields = [];
			renderFormFields();
			fail(error);
		}
	}

	async function onFormRun(): Promise<void> {
		if (!formBytes || formFields.length === 0) return;
		beginProgress('写入表单…');
		try {
			await prepareFonts();
			const flatten = (document.getElementById('formFlatten') as unknown as { checked: boolean }).checked;
			const bytes = await ops.fillForm(formBytes, {
				values: collectFormValues(),
