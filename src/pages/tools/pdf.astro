					<span class="text-xs faint" id="secSummary"></span>
				</div>

				<h3 class="block-title" style="margin-top: 1.5rem">PDF/A</h3>
				<div class="pdf-form">
					<mdui-select id="pdfaLevel" variant="outlined" label="合规级别" value="2B">
						<mdui-menu-item value="1B">PDF/A-1b</mdui-menu-item>
						<mdui-menu-item value="2b">PDF/A-2b</mdui-menu-item>
