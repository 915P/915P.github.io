---
import Page from '../../layouts/Page.astro';

const EXAMPLES = [
{ label: '二次公式', tex: String.raw`x = \frac{-b \pm \sqrt{b^2 - 4ac}}{2a}` },
{ label: '积分', tex: String.raw`\int_{-\infty}^{\infty} e^{-x^2}\,\mathrm{d}x = \sqrt{\pi}` },
{ label: '矩阵', tex: String.raw`\begin{pmatrix} a & b \\ c & d \end{pmatrix}^{-1} = \frac{1}{ad-bc}\begin{pmatrix} d & -b \\ -c & a \end{pmatrix}` },
{ label: '麦克斯韦方程组', tex: String.raw`\begin{aligned}
abla \cdot \mathbf{E} &= \frac{\rho}{\varepsilon_0} \\
abla \cdot \mathbf{B} &= 0 \\
abla \times \mathbf{E} &= -\frac{\partial \mathbf{B}}{\partial t} \\
abla \times \mathbf{B} &= \mu_0\mathbf{J} + \mu_0\varepsilon_0\frac{\partial \mathbf{E}}{\partial t}
\end{aligned}` },
{ label: '级数', tex: String.raw`\sum_{n=1}^{\infty}\frac{1}{n^2} = \frac{\pi^2}{6}` },
{ label: '化学式', tex: String.raw`\mathrm{2H_2 + O_2 \to 2H_2O}` },
];

const sym = (label: string, tex: string) => ({ label, show: tex, insert: tex });

const PALETTE = [
{
label: '常用结构',
items: [
{ label: '上标', show: String.raw`x^{2}`, insert: String.raw`x^{}` },
{ label: '下标', show: String.raw`x_{i}`, insert: String.raw`x_{}` },
{ label: '分数', show: String.raw`\frac{a}{b}`, insert: String.raw`\frac{}{}` },
{ label: '根号', show: String.raw`\sqrt{x}`, insert: String.raw`\sqrt{}` },
{ label: 'n 次根', show: String.raw`\sqrt[n]{x}`, insert: String.raw`\sqrt[]{}` },
{ label: '求和', show: String.raw`\sum_{i=1}^{n}`, insert: String.raw`\sum_{i=1}^{}` },
{ label: '连乘', show: String.raw`\prod_{i=1}^{n}`, insert: String.raw`\prod_{i=1}^{}` },
{ label: '积分', show: String.raw`\int_{a}^{b}`, insert: String.raw`\int_{}^{}` },
{ label: '二重积分', show: String.raw`\iint_{D}`, insert: String.raw`\iint_{}` },
{ label: '闭合积分', show: String.raw`\oint_{C}`, insert: String.raw`\oint_{}` },
{ label: '极限', show: String.raw`\lim_{x \to \infty}`, insert: String.raw`\lim_{x \to }` },
{ label: '矩阵', show: String.raw`\begin{pmatrix} a & b \\ c & d \end{pmatrix}`, insert: String.raw`\begin{pmatrix} a & b \\ c & d \end{pmatrix}` },
{ label: '行列式', show: String.raw`\begin{vmatrix} a & b \\ c & d \end{vmatrix}`, insert: String.raw`\begin{vmatrix} a & b \\ c & d \end{vmatrix}` },
{ label: '分段函数', show: String.raw`\begin{cases} a & x > 0 \\ b & x \le 0 \end{cases}`, insert: String.raw`\begin{cases} a & x > 0 \\ b & x \le 0 \end{cases}` },
{ label: '向量', show: String.raw`\vec{v}`, insert: String.raw`\vec{}` },
{ label: '帽号', show: String.raw`\hat{x}`, insert: String.raw`\hat{}` },
{ label: '横线', show: String.raw`\bar{x}`, insert: String.raw`\bar{}` },
{ label: '上划线', show: String.raw`\overline{AB}`, insert: String.raw`\overline{}` },
{ label: '下划线', show: String.raw`\underline{x}`, insert: String.raw`\underline{}` },
{ label: '上花括号', show: String.raw`\overbrace{a+b}`, insert: String.raw`\overbrace{}` },
{ label: '组合数', show: String.raw`\binom{n}{k}`, insert: String.raw`\binom{}{}` },
{ label: '括号', show: String.raw`\left( x \right)`, insert: String.raw`\left( \right)` },
{ label: '绝对值', show: String.raw`\left| x \right|`, insert: String.raw`\left| \right|` },
{ label: '范数', show: String.raw`\left\| x \right\|`, insert: String.raw`\left\| \right\|` },
{ label: '角度', show: String.raw`\angle ABC`, insert: String.raw`\angle ` },
{ label: '度数', show: String.raw`90^\circ`, insert: String.raw`^\circ` },
{ label: '文本', show: String.raw`\text{text}`, insert: String.raw`\text{}` },
],
},
{
label: '希腊字母',
items: [
'\\alpha','\\beta','\\gamma','\\delta','\\epsilon','\\varepsilon','\\zeta','\\eta','\\theta','\\vartheta',
'\\iota','\\kappa','\\lambda','\\mu','\\nu','\\xi','\\omicron','\\pi','\\varpi','\\rho','\\varrho',
'\\sigma','\\varsigma','\\tau','\\upsilon','\\phi','\\varphi','\\chi','\\psi','\\omega',
'\\Gamma','\\Delta','\\Theta','\\Lambda','\\Xi','\\Pi','\\Sigma','\\Upsilon','\\Phi','\\Psi','\\Omega',
].map((tex) => sym(tex.replace('\\', ''), tex)),
},
{
label: '运算符与关系',
items: [
'\\pm','\\mp','\\times','\\div','\\cdot','\\ast','\\star','\\circ','\\bullet',
'\\le','\\ge','\\ne','\\approx','\\equiv','\\sim','\\simeq','\\cong','\\propto',
'\\in','\\notin','\\ni','\\subset','\\subseteq','\\supset','\\supseteq',
'\\cup','\\cap','\\setminus','\\emptyset','\\varnothing',
'\\forall','\\exists','\\nexists','\\neg','\\land','\\lor',
'\\oplus','\\otimes','\\odot','\\perp','\\parallel','\\angle','\\triangle','\\square',
'\\partial','\\nabla','\\infty','\\aleph','\\hbar','\\ell','\\Re','\\Im',
].map((tex) => sym(tex.replace('\\', ''), tex)),
},
{
label: '箭头',
items: [
'\\to','\\rightarrow','\\leftarrow','\\leftrightarrow','\\Rightarrow','\\Leftarrow','\\Leftrightarrow',
'\\mapsto','\\longmapsto','\\uparrow','\\downarrow','\\updownarrow','\\Uparrow','\\Downarrow','\\Updownarrow',
'\\longrightarrow','\\longleftarrow','\\longleftrightarrow','\\rightharpoonup','\\rightharpoondown',
'\\rightleftharpoons','\\leadsto','\\nrightarrow','\\nleftarrow',
].map((tex) => sym(tex.replace('\\', ''), tex)),
},
{
label: '函数与字母',
items: [
'\\sin','\\cos','\\tan','\\cot','\\sec','\\csc','\\arcsin','\\arccos','\\arctan',
'\\sinh','\\cosh','\\tanh','\\log','\\ln','\\lg','\\exp','\\lim','\\max','\\min','\\gcd','\\det','\\dim','\\ker','\\deg','\\arg',
'\\mathbb{R}','\\mathbb{N}','\\mathbb{Z}','\\mathbb{Q}','\\mathbb{C}','\\mathcal{L}','\\mathfrak{g}',
'\\mathbf{v}','\\mathrm{d}','\\mathit{x}','\\mathsf{A}','\\mathtt{x}',
].map((tex) => sym(tex.replace('\\', ''), tex)),
},
];

import fontCss from '../../styles/katex-fonts.css?url';

const DEFAULT_TEX = String.raw`\begin{aligned}
\int_{0}^{1} x^2 \,\mathrm{d}x &= \frac{1}{3} \\
e^{i\pi} + 1 &= 0
\end{aligned}`;
---

<Page
title="LaTeX 编辑器"
description="在线输入 LaTeX / TeX 数学公式，使用 KaTeX 实时渲染，并可导出 SVG / PNG。"
active="tools"
>
<link rel="stylesheet" href="/vendor/katex/katex.min.css" />
<!-- 必须排在 katex.min.css 之后：同名 @font-face 与 KaTeX_Main/Math 时后者胜 -->
<link rel="stylesheet" href={fontCss} />
<script is:inline src="/vendor/katex/katex.min.js"></script>
<script is:inline src="/vendor/html-to-image/html-to-image.js"></script>

<div class="tool-head head-split">
<div class="head-title">
<h1>LaTeX 编辑器</h1>
<p class="lede">
输入 TeX 数学公式，右侧用 KaTeX 实时渲染。公式只在本地浏览器中计算，不会上传。
</p>
</div>
<div class="head-tools">
<mdui-chip variant="tonal">
<mdui-icon-check-circle></mdui-icon-check-circle>
本地渲染
</mdui-chip>
</div>
</div>

<div class="latex-layout">
<section class="panel latex-pane">
<div class="row-between panel-head">
<h2 class="block-title">TeX 输入</h2>
<span class="text-xs faint" id="charCount"></span>
</div>

<mdui-text-field
	id="tex"
	variant="outlined"
	rows="8"
	class="latex-input mono"
	spellcheck="false"
	aria-label="LaTeX 输入"
	value={DEFAULT_TEX}
></mdui-text-field>

<div class="row latex-actions">
<mdui-button variant="filled" id="render">重新渲染</mdui-button>
<mdui-button variant="outlined" id="clear">清空</mdui-button>
<mdui-button variant="text" id="copy">复制 TeX</mdui-button>
</div>

<div class="example-strip">
<span class="text-xs faint">示例</span>
<div class="row example-chips" id="examples">
{EXAMPLES.map((e) => (
<mdui-chip class="example-chip" variant="outlined" data-tex={e.tex}>{e.label}</mdui-chip>
))}
</div>
</div>
</section>

<section class="panel latex-pane">
<div class="row-between panel-head">
<h2 class="block-title">渲染结果</h2>
<div class="row result-tools">
<span class="text-xs faint" id="status" role="status"></span>
<mdui-select
	id="mathFont"
	class="math-font-select"
	variant="outlined"
	label="数学字体"
	value="xits"
>
<mdui-menu-item value="xits">XITS（本站默认）</mdui-menu-item>
<mdui-menu-item value="katex">KaTeX_Main</mdui-menu-item>
<mdui-icon-arrow-drop-down slot="end-icon"></mdui-icon-arrow-drop-down>
</mdui-select>
</div>
</div>

<div id="preview" class="latex-preview" aria-live="polite">
<div class="preview-body" id="previewBody"></div>
</div>

<div class="row result-actions">
<mdui-button variant="outlined" id="exportSvg">导出 SVG</mdui-button>
<mdui-button variant="outlined" id="exportPng">导出 PNG</mdui-button>
</div>

<p class="text-xs faint latex-hint">
支持 KaTeX 的 TeX 子集：行内公式也可写成 <code class="mono">$...$</code>；
不要写文档类或 <code class="mono">\usepackage</code>。
</p>
</section>

<section class="panel-lg latex-palette">
<div class="row-between panel-head">
<h2 class="block-title">公式与符号面板</h2>
<span class="text-xs faint palette-hint">
点击插入到光标处；结构类模板含空花括号时，已有选中内容会填入第一个空花括号。
</span>
</div>
<div class="palette-groups">
{PALETTE.map((group) => (
<section class="palette-group">
<h4 class="palette-title">{group.label}</h4>
<div class="palette-grid">
{group.items.map((item) => (
<button
type="button"
class="palette-btn"
data-insert={item.insert}
title={item.label}
aria-label={item.label}
>
<span class="palette-render" data-render={item.show}></span>
</button>
))}
</div>
</section>
))}
</div>
</section>
</div>

<p class="footnote">
KaTeX（MIT）与 html-to-image（MIT）均为第三方开源库，本站本地分发。
许可与溯源详见仓库内 <code class="mono">THIRD_PARTY_NOTICES.md</code>。
</p>
</Page>

<style is:global>
.latex-layout {
display: grid;
gap: 1rem;
margin-top: 1.25rem;
}

.math-font-select {
width: 13rem;
max-width: 100%;
}

@media (min-width: 900px) {
.latex-layout {
grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
}

.latex-palette {
grid-column: 1 / -1;
}
}

.panel-head {
align-items: baseline;
gap: 0.4rem 1rem;
margin-bottom: 0.85rem;
}

.latex-pane {
display: flex;
min-width: 0;
flex-direction: column;
}

.latex-input {
width: 100%;
min-height: 10.5rem;
resize: vertical;
line-height: 1.7;
tab-size: 2;
}

.latex-actions {
gap: 0.5rem;
    margin-top: 0.85rem;
}

.example-strip {
display: flex;
align-items: baseline;
gap: 0.4rem 0.75rem;
flex-wrap: wrap;
margin-top: 1rem;
padding-top: 0.9rem;
border-top: 1px solid rgb(var(--mdui-color-outline-variant));
}

.example-chips {
flex-grow: 1;
gap: 0.4rem;
}

/*
 * 字体选择放在渲染面板标题行：它只影响右侧的渲染结果，
 * 放页头会让人误以为跟整页工具栏有关。
 */
.result-tools {
align-items: center;
gap: 0.4rem 0.5rem;
}

.result-actions {
justify-content: flex-end;
gap: 0.5rem;
margin-top: 0.85rem;
}

.latex-hint {
margin-top: 0.85rem;
}

.latex-preview {
display: flex;
flex: 1 1 auto;
min-height: 15rem;
overflow: auto;
padding: 1.25rem;
border-radius: var(--mdui-shape-corner-medium);
background-color: rgb(var(--mdui-color-surface-container-lowest));
border: 1px solid rgb(var(--mdui-color-outline-variant));
}

/*
 * 居中靠 margin: auto 而不是 justify-content: center：
 * 公式比容器宽时 auto 外边距会算成 0，内容贴着起点且可完整滚动，
 * 用 flex 居中则会把左侧溢出裁掉、滚不回去。
 */
.preview-body {
max-width: 100%;
margin: auto;
}

.latex-empty {
margin: 0;
}

.latex-preview .katex-display {
margin: 0.5rem 0;
}

.latex-preview.is-exporting {
display: inline-block;
width: fit-content;
max-width: 100%;
min-height: 0;
height: auto;
flex: none;
overflow: visible;
text-align: center;
border-color: transparent;
background: transparent;
color: #000;
padding: 0.25rem 0.35rem;
}

.latex-preview.is-exporting .katex,
.latex-preview.is-exporting .katex * {
color: #000 !important;
}

.latex-palette {
margin-top: 0;
}

.palette-groups {
display: grid;
gap: 0.85rem;
grid-template-columns: minmax(0, 1fr);
}

/*
 * 分组列数按 5 组的实际数量给固定档位，不用 auto-fit：
 * auto-fit 在 1024 / 768 这类宽度下会算出 4 列，把第 5 组甩成孤零零的第二行。
 */
@media (min-width: 520px) {
.palette-groups {
grid-template-columns: repeat(2, minmax(0, 1fr));
}
}

@media (min-width: 760px) {
.palette-groups {
grid-template-columns: repeat(3, minmax(0, 1fr));
}
}

@media (min-width: 1120px) {
.palette-groups {
grid-template-columns: repeat(5, minmax(0, 1fr));
}
}

.palette-group {
padding: 0.7rem 0.75rem 0.8rem;
border: 1px solid rgb(var(--mdui-color-outline-variant));
border-radius: var(--mdui-shape-corner-medium);
background-color: rgb(var(--mdui-color-surface-container-lowest));
}

.palette-hint {
max-width: 34rem;
text-align: right;
}

.palette-title {
margin: 0 0 0.55rem;
font-size: var(--mdui-typescale-label-large-size);
font-weight: 500;
color: rgb(var(--mdui-color-primary));
}

.palette-grid {
display: flex;
flex-wrap: wrap;
gap: 0.3rem;
}

.palette-btn {
display: inline-flex;
overflow: hidden;
min-width: 0;
flex: 0 0 auto;
align-items: center;
justify-content: center;
min-height: 2rem;
padding: 0.1rem 0.5rem;
border: 1px solid rgb(var(--mdui-color-outline-variant));
border-radius: var(--mdui-shape-corner-small);
background-color: rgb(var(--mdui-color-surface-container));
color: rgb(var(--mdui-color-on-surface));
cursor: pointer;
font-size: 0.95rem;
transition:
    background-color var(--mdui-motion-duration-short2),
    border-color var(--mdui-motion-duration-short2),
    transform var(--mdui-motion-duration-short2);
}

.palette-btn:hover {
background-color: rgb(var(--mdui-color-surface-container-high));
border-color: rgb(var(--mdui-color-outline));
}

.palette-btn:active {
transform: scale(0.95);
}

.palette-btn:focus-visible {
outline: 2px solid rgb(var(--mdui-color-primary));
outline-offset: 1px;
}

/*
 * overflow 用 visible：KaTeX 的上下标（x_{i}、\int_{a}^{b}）固有宽度比视觉宽度
 * 少 2px，隐藏会把右半边切掉；按钮本身还有 overflow: hidden 兜底。
 */
.palette-render {
display: inline-block;
overflow: visible;
line-height: 1;
white-space: nowrap;
}

.palette-render .katex {
font-size: 0.9em;
}

.example-chip {
cursor: pointer;
}
</style>

<script>
const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
document.getElementById(id) as T;

/*
 * 数学字体切换。
 *
 * 真正的样式在 src/styles/katex-fonts.css —— 它必须排在 katex.min.css 之后，
 * 这里只负责在 <html> 上打 data-katex-font 标记并持久化选择。
 */
const MATH_FONT_KEY = '915p-latex-math-font';

function applyMathFont(key: string): void {
if (key === 'xits') {
document.documentElement.setAttribute('data-katex-font', 'xits');
} else {
document.documentElement.removeAttribute('data-katex-font');
}
}

const mathFont = $<HTMLElement & { value: string }>('mathFont');
{
const saved = localStorage.getItem(MATH_FONT_KEY);
if (saved === 'katex' || saved === 'xits') mathFont.value = saved;
else mathFont.value = 'xits';
applyMathFont(mathFont.value);
}
mathFont.addEventListener('change', () => {
applyMathFont(mathFont.value);
try {
localStorage.setItem(MATH_FONT_KEY, mathFont.value);
} catch {
// 隐私模式下 localStorage 可能不可写，忽略即可
}
});

const tex = $<HTMLTextAreaElement>('tex');
const preview = $('preview');
const previewBody = $('previewBody');
const status = $('status');
const charCount = $('charCount');

type HtmlToImage = {
toSvg: (node: HTMLElement, options?: Record<string, unknown>) => Promise<string>;
toPng: (node: HTMLElement, options?: Record<string, unknown>) => Promise<string>;
};

function renderPalette() {
const katex = (window as unknown as { katex?: { render: Function } }).katex;
if (!katex) {
setTimeout(renderPalette, 60);
return;
}
document.querySelectorAll<HTMLElement>('[data-render]').forEach((el) => {
const source = el.dataset.render;
if (!source) return;
try {
katex.render(source, el, {
displayMode: false,
throwOnError: false,
strict: 'ignore',
output: 'html',
});
} catch {
el.textContent = source;
}
});
}

function render() {
charCount.textContent = `${tex.value.length} 字符`;
const katex = (window as unknown as { katex?: { render: Function } }).katex;
if (!katex) {
status.textContent = 'KaTeX 加载中…';
setTimeout(render, 60);
return;
}
const source = tex.value.trim();
if (!source) {
previewBody.innerHTML = '<p class="muted latex-empty">在左侧输入 TeX 公式后，这里会显示渲染结果。</p>';
status.textContent = '';
return;
}
try {
katex.render(source, previewBody, {
displayMode: true,
throwOnError: false,
strict: 'ignore',
trust: false,
output: 'html',
});
status.textContent = '';
} catch (err) {
previewBody.innerHTML = `<p class="muted latex-empty">渲染失败：${String((err as Error).message ?? err)}</p>`;
status.textContent = '有错误';
}
}

function insertAtCursor(text: string) {
const start = tex.selectionStart;
const end = tex.selectionEnd;
if (start !== end) {
// 有选区时把选区包进第一个空花括号
const wrapped = text.replace('{}', `{${tex.value.slice(start, end)}}`);
tex.setRangeText(wrapped, start, end, 'end');
} else {
tex.setRangeText(text, start, end, 'end');
// 光标移进第一个空花括号，方便直接输入
const empty = text.indexOf('{}');
if (empty >= 0) tex.setSelectionRange(start + empty + 1, start + empty + 1);
}
render();
tex.focus();
}

function download(dataUrl: string, filename: string) {
const a = document.createElement('a');
a.href = dataUrl;
a.download = filename;
document.body.appendChild(a);
a.click();
a.remove();
}

async function exportImage(kind: 'svg' | 'png') {
const hti = (window as unknown as { htmlToImage?: HtmlToImage }).htmlToImage;
if (!hti) {
status.textContent = '导出库加载中…';
return;
}
status.textContent = '导出中…';
preview.classList.add('is-exporting');
try {
const options = {
backgroundColor: kind === 'png' ? '#ffffff' : 'transparent',
pixelRatio: kind === 'png' ? 3 : 2,
cacheBust: true,
style: { border: 'none', background: 'transparent', color: '#000', padding: '0.25rem 0.35rem' },
};
const dataUrl = kind === 'svg' ? await hti.toSvg(preview, options) : await hti.toPng(preview, options);
download(dataUrl, `915p-formula.${kind}`);
status.textContent = '已导出';
setTimeout(() => (status.textContent = ''), 1200);
} catch (err) {
status.textContent = `导出失败：${String((err as Error).message ?? err)}`;
} finally {
preview.classList.remove('is-exporting');
}
}

tex.addEventListener('input', render);
$('render').addEventListener('click', render);
$('clear').addEventListener('click', () => {
tex.value = '';
render();
tex.focus();
});
$('copy').addEventListener('click', async () => {
try {
await navigator.clipboard.writeText(tex.value);
status.textContent = '已复制';
setTimeout(() => (status.textContent = ''), 1200);
} catch {
status.textContent = '复制失败，请手动选择文本';
}
});
$('exportSvg').addEventListener('click', () => void exportImage('svg'));
$('exportPng').addEventListener('click', () => void exportImage('png'));

document.querySelectorAll<HTMLElement>('[data-tex]').forEach((chip) => {
chip.addEventListener('click', () => {
tex.value = chip.dataset.tex ?? '';
render();
tex.focus();
});
});

document.querySelectorAll<HTMLElement>('[data-insert]').forEach((chip) => {
chip.addEventListener('click', () => {
insertAtCursor(chip.dataset.insert ?? '');
});
});

renderPalette();
render();
</script>
