	function readTranscodeOptions(): ops.TranscodeOptions {
		const video = videoSpec();
		const audio = audioSpec();
		const mode = ($('transcodeMode') as SelectEl).value as ops.RateMode;
		const scale = ($('transcodeScale') as SelectEl).value as ops.ResolutionPreset;
		return {
			videoCodec: video.id,
			audioCodec: audio.id,
			container: ($('transcodeContainer') as SelectEl).value as ops.RemuxContainer,
			rateMode: mode,
			crf: Number(($('transcodeCrf') as unknown as TextField).value),
			videoBitrate: Number(($('transcodeVBitrate') as unknown as TextField).value) || undefined,
			audioBitrate: Number(($('transcodeABitrate') as SelectEl).value) || undefined,
			presetId: ($('transcodePreset') as SelectEl).value,
			resolution: scale,
			customWidth: Number(($('transcodeWidth') as unknown as TextField).value) || undefined,
			customHeight: Number(($('transcodeHeight') as unknown as TextField).value) || undefined,
