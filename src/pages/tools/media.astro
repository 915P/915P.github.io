	/* ------------------------------------------------------------ 拼接 */

	function renderConcat(): void {
		const list = $('concatList');
		list.textContent = '';
		concatFiles.forEach((file, index) => {
			const item = document.createElement('li');
			item.className = 'media-item';
			item.draggable = true;

			const order = document.createElement('span');
			order.className = 'media-item-order';
			order.textContent = `${index + 1}.`;

			const name = document.createElement('span');
			name.className = 'media-item-name';
			name.textContent = file.name;

			const size = document.createElement('span');
			size.className = 'media-item-size';
			size.textContent = ops.formatBytes(file.size);

			/*
			 * 图标按钮要**塞子元素** <mdui-icon-xxx>，不能写 icon="xxx" 属性。
			 * mdui-button-icon 的 icon 是 property，lit 组件不把同名 attribute
			 * 映射回 property，结果属性名本身被当成文字渲染出来（显示成 "clo"）。
			 */
			const remove = document.createElement('mdui-button-icon');
			remove.setAttribute('variant', 'standard');
			remove.setAttribute('aria-label', `移除 ${file.name}`);
			remove.title = '移除';
			remove.appendChild(document.createElement('mdui-icon-close'));
			remove.addEventListener('click', () => {
				concatFiles.splice(index, 1);
				renderConcat();
			});

			item.append(order, name, size, remove);

			/*
			 * 拖动排序：原生 HTML5 drag。dragstart 给拖起的行加 .is-dragging，
			 * drop 时按 DOM 位置算出源与目标索引，再改数组顺序后重绘。
			 * 重绘会销毁所有行，所以必须靠 class 找回拖起的是哪一个 ——
			 * 不能提前把索引存到 item.dataset 上，drop 时那个节点已经不在了。
			 */
			item.addEventListener('dragstart', () => item.classList.add('is-dragging'));
			item.addEventListener('dragend', () => item.classList.remove('is-dragging'));
			item.addEventListener('dragover', (event) => event.preventDefault());
			item.addEventListener('drop', (event) => {
				event.preventDefault();
				const dragging = list.querySelector('.is-dragging');
				if (!dragging || dragging === item) return;
				const items = Array.from(list.children);
				const from = items.indexOf(dragging);
				const to = items.indexOf(item);
				if (from < 0 || to < 0) return;
				const [moved] = concatFiles.splice(from, 1);
				concatFiles.splice(to, 0, moved);
				renderConcat();
			});

			list.appendChild(item);
		});
		setDisabled('concatRun', concatFiles.length < 2);
	}

	wirePicker({
		buttonId: 'concatPick',
		dropId: 'concatDrop',
		multiple: true,
		onFiles: (files) => {
			// 同名文件先加序号，否则挂载后互相覆盖
			for (const file of files) {
				let candidate = file;
				let n = 2;
				while (concatFiles.some((f) => f.name === candidate.name)) {
					const dot = file.name.lastIndexOf('.');
					const renamed =
						dot > 0
							? `${file.name.slice(0, dot)}-${n++}${file.name.slice(dot)}`
							: `${file.name}-${n++}`;
					candidate = new File([file], renamed, { type: file.type });
				}
				concatFiles.push(candidate);
			}
			renderConcat();
		},
	});

	/** 只跑 -i 读一遍 banner，拿流信息；ffmpeg 会以「缺输出文件」退出，这是预期的 */
	async function probeOne(instance: FfmpegInstance, name: string): Promise<ops.ProbeResult> {
		let buffer = '';
		const handler = ({ message }: { message: string }) => {
			buffer += message + '\n';
		};
		instance.on('log', handler);
		try {
			await instance.exec(['-i', name]);
		} finally {
			instance.off('log', handler);
		}
		return ops.parseProbeLog(buffer);
	}

	async function onConcatRun(): Promise<void> {
		if (concatFiles.length < 2 || busy) return;
		setBusy(true);
		setDisabled('concatRun', true);
		try {
			const instance = await ensureFfmpeg();
			ops.assertSizeOk(concatFiles);

			let mode = ($('concatMode') as SelectEl).value as 'auto' | 'ts' | 'concat';
			if (mode === 'auto') {
				const allTs = concatFiles.every((f) => ['ts', 'mts', 'm2ts'].includes(ops.extOf(f.name)));
				mode = allTs ? 'ts' : 'concat';
				log(`自动判断拼接方式为 ${mode === 'ts' ? 'TS concat 协议' : 'concat 清单'}`);
			}

			const inputNames = concatFiles.map(mountedName);
			const plan = ops.planConcat(inputNames, {
				mode,
				outputName: ($('concatOutput') as unknown as TextField).value,
			});

			/*
			 * 先逐个探测轨道布局再拼。
			 * concat demuxer 遇到结构不一致的输入**不报错**，而是产出时长错乱的
			 * 文件（实测 3 秒 + 只有音轨的片段 → 20.7 秒），所以必须自己拦。
			 */
			setProgress(0, 0, `检查 ${concatFiles.length} 个片段的编码…`);
			await instance.createDir('/in').catch(() => undefined);
			await instance.mount('WORKERFS', { files: concatFiles }, '/in');
			let infos: ops.ProbeResult[];
			try {
				infos = [];
				for (const name of inputNames) {
					setProgress(0, 0, `检查 ${name} 的编码…`);
					infos.push(await probeOne(instance, `/in/${name}`));
				}
			} finally {
				await instance.unmount('/in').catch(() => undefined);
			}
			ops.assertConcatCompatible(infos);
			log(`各片段编码一致：${infos.map((i) => ops.describeProbe(i)).join(' / ')}`);

			/*
			 * concat demuxer 的清单文件必须写到内存 FS 的根目录：
			 * WORKERFS 是只读挂载，写不进去。
			 *
			 * 清单里的路径按**清单文件所在目录**解析。清单在根目录、
			 * 影片挂在 /in，所以必须写绝对路径 /in/xxx，
			 * 并靠 `-safe 0`（planConcat 已加）允许绝对路径。
			 * 写裸文件名会让 ffmpeg 去根目录找，报 FS error。
			 */
			await instance.deleteFile(ops.CONCAT_LIST).catch(() => undefined);
			if (mode === 'concat') {
				const body = inputNames.map((name) => `file '/in/${name}'`).join('\n');
				await instance.writeFile(ops.CONCAT_LIST, new TextEncoder().encode(body));
			}

			const { output, bytes } = await runPlan(concatFiles, plan.args, plan.output, '拼接');
			download(bytes, output);
			$('concatSummary').textContent = `完成，${ops.formatBytes(bytes.length)}`;
			hideProgress();
		} catch (error) {
			log(describeError(error), 'error');
			$('concatSummary').textContent = describeError(error);
		} finally {
			setBusy(false);
			renderConcat();
		}
	}

	/* ------------------------------------------------------------ 命令 */

	/*
	 * 常用命令模板。$0 会被替换成挂载区里第一个文件的实际名字。
	 * 模板里 $0 外面**不带引号** —— 替换时统一加引号，否则会出现 -i ""x.mp4""
	 * 这种双层引号（虽然 parseCommandLine 能凑巧解析对，但日志里很难看）。
	 */
	const COMMAND_PRESETS: Record<string, string> = {
		remux: '-i $0 -c copy output.mp4',
		hevc: '-i $0 -c copy -tag:v hvc1 output.mp4',
		faststart: '-i $0 -c copy -movflags +faststart output.mp4',
		audio: '-i $0 -vn -c:a copy output.m4a',
		mute: '-i $0 -an -c:v copy output.mp4',
		decrypt: '-decryption_key "" -i $0 -c copy output.mp4',
		scale: '-i $0 -vf scale=-2:720 -c:v libx264 -crf 23 -preset veryfast -c:a copy output.mp4',
		fps: '-i $0 -r 25 -c:v libx264 -crf 23 -preset veryfast -c:a copy output.mp4',
		fpsprobe: '-i $0 -f null -',
		thumbnail: '-i $0 -vf fps=1/10 -q:v 3 frame%03d.jpg',
		waveform: '-i $0 -filter_complex showwavespic=s=1200x240 -frames:v 1 waveform.png',
	};

	function renderCommandFiles(): void {
