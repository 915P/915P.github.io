	async function onTranscodeProbe(): Promise<void> {
		if (busy) return;
		setBusy(true);
		setDisabled('transcodeProbe', true);
		try {
			const instance = await ensureFfmpeg();
			setProgress(0, 0, '正在读取 ffmpeg 的编码器清单…');
			infoBuffer = '';
			instance.on('log', ({ message }) => {
				infoBuffer += message + '\n';
			});
			// 同「文件信息」页：只查询不给输出，ffmpeg 会打印清单后自行退出
			await instance.exec(['-encoders']);
			encoderSet = ops.parseEncoderList(infoBuffer);
			const missing = [
				...ops.videoAvailability(encoderSet),
				...ops.audioAvailability(encoderSet),
			].filter((item) => !item.available);
			initTranscodeForm();
			$('transcodeSummary').textContent = missing.length
				? `核心提供 ${encoderSet.size} 个编码器，其中 ${missing.length} 个本工具用不到`
				: `核心提供 ${encoderSet.size} 个编码器，本工具列出的都可用`;
			log(`编码器探测完成：可用 ${encoderSet.size} 个`);
			hideProgress();
		} catch (error) {
			log(describeError(error), 'error');
			$('transcodeSummary').textContent = describeError(error);
		} finally {
			setBusy(false);
			setDisabled('transcodeProbe', false);
		}
