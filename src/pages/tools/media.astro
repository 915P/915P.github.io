	/** 实时把输入框解析成 argv，给用户看最终会怎么执行 */
	function previewCommand(): void {
		const box = $('commandPreview');
		const text = ($('commandInput') as unknown as TextField).value.trim();
		if (!text) {
			box.setAttribute('hidden', '');
			return;
		}
		const args = ops.stripFfmpegPrefix(ops.parseCommandLine(text));
		box.removeAttribute('hidden');
		$('commandPreviewText').textContent =
			`将执行 ${args.length} 个参数：${args.map((a) => (a.includes(' ') ? `"${a}"` : a)).join(' ')}`;
	}

	async function onCommandRun(): Promise<void> {
		if (!commandFiles.length || busy) return;
		setBusy(true);
		setDisabled('commandRun', true);
		try {
			const text = ($('commandInput') as unknown as TextField).value.trim();
			const args = ops.stripFfmpegPrefix(ops.parseCommandLine(text));
			const output = ops.validateCustomArgs(args);

			/*
			 * `-f null -` 是 ffmpeg 的「丢弃输出」约定，用来只看统计信息。
			 * 这时没有文件可读，跳过下载，统计都在日志里。
			 */
			if (output === '-') {
				const instance = await ensureFfmpeg();
				ops.assertSizeOk(commandFiles);
				setProgress(0, 0, '运行命令…');
				await instance.createDir('/in').catch(() => undefined);
				await instance.mount('WORKERFS', { files: commandFiles }, '/in');
				try {
					await execChecked(instance, qualify(args, new Set(commandFiles.map(mountedName))), '自定义命令');
				} finally {
					await instance.unmount('/in').catch(() => undefined);
				}
				$('commandSummary').textContent = '已执行，该命令不产出文件，结果见日志。';
				hideProgress();
				return;
			}

			const { output: finalName, bytes } = await runPlan(commandFiles, args, output, '运行命令');
			download(bytes, finalName);
			$('commandSummary').textContent = `完成，${ops.formatBytes(bytes.length)}`;
			hideProgress();
		} catch (error) {
			log(describeError(error), 'error');
			$('commandSummary').textContent = describeError(error);
		} finally {
			setBusy(false);
			renderCommandFiles();
		}
	}

	/* ------------------------------------------------------------ 文件信息 */

	wirePicker({
		buttonId: 'infoPick',
		dropId: 'infoDrop',
		multiple: false,
		onFiles: (files) => {
			infoFile = files[0];
			$('infoInfo').textContent = describe(infoFile);
			setDisabled('infoRun', false);
		},
	});

	/** 一行「标签 : 值」 */
	function infoRow(label: string, value: string | number | undefined): HTMLElement | null {
		if (value === undefined || value === '' || value === 'N/A') return null;
		const row = document.createElement('div');
		row.className = 'media-info-row';
		const key = document.createElement('span');
		key.className = 'media-info-key';
		key.textContent = label;
		const val = document.createElement('span');
		val.className = 'media-info-val';
		val.textContent = String(value);
		row.append(key, val);
		return row;
	}

	function infoSection(
		title: string,
		rows: (HTMLElement | null)[],
		...badges: (string | undefined)[]
	): HTMLElement | null {
		const kept = rows.filter((row): row is HTMLElement => row !== null);
		if (!kept.length) return null;
		const section = document.createElement('section');
		section.className = 'media-info-card';
		const head = document.createElement('h3');
		head.className = 'media-info-title';
		const titleText = document.createElement('span');
		titleText.textContent = title;
		head.appendChild(titleText);
		for (const badge of badges) {
			if (!badge) continue;
			const chip = document.createElement('span');
			chip.className = 'media-info-badge';
			chip.textContent = badge;
			head.appendChild(chip);
		}
		section.append(head, ...kept);
		return section;
	}

	const STREAM_LABELS: Record<ops.StreamType, string> = {
		video: '视频',
		audio: '音频',
		subtitle: '字幕',
		data: '数据',
		attachment: '附件',
		unknown: '未知',
	};

	/** 把结构化信息渲染成分组的卡片 */
	function renderMediaInfo(info: ops.MediaInfo): string {
		const host = $('infoOut');
		host.textContent = '';
		const container = info.container;

		const head = infoSection(
			'容器',
			[
				infoRow('格式', ops.formatLabel(info)),
				infoRow('ffmpeg 识别到的格式名', container.formatName),
				infoRow('时长', container.duration),
				infoRow('起始偏移', container.startTime),
				infoRow('总码率', container.bitrate),
				infoRow('轨道数', container.nbStreams ?? (info.streams.length || undefined)),
				// banner 里是挂载点路径 /in/xxx，展示时去掉前缀，只留用户认得的名字
				infoRow('文件名', container.fileName?.replace(/^\/in\//, '')),
				infoRow('ffmpeg', info.version),
			],
		);
		if (head) host.appendChild(head);

		// 容器元数据合成一张卡片，不要一个键一张（四个键就是四张卡，太碎）
		const containerTagRows: (HTMLElement | null)[] = [];
		for (const tagKey of Object.keys(container.tags)) {
			containerTagRows.push(infoRow(tagKey, container.tags[tagKey]));
		}
		const containerTagCard = infoSection('容器元数据', containerTagRows);
		if (containerTagCard) host.appendChild(containerTagCard);

		for (const stream of info.streams) {
			const rows: (HTMLElement | null)[] = [];
			if (stream.type === 'video') {
				rows.push(
					infoRow('编码', stream.codec),
					infoRow('档次', stream.profile),
					infoRow('级别', stream.level),
					infoRow('容器标签', stream.tag),
					infoRow('分辨率', stream.width && stream.height ? `${stream.width}×${stream.height}` : undefined),
					infoRow('像素格式', stream.pixelFormat),
					infoRow('帧率', stream.fps),
					infoRow('扫描方式', stream.fieldOrder),
					infoRow('显示宽高比', stream.dar),
					infoRow('采样宽高比', stream.sar),
					infoRow('色域范围', stream.colorRange),
					infoRow('色彩空间', stream.colorSpace),
					infoRow('色度 primaries', stream.colorPrimaries),
					infoRow('传输特性', stream.colorTransfer),
					infoRow('码率', stream.bitrate),
					infoRow('真实帧率', stream.tbr),
					infoRow('时基', stream.tbn),
				);
			} else if (stream.type === 'audio') {
				rows.push(
					infoRow('编码', stream.codec),
					infoRow('档次', stream.profile),
					infoRow('容器标签', stream.tag),
					infoRow('采样率', stream.sampleRate ? `${stream.sampleRate} Hz` : undefined),
					infoRow('声道', stream.channels),
					infoRow('声道布局', stream.channelLayout),
					infoRow('采样格式', stream.sampleFormat),
					infoRow('码率', stream.bitrate),
				);
			} else {
				rows.push(infoRow('编码', stream.codec), infoRow('容器标签', stream.tag), infoRow('码率', stream.bitrate));
			}
			rows.push(
				infoRow('轨道编号', stream.id),
				infoRow('内部 ID', stream.hexId),
				infoRow('语言', stream.language),
				infoRow('默认/标志', stream.disposition?.join('、')),
			);
			for (const tagKey of Object.keys(stream.tags)) {
				rows.push(infoRow(tagKey, stream.tags[tagKey]));
			}
			const card = infoSection(`轨道 ${stream.id}`, rows, STREAM_LABELS[stream.type], stream.codec);
			if (card) host.appendChild(card);
		}

		if (!host.children.length) {
			host.textContent = 'ffmpeg 没有输出可解析的信息，文件可能已损坏或格式不受支持。';
		}

		// 复制用纯文本，键值对齐
		return [...host.querySelectorAll('.media-info-card')]
			.map((card) => {
				const title = card.querySelector('.media-info-title')?.textContent ?? '';
				const lines = [...card.querySelectorAll('.media-info-row')].map((row) => {
					const key = row.querySelector('.media-info-key')?.textContent ?? '';
					const val = row.querySelector('.media-info-val')?.textContent ?? '';
					return `  ${key.padEnd(10, '　')} ${val}`;
				});
				return [title, ...lines].join('\n');
			})
			.join('\n\n');
	}

	async function onInfoRun(): Promise<void> {
		if (!infoFile || busy) return;
		setBusy(true);
		setDisabled('infoRun', true);
		try {
			const instance = await ensureFfmpeg();
			ops.assertSizeOk([infoFile]);
			setProgress(0, 0, '读取文件信息…');
			infoBuffer = '';
			instance.on('log', ({ message }) => {
				infoBuffer += message + '\n';
			});

			await instance.createDir('/in').catch(() => undefined);
			await instance.mount('WORKERFS', { files: [infoFile] }, '/in');
			try {
				/*
				 * 只给 -i 不给输出：ffmpeg 读完输入的 banner 后会以
				 * "At least one output file must be specified" 退出（返回码非 0），
				 * 这正是我们要的 —— 它已经把流信息全打在日志里了。
				 */
				await instance.exec(['-i', `/in/${mountedName(infoFile)}`]);
			} finally {
				await instance.unmount('/in').catch(() => undefined);
			}

			const parsed = ops.parseMediaInfo(infoBuffer);
			infoText = renderMediaInfo(parsed);
			$('infoRaw').textContent = infoBuffer.trim();
			setDisabled('infoCopy', false);
			setDisabled('infoRawToggle', false);
			$('infoSummary').textContent = ops.describeMediaInfo(parsed);
			log(`读取完成：${ops.describeMediaInfo(parsed)}（${parsed.streams.length} 条轨道）`);
			hideProgress();
		} catch (error) {
			log(describeError(error), 'error');
			$('infoSummary').textContent = describeError(error);
		} finally {
			setBusy(false);
			setDisabled('infoRun', false);
		}
	}

	/* ------------------------------------------------------------ 杂项 */

	function download(bytes: Uint8Array, filename: string, type = 'application/octet-stream'): void {
		const blob = new Blob([bytes as BlobPart], { type });
		const url = URL.createObjectURL(blob);
		const a = document.createElement('a');
		a.href = url;
		a.download = filename;
		document.body.appendChild(a);
		a.click();
		a.remove();
		setTimeout(() => URL.revokeObjectURL(url), 4000);
	}

	// 初始化
	fillContainers();
	initTranscodeForm();
	updateRemuxHint();
	renderConcat();
	renderCommandFiles();
	renderFormatList();

	for (const id of [
		'remuxRun', 'extractRun', 'trimRun', 'splitRun',
		'mergeRun', 'subtitleRun', 'concatRun', 'commandRun', 'infoRun',
		'transcodeRun',
	]) setDisabled(id, true);

	// 字幕模式切换时才显示外挂字幕的选择行
	function syncSubtitleRow(): void {
		const mux = ($('subtitleMode') as SelectEl).value === 'mux';
		$('subtitleFileRow').toggleAttribute('hidden', !mux);
	}
	syncSubtitleRow();
	$('subtitleMode').addEventListener('change', syncSubtitleRow);

	$('remuxContainer').addEventListener('change', updateRemuxHint);
	for (const id of ['transcodeVideo', 'transcodeAudio', 'transcodeMode', 'transcodeScale']) {
		$(id).addEventListener('change', syncTranscodeForm);
	}
	$('transcodeRun').addEventListener('click', () => void onTranscodeRun());
	$('transcodeProbe').addEventListener('click', () => void onTranscodeProbe());
	$('remuxRun').addEventListener('click', () => void onRemuxRun());
	$('extractRun').addEventListener('click', () => void onExtractRun());
	$('trimRun').addEventListener('click', () => void onTrimRun());
	$('splitRun').addEventListener('click', () => void onSplitRun());
	$('mergeRun').addEventListener('click', () => void onMergeRun());
	$('subtitleRun').addEventListener('click', () => void onSubtitleRun());
	$('concatRun').addEventListener('click', () => void onConcatRun());
	$('commandRun').addEventListener('click', () => void onCommandRun());
	$('infoRun').addEventListener('click', () => void onInfoRun());
	$('concatClear').addEventListener('click', () => {
		concatFiles = [];
		renderConcat();
	});
	$('infoCopy').addEventListener('click', async () => {
		if (!infoText) return;
		await navigator.clipboard.writeText(infoText);
		toast('信息已复制到剪贴板');
	});
	$('infoRawToggle').addEventListener('click', () => {
		const raw = $('infoRaw');
		const willShow = raw.hasAttribute('hidden');
		raw.toggleAttribute('hidden', !willShow);
		$('infoRawToggle').textContent = willShow ? '隐藏原始输出' : '显示原始输出';
	});
	$('commandFill').addEventListener('click', fillPreset);
	$('commandInput').addEventListener('input', previewCommand);
	$('logClear').addEventListener('click', () => {
		logBox.textContent = '';
	});

	/*
	 * 停止：ffmpeg 跑进 wasm 后没有可中断的单条命令，只能 terminate 整个
	 * worker 再 load 一次（要重新编译 wasm，约十几秒）。
	 * terminate 会把挂载也一起清掉，所以这里只置 busy=false 让 UI 恢复，
	 * 具体的重新加载交给下一次 ensureFfmpeg()（它判 loaded 为 false 会重来）。
	 */
	$('stopRun').addEventListener('click', async () => {
		if (!busy) return;
		setDisabled('stopRun', true);
		log('已请求停止，正在终止 ffmpeg…', 'warn');
		try {
			ffmpeg?.terminate();
			ffmpeg = null;
			log('ffmpeg 已终止，下次运行会重新初始化（约十几秒）。', 'warn');
		} catch (error) {
			log(describeError(error), 'error');
		} finally {
			setBusy(false);
			hideProgress();
		}
	});

	$('preloadBtn').addEventListener('click', async () => {
		setDisabled('preloadBtn', true);
		try {
			await ensureFfmpeg();
			setProgress(1, 1, `ffmpeg 已就绪（约 ${Math.round(CORE_WASM_BYTES / 1024 / 1024)} MB 已缓存）`);
		} catch (error) {
			log(describeError(error), 'error');
			setDisabled('preloadBtn', false);
		}
	});
	$('clearCacheBtn').addEventListener('click', async () => {
		await clearMediaCache();
		log('已清除 ffmpeg 本地缓存，下次使用会重新下载约 32 MB。', 'warn');
		// 缓存没了，把「首次需下载」的告知块放回来
		$('coreNotice').removeAttribute('hidden');
		setDisabled('preloadBtn', false);
	});

	/*
	 * 缓存已经热了就把 32 MB 告知块收起来。
	 * isCoreCached() 只读 IndexedDB 的两个 key，不碰 blob 本体，毫秒级返回。
	 * 注意要在 mdui 组件定义完成后再改 hidden，否则属性会被组件重置。
	 */
	void isCoreCached().then((cached) => {
		if (cached) {
			$('coreNotice').setAttribute('hidden', '');
			log('检测到本地已有 ffmpeg 核心缓存，无需重新下载。');
		}
	});
</script>
