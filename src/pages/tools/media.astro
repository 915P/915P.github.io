<script>
	import * as ops from '../../lib/media-ops';
	import {
		CORE_WASM_BYTES,
		clearMediaCache,
		isCoreCached,
		loadFfmpeg,
		mediaLoadInfo,
		type FfmpegInstance,
	} from '../../lib/media-loader';

	const $ =<T extends HTMLElement = HTMLElement>(id: string): T => {
		const el = document.getElementById(id);
		if (!el) throw new Error(`缺少元素 #${id}`);
		return el as T;
	};
	type TextField = HTMLInputElement & { value: string };
	type SelectEl = HTMLElement & { value: string };

	/* ------------------------------------------------------------ 进度条 */

	const panel = $('progressPanel');
	const bar = $('progressBar') as HTMLElement & { value: number };
	const text = $('progressText');
	const percent = $('progressPercent');

	function showProgress(): void {
		panel.removeAttribute('hidden');
	}
	function hideProgress(): void {
		panel.setAttribute('hidden', '');
	}
	function setProgress(loaded: number, total: number, label: string): void {
		showProgress();
		text.textContent = label;
		if (total > 0) {
			// 钳一下：CDN 的 content-length 是压缩后大小，可能小于实际读到的字节
			const ratio = Math.max(0, Math.min(1, loaded / total));
			bar.value = ratio;
			percent.textContent = `${Math.round(ratio * 100)}%`;
			bar.removeAttribute('indeterminate');
		} else {
			// 拿不到 Content-Length 或 wasm 编译阶段：退化成不确定进度
			bar.value = 0;
			bar.setAttribute('indeterminate', '');
			percent.textContent = '';
		}
	}
	function fromLoader(loaded: number, total: number, label: string): void {
		setProgress(loaded, total, label);
	}

	/* ------------------------------------------------------------ 日志 */

	const logBox = $('log');

	/** 短暂提示，用 mdui 的 snackbar（与 pdf 页同一套写法） */
	function toast(message: string): void {
		const mdui = (window as unknown as { mdui?: { snackbar?: (o: { message: string }) => void } }).mdui;
		mdui?.snackbar?.({ message });
	}

	function log(text: string, level: 'info' | 'warn' | 'error' = 'info'): void {
		const line = document.createElement('div');
		if (level !== 'info') line.className = `media-log-${level}`;
		line.textContent = text;
		logBox.appendChild(line);
		logBox.scrollTop = logBox.scrollHeight;
	}

	/* ------------------------------------------------------------ 文件 */

	let remuxFile: File | null = null;
	let extractFile: File | null = null;
	let trimFile: File | null = null;
	let splitFile: File | null = null;
	let mergeVideoFile: File | null = null;
	let mergeAudioFile: File | null = null;
	let subtitleFile: File | null = null;
	let subtitleSidecar: File | null = null;
	let infoFile: File | null = null;
	let concatFiles: File[] = [];
	let commandFiles: File[] = [];

	const mountedName = (file: File) => ops.sanitizeName(file.name);

	function describe(file: File): string {
		const kind = ops.sniffMediaKind(file.name);
		if (kind === 'unknown') {
			// 不拦，但要说一句，否则用户看到「未知类型」却不知道下一步做什么
			return `${file.name} · ${ops.unknownKindHint(file.name)} · ${ops.formatBytes(file.size)}`;
		}
		const label = kind === 'video' ? '视频' : kind === 'audio' ? '音频' : '图片';
		return `${file.name} · ${label} · ${ops.formatBytes(file.size)}`;
	}

	/**
	 * 文件选择器：按钮 + 虚线拖放区。
	 * 不用 <mdui-text-field type="file"> —— 它在 change 里把 value 置空，
	 * 且内部原生控件与 outlined 标签叠在一起（PDF 页踩过，见 AGENT.md）。
	 *
	 * accept 只影响原生对话框。拖放与程序注入一律照收：
	 * 白名单只是「可见性」不是「准入」，漏一个扩展名的代价是用户在对话框里
	 * 根本找不到那个文件，而 ffmpeg 其实支持（.m4s 就吃过这个亏）。
	 */
	function wirePicker(opts: {
		buttonId: string;
		dropId: string;
		multiple: boolean;
		accept?: string;
		/** 只接受这一类文件（如字幕页的外挂字幕）；不匹配时给出提示但不拦 */
		only?: (file: File) => boolean;
		onlyLabel?: string;
		onFiles: (files: File[]) => void;
	}): void {
		const drop = $(opts.dropId);
		const input = document.createElement('input');
		input.type = 'file';
		input.multiple = opts.multiple;
		input.accept = opts.accept ?? ops.MEDIA_ACCEPT;
		input.style.display = 'none';
		input.dataset.picker = opts.dropId;
		document.body.appendChild(input);

		const accept = (files: File[]): File[] => {
			if (!opts.only) return files;
			const ok = files.filter(opts.only);
			const bad = files.filter((f) => !opts.only?.(f));
			if (bad.length) {
				toast(`已跳过 ${bad.map((f) => f.name).join('、')}：这里只接受${opts.onlyLabel ?? '该类文件'}`);
			}
			return ok;
		};

		$(opts.buttonId).addEventListener('click', () => input.click());
		input.addEventListener('change', () => {
			const files = accept(Array.from(input.files ?? []));
			input.value = '';
			if (files.length) opts.onFiles(files);
		});

		for (const type of ['dragenter', 'dragover']) {
			drop.addEventListener(type, (event) => {
				event.preventDefault();
				drop.classList.add('is-over');
			});
		}
		for (const type of ['dragleave', 'dragend']) {
			drop.addEventListener(type, () => drop.classList.remove('is-over'));
		}
		drop.addEventListener('drop', (event) => {
			event.preventDefault();
			drop.classList.remove('is-over');
			const files = accept(Array.from(event.dataTransfer?.files ?? []));
			if (files.length) opts.onFiles(files);
		});
	}

	/** 界面上列出支持范围，让用户不用猜 */
	function renderFormatList(): void {
		const host = $('formatList');
		host.textContent = '';
		for (const group of ops.SUPPORTED_FORMATS) {
			const block = document.createElement('div');
			block.className = 'media-formats-group';
			const title = document.createElement('div');
			title.className = 'media-formats-label';
			title.textContent = `${group.label}（${group.exts.length}）`;
			const list = document.createElement('div');
			list.className = 'media-formats-exts';
			list.textContent = group.exts.map((ext) => '.' + ext).join('  ');
			block.append(title, list);
			host.appendChild(block);
		}
	}

	/* ------------------------------------------------------------ ffmpeg */

	let ffmpeg: FfmpegInstance | null = null;
	let infoBuffer = '';
	let infoText = '';
	let busy = false;

	function describeError(error: unknown): string {
		const message = String((error as Error)?.message ?? error);
		if (message.includes('codec not currently supported in container')) {
			return '目标容器容不下这个编码格式。请换一个容器，或用「提取」标签页只取需要的轨道。';
		}
		if (message.includes('Invalid data found')) return '无法识别的媒体文件，可能已损坏或格式不受支持。';
		if (message.includes('No such file')) return '文件读取失败，请重新选择。';
		if (message.includes('out of memory') || message.includes('OOM')) {
			return '内存不足，请处理更小的文件或先裁短。';
		}
		return message;
	}

	/**
	 * 标记当前实例已废，下一次调用会重新加载。
	 *
	 * wasm 实例一旦踩到 OOM 或崩在编码器里（实测 x265 就会），
	 * 它的线性内存就处于不确定状态，之后每次 exec 都抛
	 * "memory access out of bounds"。不丢掉它的话，用户刷新之前
	 * 这个工具就彻底废了 —— 而且报错信息完全指不到真正原因。
	 * 丢掉重下一次（核心走 IndexedDB 缓存，不会重新下载 32 MB）就好了。
	 */
	function markInstanceBroken(): void {
		if (ffmpeg?.loaded) log('ffmpeg 实例已损坏，将重新加载后再试一次。', 'warn');
		ffmpeg = null;
	}

	async function ensureFfmpeg(): Promise<FfmpegInstance> {
		if (ffmpeg?.loaded) return ffmpeg;
		setProgress(0, 0, '正在准备 ffmpeg…');
		ffmpeg = await loadFfmpeg(fromLoader);
		const info = mediaLoadInfo();
		log(
			info.cached
				? `ffmpeg 已就绪（使用本地缓存，来源 ${info.base}）`
				: `ffmpeg 已就绪（本次从 ${info.base} 下载了约 32 MB，已缓存）`,
		);
		// 32 MB 告知块到此为止没用了，收起来把版面让给工具本身
		$('coreNotice').setAttribute('hidden', '');
		setDisabled('preloadBtn', true);
		return ffmpeg;
	}

	/** 跑长任务时显示停止条；空闲时收起 */
	function setBusy(value: boolean): void {
		busy = value;
		$('stopBar').toggleAttribute('hidden', !value);
		setDisabled('stopRun', !value);
	}

	function setDisabled(id: string, disabled: boolean): void {
		($(id) as HTMLElement & { disabled: boolean }).disabled = disabled;
	}

	/*
	 * 把命令里的裸文件名换成挂载点路径。
	 * 纯函数，media-ops 拼的是裸名（便于测试与日志可读），
	 * 真正 exec 前统一在这里加 /in/ 前缀。
	 */
	function qualify(args: string[], names: Set<string>): string[] {
		return args.map((arg) => {
			if (arg === ops.CONCAT_LIST) return ops.CONCAT_LIST;
			if (arg.startsWith('concat:')) {
				const parts = arg.slice(7).split('|');
				return `concat:${parts.map((p) => `/in/${names.has(p) ? p : ops.sanitizeName(p)}`).join('|')}`;
			}
			if (names.has(arg)) return `/in/${arg}`;
			return arg;
		});
	}

	/**
	 * 执行一条 ffmpeg 命令，非零退出码当作失败抛出来。
	 *
	 * ffmpeg.wasm 的 exec() 只在「完全跑不起来」时 reject。ffmpeg 自己报错
	 * （编码器不存在、容器容不下、编码中途失败）时它**照常 resolve**，
	 * 只把退出码放进返回值 —— 之前所有调用点都忽略了这个返回值。
	 *
	 * 实测过的后果：Theora 装进 WebM 时 ffmpeg 打了 "Conversion failed!"
	 * 并以非 0 退出，页面却把写了一半的 264 字节空壳当成成品下载给了用户，
	 * 还显示「完成」。所以退出码必须查。
	 *
	 * 注意有两处**故意**期待非零退出，不要走这个包装：
	 * 「文件信息」页的 -i（读完 banner 就报错退出）和压制页的 -encoders。
	 */
	async function execChecked(
		instance: FfmpegInstance,
		args: string[],
		label: string,
	): Promise<void> {
		const code = await instance.exec(args);
		if (code === 0) return;
		// 日志尾部一般就是 ffmpeg 真正的报错，取最后几行带上
		const tail = infoBuffer
			.split('\n')
			.map((line) => line.trim())
			.filter(Boolean)
			.slice(-3)
			.join(' / ');
		markInstanceBroken();
		throw new Error(`${label}失败（ffmpeg 退出码 ${code}）${tail ? '：' + tail : ''}`);
	}

	/**
	 * 挂载文件并跑一条命令，返回产出的字节。
	 *
	 * 用 WORKERFS 而非 writeFile：WORKERFS 是零拷贝代理，文件字节不进
	 * wasm 的虚拟内存，否则大文件直接 OOM。
	 *
	 * beforeRun 用于在 exec 前往内存 FS 写文件（如 concat 清单）。
	 */
	/**
	 * 挂载并执行，返回 { output, bytes }。
	 *
	 * output 是「期望的名字」，实际可能因为重名被改（见下面 safeOutputName），
	 * 所以**必须用返回的 output 去下载**，不要用传进来的那个。
	 */
	async function runPlan(
		files: File[],
		args: string[],
		output: string,
		label: string,
		beforeRun?: (instance: FfmpegInstance) => Promise<void>,
	): Promise<{ output: string; bytes: Uint8Array }> {
		const instance = await ensureFfmpeg();
		ops.assertSizeOk(files);
		setProgress(0, 0, `${label}…`);
		infoBuffer = '';

		/*
		 * WORKERFS 是**只读**挂载，输出名撞上输入名会让 Emscripten 抛
		 * `ErrnoError: FS error`。而「输入去扩展名 + 目标扩展名」这个默认输出名
		 * 在同容器转换时必然撞车（`sample.mp4` 转 mp4 → `sample.mp4`），
		 * 偏偏「转 mp4 / 修正视频」是最常用的操作。所以这里统一兜住。
		 */
		const names = new Set(files.map(mountedName));
		const finalOutput = ops.safeOutputName(output, [...names]);
		if (finalOutput !== output) {
			const lastIndex = args.length - 1;
			if (args[lastIndex] === output) args[lastIndex] = finalOutput;
			log(`输出名与输入文件重名，已改为 ${finalOutput}`);
		}

		instance.on('log', ({ message }) => {
			infoBuffer += message + '\n';
			log(message, /error|Error|Invalid/.test(message) ? 'error' : 'info');
			// ffmpeg 的进度行含 frame= 与 time=，用它做不确定态进度
			if (/frame=|time=/.test(message)) {
				setProgress(0, 0, `${label}… ${message.trim()}`);
			}
		});

		await instance.createDir('/in').catch(() => undefined);
		await instance.mount('WORKERFS', { files }, '/in');
		try {
			await beforeRun?.(instance);
			try {
				await execChecked(instance, qualify(args, names), label);
			} catch (error) {
				// wasm 崩了（RuntimeError: memory access out of bounds）时 exec 是 reject 而非 resolve，
				// 这条路径不会经过 execChecked 里的 markInstanceBroken，所以在这里兜住。
				// 按 name 判而不是 instanceof：RuntimeError 不是 TS 认识的全局名。
				if ((error as Error)?.name === 'RuntimeError') markInstanceBroken();
				throw error;
			}
			setProgress(0, 0, `${label}完成，正在读回结果…`);
			const data = await instance.readFile(finalOutput);
			if (!(data instanceof Uint8Array) || data.length === 0) {
				throw new Error('ffmpeg 没有产出文件，请查看日志。');
			}
			return { output: finalOutput, bytes: data };
		} finally {
			await instance.unmount('/in').catch(() => undefined);
			// concat 清单写在内存 FS 的根目录，卸载后仍要清掉
			await instance.deleteFile(ops.CONCAT_LIST).catch(() => undefined);
		}
	}

	/**
	 * 跑多条命令（共享一次挂载），返回每条的产物。
	 * 剪切（切两段）用的是这条路径。
	 */
	async function runSteps(
		files: File[],
		steps: { args: string[]; output: string }[],
		label: string,
	): Promise<{ output: string; bytes: Uint8Array }[]> {
		const instance = await ensureFfmpeg();
		ops.assertSizeOk(files);
		setProgress(0, 0, `${label}…`);
		infoBuffer = '';
		instance.on('log', ({ message }) => {
			infoBuffer += message + '\n';
			log(message, /error|Error|Invalid/.test(message) ? 'error' : 'info');
			if (/frame=|time=/.test(message)) setProgress(0, 0, `${label}… ${message.trim()}`);
		});

		const names = new Set(files.map(mountedName));
		await instance.createDir('/in').catch(() => undefined);
		await instance.mount('WORKERFS', { files }, '/in');
		const results: { output: string; bytes: Uint8Array }[] = [];
		try {
			for (const [index, step] of steps.entries()) {
				setProgress(index, steps.length, `${label}（第 ${index + 1} / ${steps.length} 步）`);
				// 同样要避开与输入重名的输出名（只读挂载）
				const finalOutput = ops.safeOutputName(step.output, [...names, ...results.map((r) => r.output)]);
				if (finalOutput !== step.output) {
					const lastIndex = step.args.length - 1;
					if (step.args[lastIndex] === step.output) step.args[lastIndex] = finalOutput;
				}
				try {
					await execChecked(instance, qualify(step.args, names), label);
				} catch (error) {
					if ((error as Error)?.name === 'RuntimeError') markInstanceBroken();
					throw error;
				}
				const bytes = await instance.readFile(finalOutput);
				if (!(bytes instanceof Uint8Array) || bytes.length === 0) {
					throw new Error(`ffmpeg 没有产出 ${finalOutput}，请查看日志。`);
				}
				results.push({ output: finalOutput, bytes });
			}
		} finally {
			await instance.unmount('/in').catch(() => undefined);
		}
		return results;
	}

	/* ------------------------------------------------------------ 改格式 */

	function fillContainers(): void {
		const select = $('remuxContainer') as SelectEl;
		for (const key of Object.keys(ops.CONTAINERS) as ops.RemuxContainer[]) {
			const spec = ops.CONTAINERS[key];
			const item = document.createElement('mdui-menu-item');
			item.setAttribute('value', key);
			item.textContent = `${spec.label} — ${spec.hint}`;
			select.appendChild(item);
		}
	}

	function updateRemuxHint(): void {
		const container = ($('remuxContainer') as SelectEl).value as ops.RemuxContainer;
		const spec = ops.CONTAINERS[container];
		const quality = ($('remuxQuality') as SelectEl).value;
		const notes: string[] = [];
		notes.push(`输出 ${spec?.ext ?? '?'}，只换封装不动编码。`);
		if (quality === 'hevc' || quality === 'both') notes.push('HEVC 会补上 hvc1 标签以便 Apple 生态播放。');
		if (quality === 'faststart' || quality === 'both') notes.push('MP4 索引前置后可边下边播。');
		if (container === 'mp3' || container === 'wav' || container === 'flac') {
			notes.push('MP3 / WAV / FLAC 与常见视频里的 AAC、Vorbis 编码不同，直接复制会失败，请改用 M4A 或 OGG。');
		}
		$('remuxHint').textContent = notes.join(' ');
	}

	wirePicker({
		buttonId: 'remuxPick',
		dropId: 'remuxDrop',
		multiple: false,
		onFiles: (files) => {
			remuxFile = files[0];
			$('remuxInfo').textContent = describe(remuxFile);
			setDisabled('remuxRun', false);
		},
	});

	async function onRemuxRun(): Promise<void> {
		if (!remuxFile || busy) return;
		setBusy(true);
		setDisabled('remuxRun', true);
		try {
			const quality = ($('remuxQuality') as SelectEl).value;
			const plan = ops.planRemux(mountedName(remuxFile), {
				container: ($('remuxContainer') as SelectEl).value as ops.RemuxContainer,
				fixHevcTag: quality === 'hevc' || quality === 'both',
				fastStart: quality === 'faststart' || quality === 'both',
			});
			const { output, bytes } = await runPlan([remuxFile], plan.args, plan.output, '改格式');
			download(bytes, output);
			$('remuxSummary').textContent = `完成，${ops.formatBytes(bytes.length)}`;
			hideProgress();
		} catch (error) {
			log(describeError(error), 'error');
			$('remuxSummary').textContent = describeError(error);
		} finally {
			setBusy(false);
			setDisabled('remuxRun', false);
		}
	}

	/* ------------------------------------------------------------ 压制 */

	let transcodeFile: File | null = null;
	/** 运行时探测到的编码器清单；null 表示还没探测过 */
	let encoderSet: Set<string> | null = null;

	/** 用一组 {value,label,disabled} 重填 mdui-select */
	function fillSelect(id: string, items: { value: string; label: string; disabled?: boolean }[], keep?: string): void {
		const select = $(id) as SelectEl;
		select.textContent = '';
		for (const item of items) {
			const node = document.createElement('mdui-menu-item');
			node.setAttribute('value', item.value);
			if (item.disabled) node.setAttribute('disabled', '');
			node.textContent = item.label;
			select.appendChild(node);
		}
		if (keep && items.some((item) => item.value === keep)) select.value = keep;
	}

	function scaleValue(): ops.ResolutionPreset {
		return ($('transcodeScale') as SelectEl).value as ops.ResolutionPreset;
	}

	function videoSpec(): ops.VideoCodecSpec {
		const id = ($('transcodeVideo') as SelectEl).value as ops.VideoCodecId;
		return ops.VIDEO_CODECS.find((c) => c.id === id) ?? ops.VIDEO_CODECS[0];
	}

	function audioSpec(): ops.AudioCodecSpec {
		const id = ($('transcodeAudio') as SelectEl).value as ops.AudioCodecId;
		return ops.AUDIO_CODECS.find((c) => c.id === id) ?? ops.AUDIO_CODECS[0];
	}

	/** 探测过之后，把核心里没有的编码器标成不可选 */
	function disabledByProbe(id: string): boolean {
		if (!encoderSet) return false;
		return id === 'copy' || id === 'none' ? false : !encoderSet.has(id);
	}

	function initTranscodeForm(): void {
		$('transcodeWarn').textContent = ops.GRID_NOTE;

		fillSelect(
			'transcodeVideo',
			ops.VIDEO_CODECS.map((spec) => ({
				value: spec.id,
				label: spec.label,
				disabled: disabledByProbe(spec.encoder),
			})),
			'x264',
		);
		fillSelect(
			'transcodeAudio',
			ops.AUDIO_CODECS.map((spec) => ({
				value: spec.id,
				label: spec.label,
				disabled: disabledByProbe(spec.encoder),
			})),
			'aac',
		);
		fillSelect(
			'transcodeScale',
			(Object.keys(ops.RESOLUTION_LABELS) as ops.ResolutionPreset[]).map((key) => ({
				value: key,
				label: ops.RESOLUTION_LABELS[key],
			})),
			'source',
		);
		syncTranscodeForm();
	}

	/**
	 * 三个下拉互相牵制，逻辑集中在这里：
	 * 换编码 → 重建容器候选、速度档位、质量值区间、音轨码率；
	 * 换模式 → 质量值与目标码率二选一；换分辨率 → 自定义宽高只在 custom 时出现。
	 */
	function syncTranscodeForm(): void {
		const video = videoSpec();
		const audio = audioSpec();

		// 容器：只留装得下当前组合的，并尽量保住用户已经选的那个
		const current = ($('transcodeContainer') as SelectEl).value;
		const containers = ops.containersFor(video.id, audio.id);
		fillSelect(
			'transcodeContainer',
			containers.map((key) => ({ value: key, label: ops.CONTAINERS[key].label })),
			containers.includes(current as ops.RemuxContainer) ? current : undefined,
		);

		// 速度档位跟着视频编码走（x264 是 -preset，VP9 是 -deadline，Theora 没有）
		const speedValue = ($('transcodePreset') as SelectEl).value;
		fillSelect(
			'transcodePreset',
			video.presets.map((preset) => ({ value: preset.id, label: preset.label })),
			video.presets.some((p) => p.id === speedValue) ? speedValue : video.presetDefault,
		);

		// 质量值区间随编码器变，写进 input 的 min/max 让浏览器先拦一道
		const mode = ($('transcodeMode') as SelectEl).value as ops.RateMode;
		const crfField = $('transcodeCrf') as unknown as TextField;
		$('transcodeVBitrate').toggleAttribute('hidden', mode !== 'bitrate');
		$('transcodeCrf').toggleAttribute('hidden', mode !== 'crf');
		// 码率模式预填一个跟分辨率匹配的默认值，别丢给用户一个空框
		const bitrateField = $('transcodeVBitrate') as unknown as TextField;
		if (!bitrateField.value) {
			bitrateField.value = String(ops.defaultVideoBitrate(scaleValue()));
		}
		if (video.id === 'copy') {
			// 不重编码视频时质量/码率/速度都没有意义，藏起来免得误导
			$('transcodeCrf').toggleAttribute('hidden', true);
			$('transcodeVBitrate').toggleAttribute('hidden', true);
			$('transcodePreset').toggleAttribute('hidden', true);
		} else {
			$('transcodePreset').toggleAttribute('hidden', false);
		}
		if (mode === 'crf' && video.id !== 'copy') {
			crfField.min = String(video.crf[0]);
			crfField.max = String(video.crf[1]);
			const label = video.id === 'theora' ? '质量值（-qscale，越小越好）' : '质量值（CRF，越小越好）';
			crfField.setAttribute('label', label);
			if (!crfField.value || !video.crf.includes(Number(crfField.value))) {
				crfField.value = String(video.crfDefault);
			}
		}

		// 音轨码率：每个编码器的合法档位不同，用下拉而不是自由输入，从源头避免非法值
		const bitrates = audio.bitrates ?? [];
		$('transcodeABitrate').toggleAttribute('hidden', !bitrates.length);
		if (bitrates.length) {
			const prev = ($('transcodeABitrate') as SelectEl).value;
			fillSelect(
				'transcodeABitrate',
				bitrates.map((kbps) => ({ value: String(kbps), label: `${kbps} kbps` })),
				bitrates.includes(Number(prev)) ? prev : undefined,
			);
			($('transcodeABitrate') as SelectEl).value = String(audio.bitrateDefault ?? bitrates[0]);
		}

		// 自定义宽高只在选 custom 时出现
		const custom = scaleValue() === 'custom';
		$('transcodeWidth').toggleAttribute('hidden', !custom);
		$('transcodeHeight').toggleAttribute('hidden', !custom);
		// 「不压缩」的视频不能再缩放，否则命令会自相矛盾
		const scaleField = $('transcodeScale');
		const blocked = video.id === 'copy';
		if (blocked && scaleField.getAttribute('data-blocked') !== '1') {
			($('transcodeScale') as SelectEl).value = 'source';
			scaleField.setAttribute('data-blocked', '1');
		} else if (!blocked) {
			scaleField.removeAttribute('data-blocked');
		}

		updateTranscodeHint();
	}

	function updateTranscodeHint(): void {
		const video = videoSpec();
		const audio = audioSpec();
		const container = ($('transcodeContainer') as SelectEl).value as ops.RemuxContainer;
		const notes: string[] = [];

		if (video.id === 'copy') {
			notes.push('视频直接复制，不重新编码 —— 这一步其实和「改格式」一样快。');
		} else {
			notes.push(video.note);
			const mode = ($('transcodeMode') as SelectEl).value as ops.RateMode;
			if (mode === 'crf' && video.crfHint) notes.push(video.crfHint);
		}
		notes.push(audio.note);
		if (video.id !== 'copy' && video.presets.some((p) => p.id === 'uf')) {
			notes.push('越靠「慢」的档位压出来体积越小、速度越慢；应急就用默认的中。');
		}
		const spec = ops.CONTAINERS[container];
		if (spec) notes.push(`输出 ${spec.label}：${spec.hint}。`);

		const missing = [video, audio].filter(
			(spec2) => spec2.id !== 'copy' && spec2.id !== 'none' && disabledByProbe(spec2.encoder),
		);
		if (missing.length) {
			notes.push(`⚠️ 当前 ffmpeg 核心缺少 ${missing.map((m) => m.label).join('、')}，请换一个。`);
		}
		$('transcodeHint').textContent = notes.join(' ');
	}

	/**
	 * 探测当前核心到底有哪些编码器。
