	async function onTranscodeRun(): Promise<void> {
		if (!transcodeFile || busy) return;
		setBusy(true);
		setDisabled('transcodeRun', true);
		try {
			const options = readTranscodeOptions();
			const plan = ops.planTranscode(mountedName(transcodeFile), options);
			const started = performance.now();
			const { output, bytes } = await runPlan([transcodeFile], plan.args, plan.output, '压制');
			const elapsed = performance.now() - started;

			download(bytes, output);
			const source = ops.formatBytes(transcodeFile.size);
			let summary = `完成：${source} → ${ops.formatBytes(bytes.length)}`;
			// infoBuffer 里还留着这次压制开头的输入 banner，能拿到真实时长
			const duration = ops.parseFfmpegDuration(infoBuffer);
			const speed = duration ? ops.describeSpeed(duration, elapsed) : '';
			if (speed) summary += ` · ${speed}`;
			$('transcodeSummary').textContent = summary;
			log(summary);
			hideProgress();
		} catch (error) {
			log(describeError(error), 'error');
			$('transcodeSummary').textContent = describeError(error);
		} finally {
			setBusy(false);
			setDisabled('transcodeRun', false);
		}
	}

