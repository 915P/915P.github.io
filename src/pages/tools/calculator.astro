---
import Page from '../../layouts/Page.astro';

type Level = 'accent' | 'primary' | 'plain';

const KEYS: { k: string; label?: string; lv: Level }[] = [
	{ k: 'C', label: '清空', lv: 'accent' },
	{ k: '(', lv: 'primary' },
	{ k: ')', lv: 'primary' },
	{ k: '÷', lv: 'primary' },
	...['7', '8', '9'].map((k) => ({ k, lv: 'plain' as Level })),
	{ k: '×', lv: 'primary' },
	...['4', '5', '6'].map((k) => ({ k, lv: 'plain' as Level })),
	{ k: '-', lv: 'primary' },
	...['1', '2', '3'].map((k) => ({ k, lv: 'plain' as Level })),
	{ k: '+', lv: 'primary' },
	{ k: '0', lv: 'plain' },
	{ k: '.', lv: 'plain' },
	{ k: '%', lv: 'primary' },
	{ k: '⌫', label: '退格', lv: 'accent' },
];
---

<Page title="智能计算器" description="支持四则运算与括号的小计算器" active="tools">
	<div class="tool-head">
		<h1>智能计算器</h1>
		<p>支持 + − × ÷ 、括号与百分号，也可直接用键盘输入</p>
	</div>

	<div class="tool-narrow">
		<output
			id="disp"
			class="mono readout"
			aria-live="polite">0</output
		>

		<div id="pad" class="keypad">
			{
				KEYS.map((b) => (
					<button type="button" data-k={b.k} data-lv={b.lv} class="key">
						{b.label ?? b.k}
					</button>
				))
			}
			<button type="button" data-k="=" class="key">等于</button>
		</div>

		<p id="err" class="footnote" style="color: rgb(var(--mdui-color-error))" role="alert"></p>

		<p class="footnote">
			表达式由递归下降解析器求值，不使用 <code class="mono">eval</code>，只接受数字与四则运算。
		</p>
	</div>
</Page>

<script>
	const disp = document.getElementById('disp')!;
	const err = document.getElementById('err')!;
	let expr = '';

	const show = () => (disp.textContent = expr || '0');

	/** 递归下降解析：expr → term → factor → (expr) | number */
	function parse(s: string): number {
		let i = 0;
		const ws = () => {
			while (i < s.length && /\s/.test(s[i]!)) i++;
		};

		function factor(): number {
			ws();
			if (s[i] === '(') {
				i++;
				const v = expr();
				ws();
				if (s[i] !== ')') throw new Error('缺少右括号');
				i++;
				return v;
			}
			if (s[i] === '-') {
				i++;
				return -factor();
			}
			const start = i;
			while (i < s.length && /[\d.]/.test(s[i]!)) i++;
			if (start === i) throw new Error('格式错误');
			const n = Number(s.slice(start, i));
			if (Number.isNaN(n)) throw new Error('格式错误');
			return n;
		}

		function term(): number {
			let v = factor();
			for (;;) {
				ws();
				const op = s[i];
				if (op === '*' || op === '×') {
					i++;
					v *= factor();
				} else if (op === '/' || op === '÷') {
					i++;
					const d = factor();
					if (d === 0) throw new Error('不能除以零');
					v /= d;
				} else return v;
			}
		}

		function expr(): number {
			let v = term();
			for (;;) {
				ws();
				const op = s[i];
				if (op === '+') {
					i++;
					v += term();
				} else if (op === '-') {
					i++;
					v -= term();
				} else return v;
			}
		}

		const v = expr();
		ws();
		if (i < s.length) throw new Error('多余的符号');
		return v;
	}

	document.getElementById('pad')!.addEventListener('click', (e) => {
		const k = (e.target as HTMLElement).dataset.k;
		if (!k) return;
		err.hidden = true;

		if (k === 'C') expr = '';
		else if (k === '⌫') expr = expr.slice(0, -1);
		else if (k === '=') {
			try {
				const v = parse(expr);
				if (!Number.isFinite(v)) throw new Error('结果无效');
				expr = String(Math.round(v * 1e10) / 1e10);
			} catch (ex) {
				err.textContent = (ex as Error).message;
				err.hidden = false;
			}
		} else if (k === '%') {
			expr += '/100';
		} else expr += k;

		show();
	});

	document.addEventListener('keydown', (e) => {
		const k = e.key;
		if (/^[0-9.+\-()]$/.test(k)) expr += k;
		else if (k === '*') expr += '×';
		else if (k === '/') {
			e.preventDefault();
			expr += '÷';
		} else if (k === 'Enter' || k === '=') {
			document.querySelector<HTMLElement>('[data-k="="]')?.click();
			return;
		} else if (k === 'Backspace') expr = expr.slice(0, -1);
		else if (k === 'Escape') expr = '';
		else return;
		show();
	});
</script>
