---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const fmt = (d: Date) =>
	d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });

const toc = headings.filter((h) => h.depth === 2);
---

<Page
	title={post.data.title}
	description={post.data.description}
	image={post.data.hero}
	type="article"
	active="blog"
>
	<article class="article">
		<a href="/blog/" class="back-link">← 博客</a>

		<header class="article-head">
			<h1 class="page-title">{post.data.title}</h1>
			<div class="row" style="margin-top: 0.75rem; gap: 0.85rem">
				<time datetime={post.data.pubDate.toISOString()} class="text-sm muted"
					>{fmt(post.data.pubDate)}</time
				>
				{
					post.data.tags.map((t) => (
						<mdui-chip variant="assist">
							#{t}
						</mdui-chip>
					))
				}
			</div>
			{
				post.data.description && (
					<p class="muted" style="margin-top: 0.6rem">{post.data.description}</p>
				)
			}
		</header>

		{/* 目录天然是一组可选条目，用 mdui-list + mdui-list-subheader。
		    注释要放在 {…} 表达式外面，写在分支内部会解析失败。 */}
		{
			toc.length > 2 && (
				<mdui-list class="toc-list" aria-label="目录">
					<mdui-list-subheader>目录</mdui-list-subheader>
					{toc.map((h) => (
						<mdui-list-item href={`#${h.slug}`} headline={h.text} headline-line="2" />
					))}
				</mdui-list>
			)
		}

		<div class="prose" style="margin-top: 2rem">
			<Content />
		</div>
	</article>
</Page>

<style is:global>
	.toc-list {
		margin-top: 1.5rem;
		border-radius: var(--mdui-shape-corner-large);
		background: rgb(var(--mdui-color-surface-container));
		padding: 0.5rem 0.5rem 0.75rem;
	}

	.toc-list mdui-list-item {
		/* 同上：mdui-list-item 自身 padding 为 0 */
		padding: 0.4rem 0.75rem;
		border-radius: var(--mdui-shape-corner-small);
	}

	.toc-list mdui-list-item::part(headline) {
		color: rgb(var(--mdui-color-on-surface-variant));
	}
</style>

<style is:global>
	.article {
		max-width: 42rem;
		margin-inline: auto;
	}

	.back-link {
		font-size: var(--mdui-typescale-body-medium-size);
		color: rgb(var(--mdui-color-primary));
		text-decoration: none;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.article-head {
		margin-top: 1.25rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgb(var(--mdui-color-outline-variant));
	}
</style>
