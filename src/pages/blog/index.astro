---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = (d: Date) =>
	d.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
---

<Page title="博客" active="blog">
	<div class="tool-head">
		<h1>博客</h1>
		<p>共 {posts.length} 篇</p>
	</div>

	{/*
		mdui-list / mdui-list-item 替掉了原来手写的 <a class="post-card">：
		标题进 headline、摘要进 description、日期与标签走 slot，
		条目样式与内边距交给组件，顺手删掉 .post-card / .post-title 两套 CSS。
		headline-line="2" 让长标题最多两行，不会把单条撑得过高。

		注意：这段说明必须放在三元表达式**外面**。写在 {…} 分支里的 HTML
		注释（<!-- -->）会让 Astro 解析失败 —— 与 latex 页那个坑同源。
	*/}
	{
		posts.length === 0 ? (
			<p class="muted">还没有文章。</p>
		) : (
			<mdui-list class="post-list">
				{posts.map((p) => (
					<mdui-list-item
						href={`/blog/${p.id}/`}
						headline={p.data.title}
						headline-line="2"
						class="post-item"
					>
						{/*
							摘要与标签必须放进**同一个** description slot。
							之前一边用 description= 属性、一边又放了个
							<span slot="description"> 装标签，后者把前者整个顶掉了 ——
							结果列表里只剩标题和标签，摘要一个字都不显示。
						*/}
						<span slot="description" class="post-desc">
							{p.data.description && <span class="post-summary">{p.data.description}</span>}
							{p.data.tags.length > 0 && (
								<span class="post-tags">
									{p.data.tags.map((t) => (
										<mdui-chip variant="filter">#{t}</mdui-chip>
									))}
								</span>
							)}
						</span>
						<time
							slot="end-icon"
							datetime={p.data.pubDate.toISOString()}
							class="text-xs faint post-date"
						>
							{fmt(p.data.pubDate)}
						</time>
					</mdui-list-item>
				))}
			</mdui-list>
		)
	}
</Page>

<style is:global>
	.post-list {
		margin-top: 1.5rem;
		max-width: 42rem;
	}

	/* mdui-list-item 的 padding 是 0，MD3 把它交给使用者，这里补回来 */
	.post-item {
		padding: 0.85rem 1rem;
		margin-bottom: 0.5rem;
		border-radius: var(--mdui-shape-corner-medium);
		background: rgb(var(--mdui-color-surface-container));
	}

	.post-item::part(headline) {
		font-weight: var(--mdui-typescale-title-medium-weight);
	}

	.post-item::part(description) {
		margin-top: 0.2rem;
	}

	.post-date {
		white-space: nowrap;
		align-self: flex-start;
	}

	.post-desc {
		display: grid;
		gap: 0.4rem;
	}

	.post-summary {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
</style>

<style is:global>
	.post-card {
		display: block;
		padding: 1.1rem 1.25rem;
		border-radius: var(--mdui-shape-corner-large);
		background-color: rgb(var(--mdui-color-surface-container-low));
		text-decoration: none;
		transition: background-color var(--mdui-motion-duration-short2);
	}

	.post-card:hover {
		background-color: rgb(var(--mdui-color-surface-container));
	}

	.post-title {
		font-size: var(--mdui-typescale-title-medium-size);
		font-weight: 600;
		color: rgb(var(--mdui-color-on-surface));
	}
</style>
