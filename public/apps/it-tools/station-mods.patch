+    expect(wrapper.get('mdui-card').text()).to.contain('Title');
+  });
+
+  it('[c-tooltip] maps position to placement and forwards the tooltip slot', () => {
+    const wrapper = shallowMount(CTooltip, {
+      props: { tooltip: 'hello', position: 'bottom' },
+      slots: { tooltip: 'slot content' },
+    });
+
+    const tooltip = wrapper.get('mdui-tooltip');
+    expect(tooltip.attributes('placement')).to.equal('bottom');
+    expect(tooltip.attributes('content')).to.equal('hello');
+    expect(tooltip.find('[slot="content"]').text()).to.contain('slot content');
+  });
+
+  it('[c-tooltip] renders the plain slot when there is no tooltip', () => {
+    const wrapper = shallowMount(CTooltip, { slots: { default: 'plain' } });
+    expect(wrapper.find('mdui-tooltip').exists()).to.equal(false);
+    expect(wrapper.text()).to.contain('plain');
+  });
+
+  it('[c-select] renders menu items and maps change back to the original value type', async () => {
+    const wrapper = mount(CSelect, {
+      props: { options: [{ label: 'One', value: 1 }, { label: 'Two', value: 2 }], value: 1 },
+      global: i18nMocks,
+    });
+
+    const select = wrapper.get('mdui-select');
+    const items = select.findAll('mdui-menu-item');
+    expect(items).to.have.length(2);
+    expect(items[0].attributes('value')).to.equal('1');
+    expect(select.attributes('value')).to.equal('1');
+
+    // 模拟 mdui 的 change：值始终是字符串，必须映射回 number
+    (select.element as unknown as { value: string }).value = '2';
+    await select.trigger('change');
+    expect(wrapper.emitted('update:value')?.[0]).to.deep.equal([2]);
+  });
+
+  it('[c-select] forwards the displayed-value slot into the select', () => {
+    const wrapper = mount(CSelect, {
+      props: { options: ['a'] },
+      slots: { 'displayed-value': '<b>custom</b>' },
+      global: i18nMocks,
+    });
+
+    expect(wrapper.get('mdui-select').find('[slot="icon"]').html()).to.contain('<b>custom</b>');
+  });
+
+  it('[c-buttons-select] renders menu items and updates the value', async () => {
+    const wrapper = mount(CButtonsSelect, {
+      props: { options: ['a', 'b'], value: 'a' },
+    });
+
+    const select = wrapper.get('mdui-select');
+    expect(select.findAll('mdui-menu-item')).to.have.length(2);
+
+    (select.element as unknown as { value: string }).value = 'b';
+    await select.trigger('change');
+    expect(wrapper.emitted('update:value')?.[0]).to.deep.equal(['b']);
+  });
+
+  it('[c-modal] opens through the open attribute and keeps attrs on the container', async () => {
+    const wrapper = shallowMount(CModal, {
+      props: { open: true },
+      attrs: { class: 'palette-modal' },
+    });
+
+    const dialog = wrapper.get('mdui-dialog');
+    // jsdom 里 mdui 未注册，Vue 走 attribute 分支（"true"）；真实浏览器走 open 属性
+    expect(dialog.attributes('open')).to.be.ok;
+    expect(dialog.find('.c-modal--container').exists()).to.equal(true);
+    expect(dialog.find('.c-modal--container').classes()).to.include('palette-modal');
+
+    await wrapper.vm.close();
+    expect(wrapper.emitted('update:open')?.at(-1)).to.deep.equal([false]);
+  });
+
+  it('[c-collapse] maps title/title slot to the collapse item header', () => {
+    const withTitle = shallowMount(CCollapse, { props: { title: 'Head' } });
+    expect(withTitle.get('mdui-collapse-item').attributes('header')).to.equal('Head');
