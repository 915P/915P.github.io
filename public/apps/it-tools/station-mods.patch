+
+  it('[c-button] renders mdui-button with mapped variant/size and keeps test-id passthrough', () => {
+    const wrapper = shallowMount(CButton, {
+      props: { type: 'primary', size: 'small', round: true },
+      attrs: { 'data-test-id': 'btn' },
+    });
+
+    const button = wrapper.get('mdui-button');
+    expect(button.attributes('variant')).to.equal('filled');
+    expect(button.classes()).to.include('c-button--small');
+    expect(button.classes()).to.include('c-button--round');
+    expect(button.attributes('data-test-id')).to.equal('btn');
+  });
+
+  it('[c-button] maps basic default to tonal and text variant to text', () => {
+    expect(shallowMount(CButton).get('mdui-button').attributes('variant')).to.equal('tonal');
+    expect(shallowMount(CButton, { props: { variant: 'text' } }).get('mdui-button').attributes('variant')).to.equal('text');
+    expect(shallowMount(CButton, { props: { type: 'error' } }).get('mdui-button').attributes('variant')).to.equal('filled');
+  });
+
+  it('[c-button] keeps href on the mdui-button and renders to as a real router link', async () => {
