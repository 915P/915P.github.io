+import CButtonsSelect from './c-buttons-select/c-buttons-select.vue';
+import CModal from './c-modal/c-modal.vue';
+import CCollapse from './c-collapse/c-collapse.vue';
+import CAlert from './c-alert/c-alert.vue';
+import CLink from './c-link/c-link.vue';
+
+/* station mod (GPLv3): 封装层 mdui 化的结构冒烟测试。
+ * jsdom 里 mdui 自定义元素未注册（不会跑 lit），因此这里校验的是：
+ *  - 对外结构/属性/事件映射没有跑偏（根元素、插槽透传、data-test-id 透传）
+ *  - Vue 模板在自定义元素里使用 slot="..." 透传不会报错
