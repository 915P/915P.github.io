+++ b/src/composable/geo.ts
@@ -0,0 +1,30 @@
+/**
+ * 访客地区判定：读 Cloudflare 的 /cdn-cgi/trace，看 `loc` 是否为 CN（中国大陆）。
+ *
+ * 为什么用 loc 而不是自己拿 ip 查 IP 段：loc 是 Cloudflare 按访客 IP 做的
+ * 地理归属，零成本、覆盖 IPv6 与移动网络段；自建大陆 CIDR 表既难维护、
+ * 误判率反而更高。
+ *
+ * 边界与诚实说明：
+ * - trace **只在本机读取与判断**，不发往第三方、不写进存储（页脚读同一个
+ *   端点拿节点代码，见 Footer.astro）。
+ * - 只有站点走 Cloudflare 时才有这个端点：本地开发、绕过 CDN 直连源站、
+ *   离线都会 404 或抛错 —— 一律返回 false，即**不过滤**：宁可多显示，
+ *   也不要在判不出来时乱藏东西。
+ * - 这只是**展示层**开关：emoji 数据本来就在本地包里，用户手动输入照样
+ *   能打出对应字符。它不构成任何技术上的阻断。
+ */
+export async function isInMainlandChina(): Promise<boolean> {
+  try {
+    const response = await fetch('/cdn-cgi/trace', { cache: 'no-store' });
+    if (!response.ok) return false;
+
+    const text = await response.text();
+    const loc = /^loc=(\S+)$/m.exec(text)?.[1];
+    return loc === 'CN';
+  }
+  catch {
+    // 离线 / 端点不存在 / CORS 之类的失败：当作判不出来，不做过滤
+    return false;
+  }
+}
