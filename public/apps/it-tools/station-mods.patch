@@ -0,0 +1,35 @@
+import { watch, type Ref } from 'vue';
+import 'mdui';
+import 'mdui/mdui.css';
+import { setColorScheme, setTheme } from 'mdui';
+
+/**
+ * station mod (GPLv3): mdui 接入点。
+ *
+ * 为什么引入 mdui：本站主体（宿主站点）就是 mdui / MD3 设计体系，IT-Tools
+ * 作为内嵌应用长期自成一套（Naive UI + 自研组件令牌），观感与站点割裂。
+ * 阶段一先把「外壳 + 封装层」换成 mdui，阶段二再把工具页里直接使用的
+ * Naive 组件换掉，最终移除 naive-ui 依赖与它那套主题样式。
+ *
+ * 主题两件事：
+ *  - 模式：mdui.setTheme() 会在 <html> 上切换 mdui-theme-light/dark 类。
+ *    这里**只额外**做一次同步 —— 应用原有的明暗开关是 VueUse 的 useDark()
+ *    （切的是 `dark` 类），两套类并存不冲突，一个给 mdui、一个给既有样式。
+ *  - 配色：setColorScheme() 由一个种子色同时生成 light/dark 两套 MD3 色板
+ *    （见 mdui/internal/colorScheme.js：Scheme.light / Scheme.dark 各出一份），
+ *    所以明暗切换不需要再调它，避免反复注入 <style> 堆在 head 里。
+ *    种子色用站点的浅色主色 #006689，与宿主站点一致。
+ */
+export const STATION_PRIMARY = '#006689';
+
+let initialized = false;
+
+/** 首次调用注入色板并按当前模式设一次主题；之后只跟随模式变化 */
+export function setupMdui(isDark: Ref<boolean>): void {
+  if (!initialized) {
+    initialized = true;
+    setColorScheme(STATION_PRIMARY);
+    setTheme(isDark.value ? 'dark' : 'light');
+    watch(isDark, (dark) => setTheme(dark ? 'dark' : 'light'));
+  }
+}
