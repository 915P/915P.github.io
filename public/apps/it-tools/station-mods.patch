+    expect(wrapper.get('.c-alert').classes()).to.include('c-alert--error');
+    expect(wrapper.text()).to.contain('Boom');
+  });
+
+  it('[c-link] still renders an anchor with the primary color class hook', () => {
+    const wrapper = shallowMount(CLink, { props: { href: 'https://example.com' } });
+    expect(wrapper.get('a').attributes('href')).to.equal('https://example.com');
+    expect(wrapper.get('a').classes()).to.include('c-link');
+  });
+
+  it('[c-select] renders the empty slot when there is no option left', () => {
+    const wrapper = mount(CSelect, { props: { options: [] }, global: i18nMocks });
+    const select = wrapper.get('mdui-select');
+    expect(select.find('mdui-menu-item').exists()).to.equal(true);
+    expect(select.text()).to.contain('station.str.no-results-found');
+  });
+});
