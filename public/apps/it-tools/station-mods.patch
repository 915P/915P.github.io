+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { isInMainlandChina } from './geo';
+
+/**
+ * 钉住地区判定的四种结局：命中、未命中、端点不存在、网络异常。
+ * 后两种必须**返回 false（不过滤）** —— 判不出来时宁可多显示，
+ * 也不能在拿不到数据的情况下乱藏内容。
+ */
+describe('isInMainlandChina', () => {
+  afterEach(() => {
+    vi.unstubAllGlobals();
+  });
+
+  const stubTrace = (body: string, ok = true) => {
+    vi.stubGlobal('fetch', vi.fn(async () => ({ ok, text: async () => body })));
+  };
+
+  it('loc=CN 时判定为中国大陆', async () => {
+    stubTrace('fl=abc\ncolo=SHA\nip=203.0.113.7\nloc=CN\ntls=TLSv1.3\n');
+    expect(await isInMainlandChina()).toBe(true);
+  });
+
+  it('loc 为其他国家时判定为境外', async () => {
+    stubTrace('colo=HKG\nloc=US\n');
+    expect(await isInMainlandChina()).toBe(false);
+  });
+
+  it('trace 没有 loc 字段时不做过滤', async () => {
+    stubTrace('colo=SIN\n');
+    expect(await isInMainlandChina()).toBe(false);
+  });
+
+  it('端点 404（本地开发 / 直连源站）时不做过滤', async () => {
+    stubTrace('', false);
+    expect(await isInMainlandChina()).toBe(false);
+  });
+
+  it('fetch 抛错（离线）时不做过滤', async () => {
+    vi.stubGlobal('fetch', vi.fn(async () => {
+      throw new Error('offline');
+    }));
+    expect(await isInMainlandChina()).toBe(false);
+  });
+});
