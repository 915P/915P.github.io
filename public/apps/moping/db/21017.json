{"char": "则", "samples": [{"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "clear", "img": "imgs/21017/何绍基.png", "mask": "", "bbox": {"w": 195, "h": 209}}, {"master": "吴昌硕", "script": "隶书", "dynasty": "民国", "source": "碑", "stroke_style": "中锋朴厚", "structure": "结体偏长，左低右高", "desc": "一意求中锋平直，且隶且篆。以《石鼓文》笔意写隶。结体偏长，左低右高，线条浑金璞玉，苍茫古朴。", "quality": "blurry", "img": "imgs/21017/吴昌硕.png", "mask": "", "bbox": {"w": 228, "h": 172}}, {"master": "宋高宗", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "圆转精到", "structure": "结构端庄，圆润流美", "desc": "圆润流利，规范端庄，用笔精到，具有典型的皇家富贵气和晋唐法度。", "quality": "clear", "img": "imgs/21017/宋高宗.png", "mask": "", "bbox": {"w": 209, "h": 207}}, {"master": "王福庵", "script": "篆书", "dynasty": "民国", "source": "碑", "stroke_style": "笔画粗细匀一", "structure": "圆润劲健，结体极度工整对称", "desc": "端庄杂流丽，刚健含婀娜。精研“铁线篆”。笔画粗细匀一，圆润劲健，结体极度工整对称，既有秦篆的严谨，又有金石的质感。", "quality": "clear", "img": "imgs/21017/王福庵.png", "mask": "", "bbox": {"w": 184, "h": 234}}, {"master": "米芾", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "八面出锋", "structure": "结体奇肆，纵横飞动", "desc": "超迈入神，殆非侧勒，趯策，掠啄，磔所能束缚也。如天马脱衔，追风逐电，虽不可范，以驰驱之节，要自不妨痛快。书如游龙，跃渊，骏焉，得御，矫然，拔秀，诚不可攀也。", "quality": "clear", "img": "imgs/21017/米芾.png", "mask": "", "bbox": {"w": 229, "h": 217}}, {"master": "董其昌", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "平稳含蓄", "structure": "中宫虚和，结体疏朗", "desc": "楷书结构疏朗，中宫虚和，用笔平稳含蓄，点画不尚锋芒而重整体气息。强调字内空间与章法呼应，追求“淡而有味”的审美取向，弱化力量感而突出文人书卷气。", "quality": "blurry", "img": "imgs/21017/董其昌.png", "mask": "", "bbox": {"w": 237, "h": 219}}, {"master": "褚遂良", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "楷法劲健", "structure": "结体严整，清秀灵动", "desc": "以楷法为骨，行气清晰，线条劲健而不纵逸，连带克制。整体呈现出清秀、严整而略带灵动的面貌。", "quality": "blurry", "img": "imgs/21017/褚遂良.png", "mask": "", "bbox": {"w": 178, "h": 211}}, {"master": "怀素", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "藏锋内转", "structure": "结法谨密，回旋多变", "desc": "狂草。笔法瘦硬，称为“铁线描”，速度极快，回旋进退，如骤雨旋风。援毫掣电，随手万变。超妙自得，笔老而意新。虽率意颠逸，千变万化，终不离晋法度故也。结法极谨密，微有不可识者。藏锋内转，瘦硬通神，而颠墨挫毫，无碎缺。", "quality": "clear", "img": "imgs/21017/怀素.png", "mask": "", "bbox": {"w": 178, "h": 231}}, {"master": "王献之", "script": "草书", "dynasty": "晋代", "source": "帖", "stroke_style": "藏锋连绵", "structure": "结体妍雅平稳，气脉贯通", "desc": "圆转流美，以圆转流美取胜，笔画多绵连而不板滞，线条柔韧含蓄，起止多藏锋，强调气脉贯通而弱化笔画棱角。结体趋于妍雅平稳，节奏舒缓而富有韵致。", "quality": "blurry", "img": "imgs/21017/王献之.png", "mask": "", "bbox": {"w": 225, "h": 213}}, {"master": "褚遂良", "script": "楷书", "dynasty": "唐代", "source": "帖", "stroke_style": "瘦劲含蓄", "structure": "结体宽博灵动，多姿多态", "desc": "瘦而不弱，笔划极富变化，线条有弹性，结体宽博灵动，多姿多态，空灵飞动。笔瘦劲挺拔，线条富弹性，转折处锋芒内敛。结体严谨而不板滞，姿态清秀中见劲健。", "quality": "clear", "img": "imgs/21017/褚遂良.png", "mask": "", "bbox": {"w": 215, "h": 251}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21017/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 129}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21017/张即之.png", "mask": "", "bbox": {"w": 138, "h": 132}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21017/智永.png", "mask": "", "bbox": {"w": 114, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21017/柳公权.png", "mask": "", "bbox": {"w": 129, "h": 137}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21017/沈尹默.png", "mask": "", "bbox": {"w": 127, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21017/虞世南.png", "mask": "", "bbox": {"w": 121, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21017/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 129}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21017/赵孟頫.png", "mask": "", "bbox": {"w": 130, "h": 138}}]}