{"char": "弥", "samples": [{"master": "孙过庭", "script": "草书", "dynasty": "唐代", "source": "碑", "stroke_style": "笔法精微，提按清晰", "structure": "结体疏朗简约", "desc": "法度严谨而流美自然，笔法精微，提按清晰，结体疏朗。工于用笔，俊拔刚断，尚异好奇，凌越险阻。如丹崖绝壑，笔势坚劲。", "quality": "clear", "img": "imgs/24357/孙过庭.png", "mask": "", "bbox": {"w": 240, "h": 184}}, {"master": "欧阳询", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "方折险劲", "structure": "中宫紧收，险绝稳健", "desc": "法度森严，笔力险峻。点画方硬，结体险绝而稳健，中宫紧收，修长挺拔。", "quality": "blurry", "img": "imgs/24357/欧阳询.png", "mask": "", "bbox": {"w": 220, "h": 192}}, {"master": "祝允明", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "连带纵逸", "structure": "结体欹侧，跌宕多变", "desc": "纵而能敛，狂而不怪，连带自然，结体多欹侧变化，字势跌宕起伏，行气贯通而富节奏感。", "quality": "blurry", "img": "imgs/24357/祝允明.png", "mask": "", "bbox": {"w": 240, "h": 213}}, {"master": "黄庭坚", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "提按纵横", "structure": "结体开张，纵横奇崛", "desc": "见长年荡桨，乃悟笔法。清圆妙丽，引绳贯珠。虽昂藏郁拔，而神闲，意秾。变态纵横，势若飞鹤之名书，法妍媚，笔势纵横。无一笔不自空中，荡漾而又沈著痛快。", "quality": "blurry", "img": "imgs/24357/黄庭坚.png", "mask": "", "bbox": {"w": 222, "h": 224}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24357/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 135}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24357/张即之.png", "mask": "", "bbox": {"w": 138, "h": 120}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24357/智永.png", "mask": "", "bbox": {"w": 138, "h": 133}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24357/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 110}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国"