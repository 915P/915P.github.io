{"char": "军", "samples": [{"master": "傅山", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "率意纵肆", "structure": "结体奇特，纵逸不拘", "desc": "与草书类似，强调直抒胸臆。结体奇特，墨色淋漓，不拘成法，真气弥满。", "quality": "clear", "img": "imgs/20891/傅山.png", "mask": "", "bbox": {"w": 111, "h": 245}}, {"master": "康里巎巎", "script": "草书", "dynasty": "元代", "source": "碑", "stroke_style": "悬腕迅疾", "structure": "结体纵逸，欹侧多变", "desc": "运笔极快，如疾风骤雨。悬腕行笔，线条爽利锋锐，节奏明快，既有流美，又有北方民族的豪爽。", "quality": "clear", "img": "imgs/20891/康里巎巎.png", "mask": "", "bbox": {"w": 179, "h": 244}}, {"master": "智永", "script": "草书", "dynasty": "隋代", "source": "碑", "stroke_style": "藏锋圆转", "structure": "结体圆转，气脉连贯", "desc": "笔笔从空中落，从空中住，虽屋漏痕，犹不足以喻之。", "quality": "blurry", "img": "imgs/20891/智永.png", "mask": "", "bbox": {"w": 196, "h": 235}}, {"master": "米芾", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "八面出锋", "structure": "结体奇肆，纵横飞动", "desc": "超迈入神，殆非侧勒，趯策，掠啄，磔所能束缚也。如天马脱衔，追风逐电，虽不可范，以驰驱之节，要自不妨痛快。书如游龙，跃渊，骏焉，得御，矫然，拔秀，诚不可攀也。", "quality": "clear", "img": "imgs/20891/米芾.png", "mask": "", "bbox": {"w": 96, "h": 254}}, {"master": "董其昌", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "平稳含蓄", "structure": "中宫虚和，结体疏朗", "desc": "楷书结构疏朗，中宫虚和，用笔平稳含蓄，点画不尚锋芒而重整体气息。强调字内空间与章法呼应，追求“淡而有味”的审美取向，弱化力量感而突出文人书卷气。", "quality": "blurry", "img": "imgs/20891/董其昌.png", "mask": "", "bbox": {"w": 147, "h": 207}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "篆籀中锋", "structure": "结体方正宽博，重心安稳", "desc": "雄浑博大，其书气象森严，骨力遒劲，点画厚重，沉着有力。结体方正宽博，不尚纤巧。字势端严，重心安稳。", "quality": "clear", "img": "imgs/20891/颜真卿.png", "mask": "", "bbox": {"w": 233, "h": 251}}, {"master": "何绍基", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "回腕颤涩", "structure": "随字赋形，生动自然", "desc": "如天仙化人，绝无尘俗。笔法独特，多用“颤笔”，线条极其苍茫老辣，结体随字赋形，生动自然。", "quality": "blurry", "img": "imgs/20891/何绍基.png", "mask": "", "bbox": {"w": 236, "h": 220}}, {"master": "傅山", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转纵肆", "structure": "结体缠绕奇肆", "desc": "粗头乱服式线条，强调自然率真与生拙之美，笔势跌宕，墨法枯涩，极具反规范倾向。主张“宁拙毋巧”。连绵缠绕，圆转不休，气势磅礴，有一种乱头粗服、不加修饰的狂放之美。", "quality": "clear", "img": "imgs/20891/傅山.png", "mask": "", "bbox": {"w": 141, "h": 229}}, {"master": "欧阳询", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "瘦劲方折", "structure": "中宫收敛，结体紧密", "desc": "严整险劲，结体紧密，中宫收敛，笔画瘦劲而劲健，转折分明，行气克制，不尚流便而重法度。", "quality": "blurry", "img": "imgs/20891/欧阳询.png", "mask": "", "bbox": {"w": 131, "h": 211}}, {"master": "董其昌", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "轻灵含蓄", "structure": "结体疏朗平正", "desc": "疏淡清远，强调空间经营，行书节奏舒缓，连带自然，用笔轻灵，行气疏通。字形多取平正，不刻意追求速度与张力。", "quality": "clear", "img": "imgs/20891/董其昌.png", "mask": "", "bbox": {"w": 155, "h": 231}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20891/张即之.png", "mask": "", "bbox": {"w": 106, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20891/柳公权.png", "mask": "", "bbox": {"w": 121, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20891/沈尹默.png", "mask": "", "bbox": {"w": 121, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20891/虞世南.png", "mask": "", "bbox": {"w": 127, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20891/赵之谦.png", "mask": "", "bbox": {"w": 130, "h": 138}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20891/赵孟頫.png", "mask": "", "bbox": {"w": 122, "h": 135}}, {"m