{"char": "古", "samples": [{"master": "王献之", "script": "行书", "dynasty": "晋代", "source": "碑", "stroke_style": "连绵外拓", "structure": "结体秀逸，外拓奔放", "desc": "运笔连绵不绝，气势豪迈，外露和奔放，挺然秀出，极草纵之致。", "quality": "clear", "img": "imgs/21476/王献之.png", "mask": "", "bbox": {"w": 181, "h": 218}}, {"master": "米芾", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "八面出锋", "structure": "结体奇肆，纵横飞动", "desc": "超迈入神，殆非侧勒，趯策，掠啄，磔所能束缚也。如天马脱衔，追风逐电，虽不可范，以驰驱之节，要自不妨痛快。书如游龙，跃渊，骏焉，得御，矫然，拔秀，诚不可攀也。", "quality": "blurry", "img": "imgs/21476/米芾.png", "mask": "", "bbox": {"w": 174, "h": 230}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "圆润内刚", "structure": "结构沉静，外柔内刚", "desc": "字里金生，行间玉润。笔法圆润，外柔内刚，结构沉静，有一种君子温玉般的冲和之美。", "quality": "blurry", "img": "imgs/21476/虞世南.png", "mask": "", "bbox": {"w": 203, "h": 177}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "篆籀中锋", "structure": "结体方正宽博，重心安稳", "desc": "雄浑博大，其书气象森严，骨力遒劲，点画厚重，沉着有力。结体方正宽博，不尚纤巧。字势端严，重心安稳。", "quality": "blurry", "img": "imgs/21476/颜真卿.png", "mask": "", "bbox": {"w": 222, "h": 202}}, {"master": "伊秉绶", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "迟涩朴厚", "structure": "结体宽博，隶意横展", "desc": "隶意行书，结体宽博，用笔迟涩，行而不流。", "quality": "blurry", "img": "imgs/21476/伊秉绶.png", "mask": "", "bbox": {"w": 205, "h": 180}}, {"master": "启功", "script": "楷书", "dynasty": "现代", "source": "帖", "stroke_style": "瘦硬清健", "structure": "中宫紧收，四肢舒展", "desc": "瘦硬清秀，中宫紧收，四肢舒展。独创“五三五”结字法（黄金分割），雅俗共赏，书卷气浓。", "quality": "blurry", "img": "imgs/21476/启功.png", "mask": "", "bbox": {"w": 229, "h": 200}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "blurry", "img": "imgs/21476/米芾.png", "mask": "", "bbox": {"w": 254, "h": 244}}, {"master": "赵之谦", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "圆转流畅", "structure": "结构匀称，自然舒展", "desc": "以行笔为主，线条圆转，波磔柔和，结构匀称。整体风格偏于雅正，书写性强而刻石感弱。", "quality": "blurry", "img": "imgs/21476/赵之谦.png", "mask": "", "bbox": {"w": 155, "h": 232}}, {"master": "鲜于枢", "script": "草书", "dynasty": "元代", "source": "帖", "stroke_style": "中锋迅猛", "structure": "结构夸张，纵逸豪放", "desc": "纵逸豪放，用笔迅猛，结构夸张，整体气势强烈，富有草原民族豪放气质。", "quality": "blurry", "img": "imgs/21476/鲜于枢.png", "mask": "", "bbox": {"w": 187, "h": 221}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21476/张即之.png", "mask": "", "bbox": {"w": 138, "h": 134}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21476/智永.png", "mask": "", "bbox": {"w": 138, "h": 133}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21476/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 121}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21476/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 106}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21476/赵孟頫.png", "mask": "", "bbox": {"w": 138, "h": 116}}, {"master": "魏碑", "script": "楷书", "dynasty": "南北朝", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21476/魏碑.png", "mask": "", "bbox": {"w": 138, "h": 118}}]}