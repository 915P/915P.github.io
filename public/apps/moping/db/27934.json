{"char": "洞", "samples": [{"master": "倪元璐", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "渴笔涩行", "structure": "结体险绝，欹侧奇崛", "desc": "用笔多用渴墨（枯笔），线条生涩，结体险绝。", "quality": "blurry", "img": "imgs/27934/倪元璐.png", "mask": "", "bbox": {"w": 220, "h": 220}}, {"master": "王铎", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "翻折顿挫", "structure": "中宫疏朗，欹正相生", "desc": "不以端整取胜。以行草笔意入楷，结体多取纵势，中宫不紧，字形欹正相生。用笔富于提按变化，线条时见涩滞与翻折感，", "quality": "blurry", "img": "imgs/27934/王铎.png", "mask": "", "bbox": {"w": 213, "h": 157}}, {"master": "米芾", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "八面出锋", "structure": "结体奇肆，纵横飞动", "desc": "超迈入神，殆非侧勒，趯策，掠啄，磔所能束缚也。如天马脱衔，追风逐电，虽不可范，以驰驱之节，要自不妨痛快。书如游龙，跃渊，骏焉，得御，矫然，拔秀，诚不可攀也。", "quality": "blurry", "img": "imgs/27934/米芾.png", "mask": "", "bbox": {"w": 225, "h": 207}}, {"master": "怀素", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "藏锋内转", "structure": "结法谨密，回旋多变", "desc": "狂草。笔法瘦硬，称为“铁线描”，速度极快，回旋进退，如骤雨旋风。援毫掣电，随手万变。超妙自得，笔老而意新。虽率意颠逸，千变万化，终不离晋法度故也。结法极谨密，微有不可识者。藏锋内转，瘦硬通神，而颠墨挫毫，无碎缺。", "quality": "clear", "img": "imgs/27934/怀素.png", "mask": "", "bbox": {"w": 212, "h": 197}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27934/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 116}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27934/张即之.png", "mask": "", "bbox": {"w": 138, "h": 132}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27934/智永.png", "mask": "", "bbox": {"w": 138, "h": 135}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27934/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 126}}, 