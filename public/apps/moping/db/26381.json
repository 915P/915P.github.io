{"char": "服", "samples": [{"master": "唐玄宗", "script": "隶书", "dynasty": "唐代", "source": "碑", "stroke_style": "波磔丰满", "structure": "结构严整，方正丰腴", "desc": "虽有唐人习气，而端严庄重。字形肥硕，笔画丰满，挑法明显，结构严整，尽显盛唐丰腴之美。", "quality": "clear", "img": "imgs/26381/唐玄宗.png", "mask": "", "bbox": {"w": 246, "h": 140}}, {"master": "王献之", "script": "行书", "dynasty": "晋代", "source": "碑", "stroke_style": "连绵外拓", "structure": "结体秀逸，外拓奔放", "desc": "运笔连绵不绝，气势豪迈，外露和奔放，挺然秀出，极草纵之致。", "quality": "clear", "img": "imgs/26381/王献之.png", "mask": "", "bbox": {"w": 228, "h": 185}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "blurry", "img": "imgs/26381/智永.png", "mask": "", "bbox": {"w": 228, "h": 201}}, {"master": "林散之", "script": "隶书", "dynasty": "现代", "source": "帖", "stroke_style": "草意圆转", "structure": "结体舒展，高古灵动", "desc": "以汉隶为基，掺入草意。线条柔韧，墨色苍润，结体不拘泥于扁方，显出一种高古而灵动的意趣。", "quality": "clear", "img": "imgs/26381/林散之.png", "mask": "", "bbox": {"w": 243, "h": 110}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26381/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 95}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26381/张即之.png", "mask": "", "bbox": {"w": 138, "h": 131}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26381/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 133}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26381/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 97}}, {"master": "虞世南", "script": "楷书", "dynasty