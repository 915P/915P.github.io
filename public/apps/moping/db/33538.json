{"char": "茂", "samples": [{"master": "钟繇", "script": "楷书", "dynasty": "三国", "source": "碑", "stroke_style": "结构严谨", "structure": "笔势遒劲雄强，如壮士拔剑，森然有威", "desc": "妙绝古法，笔势刚劲，笔势遒劲，结构严谨，精妙绝伦，姿态万千。如云鹄游天，群鸿戏海。笔力遒劲，如壮士拔剑，森然有威。笔势雄强，气韵生动，如龙腾虎跃，气势磅礴。", "quality": "blurry", "img": "imgs/33538/钟繇.png", "mask": "", "bbox": {"w": 204, "h": 250}}, {"master": "徐渭", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "疾涩奔突", "structure": "结体解构，大小悬殊", "desc": "纵横不羁，极度纵放，用笔迅疾而多断裂感，线条枯湿强烈对比，提按夸张，笔势奔突。结体往往解构传统形态，字形大小悬殊，空间高度自由。", "quality": "blurry", "img": "imgs/33538/徐渭.png", "mask": "", "bbox": {"w": 126, "h": 231}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "blurry", "img": "imgs/33538/智永.png", "mask": "", "bbox": {"w": 183, "h": 235}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/33538/颜真卿.png", "mask": "", "bbox": {"w": 134, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/33538/张即之.png", "mask": "", "bbox": {"w": 121, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/33538/柳公权.png", "mask": "", "bbox": {"w": 131, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/33538/沈尹默.png", "mask": "", "bbox": {"w": 114, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/33538/虞世南.png", "mask": "", "bbox": {"w": 124, "h": 138}}, {"master": "赵之谦"