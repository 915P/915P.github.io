{"char": "俯", "samples": [{"master": "孙过庭", "script": "草书", "dynasty": "唐代", "source": "碑", "stroke_style": "笔法精微，提按清晰", "structure": "结体疏朗简约", "desc": "法度严谨而流美自然，笔法精微，提按清晰，结体疏朗。工于用笔，俊拔刚断，尚异好奇，凌越险阻。如丹崖绝壑，笔势坚劲。", "quality": "clear", "img": "imgs/20463/孙过庭.png", "mask": "", "bbox": {"w": 214, "h": 214}}, {"master": "张旭", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "连绵回绕", "structure": "结体纵逸，起伏跌宕", "desc": "变动犹鬼神，不可端倪。狂草。连绵回绕，起伏跌宕，千变万化，气势如虹，惊心动魄。", "quality": "clear", "img": "imgs/20463/张旭.png", "mask": "", "bbox": {"w": 229, "h": 204}}, {"master": "王铎", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "中侧并用", "structure": "结体欹侧夸张，大起大落", "desc": "翻转激荡，气势逼人，纵横恣肆，以强烈的连绵与翻转取势，字势大起大落，结体欹侧夸张，线条多中侧锋并用，提按对比剧烈。用墨浓枯交错。", "quality": "clear", "img": "imgs/20463/王铎.png", "mask": "", "bbox": {"w": 231, "h": 216}}, {"master": "苏轼", "script": "楷书", "dynasty": "宋代", "source": "帖", "stroke_style": "藏锋丰腴", "structure": "结体宽博，丰腴稳重", "desc": "以淳古重。东坡丰艳，脱尽绳墨，藏锋敛锷。重而肉稍肥。匀稳妍妙，风神在披拂间，而微欲近碑侧，记行稍自结，虽有墨猪之诮，最为淳古。肉丰而骨劲，态浓而意淡，巧于拙，特为秀伟。", "quality": "blurry", "img": "imgs/20463/苏轼.png", "mask": "", "bbox": {"w": 218, "h": 213}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20463/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 108}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20463/张即之.png", "mask": "", "bbox": {"w": 135, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20463/智永.png", "mask": "", "bbox": {"w": 138, "h": 132}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20463/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 111}}, {"master": "沈尹