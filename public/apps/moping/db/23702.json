{"char": "岖", "samples": [{"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "clear", "img": "imgs/23702/苏轼.png", "mask": "", "bbox": {"w": 227, "h": 179}}, {"master": "文征明", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "苍劲流畅", "structure": "结体修长，疏朗秀逸", "desc": "苍劲流畅，晚年愈发老辣，风姿绰约。", "quality": "blurry", "img": "imgs/23702/文征明.png", "mask": "", "bbox": {"w": 206, "h": 164}}, {"master": "董其昌", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "轻灵含蓄", "structure": "结体疏朗平正", "desc": "疏淡清远，强调空间经营，行书节奏舒缓，连带自然，用笔轻灵，行气疏通。字形多取平正，不刻意追求速度与张力。", "quality": "blurry", "img": "imgs/23702/董其昌.png", "mask": "", "bbox": {"w": 203, "h": 212}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23702/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 96}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23702/张即之.png", "mask": "", "bbox": {"w": 138, "h": 124}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23702/智永.png", "mask": "", "bbox": {"w": 138, "h": 112}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23702/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 118}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23702/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 103}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", 