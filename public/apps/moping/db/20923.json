{"char": "冻", "samples": [{"master": "于右任", "script": "草书", "dynasty": "民国", "source": "帖", "stroke_style": "碑意苍辣", "structure": "结构欹侧，气脉贯通", "desc": "以碑法入草，别开生面，章草与今草融通，用笔苍辣老健，线条枯润并存，结构欹侧而气脉贯通，整体呈现“碑意入草”的金石气。", "quality": "blurry", "img": "imgs/20923/于右任.png", "mask": "", "bbox": {"w": 223, "h": 222}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐代", "source": "帖", "stroke_style": "方折劲健", "structure": "中宫紧凑，结构严谨", "desc": "高重碑字，书锋力俱完，故特为佳。骨力遒劲，结构严谨，中宫紧凑，点画爽利，挺拔劲峭。", "quality": "blurry", "img": "imgs/20923/柳公权.png", "mask": "", "bbox": {"w": 214, "h": 227}}, {"master": "颜真卿", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "篆籀中锋", "structure": "结构稳健，宽博雄浑", "desc": "以楷法入行，笔力雄浑，结构稳健，不尚轻逸而重气骨。纵横奔逸，气势连贯。笔意激切，真情流露。行笔跌宕，痛快淋漓。通篇气脉贯注，一气呵成。", "quality": "blurry", "img": "imgs/20923/颜真卿.png", "mask": "", "bbox": {"w": 180, "h": 235}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20923/张即之.png", "mask": "", "bbox": {"w": 117, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20923/智永.png", "mask": "", "bbox": {"w": 138, "h": 133}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20923/沈尹默.png", "mask": "", "bbox": {"w": 133, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20923/虞世南.png", "mask": "", "bbox": {"w": 130, "h": 137}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20923/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 113}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structur