{"char": "共", "samples": [{"master": "宋高宗", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "圆转精到", "structure": "结构端庄，圆润流美", "desc": "圆润流利，规范端庄，用笔精到，具有典型的皇家富贵气和晋唐法度。", "quality": "clear", "img": "imgs/20849/宋高宗.png", "mask": "", "bbox": {"w": 191, "h": 196}}, {"master": "王羲之", "script": "楷书", "dynasty": "晋代", "source": "碑", "stroke_style": "藏锋精到", "structure": "结构严谨，中和端正", "desc": "用笔内振而收敛，故森严而有法度，点画精到，结构完美，不激不厉，中和之美。", "quality": "blurry", "img": "imgs/20849/王羲之.png", "mask": "", "bbox": {"w": 226, "h": 192}}, {"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "clear", "img": "imgs/20849/苏轼.png", "mask": "", "bbox": {"w": 231, "h": 186}}, {"master": "于右任", "script": "草书", "dynasty": "民国", "source": "帖", "stroke_style": "碑意苍辣", "structure": "结构欹侧，气脉贯通", "desc": "以碑法入草，别开生面，章草与今草融通，用笔苍辣老健，线条枯润并存，结构欹侧而气脉贯通，整体呈现“碑意入草”的金石气。", "quality": "blurry", "img": "imgs/20849/于右任.png", "mask": "", "bbox": {"w": 209, "h": 201}}, {"master": "唐寅", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转妍美", "structure": "结体俊逸，疏朗妍美", "desc": "笔法圆转妍美，结体俊逸，书卷气浓，潇洒流落，风流倜傥。", "quality": "blurry", "img": "imgs/20849/唐寅.png", "mask": "", "bbox": {"w": 235, "h": 223}}, {"master": "王献之", "script": "草书", "dynasty": "晋代", "source": "帖", "stroke_style": "藏锋连绵", "structure": "结体妍雅平稳，气脉贯通", "desc": "圆转流美，以圆转流美取胜，笔画多绵连而不板滞，线条柔韧含蓄，起止多藏锋，强调气脉贯通而弱化笔画棱角。结体趋于妍雅平稳，节奏舒缓而富有韵致。", "quality": "blurry", "img": "imgs/20849/王献之.png", "mask": "", "bbox": {"w": 201, "h": 236}}, {"master": "褚遂良", "script": "楷书", "dynasty": "唐代", "source": "帖", "stroke_style": "瘦劲含蓄", "structure": "结体宽博灵动，多姿多态", "desc": "瘦而不弱，笔划极富变化，线条有弹性，结体宽博灵动，多姿多态，空灵飞动。笔瘦劲挺拔，线条富弹性，转折处锋芒内敛。结体严谨而不板滞，姿态清秀中见劲健。", "quality": "blurry", "img": "imgs/20849/褚遂良.png", "mask": "", "bbox": {"w": 228, "h": 181}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20849/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 108}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20849/张即之.png", "mask": "", "bbox": {"w": 138, "h": 118}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20849/智永.png", "mask": "", "bbox": {"w": 106, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20849/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 121}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20849/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 94}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20849/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 110}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20849/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 114}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20849/赵孟頫.png", "mask": "", "bbox": {"w": 138, "h": 103}}]}