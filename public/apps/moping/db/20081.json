{"char": "乱", "samples": [{"master": "傅山", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "率意纵肆", "structure": "结体奇特，纵逸不拘", "desc": "与草书类似，强调直抒胸臆。结体奇特，墨色淋漓，不拘成法，真气弥满。", "quality": "clear", "img": "imgs/20081/傅山.png", "mask": "", "bbox": {"w": 199, "h": 236}}, {"master": "董其昌", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "平稳含蓄", "structure": "中宫虚和，结体疏朗", "desc": "楷书结构疏朗，中宫虚和，用笔平稳含蓄，点画不尚锋芒而重整体气息。强调字内空间与章法呼应，追求“淡而有味”的审美取向，弱化力量感而突出文人书卷气。", "quality": "clear", "img": "imgs/20081/董其昌.png", "mask": "", "bbox": {"w": 223, "h": 188}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元代", "source": "碑", "stroke_style": "圆润遒劲", "structure": "结体妍丽，平正宽绰", "desc": "笔既流利，学亦渊深，得心应手，会意成文。结体研丽，用笔遒劲。风格整暇，意度清和。书于规矩之中，中自有神仙蜕骨风度。", "quality": "blurry", "img": "imgs/20081/赵孟頫.png", "mask": "", "bbox": {"w": 228, "h": 194}}, {"master": "于右任", "script": "草书", "dynasty": "民国", "source": "帖", "stroke_style": "碑意苍辣", "structure": "结构欹侧，气脉贯通", "desc": "以碑法入草，别开生面，章草与今草融通，用笔苍辣老健，线条枯润并存，结构欹侧而气脉贯通，整体呈现“碑意入草”的金石气。", "quality": "clear", "img": "imgs/20081/于右任.png", "mask": "", "bbox": {"w": 234, "h": 193}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐代", "source": "帖", "stroke_style": "方折劲健", "structure": "中宫紧凑，结构严谨", "desc": "高重碑字，书锋力俱完，故特为佳。骨力遒劲，结构严谨，中宫紧凑，点画爽利，挺拔劲峭。", "quality": "blurry", "img": "imgs/20081/柳公权.png", "mask": "", "bbox": {"w": 200, "h": 209}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "blurry", "img": "imgs/20081/米芾.png", "mask": "", "bbox": {"w": 210, "h": 235}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20081/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 120}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": 