{"char": "媒", "samples": [{"master": "赵孟頫", "script": "楷书", "dynasty": "元代", "source": "碑", "stroke_style": "圆润遒劲", "structure": "结体妍丽，平正宽绰", "desc": "笔既流利，学亦渊深，得心应手，会意成文。结体研丽，用笔遒劲。风格整暇，意度清和。书于规矩之中，中自有神仙蜕骨风度。", "quality": "blurry", "img": "imgs/23186/赵孟頫.png", "mask": "", "bbox": {"w": 240, "h": 188}}, {"master": "刘墉", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "藏锋厚重", "structure": "结体内敛，敦厚稳重", "desc": "如绵裹铁，墨色厚重，人称“墨猪”，实则“棉里裹针”。初看丰肥，内含筋骨，结体虽然不够舒展，但有一种含蓄敦厚的静气。", "quality": "blurry", "img": "imgs/23186/刘墉.png", "mask": "", "bbox": {"w": 174, "h": 137}}, {"master": "黄庭坚", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "提按纵横", "structure": "结体开张，纵横奇崛", "desc": "见长年荡桨，乃悟笔法。清圆妙丽，引绳贯珠。虽昂藏郁拔，而神闲，意秾。变态纵横，势若飞鹤之名书，法妍媚，笔势纵横。无一笔不自空中，荡漾而又沈著痛快。", "quality": "blurry", "img": "imgs/23186/黄庭坚.png", "mask": "", "bbox": {"w": 222, "h": 242}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23186/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 101}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23186/张即之.png", "mask": "", "bbox": {"w": 138, "h": 116}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23186/智永.png", "mask": "", "bbox": {"w": 132, "h": 114}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23186/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 111}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23186/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 112}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_styl