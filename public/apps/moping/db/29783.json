{"char": "瑗", "samples": [{"master": "苏轼", "script": "楷书", "dynasty": "宋代", "source": "帖", "stroke_style": "藏锋丰腴", "structure": "结体宽博，丰腴稳重", "desc": "以淳古重。东坡丰艳，脱尽绳墨，藏锋敛锷。重而肉稍肥。匀稳妍妙，风神在披拂间，而微欲近碑侧，记行稍自结，虽有墨猪之诮，最为淳古。肉丰而骨劲，态浓而意淡，巧于拙，特为秀伟。", "quality": "blurry", "img": "imgs/29783/苏轼.png", "mask": "", "bbox": {"w": 233, "h": 195}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29783/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 118}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29783/张即之.png", "mask": "", "bbox": {"w": 138, "h": 112}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29783/智永.png", "mask": "", "bbox": {"w": 137, "h": 134}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29783/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 126}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29783/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 113}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29783/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 112}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29783/赵孟頫.png", "mask": "", "bbox": {"w": 138, "h": 108}}, {"master": "魏碑", "script": "楷书", "dynasty": "南北朝", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29783/魏碑.png", "mask": "", "bbox": {"w": 138, "h":