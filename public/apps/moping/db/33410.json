{"char": "节", "samples": [{"master": "伊秉绶", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "波磔内敛", "structure": "结构方正充实，横平竖直", "desc": "宽博平正，波磔内敛，结构端庄肃穆。结体方正充实，横平竖直，减省蚕头燕尾，具有强烈的装饰感和建筑美，气象博大。", "quality": "blurry", "img": "imgs/33410/伊秉绶.png", "mask": "", "bbox": {"w": 172, "h": 222}}, {"master": "倪元璐", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "渴笔涩行", "structure": "结体险绝，欹侧奇崛", "desc": "用笔多用渴墨（枯笔），线条生涩，结体险绝。", "quality": "clear", "img": "imgs/33410/倪元璐.png", "mask": "", "bbox": {"w": 102, "h": 244}}, {"master": "成亲王", "script": "草书", "dynasty": "清代", "source": "碑", "stroke_style": "圆转流畅", "structure": "结构规整，端庄典雅", "desc": "流畅圆转，规矩中见功力。典型的“馆阁体”最高水准，富贵典雅。", "quality": "blurry", "img": "imgs/33410/成亲王.png", "mask": "", "bbox": {"w": 132, "h": 218}}, {"master": "褚遂良", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "楷法劲健", "structure": "结体严整，清秀灵动", "desc": "以楷法为骨，行气清晰，线条劲健而不纵逸，连带克制。整体呈现出清秀、严整而略带灵动的面貌。", "quality": "clear", "img": "imgs/33410/褚遂良.png", "mask": "", "bbox": {"w": 142, "h": 230}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "blurry", "img": "imgs/33410/智永.png", "mask": "", "bbox": {"w": 136, "h": 211}}, {"master": "金农", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "方折生涩", "structure": "结构夸张，古拙奇崛", "desc": "方笔为主，线条粗重，刻意生涩，结构夸张，强调金石气与拙朴美感。", "quality": "blurry", "img": "imgs/33410/金农.png", "mask": "", "bbox": {"w": 215, "h": 167}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/33410/颜真卿.png", "mask": "", "bbox": {"w": 105, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/33410/张即之.p