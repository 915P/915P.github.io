{"char": "回", "samples": [{"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "clear", "img": "imgs/22238/蔡襄.png", "mask": "", "bbox": {"w": 209, "h": 158}}, {"master": "鲜于枢", "script": "行书", "dynasty": "元代", "source": "碑", "stroke_style": "悬腕中锋", "structure": "结体修长圆活", "desc": "悬腕中锋，笔力劲健，结体修长圆活，气势雄伟，善用长锋。", "quality": "blurry", "img": "imgs/22238/鲜于枢.png", "mask": "", "bbox": {"w": 194, "h": 108}}, {"master": "祝允明", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "连带纵逸", "structure": "结体欹侧，跌宕多变", "desc": "纵而能敛，狂而不怪，连带自然，结体多欹侧变化，字势跌宕起伏，行气贯通而富节奏感。", "quality": "blurry", "img": "imgs/22238/祝允明.png", "mask": "", "bbox": {"w": 231, "h": 151}}, {"master": "董其昌", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "轻灵含蓄", "structure": "结体疏朗平正", "desc": "疏淡清远，强调空间经营，行书节奏舒缓，连带自然，用笔轻灵，行气疏通。字形多取平正，不刻意追求速度与张力。", "quality": "blurry", "img": "imgs/22238/董其昌.png", "mask": "", "bbox": {"w": 189, "h": 146}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22238/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 97}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22238/张即之.png", "mask": "", "bbox": {"w": 138, "h": 89}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22238/智永.png", "mask": "", "bbox": {"w": 138, "h": 94}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22238/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 121}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": n