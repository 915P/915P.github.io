{"char": "剪", "samples": [{"master": "褚遂良", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "楷法劲健", "structure": "结体严整，清秀灵动", "desc": "以楷法为骨，行气清晰，线条劲健而不纵逸，连带克制。整体呈现出清秀、严整而略带灵动的面貌。", "quality": "blurry", "img": "imgs/21098/褚遂良.png", "mask": "", "bbox": {"w": 180, "h": 235}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "篆籀中锋", "structure": "结体方正宽博，重心安稳", "desc": "雄浑博大，其书气象森严，骨力遒劲，点画厚重，沉着有力。结体方正宽博，不尚纤巧。字势端严，重心安稳。", "quality": "clear", "img": "imgs/21098/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 236}}, {"master": "王羲之", "script": "行书", "dynasty": "晋代", "source": "帖", "stroke_style": "圆转精微", "structure": "结体疏朗平衡，欹正相生", "desc": "飘若游云，矫若惊龙。字势雄逸，如龙腾天门，虎卧凤阁。字法清润，全是章草笔意。自然流畅、情法兼备为核心特征，笔画圆转而富弹性，提按变化细腻而不露痕迹。结体疏朗平衡，欹正相生，字与字之间通过行气自然贯通。", "quality": "clear", "img": "imgs/21098/王羲之.png", "mask": "", "bbox": {"w": 143, "h": 217}}, {"master": "董其昌", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "轻灵含蓄", "structure": "结体疏朗平正", "desc": "疏淡清远，强调空间经营，行书节奏舒缓，连带自然，用笔轻灵，行气疏通。字形多取平正，不刻意追求速度与张力。", "quality": "blurry", "img": "imgs/21098/董其昌.png", "mask": "", "bbox": {"w": 165, "h": 240}}, {"master": "黄庭坚", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "提按纵横", "structure": "结体开张，纵横奇崛", "desc": "见长年荡桨，乃悟笔法。清圆妙丽，引绳贯珠。虽昂藏郁拔，而神闲，意秾。变态纵横，势若飞鹤之名书，法妍媚，笔势纵横。无一笔不自空中，荡漾而又沈著痛快。", "quality": "blurry", "img": "imgs/21098/黄庭坚.png", "mask": "", "bbox": {"w": 182, "h": 195}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21098/张即之.png", "mask": "", "bbox": {"w": 115, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21098/智永.png", "mask": "", "bbox": {"w": 120, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21098/柳公权.png", "mask": "", "bbox": {"w": 106, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21098/沈尹默.png", "mask": "", "bbox": {"w": 121, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21098/虞世南.png", "mask": "", "bbox": {"w": 127, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21098/赵之谦.png", "mask": "", "bbox": {"w": 97, "h": 138}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21098/赵孟頫.png", "mask": "", "bbox": {"w": 90, "h": 138}}]}