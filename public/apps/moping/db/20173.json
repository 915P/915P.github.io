{"char": "仍", "samples": [{"master": "于右任", "script": "楷书", "dynasty": "民国", "source": "碑", "stroke_style": "碑意朴厚", "structure": "结体方整，古拙朴厚", "desc": "融碑入帖，结体方整而不板滞，线条朴厚，具有明显碑刻意味。", "quality": "blurry", "img": "imgs/20173/于右任.png", "mask": "", "bbox": {"w": 202, "h": 215}}, {"master": "孙过庭", "script": "草书", "dynasty": "唐代", "source": "碑", "stroke_style": "笔法精微，提按清晰", "structure": "结体疏朗简约", "desc": "法度严谨而流美自然，笔法精微，提按清晰，结体疏朗。工于用笔，俊拔刚断，尚异好奇，凌越险阻。如丹崖绝壑，笔势坚劲。", "quality": "clear", "img": "imgs/20173/孙过庭.png", "mask": "", "bbox": {"w": 214, "h": 206}}, {"master": "王羲之", "script": "楷书", "dynasty": "晋代", "source": "碑", "stroke_style": "藏锋精到", "structure": "结构严谨，中和端正", "desc": "用笔内振而收敛，故森严而有法度，点画精到，结构完美，不激不厉，中和之美。", "quality": "blurry", "img": "imgs/20173/王羲之.png", "mask": "", "bbox": {"w": 243, "h": 165}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元代", "source": "碑", "stroke_style": "圆润遒劲", "structure": "结体妍丽，平正宽绰", "desc": "笔既流利，学亦渊深，得心应手，会意成文。结体研丽，用笔遒劲。风格整暇，意度清和。书于规矩之中，中自有神仙蜕骨风度。", "quality": "blurry", "img": "imgs/20173/赵孟頫.png", "mask": "", "bbox": {"w": 212, "h": 203}}, {"master": "祝允明", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "连带纵逸", "structure": "结体欹侧，跌宕多变", "desc": "纵而能敛，狂而不怪，连带自然，结体多欹侧变化，字势跌宕起伏，行气贯通而富节奏感。", "quality": "blurry", "img": "imgs/20173/祝允明.png", "mask": "", "bbox": {"w": 204, "h": 212}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "blurry", "img": "imgs/20173/米芾.png", "mask": "", "bbox": {"w": 205, "h": 189}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20173/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 111}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure"