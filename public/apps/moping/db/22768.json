{"char": "声", "samples": [{"master": "傅山", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "率意纵肆", "structure": "结体奇特，纵逸不拘", "desc": "与草书类似，强调直抒胸臆。结体奇特，墨色淋漓，不拘成法，真气弥满。", "quality": "clear", "img": "imgs/22768/傅山.png", "mask": "", "bbox": {"w": 186, "h": 247}}, {"master": "吴昌硕", "script": "隶书", "dynasty": "民国", "source": "碑", "stroke_style": "中锋朴厚", "structure": "结体偏长，左低右高", "desc": "一意求中锋平直，且隶且篆。以《石鼓文》笔意写隶。结体偏长，左低右高，线条浑金璞玉，苍茫古朴。", "quality": "clear", "img": "imgs/22768/吴昌硕.png", "mask": "", "bbox": {"w": 245, "h": 236}}, {"master": "朱熹", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "中锋厚重", "structure": "结体端正，刚健沉稳", "desc": "汉魏风骨，无半点俗气。不求态势，强调笔墨沉着。用笔中锋，点画厚重，结体端正，有一股刚正的儒家正气。", "quality": "blurry", "img": "imgs/22768/朱熹.png", "mask": "", "bbox": {"w": 92, "h": 184}}, {"master": "李阳冰", "script": "篆书", "dynasty": "唐代", "source": "碑", "stroke_style": "铁线圆劲", "structure": "结构严谨，匀称修长", "desc": "以瘦劲取胜，线条如“玉箸”，粗细划一，圆润婉转，法度极严。", "quality": "blurry", "img": "imgs/22768/李阳冰.png", "mask": "", "bbox": {"w": 184, "h": 236}}, {"master": "王宠", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "用笔含蓄克制，连带不多", "structure": "结体多呈欹正相生之态", "desc": "清疏一路，行而不纵，动而能收，行气平缓，用笔含蓄克制，连带不多，字字分明，结体多呈欹正相生之态。", "quality": "blurry", "img": "imgs/22768/王宠.png", "mask": "", "bbox": {"w": 134, "h": 238}}, {"master": "王铎", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "翻折顿挫", "structure": "中宫疏朗，欹正相生", "desc": "不以端整取胜。以行草笔意入楷，结体多取纵势，中宫不紧，字形欹正相生。用笔富于提按变化，线条时见涩滞与翻折感，", "quality": "blurry", "img": "imgs/22768/王铎.png", "mask": "", "bbox": {"w": 156, "h": 236}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元代", "source": "碑", "stroke_style": "圆润遒劲", "structure": "结体妍丽，平正宽绰", "desc": "笔既流利，学亦渊深，得心应手，会意成文。结体研丽，用笔遒劲。风格整暇，意度清和。书于规矩之中，中自有神仙蜕骨风度。", "quality": "blurry", "img": "imgs/22768/赵孟頫.png", "mask": "", "bbox": {"w": 242, "h": 251}}, {"master": "鲜于枢", "script": "行书", "dynasty": "元代", "source": "碑", "stroke_style": "悬腕中锋", "structure": "结体修长圆活", "desc": "悬腕中锋，笔力劲健，结体修长圆活，气势雄伟，善用长锋。", "quality": "blurry", "img": "imgs/22768/鲜于枢.png", "mask": "", "bbox": {"w": 165, "h": 237}}, {"master": "文征明", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "苍劲流畅", "structure": "结体修长，疏朗秀逸", "desc": "苍劲流畅，晚年愈发老辣，风姿绰约。", "quality": "blurry", "img": "imgs/22768/文征明.png", "mask": "", "bbox": {"w": 159, "h": 239}}, {"master": "沈周", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "中锋颤涩", "structure": "结构开张，拙朴雄强", "desc": "遒劲奇崛，用笔中锋，线条粗壮且多颤笔，结构开张，虽然略显拙朴，但苍劲有力。", "quality": "clear", "img": "imgs/22768/沈周.png", "mask": "", "bbox": {"w": 173, "h": 224}}, {"master": "董其昌", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "轻灵含蓄", "structure": "结体疏朗平正", "desc": "疏淡清远，强调空间经营，行书节奏舒缓，连带自然，用笔轻灵，行气疏通。字形多取平正，不刻意追求速度与张力。", "quality": "clear", "img": "imgs/22768/董其昌.png", "mask": "", "bbox": {"w": 135, "h": 217}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22768/颜真卿.png", "mask": "", "bbox": {"w": 115, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22768/张即之.png", "mask": "", "bbox": {"w": 120, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22768/智永.png", "mask": "", "bbox": {"w": 114, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22768/柳公权.png", "mask": "", "bbox": {"w": 110, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22768/沈尹默.png", "mask": "", "bbox": {"w": 115, "h": 137}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source"