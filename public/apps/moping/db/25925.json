{"char": "故", "samples": [{"master": "祝允明", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "中锋顿挫", "structure": "结体严谨，不板不滞", "desc": "守法而不激，结体严谨而不板滞，用笔中锋为主，点画分明，转折处见顿挫。", "quality": "blurry", "img": "imgs/25925/祝允明.png", "mask": "", "bbox": {"w": 242, "h": 158}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "圆润内刚", "structure": "结构沉静，外柔内刚", "desc": "字里金生，行间玉润。笔法圆润，外柔内刚，结构沉静，有一种君子温玉般的冲和之美。", "quality": "blurry", "img": "imgs/25925/虞世南.png", "mask": "", "bbox": {"w": 220, "h": 167}}, {"master": "邓石如", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "篆意圆劲", "structure": "结构自然舒展", "desc": "融篆入隶，线条圆劲流畅，结构自然舒展，波磔不事夸张，整体呈现古朴而生动的面貌。", "quality": "blurry", "img": "imgs/25925/邓石如.png", "mask": "", "bbox": {"w": 232, "h": 139}}, {"master": "宋徽宗", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "铁线方折", "structure": "结体瘦长，连绵飞动", "desc": "如狂草，动中有静。笔法承袭其“瘦金体”，线条细劲如铁线，狂放疾驰，转折处如切金断玉，连绵不断。", "quality": "clear", "img": "imgs/25925/宋徽宗.png", "mask": "", "bbox": {"w": 235, "h": 214}}, {"master": "林散之", "script": "隶书", "dynasty": "现代", "source": "帖", "stroke_style": "草意圆转", "structure": "结体舒展，高古灵动", "desc": "以汉隶为基，掺入草意。线条柔韧，墨色苍润，结体不拘泥于扁方，显出一种高古而灵动的意趣。", "quality": "clear", "img": "imgs/25925/林散之.png", "mask": "", "bbox": {"w": 233, "h": 143}}, {"master": "沈周", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "中锋颤涩", "structure": "结构开张，拙朴雄强", "desc": "遒劲奇崛，用笔中锋，线条粗壮且多颤笔，结构开张，虽然略显拙朴，但苍劲有力。", "quality": "blurry", "img": "imgs/25925/沈周.png", "mask": "", "bbox": {"w": 217, "h": 201}}, {"master": "邓石如", "script": "篆书", "dynasty": "清代", "source": "帖", "stroke_style": "中锋圆劲", "structure": "结构严谨，匀称舒展", "desc": "线条圆润匀称，起止自然，结构严谨而不板滞，强调书写节奏与线条弹性", "quality": "blurry", "img": "imgs/25925/邓石如.png", "mask": "", "bbox": {"w": 135, "h": 241}}, {"master": "黄庭坚", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "提按纵横", "structure": "结体开张，纵横奇崛", "desc": "见长年荡桨，乃悟笔法。清圆妙丽，引绳贯珠。虽昂藏郁拔，而神闲，意秾。变态纵横