{"char": "殊", "samples": [{"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "clear", "img": "imgs/27530/蔡襄.png", "mask": "", "bbox": {"w": 223, "h": 187}}, {"master": "鲜于枢", "script": "行书", "dynasty": "元代", "source": "碑", "stroke_style": "悬腕中锋", "structure": "结体修长圆活", "desc": "悬腕中锋，笔力劲健，结体修长圆活，气势雄伟，善用长锋。", "quality": "blurry", "img": "imgs/27530/鲜于枢.png", "mask": "", "bbox": {"w": 202, "h": 206}}, {"master": "傅山", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转纵肆", "structure": "结体缠绕奇肆", "desc": "粗头乱服式线条，强调自然率真与生拙之美，笔势跌宕，墨法枯涩，极具反规范倾向。主张“宁拙毋巧”。连绵缠绕，圆转不休，气势磅礴，有一种乱头粗服、不加修饰的狂放之美。", "quality": "clear", "img": "imgs/27530/傅山.png", "mask": "", "bbox": {"w": 203, "h": 246}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27530/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 117}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27530/张即之.png", "mask": "", "bbox": {"w": 138, "h": 123}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27530/智永.png", "mask": "", "bbox": {"w": 138, "h": 131}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27530/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 111}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27530/沈尹默.png", "mask": "", "bbox": {"w": 135, "h": 113}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null,