{"char": "互", "samples": [{"master": "于右任", "script": "草书", "dynasty": "民国", "source": "帖", "stroke_style": "碑意苍辣", "structure": "结构欹侧，气脉贯通", "desc": "以碑法入草，别开生面，章草与今草融通，用笔苍辣老健，线条枯润并存，结构欹侧而气脉贯通，整体呈现“碑意入草”的金石气。", "quality": "clear", "img": "imgs/20114/于右任.png", "mask": "", "bbox": {"w": 173, "h": 227}}, {"master": "张旭", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "连绵回绕", "structure": "结体纵逸，起伏跌宕", "desc": "变动犹鬼神，不可端倪。狂草。连绵回绕，起伏跌宕，千变万化，气势如虹，惊心动魄。", "quality": "blurry", "img": "imgs/20114/张旭.png", "mask": "", "bbox": {"w": 207, "h": 222}}, {"master": "怀素", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "藏锋内转", "structure": "结法谨密，回旋多变", "desc": "狂草。笔法瘦硬，称为“铁线描”，速度极快，回旋进退，如骤雨旋风。援毫掣电，随手万变。超妙自得，笔老而意新。虽率意颠逸，千变万化，终不离晋法度故也。结法极谨密，微有不可识者。藏锋内转，瘦硬通神，而颠墨挫毫，无碎缺。", "quality": "blurry", "img": "imgs/20114/怀素.png", "mask": "", "bbox": {"w": 198, "h": 193}}, {"master": "鲜于枢", "script": "草书", "dynasty": "元代", "source": "帖", "stroke_style": "中锋迅猛", "structure": "结构夸张，纵逸豪放", "desc": "纵逸豪放，用笔迅猛，结构夸张，整体气势强烈，富有草原民族豪放气质。", "quality": "blurry", "img": "imgs/20114/鲜于枢.png", "mask": "", "bbox": {"w": 168, "h": 203}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20114/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 104}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20114/张即之.png", "mask": "", "bbox": {"w": 138, "h": 129}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20114/智永.png", "mask": "", "bbox": {"w": 138, "h": 114}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20114/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 122}}, {"master": "沈尹默", "sc