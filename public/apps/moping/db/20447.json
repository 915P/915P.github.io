{"char": "俟", "samples": [{"master": "米芾", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "八面出锋", "structure": "结体奇肆，纵横飞动", "desc": "超迈入神，殆非侧勒，趯策，掠啄，磔所能束缚也。如天马脱衔，追风逐电，虽不可范，以驰驱之节，要自不妨痛快。书如游龙，跃渊，骏焉，得御，矫然，拔秀，诚不可攀也。", "quality": "clear", "img": "imgs/20447/米芾.png", "mask": "", "bbox": {"w": 161, "h": 225}}, {"master": "钟繇", "script": "楷书", "dynasty": "三国", "source": "碑", "stroke_style": "结构严谨", "structure": "笔势遒劲雄强，如壮士拔剑，森然有威", "desc": "妙绝古法，笔势刚劲，笔势遒劲，结构严谨，精妙绝伦，姿态万千。如云鹄游天，群鸿戏海。笔力遒劲，如壮士拔剑，森然有威。笔势雄强，气韵生动，如龙腾虎跃，气势磅礴。", "quality": "blurry", "img": "imgs/20447/钟繇.png", "mask": "", "bbox": {"w": 220, "h": 205}}, {"master": "张瑞图", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "侧锋方折", "structure": "横向取势，奇峭紧密", "desc": "侧锋偏锋并用，翻折方硬，横向取势，节奏紧凑，风格尖利奇峭，别具一格。", "quality": "blurry", "img": "imgs/20447/张瑞图.png", "mask": "", "bbox": {"w": 222, "h": 221}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20447/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 110}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20447/张即之.png", "mask": "", "bbox": {"w": 134, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20447/智永.png", "mask": "", "bbox": {"w": 138, "h": 137}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20447/柳公权.png", "mask": "", "bbox": {"w": 137, "h": 116}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20447/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 130}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "str