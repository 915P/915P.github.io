{"char": "恐", "samples": [{"master": "米芾", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "八面出锋", "structure": "结体奇肆，纵横飞动", "desc": "超迈入神，殆非侧勒，趯策，掠啄，磔所能束缚也。如天马脱衔，追风逐电，虽不可范，以驰驱之节，要自不妨痛快。书如游龙，跃渊，骏焉，得御，矫然，拔秀，诚不可攀也。", "quality": "clear", "img": "imgs/24656/米芾.png", "mask": "", "bbox": {"w": 203, "h": 147}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "圆润内刚", "structure": "结构沉静，外柔内刚", "desc": "字里金生，行间玉润。笔法圆润，外柔内刚，结构沉静，有一种君子温玉般的冲和之美。", "quality": "blurry", "img": "imgs/24656/虞世南.png", "mask": "", "bbox": {"w": 200, "h": 187}}, {"master": "邓石如", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "篆意圆劲", "structure": "结构自然舒展", "desc": "融篆入隶，线条圆劲流畅，结构自然舒展，波磔不事夸张，整体呈现古朴而生动的面貌。", "quality": "blurry", "img": "imgs/24656/邓石如.png", "mask": "", "bbox": {"w": 220, "h": 195}}, {"master": "傅山", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转纵肆", "structure": "结体缠绕奇肆", "desc": "粗头乱服式线条，强调自然率真与生拙之美，笔势跌宕，墨法枯涩，极具反规范倾向。主张“宁拙毋巧”。连绵缠绕，圆转不休，气势磅礴，有一种乱头粗服、不加修饰的狂放之美。", "quality": "blurry", "img": "imgs/24656/傅山.png", "mask": "", "bbox": {"w": 209, "h": 222}}, {"master": "张瑞图", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "侧锋方折", "structure": "横向取势，奇峭紧密", "desc": "侧锋偏锋并用，翻折方硬，横向取势，节奏紧凑，风格尖利奇峭，别具一格。", "quality": "clear", "img": "imgs/24656/张瑞图.png", "mask": "", "bbox": {"w": 183, "h": 209}}, {"master": "王羲之", "script": "行书", "dynasty": "晋代", "source": "帖", "stroke_style": "圆转精微", "structure": "结体疏朗平衡，欹正相生", "desc": "飘若游云，矫若惊龙。字势雄逸，如龙腾天门，虎卧凤阁。字法清润，全是章草笔意。自然流畅、情法兼备为核心特征，笔画圆转而富弹性，提按变化细腻而不露痕迹。结体疏朗平衡，欹正相生，字与字之间通过行气自然贯通。", "quality": "blurry", "img": "imgs/24656/王羲之.png", "mask": "", "bbox": {"w": 230, "h": 213}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24656/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 124}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24656/张即之.png", "mask": "", "bbox": {"w": 136, "h": 119}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24656/智永.png", "mask": "", "bbox": {"w": 138, "h": 123}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24656/柳公权.png", "mask": "", "bbox": {"w": 130, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24656/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 135}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24656/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 115}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24656/赵孟頫.png", "mask": "", "bbox": {"w": 138, "h": 108}}]}