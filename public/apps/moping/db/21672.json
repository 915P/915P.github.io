{"char": "咨", "samples": [{"master": "刘墉", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "藏锋厚重", "structure": "结体内敛，敦厚稳重", "desc": "如绵裹铁，墨色厚重，人称“墨猪”，实则“棉里裹针”。初看丰肥，内含筋骨，结体虽然不够舒展，但有一种含蓄敦厚的静气。", "quality": "blurry", "img": "imgs/21672/刘墉.png", "mask": "", "bbox": {"w": 177, "h": 170}}, {"master": "王羲之", "script": "行书", "dynasty": "晋代", "source": "帖", "stroke_style": "圆转精微", "structure": "结体疏朗平衡，欹正相生", "desc": "飘若游云，矫若惊龙。字势雄逸，如龙腾天门，虎卧凤阁。字法清润，全是章草笔意。自然流畅、情法兼备为核心特征，笔画圆转而富弹性，提按变化细腻而不露痕迹。结体疏朗平衡，欹正相生，字与字之间通过行气自然贯通。", "quality": "blurry", "img": "imgs/21672/王羲之.png", "mask": "", "bbox": {"w": 239, "h": 189}}, {"master": "董其昌", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "轻灵含蓄", "structure": "结体疏朗平正", "desc": "疏淡清远，强调空间经营，行书节奏舒缓，连带自然，用笔轻灵，行气疏通。字形多取平正，不刻意追求速度与张力。", "quality": "clear", "img": "imgs/21672/董其昌.png", "mask": "", "bbox": {"w": 173, "h": 221}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21672/颜真卿.png", "mask": "", "bbox": {"w": 137, "h": 91}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21672/张即之.png", "mask": "", "bbox": {"w": 138, "h": 109}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21672/智永.png", "mask": "", "bbox": {"w": 137, "h": 118}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21672/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 109}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21672/沈尹默.png", "mask": "", "bbox": {"w": 137, "h": 109}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source"