{"char": "新", "samples": [{"master": "徐渭", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "疾涩纵肆", "structure": "结体纵逸，大小错落", "desc": "八法之散圣，字林之侠客。笔墨如骤雨狂风，恣肆汪洋，点画狼藉，不计工拙，主要表现激越的情感。", "quality": "clear", "img": "imgs/26032/徐渭.png", "mask": "", "bbox": {"w": 103, "h": 241}}, {"master": "王献之", "script": "行书", "dynasty": "晋代", "source": "碑", "stroke_style": "连绵外拓", "structure": "结体秀逸，外拓奔放", "desc": "运笔连绵不绝，气势豪迈，外露和奔放，挺然秀出，极草纵之致。", "quality": "clear", "img": "imgs/26032/王献之.png", "mask": "", "bbox": {"w": 192, "h": 227}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "圆润内刚", "structure": "结构沉静，外柔内刚", "desc": "字里金生，行间玉润。笔法圆润，外柔内刚，结构沉静，有一种君子温玉般的冲和之美。", "quality": "blurry", "img": "imgs/26032/虞世南.png", "mask": "", "bbox": {"w": 207, "h": 218}}, {"master": "吴昌硕", "script": "篆书", "dynasty": "民国", "source": "帖", "stroke_style": "中锋遒劲", "structure": "结体欹侧，耸肩驼背", "desc": "如铸铁，如印泥。专攻《石鼓文》。用笔凝练遒劲，气度沉雄，打破了秦汉小篆的平衡，结体耸肩驼背，极具金石气。", "quality": "clear", "img": "imgs/26032/吴昌硕.png", "mask": "", "bbox": {"w": 197, "h": 242}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26032/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 126}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26032/张即之.png", "mask": "", "bbox": {"w": 138, "h": 132}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26032/智永.png", "mask": "", "bbox": {"w": 123, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26032/柳公权.png", "mask": "", "bbox": {"w": 135, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "str