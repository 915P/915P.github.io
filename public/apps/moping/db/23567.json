{"char": "小", "samples": [{"master": "成亲王", "script": "草书", "dynasty": "清代", "source": "碑", "stroke_style": "圆转流畅", "structure": "结构规整，端庄典雅", "desc": "流畅圆转，规矩中见功力。典型的“馆阁体”最高水准，富贵典雅。", "quality": "blurry", "img": "imgs/23567/成亲王.png", "mask": "", "bbox": {"w": 232, "h": 116}}, {"master": "钟繇", "script": "楷书", "dynasty": "三国", "source": "碑", "stroke_style": "结构严谨", "structure": "笔势遒劲雄强，如壮士拔剑，森然有威", "desc": "妙绝古法，笔势刚劲，笔势遒劲，结构严谨，精妙绝伦，姿态万千。如云鹄游天，群鸿戏海。笔力遒劲，如壮士拔剑，森然有威。笔势雄强，气韵生动，如龙腾虎跃，气势磅礴。", "quality": "clear", "img": "imgs/23567/钟繇.png", "mask": "", "bbox": {"w": 193, "h": 142}}, {"master": "唐寅", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转妍美", "structure": "结体俊逸，疏朗妍美", "desc": "笔法圆转妍美，结体俊逸，书卷气浓，潇洒流落，风流倜傥。", "quality": "blurry", "img": "imgs/23567/唐寅.png", "mask": "", "bbox": {"w": 233, "h": 129}}, {"master": "怀素", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "藏锋内转", "structure": "结法谨密，回旋多变", "desc": "狂草。笔法瘦硬，称为“铁线描”，速度极快，回旋进退，如骤雨旋风。援毫掣电，随手万变。超妙自得，笔老而意新。虽率意颠逸，千变万化，终不离晋法度故也。结法极谨密，微有不可识者。藏锋内转，瘦硬通神，而颠墨挫毫，无碎缺。", "quality": "clear", "img": "imgs/23567/怀素.png", "mask": "", "bbox": {"w": 215, "h": 156}}, {"master": "金农", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "方折生涩", "structure": "结构夸张，古拙奇崛", "desc": "方笔为主，线条粗重，刻意生涩，结构夸张，强调金石气与拙朴美感。", "quality": "clear", "img": "imgs/23567/金农.png", "mask": "", "bbox": {"w": 222, "h": 116}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23567/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 107}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23567/张即之.png", "mask": "", "bbox": {"w": 138, "h": 99}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23567/智永.png", "mask": "", "bbo