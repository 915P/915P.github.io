{"char": "力", "samples": [{"master": "智永", "script": "草书", "dynasty": "隋代", "source": "碑", "stroke_style": "藏锋圆转", "structure": "结体圆转，气脉连贯", "desc": "笔笔从空中落，从空中住，虽屋漏痕，犹不足以喻之。", "quality": "blurry", "img": "imgs/21147/智永.png", "mask": "", "bbox": {"w": 188, "h": 200}}, {"master": "王铎", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "翻折顿挫", "structure": "中宫疏朗，欹正相生", "desc": "不以端整取胜。以行草笔意入楷，结体多取纵势，中宫不紧，字形欹正相生。用笔富于提按变化，线条时见涩滞与翻折感，", "quality": "blurry", "img": "imgs/21147/王铎.png", "mask": "", "bbox": {"w": 157, "h": 189}}, {"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "clear", "img": "imgs/21147/苏轼.png", "mask": "", "bbox": {"w": 238, "h": 212}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "篆籀中锋", "structure": "结体方正宽博，重心安稳", "desc": "雄浑博大，其书气象森严，骨力遒劲，点画厚重，沉着有力。结体方正宽博，不尚纤巧。字势端严，重心安稳。", "quality": "clear", "img": "imgs/21147/颜真卿.png", "mask": "", "bbox": {"w": 175, "h": 219}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21147/张即之.png", "mask": "", "bbox": {"w": 116, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21147/柳公权.png", "mask": "", "bbox": {"w": 132, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21147/沈尹默.png", "mask": "", "bbox": {"w": 137, "h": 134}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21147/虞世南.png", "mask": "", "bbox": {