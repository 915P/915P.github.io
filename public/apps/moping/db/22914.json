{"char": "如", "samples": [{"master": "唐玄宗", "script": "隶书", "dynasty": "唐代", "source": "碑", "stroke_style": "波磔丰满", "structure": "结构严整，方正丰腴", "desc": "虽有唐人习气，而端严庄重。字形肥硕，笔画丰满，挑法明显，结构严整，尽显盛唐丰腴之美。", "quality": "clear", "img": "imgs/22914/唐玄宗.png", "mask": "", "bbox": {"w": 244, "h": 115}}, {"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "blurry", "img": "imgs/22914/蔡襄.png", "mask": "", "bbox": {"w": 221, "h": 118}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "圆润内刚", "structure": "结构沉静，外柔内刚", "desc": "字里金生，行间玉润。笔法圆润，外柔内刚，结构沉静，有一种君子温玉般的冲和之美。", "quality": "clear", "img": "imgs/22914/虞世南.png", "mask": "", "bbox": {"w": 222, "h": 166}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "篆籀中锋", "structure": "结体方正宽博，重心安稳", "desc": "雄浑博大，其书气象森严，骨力遒劲，点画厚重，沉着有力。结体方正宽博，不尚纤巧。字势端严，重心安稳。", "quality": "blurry", "img": "imgs/22914/颜真卿.png", "mask": "", "bbox": {"w": 240, "h": 164}}, {"master": "王献之", "script": "草书", "dynasty": "晋代", "source": "帖", "stroke_style": "藏锋连绵", "structure": "结体妍雅平稳，气脉贯通", "desc": "圆转流美，以圆转流美取胜，笔画多绵连而不板滞，线条柔韧含蓄，起止多藏锋，强调气脉贯通而弱化笔画棱角。结体趋于妍雅平稳，节奏舒缓而富有韵致。", "quality": "blurry", "img": "imgs/22914/王献之.png", "mask": "", "bbox": {"w": 211, "h": 137}}, {"master": "苏轼", "script": "楷书", "dynasty": "宋代", "source": "帖", "stroke_style": "藏锋丰腴", "structure": "结体宽博，丰腴稳重", "desc": "以淳古重。东坡丰艳，脱尽绳墨，藏锋敛锷。重而肉稍肥。匀稳妍妙，风神在披拂间，而微欲近碑侧，记行稍自结，虽有墨猪之诮，最为淳古。肉丰而骨劲，态浓而意淡，巧于拙，特为秀伟。", "quality": "blurry", "img": "imgs/22914/苏轼.png", "mask": "", "bbox": {"w": 230, "h": 116}}, {"master": "赵之谦", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "圆转流畅", "structure": "结构匀称，自然舒展", "desc": "以行笔为主，线条圆转，波磔柔和，结构匀称。整体风格偏于雅正，书写性强而刻石感弱。", "quality": "blurry", "img": "imgs/22914/赵之谦.png", "mask": "", "bbox": {"w": 226, "h": 152}}, {"master": "金农", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "方折生涩", "structure": "结构夸张，古拙奇崛", "desc": "方笔为主，线条粗重，刻意生涩，结构夸张，强调金石气与拙朴美感。", "quality": "clear", "img": "imgs/22914/金农.png", "mask": "", "bbox": {"w": 245, "h": 197}}, {"master": "颜真卿", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "篆籀中锋", "structure": "结构稳健，宽博雄浑", "desc": "以楷法入行，笔力雄浑，结构稳健，不尚轻逸而重气骨。纵横奔逸，气势连贯。笔意激切，真情流露。行笔跌宕，痛快淋漓。通篇气脉贯注，一气呵成。", "quality": "blurry", "img": "imgs/22914/颜真卿.png", "mask": "", "bbox": {"w": 228, "h": 165}}, {"master": "黄庭坚", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "提按纵横", "structure": "结体开张，纵横奇崛", "desc": "见长年荡桨，乃悟笔法。清圆妙丽，引绳贯珠。虽昂藏郁拔，而神闲，意秾。变态纵横，势若飞鹤之名书，法妍媚，笔势纵横。无一笔不自空中，荡漾而又沈著痛快。", "quality": "blurry", "img": "imgs/22914/黄庭坚.png", "mask": "", "bbox": {"w": 225, "h": 167}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22914/张即之.png", "mask": "", "bbox": {"w": 138, "h": 92}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22914/智永.png", "mask": "", "bbox": {"w": 138, "h": 95}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22914/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 94}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22914/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 98}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22914/赵孟頫.png", "mask": "", "bbox": {"w": 138, "h": 83}}]}