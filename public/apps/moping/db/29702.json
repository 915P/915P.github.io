{"char": "理", "samples": [{"master": "徐渭", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "疾涩纵肆", "structure": "结体纵逸，大小错落", "desc": "八法之散圣，字林之侠客。笔墨如骤雨狂风，恣肆汪洋，点画狼藉，不计工拙，主要表现激越的情感。", "quality": "blurry", "img": "imgs/29702/徐渭.png", "mask": "", "bbox": {"w": 226, "h": 140}}, {"master": "米芾", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "八面出锋", "structure": "结体奇肆，纵横飞动", "desc": "超迈入神，殆非侧勒，趯策，掠啄，磔所能束缚也。如天马脱衔，追风逐电，虽不可范，以驰驱之节，要自不妨痛快。书如游龙，跃渊，骏焉，得御，矫然，拔秀，诚不可攀也。", "quality": "clear", "img": "imgs/29702/米芾.png", "mask": "", "bbox": {"w": 180, "h": 236}}, {"master": "褚遂良", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "楷法劲健", "structure": "结体严整，清秀灵动", "desc": "以楷法为骨，行气清晰，线条劲健而不纵逸，连带克制。整体呈现出清秀、严整而略带灵动的面貌。", "quality": "clear", "img": "imgs/29702/褚遂良.png", "mask": "", "bbox": {"w": 237, "h": 221}}, {"master": "钟繇", "script": "楷书", "dynasty": "三国", "source": "碑", "stroke_style": "结构严谨", "structure": "笔势遒劲雄强，如壮士拔剑，森然有威", "desc": "妙绝古法，笔势刚劲，笔势遒劲，结构严谨，精妙绝伦，姿态万千。如云鹄游天，群鸿戏海。笔力遒劲，如壮士拔剑，森然有威。笔势雄强，气韵生动，如龙腾虎跃，气势磅礴。", "quality": "blurry", "img": "imgs/29702/钟繇.png", "mask": "", "bbox": {"w": 235, "h": 181}}, {"master": "金农", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "方折生涩", "structure": "结构夸张，古拙奇崛", "desc": "方笔为主，线条粗重，刻意生涩，结构夸张，强调金石气与拙朴美感。", "quality": "clear", "img": "imgs/29702/金农.png", "mask": "", "bbox": {"w": 232, "h": 157}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29702/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 112}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29702/张即之.png", "mask": "", "bbox": {"w": 138, "h": 120}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29702/智永.png", "mask": "",