{"char": "偻", "samples": [{"master": "黄庭坚", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "提按纵横", "structure": "结体开张，纵横奇崛", "desc": "见长年荡桨，乃悟笔法。清圆妙丽，引绳贯珠。虽昂藏郁拔，而神闲，意秾。变态纵横，势若飞鹤之名书，法妍媚，笔势纵横。无一笔不自空中，荡漾而又沈著痛快。", "quality": "blurry", "img": "imgs/20603/黄庭坚.png", "mask": "", "bbox": {"w": 181, "h": 173}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20603/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 116}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20603/张即之.png", "mask": "", "bbox": {"w": 138, "h": 126}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20603/智永.png", "mask": "", "bbox": {"w": 138, "h": 137}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20603/柳公权.png", "mask": "", "bbox": {"w": 137, "h": 123}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20603/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 116}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20603/虞世南.png", "mask": "", "bbox": {"w": 137, "h": 115}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20603/赵之谦.png", "mask": "", "bbox": {"w": 137, "h": 97}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20603/赵孟頫.png", "mask": "", "bbox": {"w": 138, "h": 128}}]}