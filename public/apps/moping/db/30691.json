{"char": "矣", "samples": [{"master": "伊秉绶", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "波磔内敛", "structure": "结构方正充实，横平竖直", "desc": "宽博平正，波磔内敛，结构端庄肃穆。结体方正充实，横平竖直，减省蚕头燕尾，具有强烈的装饰感和建筑美，气象博大。", "quality": "blurry", "img": "imgs/30691/伊秉绶.png", "mask": "", "bbox": {"w": 230, "h": 185}}, {"master": "唐玄宗", "script": "隶书", "dynasty": "唐代", "source": "碑", "stroke_style": "波磔丰满", "structure": "结构严整，方正丰腴", "desc": "虽有唐人习气，而端严庄重。字形肥硕，笔画丰满，挑法明显，结构严整，尽显盛唐丰腴之美。", "quality": "clear", "img": "imgs/30691/唐玄宗.png", "mask": "", "bbox": {"w": 237, "h": 153}}, {"master": "康里巎巎", "script": "草书", "dynasty": "元代", "source": "碑", "stroke_style": "悬腕迅疾", "structure": "结体纵逸，欹侧多变", "desc": "运笔极快，如疾风骤雨。悬腕行笔，线条爽利锋锐，节奏明快，既有流美，又有北方民族的豪爽。", "quality": "clear", "img": "imgs/30691/康里巎巎.png", "mask": "", "bbox": {"w": 68, "h": 215}}, {"master": "刘墉", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "藏锋厚重", "structure": "结体内敛，敦厚稳重", "desc": "如绵裹铁，墨色厚重，人称“墨猪”，实则“棉里裹针”。初看丰肥，内含筋骨，结体虽然不够舒展，但有一种含蓄敦厚的静气。", "quality": "blurry", "img": "imgs/30691/刘墉.png", "mask": "", "bbox": {"w": 144, "h": 191}}, {"master": "张旭", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "连绵回绕", "structure": "结体纵逸，起伏跌宕", "desc": "变动犹鬼神，不可端倪。狂草。连绵回绕，起伏跌宕，千变万化，气势如虹，惊心动魄。", "quality": "clear", "img": "imgs/30691/张旭.png", "mask": "", "bbox": {"w": 136, "h": 239}}, {"master": "沈周", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "中锋颤涩", "structure": "结构开张，拙朴雄强", "desc": "遒劲奇崛，用笔中锋，线条粗壮且多颤笔，结构开张，虽然略显拙朴，但苍劲有力。", "quality": "clear", "img": "imgs/30691/沈周.png", "mask": "", "bbox": {"w": 206, "h": 223}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/30691/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 136}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/30691/张即之.png", "mask"