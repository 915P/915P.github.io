{"char": "宿", "samples": [{"master": "于右任", "script": "楷书", "dynasty": "民国", "source": "碑", "stroke_style": "碑意朴厚", "structure": "结体方整，古拙朴厚", "desc": "融碑入帖，结体方整而不板滞，线条朴厚，具有明显碑刻意味。", "quality": "blurry", "img": "imgs/23487/于右任.png", "mask": "", "bbox": {"w": 221, "h": 213}}, {"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "clear", "img": "imgs/23487/苏轼.png", "mask": "", "bbox": {"w": 200, "h": 235}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "圆润内刚", "structure": "结构沉静，外柔内刚", "desc": "字里金生，行间玉润。笔法圆润，外柔内刚，结构沉静，有一种君子温玉般的冲和之美。", "quality": "clear", "img": "imgs/23487/虞世南.png", "mask": "", "bbox": {"w": 201, "h": 238}}, {"master": "黄庭坚", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "提按顿挫", "structure": "结体险绝，开张多变", "desc": "险坠，落墨奇，骨丰筋，力不使，转恶，悉出，极而且温，浓纤刚柔，一皆与人意，会其合，处直接皇石，不止屋漏，漏雨法也。", "quality": "blurry", "img": "imgs/23487/黄庭坚.png", "mask": "", "bbox": {"w": 208, "h": 214}}, {"master": "欧阳询", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "瘦劲方折", "structure": "中宫收敛，结体紧密", "desc": "严整险劲，结体紧密，中宫收敛，笔画瘦劲而劲健，转折分明，行气克制，不尚流便而重法度。", "quality": "clear", "img": "imgs/23487/欧阳询.png", "mask": "", "bbox": {"w": 163, "h": 230}}, {"master": "郑板桥", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "生拙率真", "structure": "奇正相生，大小错落", "desc": "结构奇正相生，字形大小错落，用笔生拙而率真，节奏自由，带有明显的个性化与破格意识。", "quality": "blurry", "img": "imgs/23487/郑板桥.png", "mask": "", "bbox": {"w": 187, "h": 190}}, {"master": "鲜于枢", "script": "草书", "dynasty": "元代", "source": "帖", "stroke_style": "中锋迅猛", "structure": "结构夸张，纵逸豪放", "desc": "纵逸豪放，用笔迅猛，结构夸张，整体气势强烈，富有草原民族豪放气质。", "quality": "clear", "img": "imgs/23487/鲜于枢.png", "mask": "", "bbox": {"w": 171, "h": 235}}, {"master": "颜真卿", "script": "楷书", "dynasty"