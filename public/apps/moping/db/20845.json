{"char": "六", "samples": [{"master": "成亲王", "script": "草书", "dynasty": "清代", "source": "碑", "stroke_style": "圆转流畅", "structure": "结构规整，端庄典雅", "desc": "流畅圆转，规矩中见功力。典型的“馆阁体”最高水准，富贵典雅。", "quality": "clear", "img": "imgs/20845/成亲王.png", "mask": "", "bbox": {"w": 209, "h": 227}}, {"master": "朱熹", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "中锋厚重", "structure": "结体端正，刚健沉稳", "desc": "汉魏风骨，无半点俗气。不求态势，强调笔墨沉着。用笔中锋，点画厚重，结体端正，有一股刚正的儒家正气。", "quality": "blurry", "img": "imgs/20845/朱熹.png", "mask": "", "bbox": {"w": 210, "h": 212}}, {"master": "柳公权", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "方折爽利", "structure": "中宫紧凑，结构严谨", "desc": "骨力遒劲，结构严谨，中宫紧凑，点画爽利，挺拔劲峭。", "quality": "clear", "img": "imgs/20845/柳公权.png", "mask": "", "bbox": {"w": 223, "h": 139}}, {"master": "王羲之", "script": "行书", "dynasty": "晋代", "source": "帖", "stroke_style": "圆转精微", "structure": "结体疏朗平衡，欹正相生", "desc": "飘若游云，矫若惊龙。字势雄逸，如龙腾天门，虎卧凤阁。字法清润，全是章草笔意。自然流畅、情法兼备为核心特征，笔画圆转而富弹性，提按变化细腻而不露痕迹。结体疏朗平衡，欹正相生，字与字之间通过行气自然贯通。", "quality": "blurry", "img": "imgs/20845/王羲之.png", "mask": "", "bbox": {"w": 226, "h": 221}}, {"master": "颜真卿", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "篆籀中锋", "structure": "结构稳健，宽博雄浑", "desc": "以楷法入行，笔力雄浑，结构稳健，不尚轻逸而重气骨。纵横奔逸，气势连贯。笔意激切，真情流露。行笔跌宕，痛快淋漓。通篇气脉贯注，一气呵成。", "quality": "blurry", "img": "imgs/20845/颜真卿.png", "mask": "", "bbox": {"w": 190, "h": 142}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20845/张即之.png", "mask": "", "bbox": {"w": 138, "h": 97}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20845/智永.png", "mask": "", "bbox": {"w": 138, "h": 107}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20845/沈尹默.png", "mask": "", "bb