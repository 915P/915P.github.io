{"char": "困", "samples": [{"master": "宋高宗", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "圆转精到", "structure": "结构端庄，圆润流美", "desc": "圆润流利，规范端庄，用笔精到，具有典型的皇家富贵气和晋唐法度。", "quality": "clear", "img": "imgs/22256/宋高宗.png", "mask": "", "bbox": {"w": 156, "h": 225}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元代", "source": "碑", "stroke_style": "圆润遒劲", "structure": "结体妍丽，平正宽绰", "desc": "笔既流利，学亦渊深，得心应手，会意成文。结体研丽，用笔遒劲。风格整暇，意度清和。书于规矩之中，中自有神仙蜕骨风度。", "quality": "blurry", "img": "imgs/22256/赵孟頫.png", "mask": "", "bbox": {"w": 210, "h": 233}}, {"master": "何绍基", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "回腕颤涩", "structure": "随字赋形，生动自然", "desc": "如天仙化人，绝无尘俗。笔法独特，多用“颤笔”，线条极其苍茫老辣，结体随字赋形，生动自然。", "quality": "clear", "img": "imgs/22256/何绍基.png", "mask": "", "bbox": {"w": 229, "h": 184}}, {"master": "傅山", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转纵肆", "structure": "结体缠绕奇肆", "desc": "粗头乱服式线条，强调自然率真与生拙之美，笔势跌宕，墨法枯涩，极具反规范倾向。主张“宁拙毋巧”。连绵缠绕，圆转不休，气势磅礴，有一种乱头粗服、不加修饰的狂放之美。", "quality": "clear", "img": "imgs/22256/傅山.png", "mask": "", "bbox": {"w": 204, "h": 247}}, {"master": "王宠", "script": "楷书", "dynasty": "明代", "source": "帖", "stroke_style": "中锋细劲", "structure": "中宫疏朗，骨架分明", "desc": "清润雅正，疏朗而不散，清瘦而不弱，中宫不紧而骨架分明，用笔细劲含蓄，多以中锋行笔，转折自然。", "quality": "clear", "img": "imgs/22256/王宠.png", "mask": "", "bbox": {"w": 226, "h": 215}}, {"master": "王羲之", "script": "行书", "dynasty": "晋代", "source": "帖", "stroke_style": "圆转精微", "structure": "结体疏朗平衡，欹正相生", "desc": "飘若游云，矫若惊龙。字势雄逸，如龙腾天门，虎卧凤阁。字法清润，全是章草笔意。自然流畅、情法兼备为核心特征，笔画圆转而富弹性，提按变化细腻而不露痕迹。结体疏朗平衡，欹正相生，字与字之间通过行气自然贯通。", "quality": "blurry", "img": "imgs/22256/王羲之.png", "mask": "", "bbox": {"w": 186, "h": 218}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22256/颜真卿.png", "mask": "", "bbox": {"w": 117, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "s