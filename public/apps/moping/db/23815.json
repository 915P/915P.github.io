{"char": "崇", "samples": [{"master": "孙过庭", "script": "草书", "dynasty": "唐代", "source": "碑", "stroke_style": "笔法精微，提按清晰", "structure": "结体疏朗简约", "desc": "法度严谨而流美自然，笔法精微，提按清晰，结体疏朗。工于用笔，俊拔刚断，尚异好奇，凌越险阻。如丹崖绝壑，笔势坚劲。", "quality": "clear", "img": "imgs/23815/孙过庭.png", "mask": "", "bbox": {"w": 148, "h": 235}}, {"master": "林散之", "script": "隶书", "dynasty": "现代", "source": "帖", "stroke_style": "草意圆转", "structure": "结体舒展，高古灵动", "desc": "以汉隶为基，掺入草意。线条柔韧，墨色苍润，结体不拘泥于扁方，显出一种高古而灵动的意趣。", "quality": "clear", "img": "imgs/23815/林散之.png", "mask": "", "bbox": {"w": 239, "h": 205}}, {"master": "王宠", "script": "楷书", "dynasty": "明代", "source": "帖", "stroke_style": "中锋细劲", "structure": "中宫疏朗，骨架分明", "desc": "清润雅正，疏朗而不散，清瘦而不弱，中宫不紧而骨架分明，用笔细劲含蓄，多以中锋行笔，转折自然。", "quality": "clear", "img": "imgs/23815/王宠.png", "mask": "", "bbox": {"w": 158, "h": 223}}, {"master": "褚遂良", "script": "楷书", "dynasty": "唐代", "source": "帖", "stroke_style": "瘦劲含蓄", "structure": "结体宽博灵动，多姿多态", "desc": "瘦而不弱，笔划极富变化，线条有弹性，结体宽博灵动，多姿多态，空灵飞动。笔瘦劲挺拔，线条富弹性，转折处锋芒内敛。结体严谨而不板滞，姿态清秀中见劲健。", "quality": "blurry", "img": "imgs/23815/褚遂良.png", "mask": "", "bbox": {"w": 160, "h": 228}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23815/颜真卿.png", "mask": "", "bbox": {"w": 115, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23815/张即之.png", "mask": "", "bbox": {"w": 99, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23815/智永.png", "mask": "", "bbox": {"w": 107, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23815/柳公权.png", "mask": "", "bbox": {"w": 111, "h": 138}}, {"master": "沈尹默", "script": "楷书", "d