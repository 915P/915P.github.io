{"char": "弓", "samples": [{"master": "王铎", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "翻折顿挫", "structure": "中宫疏朗，欹正相生", "desc": "不以端整取胜。以行草笔意入楷，结体多取纵势，中宫不紧，字形欹正相生。用笔富于提按变化，线条时见涩滞与翻折感，", "quality": "blurry", "img": "imgs/24339/王铎.png", "mask": "", "bbox": {"w": 135, "h": 235}}, {"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "blurry", "img": "imgs/24339/蔡襄.png", "mask": "", "bbox": {"w": 144, "h": 239}}, {"master": "何绍基", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "回腕颤涩", "structure": "随字赋形，生动自然", "desc": "如天仙化人，绝无尘俗。笔法独特，多用“颤笔”，线条极其苍茫老辣，结体随字赋形，生动自然。", "quality": "clear", "img": "imgs/24339/何绍基.png", "mask": "", "bbox": {"w": 187, "h": 238}}, {"master": "徐渭", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "疾涩奔突", "structure": "结体解构，大小悬殊", "desc": "纵横不羁，极度纵放，用笔迅疾而多断裂感，线条枯湿强烈对比，提按夸张，笔势奔突。结体往往解构传统形态，字形大小悬殊，空间高度自由。", "quality": "blurry", "img": "imgs/24339/徐渭.png", "mask": "", "bbox": {"w": 84, "h": 240}}, {"master": "黄庭坚", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "提按纵横", "structure": "结体开张，纵横奇崛", "desc": "见长年荡桨，乃悟笔法。清圆妙丽，引绳贯珠。虽昂藏郁拔，而神闲，意秾。变态纵横，势若飞鹤之名书，法妍媚，笔势纵横。无一笔不自空中，荡漾而又沈著痛快。", "quality": "blurry", "img": "imgs/24339/黄庭坚.png", "mask": "", "bbox": {"w": 109, "h": 234}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24339/颜真卿.png", "mask": "", "bbox": {"w": 109, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24339/张即之.png", "mask": "", "bbox": {"w": 78, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24339/智永.pn