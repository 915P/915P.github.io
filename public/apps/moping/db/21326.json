{"char": "华", "samples": [{"master": "傅山", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "率意纵肆", "structure": "结体奇特，纵逸不拘", "desc": "与草书类似，强调直抒胸臆。结体奇特，墨色淋漓，不拘成法，真气弥满。", "quality": "clear", "img": "imgs/21326/傅山.png", "mask": "", "bbox": {"w": 133, "h": 244}}, {"master": "吴昌硕", "script": "隶书", "dynasty": "民国", "source": "碑", "stroke_style": "中锋朴厚", "structure": "结体偏长，左低右高", "desc": "一意求中锋平直，且隶且篆。以《石鼓文》笔意写隶。结体偏长，左低右高，线条浑金璞玉，苍茫古朴。", "quality": "blurry", "img": "imgs/21326/吴昌硕.png", "mask": "", "bbox": {"w": 245, "h": 207}}, {"master": "王福庵", "script": "篆书", "dynasty": "民国", "source": "碑", "stroke_style": "笔画粗细匀一", "structure": "圆润劲健，结体极度工整对称", "desc": "端庄杂流丽，刚健含婀娜。精研“铁线篆”。笔画粗细匀一，圆润劲健，结体极度工整对称，既有秦篆的严谨，又有金石的质感。", "quality": "blurry", "img": "imgs/21326/王福庵.png", "mask": "", "bbox": {"w": 147, "h": 236}}, {"master": "褚遂良", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "楷法劲健", "structure": "结体严整，清秀灵动", "desc": "以楷法为骨，行气清晰，线条劲健而不纵逸，连带克制。整体呈现出清秀、严整而略带灵动的面貌。", "quality": "clear", "img": "imgs/21326/褚遂良.png", "mask": "", "bbox": {"w": 128, "h": 243}}, {"master": "邓石如", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "篆意圆劲", "structure": "结构自然舒展", "desc": "融篆入隶，线条圆劲流畅，结构自然舒展，波磔不事夸张，整体呈现古朴而生动的面貌。", "quality": "blurry", "img": "imgs/21326/邓石如.png", "mask": "", "bbox": {"w": 219, "h": 200}}, {"master": "宋徽宗", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "铁线方折", "structure": "结体瘦长，连绵飞动", "desc": "如狂草，动中有静。笔法承袭其“瘦金体”，线条细劲如铁线，狂放疾驰，转折处如切金断玉，连绵不断。", "quality": "clear", "img": "imgs/21326/宋徽宗.png", "mask": "", "bbox": {"w": 169, "h": 254}}, {"master": "张旭", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "连绵回绕", "structure": "结体纵逸，起伏跌宕", "desc": "变动犹鬼神，不可端倪。狂草。连绵回绕，起伏跌宕，千变万化，气势如虹，惊心动魄。", "quality": "clear", "img": "imgs/21326/张旭.png", "mask": "", "bbox": {"w": 132, "h": 233}}, {"master": "欧阳询", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "瘦劲方折", "structure": "中宫收敛，结体紧密", "desc": "严整险劲，结体紧密，中宫收敛，笔画瘦劲而劲健，转折分明，行气克制，不尚流便而重法度。", "quality": "blurry", "img": "imgs/21326/欧阳询.png", "mask": "", "bbox": {"w": 150, "h": 234}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21326/颜真卿.png", "mask": "", "bbox": {"w": 128, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21326/张即之.png", "mask": "", "bbox": {"w": 115, "h": 137}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21326/智永.png", "mask": "", "bbox": {"w": 105, "h": 136}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21326/柳公权.png", "mask": "", "bbox": {"w": 114, "h": 137}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21326/沈尹默.png", "mask": "", "bbox": {"w": 116, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21326/虞世南.png", "mask": "", "bbox": {"w": 134, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21326/赵之谦.png", "mask": "", "bbox": {"w": 98, "h": 138}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21326/赵孟頫.png", "mask": "", "bbox": {"w": 101, "h": 138}}]}