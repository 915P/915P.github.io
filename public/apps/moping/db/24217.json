{"char": "庙", "samples": [{"master": "伊秉绶", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "波磔内敛", "structure": "结构方正充实，横平竖直", "desc": "宽博平正，波磔内敛，结构端庄肃穆。结体方正充实，横平竖直，减省蚕头燕尾，具有强烈的装饰感和建筑美，气象博大。", "quality": "blurry", "img": "imgs/24217/伊秉绶.png", "mask": "", "bbox": {"w": 250, "h": 253}}, {"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "clear", "img": "imgs/24217/何绍基.png", "mask": "", "bbox": {"w": 201, "h": 239}}, {"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "clear", "img": "imgs/24217/何绍基.png", "mask": "", "bbox": {"w": 194, "h": 199}}, {"master": "傅山", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "率意纵肆", "structure": "结体奇特，纵逸不拘", "desc": "与草书类似，强调直抒胸臆。结体奇特，墨色淋漓，不拘成法，真气弥满。", "quality": "clear", "img": "imgs/24217/傅山.png", "mask": "", "bbox": {"w": 225, "h": 226}}, {"master": "孙过庭", "script": "草书", "dynasty": "唐代", "source": "碑", "stroke_style": "笔法精微，提按清晰", "structure": "结体疏朗简约", "desc": "法度严谨而流美自然，笔法精微，提按清晰，结体疏朗。工于用笔，俊拔刚断，尚异好奇，凌越险阻。如丹崖绝壑，笔势坚劲。", "quality": "blurry", "img": "imgs/24217/孙过庭.png", "mask": "", "bbox": {"w": 180, "h": 213}}, {"master": "智永", "script": "草书", "dynasty": "隋代", "source": "碑", "stroke_style": "藏锋圆转", "structure": "结体圆转，气脉连贯", "desc": "笔笔从空中落，从空中住，虽屋漏痕，犹不足以喻之。", "quality": "blurry", "img": "imgs/24217/智永.png", "mask": "", "bbox": {"w": 210, "h": 236}}, {"master": "李阳冰", "script": "篆书", "dynasty": "唐代", "source": "碑", "stroke_style": "铁线圆劲", "structure": "结构严谨，匀称修长", "desc": "以瘦劲取胜，线条如“玉箸”，粗细划一，圆润婉转，法度极严。", "quality": "clear", "img": "imgs/24217/李阳冰.png", "mask": "", "bbox": {"w": 139, "h": 244}}, {"master": "黄庭坚", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "提按顿挫", "structure": "结体险绝，开张多变", "desc": "险坠，落墨奇，骨丰筋，力不使，转恶，悉出，极而且温，浓纤刚柔，一皆与人意，会其合，处直接皇石，不止屋漏，漏雨法也。", "quality": "blurry", "img": "imgs/24217/黄庭坚.png", "mask": "", "bbox": {"w": 188, "h": 229}}, {"master": "张瑞图", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "侧锋方折", "structure": "横向取势，奇峭紧密", "desc": "侧锋偏锋并用，翻折方硬，横向取势，节奏紧凑，风格尖利奇峭，别具一格。", "quality": "clear", "img": "imgs/24217/张瑞图.png", "mask": "", "bbox": {"w": 169, "h": 252}}, {"master": "赵孟頫", "script": "隶书", "dynasty": "元代", "source": "帖", "stroke_style": "圆润简净", "structure": "结构简净，温雅平正", "desc": "复古，去繁就简，温雅纯正。", "quality": "blurry", "img": "imgs/24217/赵孟頫.png", "mask": "", "bbox": {"w": 233, "h": 193}}, {"master": "黄庭坚", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "提按纵横", "structure": "结体开张，纵横奇崛", "desc": "见长年荡桨，乃悟笔法。清圆妙丽，引绳贯珠。虽昂藏郁拔，而神闲，意秾。变态纵横，势若飞鹤之名书，法妍媚，笔势纵横。无一笔不自空中，荡漾而又沈著痛快。", "quality": "clear", "img": "imgs/24217/黄庭坚.png", "mask": "", "bbox": {"w": 217, "h": 251}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24217/颜真卿.png", "mask": "", "bbox": {"w": 137, "h": 120}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24217/张即之.png", "mask": "", "bbox": {"w": 129, "h": 136}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24217/柳公权.png", "mask": "", "bbox": {"w": 134, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24217/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 131}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24217/虞世南.png", "mask": "", "bbox": {"w": 136, "h": 138}}, {"master": "赵之谦", "script":