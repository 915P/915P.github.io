{"char": "根", "samples": [{"master": "黄庭坚", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "提按顿挫", "structure": "结体险绝，开张多变", "desc": "险坠，落墨奇，骨丰筋，力不使，转恶，悉出，极而且温，浓纤刚柔，一皆与人意，会其合，处直接皇石，不止屋漏，漏雨法也。", "quality": "blurry", "img": "imgs/26681/黄庭坚.png", "mask": "", "bbox": {"w": 223, "h": 173}}, {"master": "宋徽宗", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "铁线方折", "structure": "结体瘦长，连绵飞动", "desc": "如狂草，动中有静。笔法承袭其“瘦金体”，线条细劲如铁线，狂放疾驰，转折处如切金断玉，连绵不断。", "quality": "clear", "img": "imgs/26681/宋徽宗.png", "mask": "", "bbox": {"w": 248, "h": 226}}, {"master": "邓石如", "script": "篆书", "dynasty": "清代", "source": "帖", "stroke_style": "中锋圆劲", "structure": "结构严谨，匀称舒展", "desc": "线条圆润匀称，起止自然，结构严谨而不板滞，强调书写节奏与线条弹性", "quality": "clear", "img": "imgs/26681/邓石如.png", "mask": "", "bbox": {"w": 166, "h": 240}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26681/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 87}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26681/张即之.png", "mask": "", "bbox": {"w": 138, "h": 118}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26681/智永.png", "mask": "", "bbox": {"w": 138, "h": 117}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26681/柳公权.png", "mask": "", "bbox": {"w": 137, "h": 96}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26681/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 96}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": 