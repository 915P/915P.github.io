{"char": "右", "samples": [{"master": "宋高宗", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "圆转精到", "structure": "结构端庄，圆润流美", "desc": "圆润流利，规范端庄，用笔精到，具有典型的皇家富贵气和晋唐法度。", "quality": "clear", "img": "imgs/21491/宋高宗.png", "mask": "", "bbox": {"w": 224, "h": 219}}, {"master": "康里巎巎", "script": "草书", "dynasty": "元代", "source": "碑", "stroke_style": "悬腕迅疾", "structure": "结体纵逸，欹侧多变", "desc": "运笔极快，如疾风骤雨。悬腕行笔，线条爽利锋锐，节奏明快，既有流美，又有北方民族的豪爽。", "quality": "clear", "img": "imgs/21491/康里巎巎.png", "mask": "", "bbox": {"w": 204, "h": 253}}, {"master": "朱熹", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "中锋厚重", "structure": "结体端正，刚健沉稳", "desc": "汉魏风骨，无半点俗气。不求态势，强调笔墨沉着。用笔中锋，点画厚重，结体端正，有一股刚正的儒家正气。", "quality": "clear", "img": "imgs/21491/朱熹.png", "mask": "", "bbox": {"w": 223, "h": 247}}, {"master": "王羲之", "script": "楷书", "dynasty": "晋代", "source": "碑", "stroke_style": "藏锋精到", "structure": "结构严谨，中和端正", "desc": "用笔内振而收敛，故森严而有法度，点画精到，结构完美，不激不厉，中和之美。", "quality": "blurry", "img": "imgs/21491/王羲之.png", "mask": "", "bbox": {"w": 225, "h": 189}}, {"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "blurry", "img": "imgs/21491/蔡襄.png", "mask": "", "bbox": {"w": 225, "h": 147}}, {"master": "黄庭坚", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "提按顿挫", "structure": "结体险绝，开张多变", "desc": "险坠，落墨奇，骨丰筋，力不使，转恶，悉出，极而且温，浓纤刚柔，一皆与人意，会其合，处直接皇石，不止屋漏，漏雨法也。", "quality": "blurry", "img": "imgs/21491/黄庭坚.png", "mask": "", "bbox": {"w": 222, "h": 167}}, {"master": "于右任", "script": "草书", "dynasty": "民国", "source": "帖", "stroke_style": "碑意苍辣", "structure": "结构欹侧，气脉贯通", "desc": "以碑法入草，别开生面，章草与今草融通，用笔苍辣老健，线条枯润并存，结构欹侧而气脉贯通，整体呈现“碑意入草”的金石气。", "quality": "clear", "img": "imgs/21491/于右任.png", "mask": "", "bbox": {"w": 177, "h": 231}}, {"master": "伊秉绶", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "迟涩朴厚", "structure": "结体宽博，隶意横展", "desc": "隶意行书，结体宽博，用笔迟涩，行而不流。", "quality": "clear", "img": "imgs/21491/伊秉绶.png", "mask": "", "bbox": {"w": 197, "h": 170}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21491/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 103}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21491/张即之.png", "mask": "", "bbox": {"w": 138, "h": 126}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21491/智永.png", "mask": "", "bbox": {"w": 135, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21491/柳公权.png", "mask": "", "bbox": {"w": 136, "h": 121}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21491/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 106}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21491/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 114}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21491/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 132}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21491/赵孟頫.png", "mask": "", "bbox": {"w": 138, "h": 113}}]}