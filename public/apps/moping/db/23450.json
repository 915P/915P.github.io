{"char": "定", "samples": [{"master": "张旭", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "连绵回绕", "structure": "结体纵逸，起伏跌宕", "desc": "变动犹鬼神，不可端倪。狂草。连绵回绕，起伏跌宕，千变万化，气势如虹，惊心动魄。", "quality": "blurry", "img": "imgs/23450/张旭.png", "mask": "", "bbox": {"w": 178, "h": 221}}, {"master": "文征明", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "苍劲流畅", "structure": "结体修长，疏朗秀逸", "desc": "苍劲流畅，晚年愈发老辣，风姿绰约。", "quality": "blurry", "img": "imgs/23450/文征明.png", "mask": "", "bbox": {"w": 168, "h": 219}}, {"master": "朱熹", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "中锋厚重", "structure": "结体端正，沉稳厚重", "desc": "汉魏风骨，无半点俗气。不求态势，强调笔墨沉着。用笔中锋，点画厚重，结体端正，有一股刚正的儒家正气。", "quality": "blurry", "img": "imgs/23450/朱熹.png", "mask": "", "bbox": {"w": 184, "h": 249}}, {"master": "林散之", "script": "隶书", "dynasty": "现代", "source": "帖", "stroke_style": "草意圆转", "structure": "结体舒展，高古灵动", "desc": "以汉隶为基，掺入草意。线条柔韧，墨色苍润，结体不拘泥于扁方，显出一种高古而灵动的意趣。", "quality": "clear", "img": "imgs/23450/林散之.png", "mask": "", "bbox": {"w": 214, "h": 229}}, {"master": "褚遂良", "script": "楷书", "dynasty": "唐代", "source": "帖", "stroke_style": "瘦劲含蓄", "structure": "结体宽博灵动，多姿多态", "desc": "瘦而不弱，笔划极富变化，线条有弹性，结体宽博灵动，多姿多态，空灵飞动。笔瘦劲挺拔，线条富弹性，转折处锋芒内敛。结体严谨而不板滞，姿态清秀中见劲健。", "quality": "clear", "img": "imgs/23450/褚遂良.png", "mask": "", "bbox": {"w": 233, "h": 218}}, {"master": "颜真卿", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "篆籀中锋", "structure": "结构稳健，宽博雄浑", "desc": "以楷法入行，笔力雄浑，结构稳健，不尚轻逸而重气骨。纵横奔逸，气势连贯。笔意激切，真情流露。行笔跌宕，痛快淋漓。通篇气脉贯注，一气呵成。", "quality": "blurry", "img": "imgs/23450/颜真卿.png", "mask": "", "bbox": {"w": 162, "h": 169}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23450/张即之.png", "mask": "", "bbox": {"w": 118, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/2345