{"char": "俊", "samples": [{"master": "孙过庭", "script": "草书", "dynasty": "唐代", "source": "碑", "stroke_style": "笔法精微，提按清晰", "structure": "结体疏朗简约", "desc": "法度严谨而流美自然，笔法精微，提按清晰，结体疏朗。工于用笔，俊拔刚断，尚异好奇，凌越险阻。如丹崖绝壑，笔势坚劲。", "quality": "blurry", "img": "imgs/20426/孙过庭.png", "mask": "", "bbox": {"w": 207, "h": 220}}, {"master": "李阳冰", "script": "篆书", "dynasty": "唐代", "source": "碑", "stroke_style": "铁线圆劲", "structure": "结构严谨，匀称修长", "desc": "以瘦劲取胜，线条如“玉箸”，粗细划一，圆润婉转，法度极严。", "quality": "blurry", "img": "imgs/20426/李阳冰.png", "mask": "", "bbox": {"w": 184, "h": 228}}, {"master": "欧阳询", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "方折险劲", "structure": "中宫紧收，险绝稳健", "desc": "法度森严，笔力险峻。点画方硬，结体险绝而稳健，中宫紧收，修长挺拔。", "quality": "clear", "img": "imgs/20426/欧阳询.png", "mask": "", "bbox": {"w": 232, "h": 192}}, {"master": "王献之", "script": "行书", "dynasty": "晋代", "source": "碑", "stroke_style": "连绵外拓", "structure": "结体秀逸，外拓奔放", "desc": "运笔连绵不绝，气势豪迈，外露和奔放，挺然秀出，极草纵之致。", "quality": "clear", "img": "imgs/20426/王献之.png", "mask": "", "bbox": {"w": 172, "h": 245}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "blurry", "img": "imgs/20426/智永.png", "mask": "", "bbox": {"w": 231, "h": 188}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "blurry", "img": "imgs/20426/米芾.png", "mask": "", "bbox": {"w": 180, "h": 230}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20426/颜真卿.png", "mask": "", "bbox": {"w": 136, "h": 98}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke