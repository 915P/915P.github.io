{"char": "封", "samples": [{"master": "何绍基", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "回腕颤涩", "structure": "随字赋形，生动自然", "desc": "如天仙化人，绝无尘俗。笔法独特，多用“颤笔”，线条极其苍茫老辣，结体随字赋形，生动自然。", "quality": "clear", "img": "imgs/23553/何绍基.png", "mask": "", "bbox": {"w": 254, "h": 193}}, {"master": "启功", "script": "楷书", "dynasty": "现代", "source": "帖", "stroke_style": "瘦硬清健", "structure": "中宫紧收，四肢舒展", "desc": "瘦硬清秀，中宫紧收，四肢舒展。独创“五三五”结字法（黄金分割），雅俗共赏，书卷气浓。", "quality": "blurry", "img": "imgs/23553/启功.png", "mask": "", "bbox": {"w": 205, "h": 229}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "blurry", "img": "imgs/23553/米芾.png", "mask": "", "bbox": {"w": 208, "h": 226}}, {"master": "颜真卿", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "篆籀中锋", "structure": "结构稳健，宽博雄浑", "desc": "以楷法入行，笔力雄浑，结构稳健，不尚轻逸而重气骨。纵横奔逸，气势连贯。笔意激切，真情流露。行笔跌宕，痛快淋漓。通篇气脉贯注，一气呵成。", "quality": "blurry", "img": "imgs/23553/颜真卿.png", "mask": "", "bbox": {"w": 198, "h": 180}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23553/张即之.png", "mask": "", "bbox": {"w": 134, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23553/智永.png", "mask": "", "bbox": {"w": 112, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23553/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 128}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23553/沈尹默.png", "mask": "", "bbox": {"