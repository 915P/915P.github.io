{"char": "夫", "samples": [{"master": "伊秉绶", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "波磔内敛", "structure": "结构方正充实，横平竖直", "desc": "宽博平正，波磔内敛，结构端庄肃穆。结体方正充实，横平竖直，减省蚕头燕尾，具有强烈的装饰感和建筑美，气象博大。", "quality": "blurry", "img": "imgs/22827/伊秉绶.png", "mask": "", "bbox": {"w": 248, "h": 228}}, {"master": "唐玄宗", "script": "隶书", "dynasty": "唐代", "source": "碑", "stroke_style": "波磔丰满", "structure": "结构严整，方正丰腴", "desc": "虽有唐人习气，而端严庄重。字形肥硕，笔画丰满，挑法明显，结构严整，尽显盛唐丰腴之美。", "quality": "clear", "img": "imgs/22827/唐玄宗.png", "mask": "", "bbox": {"w": 236, "h": 153}}, {"master": "智永", "script": "草书", "dynasty": "隋代", "source": "碑", "stroke_style": "藏锋圆转", "structure": "结体圆转，气脉连贯", "desc": "笔笔从空中落，从空中住，虽屋漏痕，犹不足以喻之。", "quality": "blurry", "img": "imgs/22827/智永.png", "mask": "", "bbox": {"w": 183, "h": 228}}, {"master": "唐寅", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转妍美", "structure": "结体俊逸，疏朗妍美", "desc": "笔法圆转妍美，结体俊逸，书卷气浓，潇洒流落，风流倜傥。", "quality": "clear", "img": "imgs/22827/唐寅.png", "mask": "", "bbox": {"w": 236, "h": 243}}, {"master": "宋徽宗", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "铁线方折", "structure": "结体瘦长，连绵飞动", "desc": "如狂草，动中有静。笔法承袭其“瘦金体”，线条细劲如铁线，狂放疾驰，转折处如切金断玉，连绵不断。", "quality": "clear", "img": "imgs/22827/宋徽宗.png", "mask": "", "bbox": {"w": 163, "h": 240}}, {"master": "林散之", "script": "隶书", "dynasty": "现代", "source": "帖", "stroke_style": "草意圆转", "structure": "结体舒展，高古灵动", "desc": "以汉隶为基，掺入草意。线条柔韧，墨色苍润，结体不拘泥于扁方，显出一种高古而灵动的意趣。", "quality": "clear", "img": "imgs/22827/林散之.png", "mask": "", "bbox": {"w": 249, "h": 190}}, {"master": "赵孟頫", "script": "隶书", "dynasty": "元代", "source": "帖", "stroke_style": "圆润简净", "structure": "结构简净，温雅平正", "desc": "复古，去繁就简，温雅纯正。", "quality": "blurry", "img": "imgs/22827/赵孟頫.png", "mask": "", "bbox": {"w": 230, "h": 169}}, {"master": "陈道复", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "迅疾纵逸", "structure": "结体多变，欹侧奔放", "desc": "纵逸奔放，线条迅疾，结构多变，节奏感强烈，强调情绪表达与书写速度。", "quality": "blurry", "img": "imgs/22827/陈道复.png", "mask": "", "bbox": {"w": 133, "h": 231}}, {"master": "颜真卿", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "篆籀中锋", "structure": "结构稳健，宽博雄浑", "desc": "以楷法入行，笔力雄浑，结构稳健，不尚轻逸而重气骨。纵横奔逸，气势连贯。笔意激切，真情流露。行笔跌宕，痛快淋漓。通篇气脉贯注，一气呵成。", "quality": "blurry", "img": "imgs/22827/颜真卿.png", "mask": "", "bbox": {"w": 201, "h": 230}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22827/张即之.png", "mask": "", "bbox": {"w": 123, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22827/沈尹默.png", "mask": "", "bbox": {"w": 137, "h": 134}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22827/虞世南.png", "mask": "", "bbox": {"w": 137, "h": 133}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22827/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 110}}, {"master": "魏碑", "script": "楷书", "dynasty": "南北朝", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22827/魏碑.png", "mask": "", "bbox": {"w": 134, "h": 114}}]}