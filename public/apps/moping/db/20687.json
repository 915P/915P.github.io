{"char": "像", "samples": [{"master": "颜真卿", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "篆籀中锋", "structure": "结体方正宽博，重心安稳", "desc": "雄浑博大，其书气象森严，骨力遒劲，点画厚重，沉着有力。结体方正宽博，不尚纤巧。字势端严，重心安稳。", "quality": "clear", "img": "imgs/20687/颜真卿.png", "mask": "", "bbox": {"w": 212, "h": 247}}, {"master": "吴昌硕", "script": "篆书", "dynasty": "民国", "source": "帖", "stroke_style": "中锋遒劲", "structure": "结体欹侧，耸肩驼背", "desc": "如铸铁，如印泥。专攻《石鼓文》。用笔凝练遒劲，气度沉雄，打破了秦汉小篆的平衡，结体耸肩驼背，极具金石气。", "quality": "blurry", "img": "imgs/20687/吴昌硕.png", "mask": "", "bbox": {"w": 160, "h": 231}}, {"master": "王献之", "script": "草书", "dynasty": "晋代", "source": "帖", "stroke_style": "藏锋连绵", "structure": "结体妍雅平稳，气脉贯通", "desc": "圆转流美，以圆转流美取胜，笔画多绵连而不板滞，线条柔韧含蓄，起止多藏锋，强调气脉贯通而弱化笔画棱角。结体趋于妍雅平稳，节奏舒缓而富有韵致。", "quality": "blurry", "img": "imgs/20687/王献之.png", "mask": "", "bbox": {"w": 181, "h": 215}}, {"master": "王铎", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "中侧并用", "structure": "结体欹侧夸张，大起大落", "desc": "翻转激荡，气势逼人，纵横恣肆，以强烈的连绵与翻转取势，字势大起大落，结体欹侧夸张，线条多中侧锋并用，提按对比剧烈。用墨浓枯交错。", "quality": "clear", "img": "imgs/20687/王铎.png", "mask": "", "bbox": {"w": 205, "h": 254}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20687/张即之.png", "mask": "", "bbox": {"w": 138, "h": 128}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20687/智永.png", "mask": "", "bbox": {"w": 133, "h": 129}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20687/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 110}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20687/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 106}}, {"master": "虞世南