{"char": "合", "samples": [{"master": "祝允明", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "中锋顿挫", "structure": "结体严谨，不板不滞", "desc": "守法而不激，结体严谨而不板滞，用笔中锋为主，点画分明，转折处见顿挫。", "quality": "blurry", "img": "imgs/21512/祝允明.png", "mask": "", "bbox": {"w": 227, "h": 146}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "篆籀中锋", "structure": "结体方正宽博，重心安稳", "desc": "雄浑博大，其书气象森严，骨力遒劲，点画厚重，沉着有力。结体方正宽博，不尚纤巧。字势端严，重心安稳。", "quality": "blurry", "img": "imgs/21512/颜真卿.png", "mask": "", "bbox": {"w": 225, "h": 180}}, {"master": "吴昌硕", "script": "篆书", "dynasty": "民国", "source": "帖", "stroke_style": "中锋遒劲", "structure": "结体欹侧，耸肩驼背", "desc": "如铸铁，如印泥。专攻《石鼓文》。用笔凝练遒劲，气度沉雄，打破了秦汉小篆的平衡，结体耸肩驼背，极具金石气。", "quality": "clear", "img": "imgs/21512/吴昌硕.png", "mask": "", "bbox": {"w": 180, "h": 242}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "blurry", "img": "imgs/21512/米芾.png", "mask": "", "bbox": {"w": 169, "h": 236}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21512/张即之.png", "mask": "", "bbox": {"w": 138, "h": 97}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21512/智永.png", "mask": "", "bbox": {"w": 138, "h": 104}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21512/柳公权.png", "mask": "", "bbox": {"w": 133, "h": 95}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21512/沈尹默.png", "mask": "", "bbox": {"w": 136, "h": 86