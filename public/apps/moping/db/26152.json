{"char": "昨", "samples": [{"master": "傅山", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转纵肆", "structure": "结体缠绕奇肆", "desc": "粗头乱服式线条，强调自然率真与生拙之美，笔势跌宕，墨法枯涩，极具反规范倾向。主张“宁拙毋巧”。连绵缠绕，圆转不休，气势磅礴，有一种乱头粗服、不加修饰的狂放之美。", "quality": "clear", "img": "imgs/26152/傅山.png", "mask": "", "bbox": {"w": 217, "h": 244}}, {"master": "王献之", "script": "草书", "dynasty": "晋代", "source": "帖", "stroke_style": "藏锋连绵", "structure": "结体妍雅平稳，气脉贯通", "desc": "圆转流美，以圆转流美取胜，笔画多绵连而不板滞，线条柔韧含蓄，起止多藏锋，强调气脉贯通而弱化笔画棱角。结体趋于妍雅平稳，节奏舒缓而富有韵致。", "quality": "blurry", "img": "imgs/26152/王献之.png", "mask": "", "bbox": {"w": 230, "h": 203}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26152/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 131}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26152/张即之.png", "mask": "", "bbox": {"w": 135, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26152/智永.png", "mask": "", "bbox": {"w": 138, "h": 125}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26152/柳公权.png", "mask": "", "bbox": {"w": 135, "h": 132}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26152/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 134}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26152/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 125}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality