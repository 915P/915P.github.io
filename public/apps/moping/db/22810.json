{"char": "多", "samples": [{"master": "伊秉绶", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "波磔内敛", "structure": "结构方正充实，横平竖直", "desc": "宽博平正，波磔内敛，结构端庄肃穆。结体方正充实，横平竖直，减省蚕头燕尾，具有强烈的装饰感和建筑美，气象博大。", "quality": "blurry", "img": "imgs/22810/伊秉绶.png", "mask": "", "bbox": {"w": 233, "h": 165}}, {"master": "王铎", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "翻折顿挫", "structure": "中宫疏朗，欹正相生", "desc": "不以端整取胜。以行草笔意入楷，结体多取纵势，中宫不紧，字形欹正相生。用笔富于提按变化，线条时见涩滞与翻折感，", "quality": "blurry", "img": "imgs/22810/王铎.png", "mask": "", "bbox": {"w": 110, "h": 225}}, {"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "clear", "img": "imgs/22810/苏轼.png", "mask": "", "bbox": {"w": 178, "h": 234}}, {"master": "宋徽宗", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "铁线方折", "structure": "结体瘦长，连绵飞动", "desc": "如狂草，动中有静。笔法承袭其“瘦金体”，线条细劲如铁线，狂放疾驰，转折处如切金断玉，连绵不断。", "quality": "clear", "img": "imgs/22810/宋徽宗.png", "mask": "", "bbox": {"w": 118, "h": 244}}, {"master": "康里巎巎", "script": "行书", "dynasty": "元代", "source": "帖", "stroke_style": "悬腕迅疾", "structure": "结体修长，行气贯通", "desc": "运笔极快，如疾风骤雨。悬腕行笔，线条爽利锋锐，节奏明快，既有流美，又有北方民族的豪爽。", "quality": "clear", "img": "imgs/22810/康里巎巎.png", "mask": "", "bbox": {"w": 120, "h": 240}}, {"master": "怀素", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "藏锋内转", "structure": "结法谨密，回旋多变", "desc": "狂草。笔法瘦硬，称为“铁线描”，速度极快，回旋进退，如骤雨旋风。援毫掣电，随手万变。超妙自得，笔老而意新。虽率意颠逸，千变万化，终不离晋法度故也。结法极谨密，微有不可识者。藏锋内转，瘦硬通神，而颠墨挫毫，无碎缺。", "quality": "blurry", "img": "imgs/22810/怀素.png", "mask": "", "bbox": {"w": 175, "h": 248}}, {"master": "王羲之", "script": "行书", "dynasty": "晋代", "source": "帖", "stroke_style": "圆转精微", "structure": "结体疏朗平衡，欹正相生", "desc": "飘若游云，矫若惊龙。字势雄逸，如龙腾天门，虎卧凤阁。字法清润，全是章草笔意。自然流畅、情法兼备为核心特征，笔画圆转而富弹性，提按变化细腻而不露痕迹。结体疏朗平衡，欹正相生，字与字之间通过行气自然贯通。", "quality": "blurry", "img": "imgs/22810/王羲之.png", "mask": "", "bbox": {"w": 120, "h": 232}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "clear", "img": "imgs/22810/米芾.png", "mask": "", "bbox": {"w": 99, "h": 225}}, {"master": "赵之谦", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "圆转流畅", "structure": "结构匀称，自然舒展", "desc": "以行笔为主，线条圆转，波磔柔和，结构匀称。整体风格偏于雅正，书写性强而刻石感弱。", "quality": "blurry", "img": "imgs/22810/赵之谦.png", "mask": "", "bbox": {"w": 132, "h": 226}}, {"master": "郑板桥", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "生拙率真", "structure": "奇正相生，大小错落", "desc": "结构奇正相生，字形大小错落，用笔生拙而率真，节奏自由，带有明显的个性化与破格意识。", "quality": "blurry", "img": "imgs/22810/郑板桥.png", "mask": "", "bbox": {"w": 218, "h": 145}}, {"master": "金农", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "方折生涩", "structure": "结构夸张，古拙奇崛", "desc": "方笔为主，线条粗重，刻意生涩，结构夸张，强调金石气与拙朴美感。", "quality": "clear", "img": "imgs/22810/金农.png", "mask": "", "bbox": {"w": 133, "h": 227}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22810/颜真卿.png", "mask": "", "bbox": {"w": 100, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22810/张即之.png", "mask": "", "bbox": {"w": 75, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22810/智永.png", "mask": "", "bbox": {"w": 67, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22810/柳公权.png", "mask": "", "bbox": {"w": 82, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22810/沈尹默.png", "mask": "", "bbox": {"w": 73, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22810/虞世南.png", "mask": "", "bbox": {"w": 72, "h": 138}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22810/赵孟頫.png", "mask": "", "bbox": {"w": 52, "h": 138}}]}