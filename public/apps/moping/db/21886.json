{"char": "啾", "samples": [{"master": "欧阳询", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "方折险劲", "structure": "中宫紧收，险绝稳健", "desc": "法度森严，笔力险峻。点画方硬，结体险绝而稳健，中宫紧收，修长挺拔。", "quality": "blurry", "img": "imgs/21886/欧阳询.png", "mask": "", "bbox": {"w": 216, "h": 161}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "blurry", "img": "imgs/21886/米芾.png", "mask": "", "bbox": {"w": 230, "h": 207}}, {"master": "蔡襄", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "藏锋稳健", "structure": "结体端庄严整", "desc": "浑厚端庄，淳淡婉美，恪守法度，具有极高的传统功力。", "quality": "clear", "img": "imgs/21886/蔡襄.png", "mask": "", "bbox": {"w": 213, "h": 179}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21886/颜真卿.png", "mask": "", "bbox": {"w": 137, "h": 83}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21886/张即之.png", "mask": "", "bbox": {"w": 138, "h": 94}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21886/智永.png", "mask": "", "bbox": {"w": 138, "h": 103}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21886/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 95}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21886/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 83}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "stru