{"char": "废", "samples": [{"master": "成亲王", "script": "草书", "dynasty": "清代", "source": "碑", "stroke_style": "圆转流畅", "structure": "结构规整，端庄典雅", "desc": "流畅圆转，规矩中见功力。典型的“馆阁体”最高水准，富贵典雅。", "quality": "blurry", "img": "imgs/24223/成亲王.png", "mask": "", "bbox": {"w": 169, "h": 230}}, {"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "clear", "img": "imgs/24223/苏轼.png", "mask": "", "bbox": {"w": 234, "h": 217}}, {"master": "唐寅", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转妍美", "structure": "结体俊逸，疏朗妍美", "desc": "笔法圆转妍美，结体俊逸，书卷气浓，潇洒流落，风流倜傥。", "quality": "clear", "img": "imgs/24223/唐寅.png", "mask": "", "bbox": {"w": 173, "h": 227}}, {"master": "张旭", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "连绵回绕", "structure": "结体纵逸，起伏跌宕", "desc": "变动犹鬼神，不可端倪。狂草。连绵回绕，起伏跌宕，千变万化，气势如虹，惊心动魄。", "quality": "blurry", "img": "imgs/24223/张旭.png", "mask": "", "bbox": {"w": 159, "h": 219}}, {"master": "怀素", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "藏锋内转", "structure": "结法谨密，回旋多变", "desc": "狂草。笔法瘦硬，称为“铁线描”，速度极快，回旋进退，如骤雨旋风。援毫掣电，随手万变。超妙自得，笔老而意新。虽率意颠逸，千变万化，终不离晋法度故也。结法极谨密，微有不可识者。藏锋内转，瘦硬通神，而颠墨挫毫，无碎缺。", "quality": "blurry", "img": "imgs/24223/怀素.png", "mask": "", "bbox": {"w": 152, "h": 208}}, {"master": "王宠", "script": "楷书", "dynasty": "明代", "source": "帖", "stroke_style": "中锋细劲", "structure": "中宫疏朗，骨架分明", "desc": "清润雅正，疏朗而不散，清瘦而不弱，中宫不紧而骨架分明，用笔细劲含蓄，多以中锋行笔，转折自然。", "quality": "blurry", "img": "imgs/24223/王宠.png", "mask": "", "bbox": {"w": 184, "h": 243}}, {"master": "王羲之", "script": "行书", "dynasty": "晋代", "source": "帖", "stroke_style": "圆转精微", "structure": "结体疏朗平衡，欹正相生", "desc": "飘若游云，矫若惊龙。字势雄逸，如龙腾天门，虎卧凤阁。字法清润，全是章草笔意。自然流畅、情法兼备为核心特征，笔画圆转而富弹性，提按变化细腻而不露痕迹。结体疏朗平衡，欹正相生，字与字之间通过行气自然贯通。", "quality": "blurry", "img": "imgs/24223/王羲之.png", "mask": "", "bbox": {"w": 137, "h": 192}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24223/颜真卿.png", "mask": "", "bbox": {"w": 137, "h": 119}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24223/张即之.png", "mask": "", "bbox": {"w": 132, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24223/智永.png", "mask": "", "bbox": {"w": 132, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24223/柳公权.png", "mask": "", "bbox": {"w": 137, "h": 122}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24223/沈尹默.png", "mask": "", "bbox": {"w": 137, "h": 122}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24223/虞世南.png", "mask": "", "bbox": {"w": 125, "h": 137}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24223/赵孟頫.png", "mask": "", "bbox": {"w": 138, "h": 133}}, {"master": "魏碑", "script": "楷书", "dynasty": "南北朝", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24223/魏碑.png", "mask": "", "bbox": {"w": 138, "h": 127}}]}