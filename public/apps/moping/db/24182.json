{"char": "并", "samples": [{"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "blurry", "img": "imgs/24182/何绍基.png", "mask": "", "bbox": {"w": 177, "h": 209}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元代", "source": "碑", "stroke_style": "圆润遒劲", "structure": "结体妍丽，平正宽绰", "desc": "笔既流利，学亦渊深，得心应手，会意成文。结体研丽，用笔遒劲。风格整暇，意度清和。书于规矩之中，中自有神仙蜕骨风度。", "quality": "blurry", "img": "imgs/24182/赵孟頫.png", "mask": "", "bbox": {"w": 240, "h": 194}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "篆籀中锋", "structure": "结体方正宽博，重心安稳", "desc": "雄浑博大，其书气象森严，骨力遒劲，点画厚重，沉着有力。结体方正宽博，不尚纤巧。字势端严，重心安稳。", "quality": "clear", "img": "imgs/24182/颜真卿.png", "mask": "", "bbox": {"w": 228, "h": 201}}, {"master": "伊秉绶", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "迟涩朴厚", "structure": "结体宽博，隶意横展", "desc": "隶意行书，结体宽博，用笔迟涩，行而不流。", "quality": "clear", "img": "imgs/24182/伊秉绶.png", "mask": "", "bbox": {"w": 226, "h": 193}}, {"master": "怀素", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "藏锋内转", "structure": "结法谨密，回旋多变", "desc": "狂草。笔法瘦硬，称为“铁线描”，速度极快，回旋进退，如骤雨旋风。援毫掣电，随手万变。超妙自得，笔老而意新。虽率意颠逸，千变万化，终不离晋法度故也。结法极谨密，微有不可识者。藏锋内转，瘦硬通神，而颠墨挫毫，无碎缺。", "quality": "clear", "img": "imgs/24182/怀素.png", "mask": "", "bbox": {"w": 113, "h": 225}}, {"master": "怀素", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "藏锋内转", "structure": "结法谨密，回旋多变", "desc": "狂草。笔法瘦硬，称为“铁线描”，速度极快，回旋进退，如骤雨旋风。援毫掣电，随手万变。超妙自得，笔老而意新。虽率意颠逸，千变万化，终不离晋法度故也。结法极谨密，微有不可识者。藏锋内转，瘦硬通神，而颠墨挫毫，无碎缺。", "quality": "blurry", "img": "imgs/24182/怀素.png", "mask": "", "bbox": {"w": 198, "h": 221}}, {"master": "文征明", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "苍劲流畅", "structure": "结体修长，疏朗秀逸", "desc": "苍劲流畅，晚年愈发老辣，风姿绰约。", "quality": "blurry", "img": "imgs/24182/文征明.png", "mask": "", "bbox": {"w": 129, "h": 217}}, {"master": "林散之", "script": "隶书", "dynasty": "现代", "source": "帖", "stroke_style": "草意圆转", "structure": "结体舒展，高古灵动", "desc": "以汉隶为基，掺入草意。线条柔韧，墨色苍润，结体不拘泥于扁方，显出一种高古而灵动的意趣。", "quality": "clear", "img": "imgs/24182/林散之.png", "mask": "", "bbox": {"w": 231, "h": 176}}, {"master": "王宠", "script": "楷书", "dynasty": "明代", "source": "帖", "stroke_style": "中锋细劲", "structure": "中宫疏朗，骨架分明", "desc": "清润雅正，疏朗而不散，清瘦而不弱，中宫不紧而骨架分明，用笔细劲含蓄，多以中锋行笔，转折自然。", "quality": "clear", "img": "imgs/24182/王宠.png", "mask": "", "bbox": {"w": 163, "h": 239}}, {"master": "蔡襄", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "藏锋稳健", "structure": "结体端庄严整", "desc": "浑厚端庄，淳淡婉美，恪守法度，具有极高的传统功力。", "quality": "blurry", "img": "imgs/24182/蔡襄.png", "mask": "", "bbox": {"w": 150, "h": 217}}, {"master": "赵之谦", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "圆转流畅", "structure": "结构匀称，自然舒展", "desc": "以行笔为主，线条圆转，波磔柔和，结构匀称。整体风格偏于雅正，书写性强而刻石感弱。", "quality": "blurry", "img": "imgs/24182/赵之谦.png", "mask": "", "bbox": {"w": 225, "h": 178}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24182/张即之.png", "mask": "", "bbox": {"w": 129, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24182/智永.png", "mask": "", "bbox": {"w": 116, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24182/柳公权.png", "mask": "", "bbox": {"w": 122, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24182/沈尹默.png", "mask": "", "bbox": {"w": 94, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24182/虞世南.