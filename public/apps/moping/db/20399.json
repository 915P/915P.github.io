{"char": "侯", "samples": [{"master": "唐玄宗", "script": "隶书", "dynasty": "唐代", "source": "碑", "stroke_style": "波磔丰满", "structure": "结构严整，方正丰腴", "desc": "虽有唐人习气，而端严庄重。字形肥硕，笔画丰满，挑法明显，结构严整，尽显盛唐丰腴之美。", "quality": "blurry", "img": "imgs/20399/唐玄宗.png", "mask": "", "bbox": {"w": 238, "h": 171}}, {"master": "朱熹", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "中锋厚重", "structure": "结体端正，刚健沉稳", "desc": "汉魏风骨，无半点俗气。不求态势，强调笔墨沉着。用笔中锋，点画厚重，结体端正，有一股刚正的儒家正气。", "quality": "blurry", "img": "imgs/20399/朱熹.png", "mask": "", "bbox": {"w": 211, "h": 220}}, {"master": "唐寅", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转妍美", "structure": "结体俊逸，疏朗妍美", "desc": "笔法圆转妍美，结体俊逸，书卷气浓，潇洒流落，风流倜傥。", "quality": "blurry", "img": "imgs/20399/唐寅.png", "mask": "", "bbox": {"w": 199, "h": 229}}, {"master": "徐渭", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "疾涩奔突", "structure": "结体解构，大小悬殊", "desc": "纵横不羁，极度纵放，用笔迅疾而多断裂感，线条枯湿强烈对比，提按夸张，笔势奔突。结体往往解构传统形态，字形大小悬殊，空间高度自由。", "quality": "clear", "img": "imgs/20399/徐渭.png", "mask": "", "bbox": {"w": 225, "h": 241}}, {"master": "怀素", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "藏锋内转", "structure": "结法谨密，回旋多变", "desc": "狂草。笔法瘦硬，称为“铁线描”，速度极快，回旋进退，如骤雨旋风。援毫掣电，随手万变。超妙自得，笔老而意新。虽率意颠逸，千变万化，终不离晋法度故也。结法极谨密，微有不可识者。藏锋内转，瘦硬通神，而颠墨挫毫，无碎缺。", "quality": "blurry", "img": "imgs/20399/怀素.png", "mask": "", "bbox": {"w": 153, "h": 246}}, {"master": "王铎", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "中侧并用", "structure": "结体欹侧夸张，大起大落", "desc": "翻转激荡，气势逼人，纵横恣肆，以强烈的连绵与翻转取势，字势大起大落，结体欹侧夸张，线条多中侧锋并用，提按对比剧烈。用墨浓枯交错。", "quality": "clear", "img": "imgs/20399/王铎.png", "mask": "", "bbox": {"w": 132, "h": 241}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20399/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 117}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structur