{"char": "富", "samples": [{"master": "朱熹", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "中锋厚重", "structure": "结体端正，刚健沉稳", "desc": "汉魏风骨，无半点俗气。不求态势，强调笔墨沉着。用笔中锋，点画厚重，结体端正，有一股刚正的儒家正气。", "quality": "clear", "img": "imgs/23500/朱熹.png", "mask": "", "bbox": {"w": 189, "h": 221}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元代", "source": "碑", "stroke_style": "圆润遒劲", "structure": "结体妍丽，平正宽绰", "desc": "笔既流利，学亦渊深，得心应手，会意成文。结体研丽，用笔遒劲。风格整暇，意度清和。书于规矩之中，中自有神仙蜕骨风度。", "quality": "blurry", "img": "imgs/23500/赵孟頫.png", "mask": "", "bbox": {"w": 217, "h": 250}}, {"master": "启功", "script": "楷书", "dynasty": "现代", "source": "帖", "stroke_style": "瘦硬清健", "structure": "中宫紧收，四肢舒展", "desc": "瘦硬清秀，中宫紧收，四肢舒展。独创“五三五”结字法（黄金分割），雅俗共赏，书卷气浓。", "quality": "blurry", "img": "imgs/23500/启功.png", "mask": "", "bbox": {"w": 176, "h": 230}}, {"master": "张瑞图", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "侧锋方折", "structure": "横向取势，奇峭紧密", "desc": "侧锋偏锋并用，翻折方硬，横向取势，节奏紧凑，风格尖利奇峭，别具一格。", "quality": "clear", "img": "imgs/23500/张瑞图.png", "mask": "", "bbox": {"w": 117, "h": 239}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "blurry", "img": "imgs/23500/智永.png", "mask": "", "bbox": {"w": 222, "h": 217}}, {"master": "颜真卿", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "篆籀中锋", "structure": "结构稳健，宽博雄浑", "desc": "以楷法入行，笔力雄浑，结构稳健，不尚轻逸而重气骨。纵横奔逸，气势连贯。笔意激切，真情流露。行笔跌宕，痛快淋漓。通篇气脉贯注，一气呵成。", "quality": "blurry", "img": "imgs/23500/颜真卿.png", "mask": "", "bbox": {"w": 144, "h": 178}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23500/张即之.png", "mask": "", "bbox": {"w": 127, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23500/柳公权.png", "mask": "", "bbox": {"w": 117, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23500/沈尹默.png", "mask": "", "bbox": {"w": 115, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23500/虞世南.png", "mask": "", "bbox": {"w": 116, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23500/赵之谦.png", "mask": "", "bbox": {"w": 116, "h": 138}}]}