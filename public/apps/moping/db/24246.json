{"char": "庶", "samples": [{"master": "康里巎巎", "script": "草书", "dynasty": "元代", "source": "碑", "stroke_style": "悬腕迅疾", "structure": "结体纵逸，欹侧多变", "desc": "运笔极快，如疾风骤雨。悬腕行笔，线条爽利锋锐，节奏明快，既有流美，又有北方民族的豪爽。", "quality": "clear", "img": "imgs/24246/康里巎巎.png", "mask": "", "bbox": {"w": 128, "h": 228}}, {"master": "王羲之", "script": "楷书", "dynasty": "晋代", "source": "碑", "stroke_style": "藏锋精到", "structure": "结构严谨，中和端正", "desc": "用笔内振而收敛，故森严而有法度，点画精到，结构完美，不激不厉，中和之美。", "quality": "clear", "img": "imgs/24246/王羲之.png", "mask": "", "bbox": {"w": 208, "h": 233}}, {"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "clear", "img": "imgs/24246/蔡襄.png", "mask": "", "bbox": {"w": 228, "h": 217}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24246/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 121}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24246/张即之.png", "mask": "", "bbox": {"w": 126, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24246/智永.png", "mask": "", "bbox": {"w": 126, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24246/柳公权.png", "mask": "", "bbox": {"w": 137, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24246/沈尹默.png", "mask": "", "bbox": {"w": 137, "h": 132}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "qua