{"char": "书", "samples": [{"master": "文征明", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "中锋秀劲", "structure": "结体严谨，疏朗秀美", "desc": "小楷精绝。温润秀劲，法度严谨，笔笔不苟，有晋唐遗风。", "quality": "blurry", "img": "imgs/20070/文征明.png", "mask": "", "bbox": {"w": 175, "h": 210}}, {"master": "智永", "script": "草书", "dynasty": "隋代", "source": "碑", "stroke_style": "藏锋圆转", "structure": "结体圆转，气脉连贯", "desc": "笔笔从空中落，从空中住，虽屋漏痕，犹不足以喻之。", "quality": "blurry", "img": "imgs/20070/智永.png", "mask": "", "bbox": {"w": 181, "h": 224}}, {"master": "柳公权", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "方折爽利", "structure": "中宫紧凑，结构严谨", "desc": "骨力遒劲，结构严谨，中宫紧凑，点画爽利，挺拔劲峭。", "quality": "clear", "img": "imgs/20070/柳公权.png", "mask": "", "bbox": {"w": 177, "h": 205}}, {"master": "王福庵", "script": "篆书", "dynasty": "民国", "source": "碑", "stroke_style": "笔画粗细匀一", "structure": "圆润劲健，结体极度工整对称", "desc": "端庄杂流丽，刚健含婀娜。精研“铁线篆”。笔画粗细匀一，圆润劲健，结体极度工整对称，既有秦篆的严谨，又有金石的质感。", "quality": "clear", "img": "imgs/20070/王福庵.png", "mask": "", "bbox": {"w": 132, "h": 235}}, {"master": "米芾", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "八面出锋", "structure": "结体奇肆，纵横飞动", "desc": "超迈入神，殆非侧勒，趯策，掠啄，磔所能束缚也。如天马脱衔，追风逐电，虽不可范，以驰驱之节，要自不妨痛快。书如游龙，跃渊，骏焉，得御，矫然，拔秀，诚不可攀也。", "quality": "clear", "img": "imgs/20070/米芾.png", "mask": "", "bbox": {"w": 196, "h": 170}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "圆润内刚", "structure": "结构沉静，外柔内刚", "desc": "字里金生，行间玉润。笔法圆润，外柔内刚，结构沉静，有一种君子温玉般的冲和之美。", "quality": "clear", "img": "imgs/20070/虞世南.png", "mask": "", "bbox": {"w": 196, "h": 232}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "篆籀中锋", "structure": "结体方正宽博，重心安稳", "desc": "雄浑博大，其书气象森严，骨力遒劲，点画厚重，沉着有力。结体方正宽博，不尚纤巧。字势端严，重心安稳。", "quality": "blurry", "img": "imgs/20070/颜真卿.png", "mask": "", "bbox": {"w": 196, "h": 244}}, {"master": "何绍基", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "回腕颤涩", "structure": "随字赋形，生动自然", "desc": "如天仙化人，绝无尘俗。笔法独特，多用“颤笔”，线条极其苍茫老辣，结体随字赋形，生动自然。", "quality": "clear", "img": "imgs/20070/何绍基.png", "mask": "", "bbox": {"w": 217, "h": 232}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "blurry", "img": "imgs/20070/米芾.png", "mask": "", "bbox": {"w": 140, "h": 234}}, {"master": "蔡襄", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "藏锋稳健", "structure": "结体端庄严整", "desc": "浑厚端庄，淳淡婉美，恪守法度，具有极高的传统功力。", "quality": "blurry", "img": "imgs/20070/蔡襄.png", "mask": "", "bbox": {"w": 206, "h": 235}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20070/张即之.png", "mask": "", "bbox": {"w": 134, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20070/沈尹默.png", "mask": "", "bbox": {"w": 131, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20070/赵之谦.png", "mask": "", "bbox": {"w": 114, "h": 138}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20070/赵孟頫.png", "mask": "", "bbox": {"w": 138, "h": 129}}]}