{"char": "备", "samples": [{"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "clear", "img": "imgs/22791/何绍基.png", "mask": "", "bbox": {"w": 193, "h": 213}}, {"master": "文征明", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "中锋秀劲", "structure": "结体严谨，疏朗秀美", "desc": "小楷精绝。温润秀劲，法度严谨，笔笔不苟，有晋唐遗风。", "quality": "blurry", "img": "imgs/22791/文征明.png", "mask": "", "bbox": {"w": 201, "h": 239}}, {"master": "欧阳询", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "方折险劲", "structure": "中宫紧收，险绝稳健", "desc": "法度森严，笔力险峻。点画方硬，结体险绝而稳健，中宫紧收，修长挺拔。", "quality": "clear", "img": "imgs/22791/欧阳询.png", "mask": "", "bbox": {"w": 203, "h": 250}}, {"master": "王献之", "script": "行书", "dynasty": "晋代", "source": "碑", "stroke_style": "连绵外拓", "structure": "结体秀逸，外拓奔放", "desc": "运笔连绵不绝，气势豪迈，外露和奔放，挺然秀出，极草纵之致。", "quality": "blurry", "img": "imgs/22791/王献之.png", "mask": "", "bbox": {"w": 211, "h": 201}}, {"master": "王羲之", "script": "楷书", "dynasty": "晋代", "source": "碑", "stroke_style": "藏锋精到", "structure": "结构严谨，中和端正", "desc": "用笔内振而收敛，故森严而有法度，点画精到，结构完美，不激不厉，中和之美。", "quality": "blurry", "img": "imgs/22791/王羲之.png", "mask": "", "bbox": {"w": 202, "h": 212}}, {"master": "褚遂良", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "楷法劲健", "structure": "结体严整，清秀灵动", "desc": "以楷法为骨，行气清晰，线条劲健而不纵逸，连带克制。整体呈现出清秀、严整而略带灵动的面貌。", "quality": "clear", "img": "imgs/22791/褚遂良.png", "mask": "", "bbox": {"w": 199, "h": 230}}, {"master": "鲜于枢", "script": "行书", "dynasty": "元代", "source": "碑", "stroke_style": "悬腕中锋", "structure": "结体修长圆活", "desc": "悬腕中锋，笔力劲健，结体修长圆活，气势雄伟，善用长锋。", "quality": "clear", "img": "imgs/22791/鲜于枢.png", "mask": "", "bbox": {"w": 183, "h": 213}}, {"master": "褚遂良", "script": "楷书", "dynasty": "唐代", "source": "帖", "stroke_style": "瘦劲含蓄", "structure": "结体宽博灵动，多姿多态", "desc": "瘦而不弱，笔划极富变化，线条有弹性，结体宽博灵动，多姿多态，空灵飞动。笔瘦劲挺拔，线条富弹性，转折处锋芒内敛。结体严谨而不板滞