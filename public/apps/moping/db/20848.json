{"char": "兰", "samples": [{"master": "傅山", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "率意纵肆", "structure": "结体奇特，纵逸不拘", "desc": "与草书类似，强调直抒胸臆。结体奇特，墨色淋漓，不拘成法，真气弥满。", "quality": "clear", "img": "imgs/20848/傅山.png", "mask": "", "bbox": {"w": 124, "h": 226}}, {"master": "成亲王", "script": "草书", "dynasty": "清代", "source": "碑", "stroke_style": "圆转流畅", "structure": "结构规整，端庄典雅", "desc": "流畅圆转，规矩中见功力。典型的“馆阁体”最高水准，富贵典雅。", "quality": "blurry", "img": "imgs/20848/成亲王.png", "mask": "", "bbox": {"w": 154, "h": 224}}, {"master": "朱熹", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "中锋厚重", "structure": "结体端正，刚健沉稳", "desc": "汉魏风骨，无半点俗气。不求态势，强调笔墨沉着。用笔中锋，点画厚重，结体端正，有一股刚正的儒家正气。", "quality": "clear", "img": "imgs/20848/朱熹.png", "mask": "", "bbox": {"w": 166, "h": 232}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "圆润内刚", "structure": "结构沉静，外柔内刚", "desc": "字里金生，行间玉润。笔法圆润，外柔内刚，结构沉静，有一种君子温玉般的冲和之美。", "quality": "blurry", "img": "imgs/20848/虞世南.png", "mask": "", "bbox": {"w": 154, "h": 229}}, {"master": "宋徽宗", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "铁线方折", "structure": "结体瘦长，连绵飞动", "desc": "如狂草，动中有静。笔法承袭其“瘦金体”，线条细劲如铁线，狂放疾驰，转折处如切金断玉，连绵不断。", "quality": "clear", "img": "imgs/20848/宋徽宗.png", "mask": "", "bbox": {"w": 167, "h": 252}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20848/颜真卿.png", "mask": "", "bbox": {"w": 89, "h": 137}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20848/张即之.png", "mask": "", "bbox": {"w": 90, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20848/智永.png", "mask": "", "bbox": {"w": 78, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "so