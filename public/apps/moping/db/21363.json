{"char": "即", "samples": [{"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "blurry", "img": "imgs/21363/苏轼.png", "mask": "", "bbox": {"w": 178, "h": 242}}, {"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "blurry", "img": "imgs/21363/蔡襄.png", "mask": "", "bbox": {"w": 188, "h": 231}}, {"master": "褚遂良", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "楷法劲健", "structure": "结体严整，清秀灵动", "desc": "以楷法为骨，行气清晰，线条劲健而不纵逸，连带克制。整体呈现出清秀、严整而略带灵动的面貌。", "quality": "blurry", "img": "imgs/21363/褚遂良.png", "mask": "", "bbox": {"w": 169, "h": 202}}, {"master": "黄庭坚", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "提按顿挫", "structure": "结体险绝，开张多变", "desc": "险坠，落墨奇，骨丰筋，力不使，转恶，悉出，极而且温，浓纤刚柔，一皆与人意，会其合，处直接皇石，不止屋漏，漏雨法也。", "quality": "blurry", "img": "imgs/21363/黄庭坚.png", "mask": "", "bbox": {"w": 201, "h": 226}}, {"master": "宋高宗", "script": "楷书", "dynasty": "宋代", "source": "帖", "stroke_style": "圆润精到", "structure": "结构端庄，平正匀稳", "desc": "圆润流利，规范端庄，用笔精到，具有典型的皇家富贵气和晋唐法度。", "quality": "blurry", "img": "imgs/21363/宋高宗.png", "mask": "", "bbox": {"w": 181, "h": 233}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "blurry", "img": "imgs/21363/智永.png", "mask": "", "bbox": {"w": 187, "h": 225}}, {"master": "王宠", "script": "楷书", "dynasty": "明代", "source": "帖", "stroke_style": "中锋细劲", "structure": "中宫疏朗，骨架分明", "desc": "清润雅正，疏朗而不散，清瘦而不弱，中宫不紧而骨架分明，用笔细劲含蓄，多以中锋行笔，转折自然。", "quality": "clear", "img": "imgs/21363/王宠.png", "mask": "", "bbox": {"w": 232, "h": 204}}, {"master": "王铎", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "中侧并用", "structure": "结体欹侧夸张，大起大落", "desc": "翻转激荡，气势逼人，纵横恣肆，以强烈的连绵与翻转取势，字势大起大落，结体欹侧夸张，线条多中侧锋并用，提按对比剧烈。用墨浓枯交错。", "quality": "blurry", "img": "imgs/21363/王铎.png", "mask": "", "bbox": {"w": 136, "h": 243}}, {"master": "苏轼", "script": "楷书", "dynasty": "宋代", "source": "帖", "stroke_style": "藏锋丰腴", "structure": "结体宽博，丰腴稳重", "desc": "以淳古重。东坡丰艳，脱尽绳墨，藏锋敛锷。重而肉稍肥。匀稳妍妙，风神在披拂间，而微欲近碑侧，记行稍自结，虽有墨猪之诮，最为淳古。肉丰而骨劲，态浓而意淡，巧于拙，特为秀伟。", "quality": "blurry", "img": "imgs/21363/苏轼.png", "mask": "", "bbox": {"w": 162, "h": 225}}, {"master": "郑板桥", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "生拙率真", "structure": "奇正相生，大小错落", "desc": "结构奇正相生，字形大小错落，用笔生拙而率真，节奏自由，带有明显的个性化与破格意识。", "quality": "blurry", "img": "imgs/21363/郑板桥.png", "mask": "", "bbox": {"w": 156, "h": 212}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21363/颜真卿.png", "mask": "", "bbox": {"w": 120, "h": 137}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21363/张即之.png", "mask": "", "bbox": {"w": 136, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21363/柳公权.png", "mask": "", "bbox": {"w": 102, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21363/沈尹默.png", "mask": "", "bbox": {"w": 126, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21363/虞世南.png", "mask": "", "bbox": {"w": 109, "h": 137}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21363/赵之谦.png", "mask": "", "bbox": {"w": 125, "h": 138}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21363/赵孟頫.png", "mask": "", "bbox": {"w": 106, "h": 137}}]}