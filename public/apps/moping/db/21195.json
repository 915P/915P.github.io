{"char": "勋", "samples": [{"master": "伊秉绶", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "波磔内敛", "structure": "结构方正充实，横平竖直", "desc": "宽博平正，波磔内敛，结构端庄肃穆。结体方正充实，横平竖直，减省蚕头燕尾，具有强烈的装饰感和建筑美，气象博大。", "quality": "clear", "img": "imgs/21195/伊秉绶.png", "mask": "", "bbox": {"w": 237, "h": 228}}, {"master": "吴昌硕", "script": "隶书", "dynasty": "民国", "source": "碑", "stroke_style": "中锋朴厚", "structure": "结体偏长，左低右高", "desc": "一意求中锋平直，且隶且篆。以《石鼓文》笔意写隶。结体偏长，左低右高，线条浑金璞玉，苍茫古朴。", "quality": "clear", "img": "imgs/21195/吴昌硕.png", "mask": "", "bbox": {"w": 196, "h": 251}}, {"master": "文征明", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "中锋秀劲", "structure": "结体严谨，疏朗秀美", "desc": "小楷精绝。温润秀劲，法度严谨，笔笔不苟，有晋唐遗风。", "quality": "blurry", "img": "imgs/21195/文征明.png", "mask": "", "bbox": {"w": 182, "h": 212}}, {"master": "于右任", "script": "草书", "dynasty": "民国", "source": "帖", "stroke_style": "碑意苍辣", "structure": "结构欹侧，气脉贯通", "desc": "以碑法入草，别开生面，章草与今草融通，用笔苍辣老健，线条枯润并存，结构欹侧而气脉贯通，整体呈现“碑意入草”的金石气。", "quality": "clear", "img": "imgs/21195/于右任.png", "mask": "", "bbox": {"w": 203, "h": 237}}, {"master": "金农", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "方折生涩", "structure": "结构夸张，古拙奇崛", "desc": "方笔为主，线条粗重，刻意生涩，结构夸张，强调金石气与拙朴美感。", "quality": "blurry", "img": "imgs/21195/金农.png", "mask": "", "bbox": {"w": 210, "h": 189}}, {"master": "颜真卿", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "篆籀中锋", "structure": "结构稳健，宽博雄浑", "desc": "以楷法入行，笔力雄浑，结构稳健，不尚轻逸而重气骨。纵横奔逸，气势连贯。笔意激切，真情流露。行笔跌宕，痛快淋漓。通篇气脉贯注，一气呵成。", "quality": "blurry", "img": "imgs/21195/颜真卿.png", "mask": "", "bbox": {"w": 215, "h": 227}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21195/张即之.png", "mask": "", "bbox": {"w": 138, "h": 131}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21195/智永.