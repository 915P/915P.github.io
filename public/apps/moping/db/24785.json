{"char": "惑", "samples": [{"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "clear", "img": "imgs/24785/苏轼.png", "mask": "", "bbox": {"w": 241, "h": 190}}, {"master": "伊秉绶", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "迟涩朴厚", "structure": "结体宽博，隶意横展", "desc": "隶意行书，结体宽博，用笔迟涩，行而不流。", "quality": "clear", "img": "imgs/24785/伊秉绶.png", "mask": "", "bbox": {"w": 184, "h": 237}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24785/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 131}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24785/张即之.png", "mask": "", "bbox": {"w": 125, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24785/智永.png", "mask": "", "bbox": {"w": 138, "h": 125}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24785/柳公权.png", "mask": "", "bbox": {"w": 135, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24785/沈尹默.png", "mask": "", "bbox": {"w": 129, "h": 137}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24785/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 136}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "