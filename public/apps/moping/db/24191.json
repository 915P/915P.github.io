{"char": "广", "samples": [{"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "missing", "img": "imgs/24191/何绍基.png", "mask": "", "bbox": {"w": 174, "h": 218}}, {"master": "倪元璐", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "渴笔涩行", "structure": "结体险绝，欹侧奇崛", "desc": "用笔多用渴墨（枯笔），线条生涩，结体险绝。", "quality": "blurry", "img": "imgs/24191/倪元璐.png", "mask": "", "bbox": {"w": 123, "h": 244}}, {"master": "董其昌", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "平稳含蓄", "structure": "中宫虚和，结体疏朗", "desc": "楷书结构疏朗，中宫虚和，用笔平稳含蓄，点画不尚锋芒而重整体气息。强调字内空间与章法呼应，追求“淡而有味”的审美取向，弱化力量感而突出文人书卷气。", "quality": "blurry", "img": "imgs/24191/董其昌.png", "mask": "", "bbox": {"w": 194, "h": 239}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元代", "source": "碑", "stroke_style": "圆润遒劲", "structure": "结体妍丽，平正宽绰", "desc": "笔既流利，学亦渊深，得心应手，会意成文。结体研丽，用笔遒劲。风格整暇，意度清和。书于规矩之中，中自有神仙蜕骨风度。", "quality": "clear", "img": "imgs/24191/赵孟頫.png", "mask": "", "bbox": {"w": 199, "h": 242}}, {"master": "启功", "script": "楷书", "dynasty": "现代", "source": "帖", "stroke_style": "瘦硬清健", "structure": "中宫紧收，四肢舒展", "desc": "瘦硬清秀，中宫紧收，四肢舒展。独创“五三五”结字法（黄金分割），雅俗共赏，书卷气浓。", "quality": "blurry", "img": "imgs/24191/启功.png", "mask": "", "bbox": {"w": 214, "h": 240}}, {"master": "欧阳询", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "瘦劲方折", "structure": "中宫收敛，结体紧密", "desc": "严整险劲，结体紧密，中宫收敛，笔画瘦劲而劲健，转折分明，行气克制，不尚流便而重法度。", "quality": "clear", "img": "imgs/24191/欧阳询.png", "mask": "", "bbox": {"w": 166, "h": 241}}, {"master": "黄庭坚", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "提按纵横", "structure": "结体开张，纵横奇崛", "desc": "见长年荡桨，乃悟笔法。清圆妙丽，引绳贯珠。虽昂藏郁拔，而神闲，意秾。变态纵横，势若飞鹤之名书，法妍媚，笔势纵横。无一笔不自空中，荡漾而又沈著痛快。", "quality": "clear", "img": "imgs/24191/黄庭坚.png", "mask": "", "bbox": {"w": 210, "h": 233}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_st