{"char": "国", "samples": [{"master": "智永", "script": "草书", "dynasty": "隋代", "source": "碑", "stroke_style": "藏锋圆转", "structure": "结体圆转，气脉连贯", "desc": "笔笔从空中落，从空中住，虽屋漏痕，犹不足以喻之。", "quality": "blurry", "img": "imgs/22269/智永.png", "mask": "", "bbox": {"w": 201, "h": 235}}, {"master": "欧阳询", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "方折险劲", "structure": "中宫紧收，险绝稳健", "desc": "法度森严，笔力险峻。点画方硬，结体险绝而稳健，中宫紧收，修长挺拔。", "quality": "clear", "img": "imgs/22269/欧阳询.png", "mask": "", "bbox": {"w": 159, "h": 245}}, {"master": "祝允明", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "中锋顿挫", "structure": "结体严谨，不板不滞", "desc": "守法而不激，结体严谨而不板滞，用笔中锋为主，点画分明，转折处见顿挫。", "quality": "blurry", "img": "imgs/22269/祝允明.png", "mask": "", "bbox": {"w": 194, "h": 185}}, {"master": "董其昌", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "平稳含蓄", "structure": "中宫虚和，结体疏朗", "desc": "楷书结构疏朗，中宫虚和，用笔平稳含蓄，点画不尚锋芒而重整体气息。强调字内空间与章法呼应，追求“淡而有味”的审美取向，弱化力量感而突出文人书卷气。", "quality": "blurry", "img": "imgs/22269/董其昌.png", "mask": "", "bbox": {"w": 204, "h": 219}}, {"master": "徐渭", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "疾涩奔突", "structure": "结体解构，大小悬殊", "desc": "纵横不羁，极度纵放，用笔迅疾而多断裂感，线条枯湿强烈对比，提按夸张，笔势奔突。结体往往解构传统形态，字形大小悬殊，空间高度自由。", "quality": "blurry", "img": "imgs/22269/徐渭.png", "mask": "", "bbox": {"w": 165, "h": 237}}, {"master": "怀素", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "藏锋内转", "structure": "结法谨密，回旋多变", "desc": "狂草。笔法瘦硬，称为“铁线描”，速度极快，回旋进退，如骤雨旋风。援毫掣电，随手万变。超妙自得，笔老而意新。虽率意颠逸，千变万化，终不离晋法度故也。结法极谨密，微有不可识者。藏锋内转，瘦硬通神，而颠墨挫毫，无碎缺。", "quality": "blurry", "img": "imgs/22269/怀素.png", "mask": "", "bbox": {"w": 166, "h": 224}}, {"master": "邓石如", "script": "篆书", "dynasty": "清代", "source": "帖", "stroke_style": "中锋圆劲", "structure": "结构严谨，匀称舒展", "desc": "线条圆润匀称，起止自然，结构严谨而不板滞，强调书写节奏与线条弹性", "quality": "clear", "img": "imgs/22269/邓石如.png", "mask": "", "bbox": {"w": 183, "h": 235}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stro