{"char": "县", "samples": [{"master": "文征明", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "中锋秀劲", "structure": "结体严谨，疏朗秀美", "desc": "小楷精绝。温润秀劲，法度严谨，笔笔不苟，有晋唐遗风。", "quality": "blurry", "img": "imgs/21439/文征明.png", "mask": "", "bbox": {"w": 208, "h": 206}}, {"master": "黄庭坚", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "提按顿挫", "structure": "结体险绝，开张多变", "desc": "险坠，落墨奇，骨丰筋，力不使，转恶，悉出，极而且温，浓纤刚柔，一皆与人意，会其合，处直接皇石，不止屋漏，漏雨法也。", "quality": "blurry", "img": "imgs/21439/黄庭坚.png", "mask": "", "bbox": {"w": 215, "h": 196}}, {"master": "宋徽宗", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "铁线方折", "structure": "结体瘦长，连绵飞动", "desc": "如狂草，动中有静。笔法承袭其“瘦金体”，线条细劲如铁线，狂放疾驰，转折处如切金断玉，连绵不断。", "quality": "clear", "img": "imgs/21439/宋徽宗.png", "mask": "", "bbox": {"w": 248, "h": 217}}, {"master": "祝允明", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "连带纵逸", "structure": "结体欹侧，跌宕多变", "desc": "纵而能敛，狂而不怪，连带自然，结体多欹侧变化，字势跌宕起伏，行气贯通而富节奏感。", "quality": "clear", "img": "imgs/21439/祝允明.png", "mask": "", "bbox": {"w": 235, "h": 201}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21439/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 116}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21439/张即之.png", "mask": "", "bbox": {"w": 138, "h": 114}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21439/智永.png", "mask": "", "bbox": {"w": 138, "h": 131}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21439/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 117}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": nu