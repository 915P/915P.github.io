{"char": "州", "samples": [{"master": "孙过庭", "script": "草书", "dynasty": "唐代", "source": "碑", "stroke_style": "笔法精微，提按清晰", "structure": "结体疏朗简约", "desc": "法度严谨而流美自然，笔法精微，提按清晰，结体疏朗。工于用笔，俊拔刚断，尚异好奇，凌越险阻。如丹崖绝壑，笔势坚劲。", "quality": "blurry", "img": "imgs/24030/孙过庭.png", "mask": "", "bbox": {"w": 216, "h": 215}}, {"master": "邓石如", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "篆意圆劲", "structure": "结构自然舒展", "desc": "融篆入隶，线条圆劲流畅，结构自然舒展，波磔不事夸张，整体呈现古朴而生动的面貌。", "quality": "blurry", "img": "imgs/24030/邓石如.png", "mask": "", "bbox": {"w": 224, "h": 140}}, {"master": "伊秉绶", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "迟涩朴厚", "structure": "结体宽博，隶意横展", "desc": "隶意行书，结体宽博，用笔迟涩，行而不流。", "quality": "blurry", "img": "imgs/24030/伊秉绶.png", "mask": "", "bbox": {"w": 194, "h": 201}}, {"master": "倪元璐", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "折绞峭利", "structure": "结体奇崛，多折多绞", "desc": "纵肆狂放，结体奇崛，线条多折多绞，节奏强烈，富有强烈的个性张力。", "quality": "blurry", "img": "imgs/24030/倪元璐.png", "mask": "", "bbox": {"w": 216, "h": 192}}, {"master": "文征明", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "苍劲流畅", "structure": "结体修长，疏朗秀逸", "desc": "苍劲流畅，晚年愈发老辣，风姿绰约。", "quality": "blurry", "img": "imgs/24030/文征明.png", "mask": "", "bbox": {"w": 214, "h": 229}}, {"master": "朱熹", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "中锋厚重", "structure": "结体端正，沉稳厚重", "desc": "汉魏风骨，无半点俗气。不求态势，强调笔墨沉着。用笔中锋，点画厚重，结体端正，有一股刚正的儒家正气。", "quality": "blurry", "img": "imgs/24030/朱熹.png", "mask": "", "bbox": {"w": 229, "h": 159}}, {"master": "王铎", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "中侧并用", "structure": "结体欹侧夸张，大起大落", "desc": "翻转激荡，气势逼人，纵横恣肆，以强烈的连绵与翻转取势，字势大起大落，结体欹侧夸张，线条多中侧锋并用，提按对比剧烈。用墨浓枯交错。", "quality": "blurry", "img": "imgs/24030/王铎.png", "mask": "", "bbox": {"w": 222, "h": 199}}, {"master": "祝允明", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "连带纵逸", "structure": "结体欹侧，跌宕多变", "desc": "纵而能敛，狂而不怪，连带自然，结体多欹侧变化，字势跌宕起伏，行气贯通而富节奏感。", "quality": "clear", "img": "imgs/24030/祝允明.png", "mask": "", "bbox": {"w": 219, "h": 239}}, {"master": "董其昌", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "轻灵含蓄", "structure": "结体疏朗平正", "desc": "疏淡清远，强调空间经营，行书节奏舒缓，连带自然，用笔轻灵，行气疏通。字形多取平正，不刻意追求速度与张力。", "quality": "blurry", "img": "imgs/24030/董其昌.png", "mask": "", "bbox": {"w": 172, "h": 254}}, {"master": "赵孟頫", "script": "隶书", "dynasty": "元代", "source": "帖", "stroke_style": "圆润简净", "structure": "结构简净，温雅平正", "desc": "复古，去繁就简，温雅纯正。", "quality": "blurry", "img": "imgs/24030/赵孟頫.png", "mask": "", "bbox": {"w": 232, "h": 148}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24030/颜真卿.png", "mask": "", "bbox": {"w": 137, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24030/张即之.png", "mask": "", "bbox": {"w": 135, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24030/智永.png", "mask": "", "bbox": {"w": 125, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24030/柳公权.png", "mask": "", "bbox": {"w": 121, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24030/沈尹默.png", "mask": "", "bbox": {"w": 122, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24030/虞世南.png", "mask": "", "bbox": {"w": 136, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality":