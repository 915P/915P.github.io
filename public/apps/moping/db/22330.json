{"char": "场", "samples": [{"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "clear", "img": "imgs/22330/何绍基.png", "mask": "", "bbox": {"w": 238, "h": 254}}, {"master": "唐寅", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转妍美", "structure": "结体俊逸，疏朗妍美", "desc": "笔法圆转妍美，结体俊逸，书卷气浓，潇洒流落，风流倜傥。", "quality": "clear", "img": "imgs/22330/唐寅.png", "mask": "", "bbox": {"w": 187, "h": 234}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "clear", "img": "imgs/22330/智永.png", "mask": "", "bbox": {"w": 230, "h": 220}}, {"master": "王宠", "script": "楷书", "dynasty": "明代", "source": "帖", "stroke_style": "中锋细劲", "structure": "中宫疏朗，骨架分明", "desc": "清润雅正，疏朗而不散，清瘦而不弱，中宫不紧而骨架分明，用笔细劲含蓄，多以中锋行笔，转折自然。", "quality": "blurry", "img": "imgs/22330/王宠.png", "mask": "", "bbox": {"w": 210, "h": 230}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "blurry", "img": "imgs/22330/米芾.png", "mask": "", "bbox": {"w": 174, "h": 239}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22330/颜真卿.png", "mask": "", "bbox": {"w": 132, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22330/张即之.png", "mask": "", "bbox": {"w": 131, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22330/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 127}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22330/虞世南.png", "mask": "", "bbox": {"w": 132, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22330/赵之谦.png", "mask": "", "bbox": {"w": 135, "h": 138}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22330/赵孟頫.png", "mask": "", "bbox": {"w": 135, "h": 132}}, {"master": "魏碑", "script": "楷书", "dynasty": "南北朝", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/22330/魏碑.png", "mask": "", "bbox": {"w": 127, "h": 138}}]}