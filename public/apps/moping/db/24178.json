{"char": "干", "samples": [{"master": "于右任", "script": "楷书", "dynasty": "民国", "source": "碑", "stroke_style": "碑意朴厚", "structure": "结体方整，古拙朴厚", "desc": "融碑入帖，结体方整而不板滞，线条朴厚，具有明显碑刻意味。", "quality": "clear", "img": "imgs/24178/于右任.png", "mask": "", "bbox": {"w": 234, "h": 157}}, {"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "clear", "img": "imgs/24178/何绍基.png", "mask": "", "bbox": {"w": 218, "h": 209}}, {"master": "文征明", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "中锋秀劲", "structure": "结体严谨，疏朗秀美", "desc": "小楷精绝。温润秀劲，法度严谨，笔笔不苟，有晋唐遗风。", "quality": "blurry", "img": "imgs/24178/文征明.png", "mask": "", "bbox": {"w": 247, "h": 198}}, {"master": "欧阳询", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "方折险劲", "structure": "中宫紧收，险绝稳健", "desc": "法度森严，笔力险峻。点画方硬，结体险绝而稳健，中宫紧收，修长挺拔。", "quality": "blurry", "img": "imgs/24178/欧阳询.png", "mask": "", "bbox": {"w": 209, "h": 169}}, {"master": "王铎", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "翻折顿挫", "structure": "中宫疏朗，欹正相生", "desc": "不以端整取胜。以行草笔意入楷，结体多取纵势，中宫不紧，字形欹正相生。用笔富于提按变化，线条时见涩滞与翻折感，", "quality": "blurry", "img": "imgs/24178/王铎.png", "mask": "", "bbox": {"w": 203, "h": 215}}, {"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "clear", "img": "imgs/24178/苏轼.png", "mask": "", "bbox": {"w": 226, "h": 167}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元代", "source": "碑", "stroke_style": "圆润遒劲", "structure": "结体妍丽，平正宽绰", "desc": "笔既流利，学亦渊深，得心应手，会意成文。结体研丽，用笔遒劲。风格整暇，意度清和。书于规矩之中，中自有神仙蜕骨风度。", "quality": "clear", "img": "imgs/24178/赵孟頫.png", "mask": "", "bbox": {"w": 199, "h": 201}}, {"master": "邓石如", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "篆意圆劲", "structure": "结构自然舒展", "desc": "融篆入隶，线条圆劲流畅，结构自然舒展，波磔不事夸张，整体呈现古朴而生动的面貌。", "quality": "blurry", "img": "imgs/24178/邓石如.png", "mask": "", "bbox": {"w": 225, "h": 173}}, {"master": "钟繇", "script": "楷书", "dynasty": "三国", "source": "碑", "stroke_style": "结构严谨", "structure": "笔势遒劲雄强，如壮士拔剑，森然有威", "desc": "妙绝古法，笔势刚劲，笔势遒劲，结构严谨，精妙绝伦，姿态万千。如云鹄游天，群鸿戏海。笔力遒劲，如壮士拔剑，森然有威。笔势雄强，气韵生动，如龙腾虎跃，气势磅礴。", "quality": "blurry", "img": "imgs/24178/钟繇.png", "mask": "", "bbox": {"w": 180, "h": 157}}, {"master": "何绍基", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "回腕颤涩", "structure": "随字赋形，生动自然", "desc": "如天仙化人，绝无尘俗。笔法独特，多用“颤笔”，线条极其苍茫老辣，结体随字赋形，生动自然。", "quality": "clear", "img": "imgs/24178/何绍基.png", "mask": "", "bbox": {"w": 236, "h": 191}}, {"master": "唐寅", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转妍美", "structure": "结体俊逸，疏朗妍美", "desc": "笔法圆转妍美，结体俊逸，书卷气浓，潇洒流落，风流倜傥。", "quality": "blurry", "img": "imgs/24178/唐寅.png", "mask": "", "bbox": {"w": 236, "h": 221}}, {"master": "林散之", "script": "隶书", "dynasty": "现代", "source": "帖", "stroke_style": "草意圆转", "structure": "结体舒展，高古灵动", "desc": "以汉隶为基，掺入草意。线条柔韧，墨色苍润，结体不拘泥于扁方，显出一种高古而灵动的意趣。", "quality": "clear", "img": "imgs/24178/林散之.png", "mask": "", "bbox": {"w": 240, "h": 164}}, {"master": "王羲之", "script": "行书", "dynasty": "晋代", "source": "帖", "stroke_style": "圆转精微", "structure": "结体疏朗平衡，欹正相生", "desc": "飘若游云，矫若惊龙。字势雄逸，如龙腾天门，虎卧凤阁。字法清润，全是章草笔意。自然流畅、情法兼备为核心特征，笔画圆转而富弹性，提按变化细腻而不露痕迹。结体疏朗平衡，欹正相生，字与字之间通过行气自然贯通。", "quality": "blurry", "img": "imgs/24178/王羲之.png", "mask": "", "bbox": {"w": 194, "h": 215}}, {"master": "郑板桥", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "生拙率真", "structure": "奇正相生，大小错落", "desc": "结构奇正相生，字形大小错落，用笔生拙而率真，节奏自由，带有明显的个性化与破格意识。", "quality": "blurry", "img": "imgs/24178/郑板桥.png", "mask": "", "bbox": {"w": 220, "h": 219}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24178/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 122}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24178/张即之.png", "mask": "", "bbox": {"w": 138, "h": 114}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24178/智永.png", "mask": "", "bbox": {"w": 138, "h": 126}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24178/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 124}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24178/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 111}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24178/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 128}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24178/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 117}}]}