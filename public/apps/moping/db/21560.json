{"char": "吸", "samples": [{"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "clear", "img": "imgs/21560/苏轼.png", "mask": "", "bbox": {"w": 230, "h": 143}}, {"master": "鲜于枢", "script": "草书", "dynasty": "元代", "source": "帖", "stroke_style": "中锋迅猛", "structure": "结构夸张，纵逸豪放", "desc": "纵逸豪放，用笔迅猛，结构夸张，整体气势强烈，富有草原民族豪放气质。", "quality": "blurry", "img": "imgs/21560/鲜于枢.png", "mask": "", "bbox": {"w": 221, "h": 179}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21560/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 87}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21560/张即之.png", "mask": "", "bbox": {"w": 138, "h": 100}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21560/智永.png", "mask": "", "bbox": {"w": 138, "h": 98}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21560/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 98}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21560/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 81}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21560/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 91}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure"