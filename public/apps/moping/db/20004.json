{"char": "两", "samples": [{"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "blurry", "img": "imgs/20004/何绍基.png", "mask": "", "bbox": {"w": 208, "h": 179}}, {"master": "智永", "script": "草书", "dynasty": "隋代", "source": "碑", "stroke_style": "藏锋圆转", "structure": "结体圆转，气脉连贯", "desc": "笔笔从空中落，从空中住，虽屋漏痕，犹不足以喻之。", "quality": "blurry", "img": "imgs/20004/智永.png", "mask": "", "bbox": {"w": 146, "h": 227}}, {"master": "王羲之", "script": "楷书", "dynasty": "晋代", "source": "碑", "stroke_style": "藏锋精到", "structure": "结构严谨，中和端正", "desc": "用笔内振而收敛，故森严而有法度，点画精到，结构完美，不激不厉，中和之美。", "quality": "blurry", "img": "imgs/20004/王羲之.png", "mask": "", "bbox": {"w": 208, "h": 164}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元代", "source": "碑", "stroke_style": "圆润遒劲", "structure": "结体妍丽，平正宽绰", "desc": "笔既流利，学亦渊深，得心应手，会意成文。结体研丽，用笔遒劲。风格整暇，意度清和。书于规矩之中，中自有神仙蜕骨风度。", "quality": "blurry", "img": "imgs/20004/赵孟頫.png", "mask": "", "bbox": {"w": 187, "h": 131}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元代", "source": "碑", "stroke_style": "圆润遒劲", "structure": "结体妍丽，平正宽绰", "desc": "笔既流利，学亦渊深，得心应手，会意成文。结体研丽，用笔遒劲。风格整暇，意度清和。书于规矩之中，中自有神仙蜕骨风度。", "quality": "blurry", "img": "imgs/20004/赵孟頫.png", "mask": "", "bbox": {"w": 226, "h": 198}}, {"master": "吴昌硕", "script": "篆书", "dynasty": "民国", "source": "帖", "stroke_style": "中锋遒劲", "structure": "结体欹侧，耸肩驼背", "desc": "如铸铁，如印泥。专攻《石鼓文》。用笔凝练遒劲，气度沉雄，打破了秦汉小篆的平衡，结体耸肩驼背，极具金石气。", "quality": "clear", "img": "imgs/20004/吴昌硕.png", "mask": "", "bbox": {"w": 227, "h": 188}}, {"master": "宋徽宗", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "铁线方折", "structure": "结体瘦长，连绵飞动", "desc": "如狂草，动中有静。笔法承袭其“瘦金体”，线条细劲如铁线，狂放疾驰，转折处如切金断玉，连绵不断。", "quality": "clear", "img": "imgs/20004/宋徽宗.png", "mask": "", "bbox": {"w": 155, "h": 239}}, {"master": "张瑞图", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "侧锋方折", "structure": "横向取势，奇峭紧密", "desc": "侧锋偏锋并用，翻折方硬，横向取势，节奏紧凑，风格尖利奇峭，别具一格。", "quality": "clear", "img": "imgs/20004/张瑞图.png", "mask": "", "bbox": {"w": 184, "h": 234}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "blurry", "img": "imgs/20004/智永.png", "mask": "", "bbox": {"w": 232, "h": 195}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20004/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 130}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20004/张即之.png", "mask": "", "bbox": {"w": 138, "h": 117}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20004/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 125}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20004/沈尹默.png", "mask": "", "bbox": {"w": 137, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20004/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 110}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20004/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 104}}]}