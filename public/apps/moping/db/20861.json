{"char": "兽", "samples": [{"master": "徐渭", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "疾涩纵肆", "structure": "结体纵逸，大小错落", "desc": "八法之散圣，字林之侠客。笔墨如骤雨狂风，恣肆汪洋，点画狼藉，不计工拙，主要表现激越的情感。", "quality": "clear", "img": "imgs/20861/徐渭.png", "mask": "", "bbox": {"w": 239, "h": 182}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "篆籀中锋", "structure": "结体方正宽博，重心安稳", "desc": "雄浑博大，其书气象森严，骨力遒劲，点画厚重，沉着有力。结体方正宽博，不尚纤巧。字势端严，重心安稳。", "quality": "clear", "img": "imgs/20861/颜真卿.png", "mask": "", "bbox": {"w": 239, "h": 199}}, {"master": "怀素", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "藏锋内转", "structure": "结法谨密，回旋多变", "desc": "狂草。笔法瘦硬，称为“铁线描”，速度极快，回旋进退，如骤雨旋风。援毫掣电，随手万变。超妙自得，笔老而意新。虽率意颠逸，千变万化，终不离晋法度故也。结法极谨密，微有不可识者。藏锋内转，瘦硬通神，而颠墨挫毫，无碎缺。", "quality": "clear", "img": "imgs/20861/怀素.png", "mask": "", "bbox": {"w": 213, "h": 210}}, {"master": "赵孟頫", "script": "隶书", "dynasty": "元代", "source": "帖", "stroke_style": "圆润简净", "structure": "结构简净，温雅平正", "desc": "复古，去繁就简，温雅纯正。", "quality": "blurry", "img": "imgs/20861/赵孟頫.png", "mask": "", "bbox": {"w": 232, "h": 188}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20861/张即之.png", "mask": "", "bbox": {"w": 138, "h": 102}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20861/智永.png", "mask": "", "bbox": {"w": 138, "h": 107}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20861/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 99}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20861/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 101}}, {"master": "虞世南", "script": "楷书", "dynasty":