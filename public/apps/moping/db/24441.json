{"char": "役", "samples": [{"master": "吴昌硕", "script": "篆书", "dynasty": "民国", "source": "帖", "stroke_style": "中锋遒劲", "structure": "结体欹侧，耸肩驼背", "desc": "如铸铁，如印泥。专攻《石鼓文》。用笔凝练遒劲，气度沉雄，打破了秦汉小篆的平衡，结体耸肩驼背，极具金石气。", "quality": "clear", "img": "imgs/24441/吴昌硕.png", "mask": "", "bbox": {"w": 169, "h": 233}}, {"master": "黄庭坚", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "提按纵横", "structure": "结体开张，纵横奇崛", "desc": "见长年荡桨，乃悟笔法。清圆妙丽，引绳贯珠。虽昂藏郁拔，而神闲，意秾。变态纵横，势若飞鹤之名书，法妍媚，笔势纵横。无一笔不自空中，荡漾而又沈著痛快。", "quality": "blurry", "img": "imgs/24441/黄庭坚.png", "mask": "", "bbox": {"w": 204, "h": 185}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24441/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 105}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24441/张即之.png", "mask": "", "bbox": {"w": 138, "h": 121}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24441/智永.png", "mask": "", "bbox": {"w": 138, "h": 120}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24441/柳公权.png", "mask": "", "bbox": {"w": 136, "h": 103}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24441/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 114}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24441/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 104}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "img