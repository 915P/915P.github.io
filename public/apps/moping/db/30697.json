{"char": "矩", "samples": [{"master": "李阳冰", "script": "篆书", "dynasty": "唐代", "source": "碑", "stroke_style": "铁线圆劲", "structure": "结构严谨，匀称修长", "desc": "以瘦劲取胜，线条如“玉箸”，粗细划一，圆润婉转，法度极严。", "quality": "blurry", "img": "imgs/30697/李阳冰.png", "mask": "", "bbox": {"w": 179, "h": 231}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "blurry", "img": "imgs/30697/智永.png", "mask": "", "bbox": {"w": 215, "h": 164}}, {"master": "鲜于枢", "script": "草书", "dynasty": "元代", "source": "帖", "stroke_style": "中锋迅猛", "structure": "结构夸张，纵逸豪放", "desc": "纵逸豪放，用笔迅猛，结构夸张，整体气势强烈，富有草原民族豪放气质。", "quality": "blurry", "img": "imgs/30697/鲜于枢.png", "mask": "", "bbox": {"w": 202, "h": 168}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/30697/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 90}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/30697/张即之.png", "mask": "", "bbox": {"w": 138, "h": 101}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/30697/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 123}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/30697/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 113}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/30697/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 98}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": nu