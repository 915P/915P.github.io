{"char": "一", "samples": [{"master": "柳公权", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "方折爽利", "structure": "中宫紧凑，结构严谨", "desc": "骨力遒劲，结构严谨，中宫紧凑，点画爽利，挺拔劲峭。", "quality": "blurry", "img": "imgs/19968/柳公权.png", "mask": "", "bbox": {"w": 198, "h": 43}}, {"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "blurry", "img": "imgs/19968/苏轼.png", "mask": "", "bbox": {"w": 218, "h": 64}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "圆润内刚", "structure": "结构沉静，外柔内刚", "desc": "字里金生，行间玉润。笔法圆润，外柔内刚，结构沉静，有一种君子温玉般的冲和之美。", "quality": "blurry", "img": "imgs/19968/虞世南.png", "mask": "", "bbox": {"w": 204, "h": 37}}, {"master": "伊秉绶", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "迟涩朴厚", "structure": "结体宽博，隶意横展", "desc": "隶意行书，结体宽博，用笔迟涩，行而不流。", "quality": "blurry", "img": "imgs/19968/伊秉绶.png", "mask": "", "bbox": {"w": 222, "h": 22}}, {"master": "吴昌硕", "script": "篆书", "dynasty": "民国", "source": "帖", "stroke_style": "中锋遒劲", "structure": "结体欹侧，耸肩驼背", "desc": "如铸铁，如印泥。专攻《石鼓文》。用笔凝练遒劲，气度沉雄，打破了秦汉小篆的平衡，结体耸肩驼背，极具金石气。", "quality": "blurry", "img": "imgs/19968/吴昌硕.png", "mask": "", "bbox": {"w": 228, "h": 31}}, {"master": "邓石如", "script": "篆书", "dynasty": "清代", "source": "帖", "stroke_style": "中锋圆劲", "structure": "结构严谨，匀称舒展", "desc": "线条圆润匀称，起止自然，结构严谨而不板滞，强调书写节奏与线条弹性", "quality": "clear", "img": "imgs/19968/邓石如.png", "mask": "", "bbox": {"w": 163, "h": 239}}, {"master": "陈道复", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "迅疾纵逸", "structure": "结体多变，欹侧奔放", "desc": "纵逸奔放，线条迅疾，结构多变，节奏感强烈，强调情绪表达与书写速度。", "quality": "blurry", "img": "imgs/19968/陈道复.png", "mask": "", "bbox": {"w": 212, "h": 55}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/19968/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 41}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/19968/张即之.png", "mask": "", "bbox": {"w": 138, "h": 42}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/19968/智永.png", "mask": "", "bbox": {"w": 138, "h": 30}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/19968/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 41}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/19968/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 27}}, {"master": "魏碑", "script": "楷书", "dynasty": "南北朝", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/19968/魏碑.png", "mask": "", "bbox": {"w": 138, "h": 42}}]}