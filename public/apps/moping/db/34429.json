{"char": "虽", "samples": [{"master": "倪元璐", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "渴笔涩行", "structure": "结体险绝，欹侧奇崛", "desc": "用笔多用渴墨（枯笔），线条生涩，结体险绝。", "quality": "blurry", "img": "imgs/34429/倪元璐.png", "mask": "", "bbox": {"w": 176, "h": 230}}, {"master": "吴昌硕", "script": "隶书", "dynasty": "民国", "source": "碑", "stroke_style": "中锋朴厚", "structure": "结体偏长，左低右高", "desc": "一意求中锋平直，且隶且篆。以《石鼓文》笔意写隶。结体偏长，左低右高，线条浑金璞玉，苍茫古朴。", "quality": "blurry", "img": "imgs/34429/吴昌硕.png", "mask": "", "bbox": {"w": 243, "h": 186}}, {"master": "王宠", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "用笔含蓄克制，连带不多", "structure": "结体多呈欹正相生之态", "desc": "清疏一路，行而不纵，动而能收，行气平缓，用笔含蓄克制，连带不多，字字分明，结体多呈欹正相生之态。", "quality": "blurry", "img": "imgs/34429/王宠.png", "mask": "", "bbox": {"w": 229, "h": 188}}, {"master": "王献之", "script": "行书", "dynasty": "晋代", "source": "碑", "stroke_style": "连绵外拓", "structure": "结体秀逸，外拓奔放", "desc": "运笔连绵不绝，气势豪迈，外露和奔放，挺然秀出，极草纵之致。", "quality": "clear", "img": "imgs/34429/王献之.png", "mask": "", "bbox": {"w": 181, "h": 220}}, {"master": "王福庵", "script": "篆书", "dynasty": "民国", "source": "碑", "stroke_style": "笔画粗细匀一", "structure": "圆润劲健，结体极度工整对称", "desc": "端庄杂流丽，刚健含婀娜。精研“铁线篆”。笔画粗细匀一，圆润劲健，结体极度工整对称，既有秦篆的严谨，又有金石的质感。", "quality": "clear", "img": "imgs/34429/王福庵.png", "mask": "", "bbox": {"w": 157, "h": 238}}, {"master": "陈道复", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "迅疾纵逸", "structure": "结体多变，欹侧奔放", "desc": "纵逸奔放，线条迅疾，结构多变，节奏感强烈，强调情绪表达与书写速度。", "quality": "blurry", "img": "imgs/34429/陈道复.png", "mask": "", "bbox": {"w": 164, "h": 183}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/34429/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 112}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/34429/张即之.png", "mask": "", "bbox": {"w": 1