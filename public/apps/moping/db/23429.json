{"char": "宅", "samples": [{"master": "米芾", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "八面出锋", "structure": "结体奇肆，纵横飞动", "desc": "超迈入神，殆非侧勒，趯策，掠啄，磔所能束缚也。如天马脱衔，追风逐电，虽不可范，以驰驱之节，要自不妨痛快。书如游龙，跃渊，骏焉，得御，矫然，拔秀，诚不可攀也。", "quality": "clear", "img": "imgs/23429/米芾.png", "mask": "", "bbox": {"w": 77, "h": 223}}, {"master": "董其昌", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "平稳含蓄", "structure": "中宫虚和，结体疏朗", "desc": "楷书结构疏朗，中宫虚和，用笔平稳含蓄，点画不尚锋芒而重整体气息。强调字内空间与章法呼应，追求“淡而有味”的审美取向，弱化力量感而突出文人书卷气。", "quality": "blurry", "img": "imgs/23429/董其昌.png", "mask": "", "bbox": {"w": 205, "h": 229}}, {"master": "倪元璐", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "折绞峭利", "structure": "结体奇崛，多折多绞", "desc": "纵肆狂放，结体奇崛，线条多折多绞，节奏强烈，富有强烈的个性张力。", "quality": "blurry", "img": "imgs/23429/倪元璐.png", "mask": "", "bbox": {"w": 133, "h": 221}}, {"master": "徐渭", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "疾涩奔突", "structure": "结体解构，大小悬殊", "desc": "纵横不羁，极度纵放，用笔迅疾而多断裂感，线条枯湿强烈对比，提按夸张，笔势奔突。结体往往解构传统形态，字形大小悬殊，空间高度自由。", "quality": "blurry", "img": "imgs/23429/徐渭.png", "mask": "", "bbox": {"w": 177, "h": 232}}, {"master": "邓石如", "script": "篆书", "dynasty": "清代", "source": "帖", "stroke_style": "中锋圆劲", "structure": "结构严谨，匀称舒展", "desc": "线条圆润匀称，起止自然，结构严谨而不板滞，强调书写节奏与线条弹性", "quality": "clear", "img": "imgs/23429/邓石如.png", "mask": "", "bbox": {"w": 164, "h": 233}}, {"master": "陈道复", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "迅疾纵逸", "structure": "结体多变，欹侧奔放", "desc": "纵逸奔放，线条迅疾，结构多变，节奏感强烈，强调情绪表达与书写速度。", "quality": "blurry", "img": "imgs/23429/陈道复.png", "mask": "", "bbox": {"w": 202, "h": 225}}, {"master": "颜真卿", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "篆籀中锋", "structure": "结构稳健，宽博雄浑", "desc": "以楷法入行，笔力雄浑，结构稳健，不尚轻逸而重气骨。纵横奔逸，气势连贯。笔意激切，真情流露。行笔跌宕，痛快淋漓。通篇气脉贯注，一气呵成。", "quality": "blurry", "img": "imgs/23429/颜真卿.png", "mask": "", "bbox": {"w": 186, "h": 232}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "sourc