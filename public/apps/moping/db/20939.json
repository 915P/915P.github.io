{"char": "凋", "samples": [{"master": "启功", "script": "楷书", "dynasty": "现代", "source": "帖", "stroke_style": "瘦硬清健", "structure": "中宫紧收，四肢舒展", "desc": "瘦硬清秀，中宫紧收，四肢舒展。独创“五三五”结字法（黄金分割），雅俗共赏，书卷气浓。", "quality": "blurry", "img": "imgs/20939/启功.png", "mask": "", "bbox": {"w": 200, "h": 209}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "blurry", "img": "imgs/20939/智永.png", "mask": "", "bbox": {"w": 207, "h": 187}}, {"master": "王羲之", "script": "行书", "dynasty": "晋代", "source": "帖", "stroke_style": "圆转精微", "structure": "结体疏朗平衡，欹正相生", "desc": "飘若游云，矫若惊龙。字势雄逸，如龙腾天门，虎卧凤阁。字法清润，全是章草笔意。自然流畅、情法兼备为核心特征，笔画圆转而富弹性，提按变化细腻而不露痕迹。结体疏朗平衡，欹正相生，字与字之间通过行气自然贯通。", "quality": "blurry", "img": "imgs/20939/王羲之.png", "mask": "", "bbox": {"w": 197, "h": 211}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20939/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 117}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20939/张即之.png", "mask": "", "bbox": {"w": 138, "h": 130}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20939/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 124}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20939/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 133}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20939/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 117}}, {"master": "赵孟頫", "s