{"char": "宠", "samples": [{"master": "伊秉绶", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "波磔内敛", "structure": "结构方正充实，横平竖直", "desc": "宽博平正，波磔内敛，结构端庄肃穆。结体方正充实，横平竖直，减省蚕头燕尾，具有强烈的装饰感和建筑美，气象博大。", "quality": "blurry", "img": "imgs/23456/伊秉绶.png", "mask": "", "bbox": {"w": 225, "h": 219}}, {"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "clear", "img": "imgs/23456/何绍基.png", "mask": "", "bbox": {"w": 207, "h": 222}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "圆润内刚", "structure": "结构沉静，外柔内刚", "desc": "字里金生，行间玉润。笔法圆润，外柔内刚，结构沉静，有一种君子温玉般的冲和之美。", "quality": "clear", "img": "imgs/23456/虞世南.png", "mask": "", "bbox": {"w": 191, "h": 242}}, {"master": "傅山", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转纵肆", "structure": "结体缠绕奇肆", "desc": "粗头乱服式线条，强调自然率真与生拙之美，笔势跌宕，墨法枯涩，极具反规范倾向。主张“宁拙毋巧”。连绵缠绕，圆转不休，气势磅礴，有一种乱头粗服、不加修饰的狂放之美。", "quality": "clear", "img": "imgs/23456/傅山.png", "mask": "", "bbox": {"w": 239, "h": 247}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "clear", "img": "imgs/23456/智永.png", "mask": "", "bbox": {"w": 185, "h": 210}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐代", "source": "帖", "stroke_style": "方折劲健", "structure": "中宫紧凑，结构严谨", "desc": "高重碑字，书锋力俱完，故特为佳。骨力遒劲，结构严谨，中宫紧凑，点画爽利，挺拔劲峭。", "quality": "blurry", "img": "imgs/23456/柳公权.png", "mask": "", "bbox": {"w": 188, "h": 224}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "clear", "img": "imgs/23456/米芾.png", "mask": "", "bbox": {"w": 213, "h": 240}}, {"master": "颜真卿", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "篆籀中锋", "structure": "结构稳健，宽博雄浑", "desc": "以楷法入行，笔力雄浑，结构稳健，不尚轻逸而重气骨。纵横奔逸，气势连贯。笔意激切，真情流露。行笔跌宕，痛快淋漓。通篇气脉贯注，一气呵成。", "quality": "blurry", "img": "imgs/23456/颜真卿.png", "mask": "", "bbox": {"w": 194, "h": 191}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23456/张即之.png", "mask": "", "bbox": {"w": 129, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23456/沈尹默.png", "mask": "", "bbox": {"w": 124, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23456/赵之谦.png", "mask": "", "bbox": {"w": 126, "h": 138}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23456/赵孟頫.png", "mask": "", "bbox": {"w": 127, "h": 138}}]}