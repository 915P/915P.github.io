{"char": "庸", "samples": [{"master": "王铎", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "中侧并用", "structure": "结体欹侧夸张，大起大落", "desc": "翻转激荡，气势逼人，纵横恣肆，以强烈的连绵与翻转取势，字势大起大落，结体欹侧夸张，线条多中侧锋并用，提按对比剧烈。用墨浓枯交错。", "quality": "clear", "img": "imgs/24248/王铎.png", "mask": "", "bbox": {"w": 174, "h": 254}}, {"master": "褚遂良", "script": "楷书", "dynasty": "唐代", "source": "帖", "stroke_style": "瘦劲含蓄", "structure": "结体宽博灵动，多姿多态", "desc": "瘦而不弱，笔划极富变化，线条有弹性，结体宽博灵动，多姿多态，空灵飞动。笔瘦劲挺拔，线条富弹性，转折处锋芒内敛。结体严谨而不板滞，姿态清秀中见劲健。", "quality": "blurry", "img": "imgs/24248/褚遂良.png", "mask": "", "bbox": {"w": 178, "h": 232}}, {"master": "黄庭坚", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "提按纵横", "structure": "结体开张，纵横奇崛", "desc": "见长年荡桨，乃悟笔法。清圆妙丽，引绳贯珠。虽昂藏郁拔，而神闲，意秾。变态纵横，势若飞鹤之名书，法妍媚，笔势纵横。无一笔不自空中，荡漾而又沈著痛快。", "quality": "blurry", "img": "imgs/24248/黄庭坚.png", "mask": "", "bbox": {"w": 164, "h": 222}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24248/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 133}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24248/张即之.png", "mask": "", "bbox": {"w": 114, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24248/智永.png", "mask": "", "bbox": {"w": 106, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24248/柳公权.png", "mask": "", "bbox": {"w": 112, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24248/沈尹默.png", "mask": "", "bbox": {"w": 116, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "