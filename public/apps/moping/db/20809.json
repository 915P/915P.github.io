{"char": "光", "samples": [{"master": "倪元璐", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "渴笔涩行", "structure": "结体险绝，欹侧奇崛", "desc": "用笔多用渴墨（枯笔），线条生涩，结体险绝。", "quality": "blurry", "img": "imgs/20809/倪元璐.png", "mask": "", "bbox": {"w": 227, "h": 197}}, {"master": "唐玄宗", "script": "隶书", "dynasty": "唐代", "source": "碑", "stroke_style": "波磔丰满", "structure": "结构严整，方正丰腴", "desc": "虽有唐人习气，而端严庄重。字形肥硕，笔画丰满，挑法明显，结构严整，尽显盛唐丰腴之美。", "quality": "clear", "img": "imgs/20809/唐玄宗.png", "mask": "", "bbox": {"w": 243, "h": 191}}, {"master": "王宠", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "用笔含蓄克制，连带不多", "structure": "结体多呈欹正相生之态", "desc": "清疏一路，行而不纵，动而能收，行气平缓，用笔含蓄克制，连带不多，字字分明，结体多呈欹正相生之态。", "quality": "clear", "img": "imgs/20809/王宠.png", "mask": "", "bbox": {"w": 142, "h": 238}}, {"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "blurry", "img": "imgs/20809/蔡襄.png", "mask": "", "bbox": {"w": 221, "h": 178}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "篆籀中锋", "structure": "结体方正宽博，重心安稳", "desc": "雄浑博大，其书气象森严，骨力遒劲，点画厚重，沉着有力。结体方正宽博，不尚纤巧。字势端严，重心安稳。", "quality": "clear", "img": "imgs/20809/颜真卿.png", "mask": "", "bbox": {"w": 232, "h": 240}}, {"master": "宋高宗", "script": "楷书", "dynasty": "宋代", "source": "帖", "stroke_style": "圆润精到", "structure": "结构端庄，平正匀稳", "desc": "圆润流利，规范端庄，用笔精到，具有典型的皇家富贵气和晋唐法度。", "quality": "blurry", "img": "imgs/20809/宋高宗.png", "mask": "", "bbox": {"w": 216, "h": 171}}, {"master": "朱熹", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "中锋厚重", "structure": "结体端正，沉稳厚重", "desc": "汉魏风骨，无半点俗气。不求态势，强调笔墨沉着。用笔中锋，点画厚重，结体端正，有一股刚正的儒家正气。", "quality": "clear", "img": "imgs/20809/朱熹.png", "mask": "", "bbox": {"w": 165, "h": 201}}, {"master": "王铎", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "中侧并用", "structure": "结体欹侧夸张，大起大落", "desc": "翻转激荡，气势逼人，纵横恣肆，以强烈的连绵与翻转取势，字势大起大落，结体欹侧夸张，线条多中侧锋并用，提按对比剧烈。用墨浓枯交错。", "quality": "blurry", "img": "imgs/20809/王铎.png", "mask": "", "bbox": {"w": 149, "h": 219}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "blurry", "img": "imgs/20809/米芾.png", "mask": "", "bbox": {"w": 165, "h": 239}}, {"master": "金农", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "方折生涩", "structure": "结构夸张，古拙奇崛", "desc": "方笔为主，线条粗重，刻意生涩，结构夸张，强调金石气与拙朴美感。", "quality": "clear", "img": "imgs/20809/金农.png", "mask": "", "bbox": {"w": 205, "h": 180}}, {"master": "陈道复", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "迅疾纵逸", "structure": "结体多变，欹侧奔放", "desc": "纵逸奔放，线条迅疾，结构多变，节奏感强烈，强调情绪表达与书写速度。", "quality": "blurry", "img": "imgs/20809/陈道复.png", "mask": "", "bbox": {"w": 174, "h": 224}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20809/张即之.png", "mask": "", "bbox": {"w": 138, "h": 134}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20809/智永.png", "mask": "", "bbox": {"w": 138, "h": 137}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20809/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 124}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20809/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 117}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20809/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 115}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20809/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 111}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20809/赵孟頫.png", "mask": "", "bbox": {"w": 137, "h": 126}}]}