{"char": "付", "samples": [{"master": "苏轼", "script": "楷书", "dynasty": "宋代", "source": "帖", "stroke_style": "藏锋丰腴", "structure": "结体宽博，丰腴稳重", "desc": "以淳古重。东坡丰艳，脱尽绳墨，藏锋敛锷。重而肉稍肥。匀稳妍妙，风神在披拂间，而微欲近碑侧，记行稍自结，虽有墨猪之诮，最为淳古。肉丰而骨劲，态浓而意淡，巧于拙，特为秀伟。", "quality": "clear", "img": "imgs/20184/苏轼.png", "mask": "", "bbox": {"w": 225, "h": 180}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20184/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 105}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20184/张即之.png", "mask": "", "bbox": {"w": 138, "h": 135}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20184/智永.png", "mask": "", "bbox": {"w": 138, "h": 136}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20184/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 114}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20184/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 116}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20184/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 112}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20184/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 103}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20184/赵孟頫.png", "mask": "", "bbox": {"w": 138, "h": 