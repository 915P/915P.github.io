{"char": "掇", "samples": [{"master": "沈周", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "中锋颤涩", "structure": "结构开张，拙朴雄强", "desc": "遒劲奇崛，用笔中锋，线条粗壮且多颤笔，结构开张，虽然略显拙朴，但苍劲有力。", "quality": "blurry", "img": "imgs/25479/沈周.png", "mask": "", "bbox": {"w": 231, "h": 174}}, {"master": "苏轼", "script": "楷书", "dynasty": "宋代", "source": "帖", "stroke_style": "藏锋丰腴", "structure": "结体宽博，丰腴稳重", "desc": "以淳古重。东坡丰艳，脱尽绳墨，藏锋敛锷。重而肉稍肥。匀稳妍妙，风神在披拂间，而微欲近碑侧，记行稍自结，虽有墨猪之诮，最为淳古。肉丰而骨劲，态浓而意淡，巧于拙，特为秀伟。", "quality": "blurry", "img": "imgs/25479/苏轼.png", "mask": "", "bbox": {"w": 232, "h": 213}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25479/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 100}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25479/张即之.png", "mask": "", "bbox": {"w": 138, "h": 133}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25479/智永.png", "mask": "", "bbox": {"w": 137, "h": 102}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25479/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 114}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25479/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 99}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25479/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 104}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25479/