{"char": "巾", "samples": [{"master": "王宠", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "用笔含蓄克制，连带不多", "structure": "结体多呈欹正相生之态", "desc": "清疏一路，行而不纵，动而能收，行气平缓，用笔含蓄克制，连带不多，字字分明，结体多呈欹正相生之态。", "quality": "clear", "img": "imgs/24062/王宠.png", "mask": "", "bbox": {"w": 90, "h": 236}}, {"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "blurry", "img": "imgs/24062/苏轼.png", "mask": "", "bbox": {"w": 84, "h": 141}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24062/颜真卿.png", "mask": "", "bbox": {"w": 94, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24062/张即之.png", "mask": "", "bbox": {"w": 84, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24062/智永.png", "mask": "", "bbox": {"w": 78, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24062/柳公权.png", "mask": "", "bbox": {"w": 76, "h": 137}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24062/沈尹默.png", "mask": "", "bbox": {"w": 71, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24062/虞世南.png", "mask": "", "bbox": {"w": 61, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style":