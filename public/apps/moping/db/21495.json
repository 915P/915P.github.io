{"char": "号", "samples": [{"master": "傅山", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "率意纵肆", "structure": "结体奇特，纵逸不拘", "desc": "与草书类似，强调直抒胸臆。结体奇特，墨色淋漓，不拘成法，真气弥满。", "quality": "clear", "img": "imgs/21495/傅山.png", "mask": "", "bbox": {"w": 128, "h": 254}}, {"master": "文征明", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "中锋秀劲", "structure": "结体严谨，疏朗秀美", "desc": "小楷精绝。温润秀劲，法度严谨，笔笔不苟，有晋唐遗风。", "quality": "blurry", "img": "imgs/21495/文征明.png", "mask": "", "bbox": {"w": 224, "h": 182}}, {"master": "王宠", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "用笔含蓄克制，连带不多", "structure": "结体多呈欹正相生之态", "desc": "清疏一路，行而不纵，动而能收，行气平缓，用笔含蓄克制，连带不多，字字分明，结体多呈欹正相生之态。", "quality": "blurry", "img": "imgs/21495/王宠.png", "mask": "", "bbox": {"w": 161, "h": 229}}, {"master": "王献之", "script": "行书", "dynasty": "晋代", "source": "碑", "stroke_style": "连绵外拓", "structure": "结体秀逸，外拓奔放", "desc": "运笔连绵不绝，气势豪迈，外露和奔放，挺然秀出，极草纵之致。", "quality": "blurry", "img": "imgs/21495/王献之.png", "mask": "", "bbox": {"w": 215, "h": 235}}, {"master": "祝允明", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "中锋顿挫", "structure": "结体严谨，不板不滞", "desc": "守法而不激，结体严谨而不板滞，用笔中锋为主，点画分明，转折处见顿挫。", "quality": "blurry", "img": "imgs/21495/祝允明.png", "mask": "", "bbox": {"w": 215, "h": 226}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "clear", "img": "imgs/21495/智永.png", "mask": "", "bbox": {"w": 214, "h": 235}}, {"master": "蔡襄", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "藏锋稳健", "structure": "结体端庄严整", "desc": "浑厚端庄，淳淡婉美，恪守法度，具有极高的传统功力。", "quality": "clear", "img": "imgs/21495/蔡襄.png", "mask": "", "bbox": {"w": 196, "h": 218}}, {"master": "赵孟頫", "script": "隶书", "dynasty": "元代", "source": "帖", "stroke_style": "圆润简净", "structure": "结构简净，温雅平正", "desc": "复古，去繁就简，温雅纯正。