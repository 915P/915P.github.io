{"char": "思", "samples": [{"master": "伊秉绶", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "波磔内敛", "structure": "结构方正充实，横平竖直", "desc": "宽博平正，波磔内敛，结构端庄肃穆。结体方正充实，横平竖直，减省蚕头燕尾，具有强烈的装饰感和建筑美，气象博大。", "quality": "blurry", "img": "imgs/24605/伊秉绶.png", "mask": "", "bbox": {"w": 234, "h": 200}}, {"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "clear", "img": "imgs/24605/何绍基.png", "mask": "", "bbox": {"w": 214, "h": 245}}, {"master": "王宠", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "用笔含蓄克制，连带不多", "structure": "结体多呈欹正相生之态", "desc": "清疏一路，行而不纵，动而能收，行气平缓，用笔含蓄克制，连带不多，字字分明，结体多呈欹正相生之态。", "quality": "clear", "img": "imgs/24605/王宠.png", "mask": "", "bbox": {"w": 181, "h": 238}}, {"master": "傅山", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转纵肆", "structure": "结体缠绕奇肆", "desc": "粗头乱服式线条，强调自然率真与生拙之美，笔势跌宕，墨法枯涩，极具反规范倾向。主张“宁拙毋巧”。连绵缠绕，圆转不休，气势磅礴，有一种乱头粗服、不加修饰的狂放之美。", "quality": "clear", "img": "imgs/24605/傅山.png", "mask": "", "bbox": {"w": 221, "h": 244}}, {"master": "唐寅", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转妍美", "structure": "结体俊逸，疏朗妍美", "desc": "笔法圆转妍美，结体俊逸，书卷气浓，潇洒流落，风流倜傥。", "quality": "blurry", "img": "imgs/24605/唐寅.png", "mask": "", "bbox": {"w": 192, "h": 226}}, {"master": "康里巎巎", "script": "行书", "dynasty": "元代", "source": "帖", "stroke_style": "悬腕迅疾", "structure": "结体修长，行气贯通", "desc": "运笔极快，如疾风骤雨。悬腕行笔，线条爽利锋锐，节奏明快，既有流美，又有北方民族的豪爽。", "quality": "clear", "img": "imgs/24605/康里巎巎.png", "mask": "", "bbox": {"w": 225, "h": 215}}, {"master": "林散之", "script": "隶书", "dynasty": "现代", "source": "帖", "stroke_style": "草意圆转", "structure": "结体舒展，高古灵动", "desc": "以汉隶为基，掺入草意。线条柔韧，墨色苍润，结体不拘泥于扁方，显出一种高古而灵动的意趣。", "quality": "clear", "img": "imgs/24605/林散之.png", "mask": "", "bbox": {"w": 235, "h": 189}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null