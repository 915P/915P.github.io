{"char": "强", "samples": [{"master": "孙过庭", "script": "草书", "dynasty": "唐代", "source": "碑", "stroke_style": "笔法精微，提按清晰", "structure": "结体疏朗简约", "desc": "法度严谨而流美自然，笔法精微，提按清晰，结体疏朗。工于用笔，俊拔刚断，尚异好奇，凌越险阻。如丹崖绝壑，笔势坚劲。", "quality": "blurry", "img": "imgs/24378/孙过庭.png", "mask": "", "bbox": {"w": 225, "h": 200}}, {"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "clear", "img": "imgs/24378/蔡襄.png", "mask": "", "bbox": {"w": 185, "h": 236}}, {"master": "王献之", "script": "草书", "dynasty": "晋代", "source": "帖", "stroke_style": "藏锋连绵", "structure": "结体妍雅平稳，气脉贯通", "desc": "圆转流美，以圆转流美取胜，笔画多绵连而不板滞，线条柔韧含蓄，起止多藏锋，强调气脉贯通而弱化笔画棱角。结体趋于妍雅平稳，节奏舒缓而富有韵致。", "quality": "blurry", "img": "imgs/24378/王献之.png", "mask": "", "bbox": {"w": 198, "h": 178}}]}