{"char": "审", "samples": [{"master": "于右任", "script": "楷书", "dynasty": "民国", "source": "碑", "stroke_style": "碑意朴厚", "structure": "结体方整，古拙朴厚", "desc": "融碑入帖，结体方整而不板滞，线条朴厚，具有明显碑刻意味。", "quality": "clear", "img": "imgs/23457/于右任.png", "mask": "", "bbox": {"w": 205, "h": 230}}, {"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "blurry", "img": "imgs/23457/何绍基.png", "mask": "", "bbox": {"w": 181, "h": 225}}, {"master": "文征明", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "中锋秀劲", "structure": "结体严谨，疏朗秀美", "desc": "小楷精绝。温润秀劲，法度严谨，笔笔不苟，有晋唐遗风。", "quality": "blurry", "img": "imgs/23457/文征明.png", "mask": "", "bbox": {"w": 175, "h": 211}}, {"master": "智永", "script": "草书", "dynasty": "隋代", "source": "碑", "stroke_style": "藏锋圆转", "structure": "结体圆转，气脉连贯", "desc": "笔笔从空中落，从空中住，虽屋漏痕，犹不足以喻之。", "quality": "clear", "img": "imgs/23457/智永.png", "mask": "", "bbox": {"w": 176, "h": 236}}, {"master": "王献之", "script": "行书", "dynasty": "晋代", "source": "碑", "stroke_style": "连绵外拓", "structure": "结体秀逸，外拓奔放", "desc": "运笔连绵不绝，气势豪迈，外露和奔放，挺然秀出，极草纵之致。", "quality": "clear", "img": "imgs/23457/王献之.png", "mask": "", "bbox": {"w": 161, "h": 254}}, {"master": "米芾", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "八面出锋", "structure": "结体奇肆，纵横飞动", "desc": "超迈入神，殆非侧勒，趯策，掠啄，磔所能束缚也。如天马脱衔，追风逐电，虽不可范，以驰驱之节，要自不妨痛快。书如游龙，跃渊，骏焉，得御，矫然，拔秀，诚不可攀也。", "quality": "clear", "img": "imgs/23457/米芾.png", "mask": "", "bbox": {"w": 183, "h": 242}}, {"master": "何绍基", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "回腕颤涩", "structure": "随字赋形，生动自然", "desc": "如天仙化人，绝无尘俗。笔法独特，多用“颤笔”，线条极其苍茫老辣，结体随字赋形，生动自然。", "quality": "blurry", "img": "imgs/23457/何绍基.png", "mask": "", "bbox": {"w": 227, "h": 201}}, {"master": "欧阳询", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "瘦劲方折", "structure": "中宫收敛，结体紧密", "desc": "严整险劲，结体紧密，中宫收敛，笔画瘦劲而劲健，转折分明，行气克制，不尚流便而重法度。", "quality": "blurry", "img": "imgs/23457/欧阳询.png", "mask": "", "bbox": {"w": 129, "h": 220}}, {"master": "王羲之", "script": "行书", "dynasty": "晋代", "source": "帖", "stroke_style": "圆转精微", "structure": "结体疏朗平衡，欹正相生", "desc": "飘若游云，矫若惊龙。字势雄逸，如龙腾天门，虎卧凤阁。字法清润，全是章草笔意。自然流畅、情法兼备为核心特征，笔画圆转而富弹性，提按变化细腻而不露痕迹。结体疏朗平衡，欹正相生，字与字之间通过行气自然贯通。", "quality": "blurry", "img": "imgs/23457/王羲之.png", "mask": "", "bbox": {"w": 196, "h": 231}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23457/颜真卿.png", "mask": "", "bbox": {"w": 119, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23457/张即之.png", "mask": "", "bbox": {"w": 105, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23457/柳公权.png", "mask": "", "bbox": {"w": 106, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23457/沈尹默.png", "mask": "", "bbox": {"w": 108, "h": 134}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23457/虞世南.png", "mask": "", "bbox": {"w": 130, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23457/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 129}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23457/赵孟頫.png", "mask": "", "bbox": {"w": 111, "h": 138}}]}