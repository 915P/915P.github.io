{"char": "禄", "samples": [{"master": "黄庭坚", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "提按顿挫", "structure": "结体险绝，开张多变", "desc": "险坠，落墨奇，骨丰筋，力不使，转恶，悉出，极而且温，浓纤刚柔，一皆与人意，会其合，处直接皇石，不止屋漏，漏雨法也。", "quality": "blurry", "img": "imgs/31108/黄庭坚.png", "mask": "", "bbox": {"w": 224, "h": 185}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "blurry", "img": "imgs/31108/智永.png", "mask": "", "bbox": {"w": 221, "h": 152}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31108/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 114}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31108/张即之.png", "mask": "", "bbox": {"w": 130, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31108/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 119}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31108/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 121}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31108/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 115}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31108/赵之谦.png", "mask": "", "bbox": {"w": 137, "h": 107}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": nu