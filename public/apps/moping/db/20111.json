{"char": "亏", "samples": [{"master": "李阳冰", "script": "篆书", "dynasty": "唐代", "source": "碑", "stroke_style": "铁线圆劲", "structure": "结构严谨，匀称修长", "desc": "以瘦劲取胜，线条如“玉箸”，粗细划一，圆润婉转，法度极严。", "quality": "blurry", "img": "imgs/20111/李阳冰.png", "mask": "", "bbox": {"w": 194, "h": 238}}, {"master": "钟繇", "script": "楷书", "dynasty": "三国", "source": "碑", "stroke_style": "结构严谨", "structure": "笔势遒劲雄强，如壮士拔剑，森然有威", "desc": "妙绝古法，笔势刚劲，笔势遒劲，结构严谨，精妙绝伦，姿态万千。如云鹄游天，群鸿戏海。笔力遒劲，如壮士拔剑，森然有威。笔势雄强，气韵生动，如龙腾虎跃，气势磅礴。", "quality": "clear", "img": "imgs/20111/钟繇.png", "mask": "", "bbox": {"w": 244, "h": 221}}, {"master": "宋徽宗", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "铁线方折", "structure": "结体瘦长，连绵飞动", "desc": "如狂草，动中有静。笔法承袭其“瘦金体”，线条细劲如铁线，狂放疾驰，转折处如切金断玉，连绵不断。", "quality": "clear", "img": "imgs/20111/宋徽宗.png", "mask": "", "bbox": {"w": 190, "h": 234}}, {"master": "王羲之", "script": "行书", "dynasty": "晋代", "source": "帖", "stroke_style": "圆转精微", "structure": "结体疏朗平衡，欹正相生", "desc": "飘若游云，矫若惊龙。字势雄逸，如龙腾天门，虎卧凤阁。字法清润，全是章草笔意。自然流畅、情法兼备为核心特征，笔画圆转而富弹性，提按变化细腻而不露痕迹。结体疏朗平衡，欹正相生，字与字之间通过行气自然贯通。", "quality": "blurry", "img": "imgs/20111/王羲之.png", "mask": "", "bbox": {"w": 154, "h": 169}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20111/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 122}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20111/张即之.png", "mask": "", "bbox": {"w": 138, "h": 131}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20111/智永.png", "mask": "", "bbox": {"w": 123, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20111/柳公权.png", "mask": "", "bbox": {"w": 119, "h":