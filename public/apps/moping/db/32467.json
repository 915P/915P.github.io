{"char": "结", "samples": [{"master": "智永", "script": "草书", "dynasty": "隋代", "source": "碑", "stroke_style": "藏锋圆转", "structure": "结体圆转，气脉连贯", "desc": "笔笔从空中落，从空中住，虽屋漏痕，犹不足以喻之。", "quality": "clear", "img": "imgs/32467/智永.png", "mask": "", "bbox": {"w": 223, "h": 211}}, {"master": "钟繇", "script": "楷书", "dynasty": "三国", "source": "碑", "stroke_style": "结构严谨", "structure": "笔势遒劲雄强，如壮士拔剑，森然有威", "desc": "妙绝古法，笔势刚劲，笔势遒劲，结构严谨，精妙绝伦，姿态万千。如云鹄游天，群鸿戏海。笔力遒劲，如壮士拔剑，森然有威。笔势雄强，气韵生动，如龙腾虎跃，气势磅礴。", "quality": "clear", "img": "imgs/32467/钟繇.png", "mask": "", "bbox": {"w": 212, "h": 182}}, {"master": "宋徽宗", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "铁线方折", "structure": "结体瘦长，连绵飞动", "desc": "如狂草，动中有静。笔法承袭其“瘦金体”，线条细劲如铁线，狂放疾驰，转折处如切金断玉，连绵不断。", "quality": "clear", "img": "imgs/32467/宋徽宗.png", "mask": "", "bbox": {"w": 212, "h": 254}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "clear", "img": "imgs/32467/智永.png", "mask": "", "bbox": {"w": 213, "h": 190}}, {"master": "赵孟頫", "script": "隶书", "dynasty": "元代", "source": "帖", "stroke_style": "圆润简净", "structure": "结构简净，温雅平正", "desc": "复古，去繁就简，温雅纯正。", "quality": "blurry", "img": "imgs/32467/赵孟頫.png", "mask": "", "bbox": {"w": 241, "h": 178}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/32467/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 123}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/32467/张即之.png", "mask": "", "bbox": {"w": 138, "h": 124}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/32467/柳公权.png", "mask": "", "bbox": {"