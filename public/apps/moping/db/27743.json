{"char": "江", "samples": [{"master": "米芾", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "八面出锋", "structure": "结体奇肆，纵横飞动", "desc": "超迈入神，殆非侧勒，趯策，掠啄，磔所能束缚也。如天马脱衔，追风逐电，虽不可范，以驰驱之节，要自不妨痛快。书如游龙，跃渊，骏焉，得御，矫然，拔秀，诚不可攀也。", "quality": "blurry", "img": "imgs/27743/米芾.png", "mask": "", "bbox": {"w": 222, "h": 174}}, {"master": "褚遂良", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "楷法劲健", "structure": "结体严整，清秀灵动", "desc": "以楷法为骨，行气清晰，线条劲健而不纵逸，连带克制。整体呈现出清秀、严整而略带灵动的面貌。", "quality": "blurry", "img": "imgs/27743/褚遂良.png", "mask": "", "bbox": {"w": 208, "h": 190}}, {"master": "钟繇", "script": "楷书", "dynasty": "三国", "source": "碑", "stroke_style": "结构严谨", "structure": "笔势遒劲雄强，如壮士拔剑，森然有威", "desc": "妙绝古法，笔势刚劲，笔势遒劲，结构严谨，精妙绝伦，姿态万千。如云鹄游天，群鸿戏海。笔力遒劲，如壮士拔剑，森然有威。笔势雄强，气韵生动，如龙腾虎跃，气势磅礴。", "quality": "clear", "img": "imgs/27743/钟繇.png", "mask": "", "bbox": {"w": 222, "h": 164}}, {"master": "倪元璐", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "折绞峭利", "structure": "结体奇崛，多折多绞", "desc": "纵肆狂放，结体奇崛，线条多折多绞，节奏强烈，富有强烈的个性张力。", "quality": "blurry", "img": "imgs/27743/倪元璐.png", "mask": "", "bbox": {"w": 177, "h": 208}}, {"master": "康里巎巎", "script": "行书", "dynasty": "元代", "source": "帖", "stroke_style": "悬腕迅疾", "structure": "结体修长，行气贯通", "desc": "运笔极快，如疾风骤雨。悬腕行笔，线条爽利锋锐，节奏明快，既有流美，又有北方民族的豪爽。", "quality": "clear", "img": "imgs/27743/康里巎巎.png", "mask": "", "bbox": {"w": 226, "h": 201}}, {"master": "张旭", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "连绵回绕", "structure": "结体纵逸，起伏跌宕", "desc": "变动犹鬼神，不可端倪。狂草。连绵回绕，起伏跌宕，千变万化，气势如虹，惊心动魄。", "quality": "clear", "img": "imgs/27743/张旭.png", "mask": "", "bbox": {"w": 216, "h": 223}}, {"master": "徐渭", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "疾涩奔突", "structure": "结体解构，大小悬殊", "desc": "纵横不羁，极度纵放，用笔迅疾而多断裂感，线条枯湿强烈对比，提按夸张，笔势奔突。结体往往解构传统形态，字形大小悬殊，空间高度自由。", "quality": "blurry", "img": "imgs/27743/徐渭.png", "mask": "", "bbox": {"w": 172, "h": 229}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", 