{"char": "三", "samples": [{"master": "欧阳询", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "方折险劲", "structure": "中宫紧收，险绝稳健", "desc": "法度森严，笔力险峻。点画方硬，结体险绝而稳健，中宫紧收，修长挺拔。", "quality": "blurry", "img": "imgs/19977/欧阳询.png", "mask": "", "bbox": {"w": 214, "h": 126}}, {"master": "黄庭坚", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "提按顿挫", "structure": "结体险绝，开张多变", "desc": "险坠，落墨奇，骨丰筋，力不使，转恶，悉出，极而且温，浓纤刚柔，一皆与人意，会其合，处直接皇石，不止屋漏，漏雨法也。", "quality": "blurry", "img": "imgs/19977/黄庭坚.png", "mask": "", "bbox": {"w": 220, "h": 124}}, {"master": "苏轼", "script": "楷书", "dynasty": "宋代", "source": "帖", "stroke_style": "藏锋丰腴", "structure": "结体宽博，丰腴稳重", "desc": "以淳古重。东坡丰艳，脱尽绳墨，藏锋敛锷。重而肉稍肥。匀稳妍妙，风神在披拂间，而微欲近碑侧，记行稍自结，虽有墨猪之诮，最为淳古。肉丰而骨劲，态浓而意淡，巧于拙，特为秀伟。", "quality": "blurry", "img": "imgs/19977/苏轼.png", "mask": "", "bbox": {"w": 218, "h": 153}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/19977/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 101}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/19977/张即之.png", "mask": "", "bbox": {"w": 138, "h": 87}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/19977/智永.png", "mask": "", "bbox": {"w": 138, "h": 97}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/19977/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 96}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/19977/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 98}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "struct