{"char": "品", "samples": [{"master": "于右任", "script": "楷书", "dynasty": "民国", "source": "碑", "stroke_style": "碑意朴厚", "structure": "结体方整，古拙朴厚", "desc": "融碑入帖，结体方整而不板滞，线条朴厚，具有明显碑刻意味。", "quality": "clear", "img": "imgs/21697/于右任.png", "mask": "", "bbox": {"w": 225, "h": 160}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "篆籀中锋", "structure": "结体方正宽博，重心安稳", "desc": "雄浑博大，其书气象森严，骨力遒劲，点画厚重，沉着有力。结体方正宽博，不尚纤巧。字势端严，重心安稳。", "quality": "clear", "img": "imgs/21697/颜真卿.png", "mask": "", "bbox": {"w": 232, "h": 205}}, {"master": "吴昌硕", "script": "篆书", "dynasty": "民国", "source": "帖", "stroke_style": "中锋遒劲", "structure": "结体欹侧，耸肩驼背", "desc": "如铸铁，如印泥。专攻《石鼓文》。用笔凝练遒劲，气度沉雄，打破了秦汉小篆的平衡，结体耸肩驼背，极具金石气。", "quality": "blurry", "img": "imgs/21697/吴昌硕.png", "mask": "", "bbox": {"w": 145, "h": 228}}, {"master": "王宠", "script": "楷书", "dynasty": "明代", "source": "帖", "stroke_style": "中锋细劲", "structure": "中宫疏朗，骨架分明", "desc": "清润雅正，疏朗而不散，清瘦而不弱，中宫不紧而骨架分明，用笔细劲含蓄，多以中锋行笔，转折自然。", "quality": "clear", "img": "imgs/21697/王宠.png", "mask": "", "bbox": {"w": 221, "h": 199}}, {"master": "金农", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "方折生涩", "structure": "结构夸张，古拙奇崛", "desc": "方笔为主，线条粗重，刻意生涩，结构夸张，强调金石气与拙朴美感。", "quality": "clear", "img": "imgs/21697/金农.png", "mask": "", "bbox": {"w": 225, "h": 163}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21697/张即之.png", "mask": "", "bbox": {"w": 129, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21697/智永.png", "mask": "", "bbox": {"w": 137, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21697/柳公权.png", "mask": "", "bbox": {"w": 126, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynast