{"char": "后", "samples": [{"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "blurry", "img": "imgs/21518/何绍基.png", "mask": "", "bbox": {"w": 223, "h": 183}}, {"master": "吴昌硕", "script": "隶书", "dynasty": "民国", "source": "碑", "stroke_style": "中锋朴厚", "structure": "结体偏长，左低右高", "desc": "一意求中锋平直，且隶且篆。以《石鼓文》笔意写隶。结体偏长，左低右高，线条浑金璞玉，苍茫古朴。", "quality": "blurry", "img": "imgs/21518/吴昌硕.png", "mask": "", "bbox": {"w": 235, "h": 143}}, {"master": "李阳冰", "script": "篆书", "dynasty": "唐代", "source": "碑", "stroke_style": "铁线圆劲", "structure": "结构严谨，匀称修长", "desc": "以瘦劲取胜，线条如“玉箸”，粗细划一，圆润婉转，法度极严。", "quality": "blurry", "img": "imgs/21518/李阳冰.png", "mask": "", "bbox": {"w": 196, "h": 234}}, {"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "blurry", "img": "imgs/21518/蔡襄.png", "mask": "", "bbox": {"w": 230, "h": 206}}, {"master": "傅山", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转纵肆", "structure": "结体缠绕奇肆", "desc": "粗头乱服式线条，强调自然率真与生拙之美，笔势跌宕，墨法枯涩，极具反规范倾向。主张“宁拙毋巧”。连绵缠绕，圆转不休，气势磅礴，有一种乱头粗服、不加修饰的狂放之美。", "quality": "clear", "img": "imgs/21518/傅山.png", "mask": "", "bbox": {"w": 168, "h": 237}}, {"master": "吴昌硕", "script": "篆书", "dynasty": "民国", "source": "帖", "stroke_style": "中锋遒劲", "structure": "结体欹侧，耸肩驼背", "desc": "如铸铁，如印泥。专攻《石鼓文》。用笔凝练遒劲，气度沉雄，打破了秦汉小篆的平衡，结体耸肩驼背，极具金石气。", "quality": "blurry", "img": "imgs/21518/吴昌硕.png", "mask": "", "bbox": {"w": 173, "h": 228}}, {"master": "王献之", "script": "草书", "dynasty": "晋代", "source": "帖", "stroke_style": "藏锋连绵", "structure": "结体妍雅平稳，气脉贯通", "desc": "圆转流美，以圆转流美取胜，笔画多绵连而不板滞，线条柔韧含蓄，起止多藏锋，强调气脉贯通而弱化笔画棱角。结体趋于妍雅平稳，节奏舒缓而富有韵致。", "quality": "blurry", "img": "imgs/21518/王献之.png", "mask": "", "bbox": {"w": 231, "h": 208}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "clear", "img": "imgs/21518/米芾.png", "mask": "", "bbox": {"w": 176, "h": 244}}, {"master": "陈道复", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "迅疾纵逸", "structure": "结体多变，欹侧奔放", "desc": "纵逸奔放，线条迅疾，结构多变，节奏感强烈，强调情绪表达与书写速度。", "quality": "blurry", "img": "imgs/21518/陈道复.png", "mask": "", "bbox": {"w": 160, "h": 217}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21518/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 109}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21518/张即之.png", "mask": "", "bbox": {"w": 138, "h": 106}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21518/智永.png", "mask": "", "bbox": {"w": 138, "h": 115}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21518/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 136}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21518/沈尹默.png", "mask": "", "bbox": {"w": 136, "h": 127}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21518/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 109}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21518/赵之谦.png", "mask": "", "bbox": {"w"