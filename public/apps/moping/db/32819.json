{"char": "耳", "samples": [{"master": "伊秉绶", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "波磔内敛", "structure": "结构方正充实，横平竖直", "desc": "宽博平正，波磔内敛，结构端庄肃穆。结体方正充实，横平竖直，减省蚕头燕尾，具有强烈的装饰感和建筑美，气象博大。", "quality": "blurry", "img": "imgs/32819/伊秉绶.png", "mask": "", "bbox": {"w": 229, "h": 206}}, {"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "clear", "img": "imgs/32819/蔡襄.png", "mask": "", "bbox": {"w": 185, "h": 236}}, {"master": "褚遂良", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "楷法劲健", "structure": "结体严整，清秀灵动", "desc": "以楷法为骨，行气清晰，线条劲健而不纵逸，连带克制。整体呈现出清秀、严整而略带灵动的面貌。", "quality": "blurry", "img": "imgs/32819/褚遂良.png", "mask": "", "bbox": {"w": 70, "h": 251}}, {"master": "刘墉", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "藏锋厚重", "structure": "结体内敛，敦厚稳重", "desc": "如绵裹铁，墨色厚重，人称“墨猪”，实则“棉里裹针”。初看丰肥，内含筋骨，结体虽然不够舒展，但有一种含蓄敦厚的静气。", "quality": "blurry", "img": "imgs/32819/刘墉.png", "mask": "", "bbox": {"w": 54, "h": 222}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/32819/颜真卿.png", "mask": "", "bbox": {"w": 118, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/32819/张即之.png", "mask": "", "bbox": {"w": 94, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/32819/智永.png", "mask": "", "bbox": {"w": 93, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/32819/柳公权.png", "mask": "", "bbox": {"w": 80, "h": 134}}, {"master": "沈尹默", "script": "楷书", "dynasty"