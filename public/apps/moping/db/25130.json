{"char": "截", "samples": [{"master": "怀素", "script": "草书", "dynasty": "唐代", "source": "帖", "stroke_style": "藏锋内转", "structure": "结法谨密，回旋多变", "desc": "狂草。笔法瘦硬，称为“铁线描”，速度极快，回旋进退，如骤雨旋风。援毫掣电，随手万变。超妙自得，笔老而意新。虽率意颠逸，千变万化，终不离晋法度故也。结法极谨密，微有不可识者。藏锋内转，瘦硬通神，而颠墨挫毫，无碎缺。", "quality": "blurry", "img": "imgs/25130/怀素.png", "mask": "", "bbox": {"w": 142, "h": 254}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25130/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 133}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25130/张即之.png", "mask": "", "bbox": {"w": 124, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25130/智永.png", "mask": "", "bbox": {"w": 127, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25130/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 134}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25130/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 134}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25130/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 137}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25130/赵孟頫.png", "mask": "", "bbox": {"w": 123, "h": 138}}, {"master": "魏碑", "script": "楷书", "dynasty": "南北朝", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/25130/魏碑.png", "mask": "", "