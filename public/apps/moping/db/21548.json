{"char": "听", "samples": [{"master": "吴昌硕", "script": "隶书", "dynasty": "民国", "source": "碑", "stroke_style": "中锋朴厚", "structure": "结体偏长，左低右高", "desc": "一意求中锋平直，且隶且篆。以《石鼓文》笔意写隶。结体偏长，左低右高，线条浑金璞玉，苍茫古朴。", "quality": "blurry", "img": "imgs/21548/吴昌硕.png", "mask": "", "bbox": {"w": 242, "h": 190}}, {"master": "智永", "script": "草书", "dynasty": "隋代", "source": "碑", "stroke_style": "藏锋圆转", "structure": "结体圆转，气脉连贯", "desc": "笔笔从空中落，从空中住，虽屋漏痕，犹不足以喻之。", "quality": "clear", "img": "imgs/21548/智永.png", "mask": "", "bbox": {"w": 197, "h": 233}}, {"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "clear", "img": "imgs/21548/苏轼.png", "mask": "", "bbox": {"w": 172, "h": 225}}, {"master": "褚遂良", "script": "行书", "dynasty": "唐代", "source": "碑", "stroke_style": "楷法劲健", "structure": "结体严整，清秀灵动", "desc": "以楷法为骨，行气清晰，线条劲健而不纵逸，连带克制。整体呈现出清秀、严整而略带灵动的面貌。", "quality": "clear", "img": "imgs/21548/褚遂良.png", "mask": "", "bbox": {"w": 220, "h": 212}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元代", "source": "碑", "stroke_style": "圆润遒劲", "structure": "结体妍丽，平正宽绰", "desc": "笔既流利，学亦渊深，得心应手，会意成文。结体研丽，用笔遒劲。风格整暇，意度清和。书于规矩之中，中自有神仙蜕骨风度。", "quality": "blurry", "img": "imgs/21548/赵孟頫.png", "mask": "", "bbox": {"w": 208, "h": 194}}, {"master": "宋徽宗", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "铁线方折", "structure": "结体瘦长，连绵飞动", "desc": "如狂草，动中有静。笔法承袭其“瘦金体”，线条细劲如铁线，狂放疾驰，转折处如切金断玉，连绵不断。", "quality": "clear", "img": "imgs/21548/宋徽宗.png", "mask": "", "bbox": {"w": 223, "h": 244}}, {"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "clear", "img": "imgs/21548/智永.png", "mask": "", "bbox": {"w": 218, "h": 227}}, {"master": "朱熹", "script": "草书", "dynasty": "宋代", "source": "帖", "stroke_style": "中锋厚重", "structure": "结体端正，沉稳厚重", "desc": "汉魏风骨，无半点俗气。不求态势，强调笔墨沉着。用笔中锋，点画厚重，结体端正，有一股刚正的儒家正气。", "quality": "blurry", "img": "imgs/21548/朱熹.png", "mask": "", "bbox": {"w": 216, "h": 211}}, {"master": "王铎", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "中侧并用", "structure": "结体欹侧夸张，大起大落", "desc": "翻转激荡，气势逼人，纵横恣肆，以强烈的连绵与翻转取势，字势大起大落，结体欹侧夸张，线条多中侧锋并用，提按对比剧烈。用墨浓枯交错。", "quality": "blurry", "img": "imgs/21548/王铎.png", "mask": "", "bbox": {"w": 238, "h": 197}}, {"master": "颜真卿", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "篆籀中锋", "structure": "结构稳健，宽博雄浑", "desc": "以楷法入行，笔力雄浑，结构稳健，不尚轻逸而重气骨。纵横奔逸，气势连贯。笔意激切，真情流露。行笔跌宕，痛快淋漓。通篇气脉贯注，一气呵成。", "quality": "blurry", "img": "imgs/21548/颜真卿.png", "mask": "", "bbox": {"w": 233, "h": 209}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21548/张即之.png", "mask": "", "bbox": {"w": 138, "h": 131}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21548/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 114}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21548/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 125}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21548/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 130}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21548/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 118}}]}