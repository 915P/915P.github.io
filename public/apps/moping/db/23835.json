{"char": "崛", "samples": [{"master": "王羲之", "script": "行书", "dynasty": "晋代", "source": "帖", "stroke_style": "圆转精微", "structure": "结体疏朗平衡，欹正相生", "desc": "飘若游云，矫若惊龙。字势雄逸，如龙腾天门，虎卧凤阁。字法清润，全是章草笔意。自然流畅、情法兼备为核心特征，笔画圆转而富弹性，提按变化细腻而不露痕迹。结体疏朗平衡，欹正相生，字与字之间通过行气自然贯通。", "quality": "blurry", "img": "imgs/23835/王羲之.png", "mask": "", "bbox": {"w": 209, "h": 198}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23835/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 128}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23835/张即之.png", "mask": "", "bbox": {"w": 138, "h": 128}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23835/智永.png", "mask": "", "bbox": {"w": 138, "h": 114}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23835/柳公权.png", "mask": "", "bbox": {"w": 136, "h": 129}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23835/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 116}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23835/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 116}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23835/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 110}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/23835/赵孟頫.png", "mask": "", "bb