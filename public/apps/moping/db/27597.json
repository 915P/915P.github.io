{"char": "母", "samples": [{"master": "米芾", "script": "草书", "dynasty": "宋代", "source": "碑", "stroke_style": "八面出锋", "structure": "结体奇肆，纵横飞动", "desc": "超迈入神，殆非侧勒，趯策，掠啄，磔所能束缚也。如天马脱衔，追风逐电，虽不可范，以驰驱之节，要自不妨痛快。书如游龙，跃渊，骏焉，得御，矫然，拔秀，诚不可攀也。", "quality": "blurry", "img": "imgs/27597/米芾.png", "mask": "", "bbox": {"w": 224, "h": 204}}, {"master": "康里巎巎", "script": "行书", "dynasty": "元代", "source": "帖", "stroke_style": "悬腕迅疾", "structure": "结体修长，行气贯通", "desc": "运笔极快，如疾风骤雨。悬腕行笔，线条爽利锋锐，节奏明快，既有流美，又有北方民族的豪爽。", "quality": "clear", "img": "imgs/27597/康里巎巎.png", "mask": "", "bbox": {"w": 223, "h": 241}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27597/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 105}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27597/张即之.png", "mask": "", "bbox": {"w": 138, "h": 92}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27597/智永.png", "mask": "", "bbox": {"w": 138, "h": 109}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27597/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 99}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27597/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 91}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27597/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 105}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/27597