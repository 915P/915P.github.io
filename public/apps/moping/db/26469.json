{"char": "来", "samples": [{"master": "伊秉绶", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "波磔内敛", "structure": "结构方正充实，横平竖直", "desc": "宽博平正，波磔内敛，结构端庄肃穆。结体方正充实，横平竖直，减省蚕头燕尾，具有强烈的装饰感和建筑美，气象博大。", "quality": "clear", "img": "imgs/26469/伊秉绶.png", "mask": "", "bbox": {"w": 248, "h": 170}}, {"master": "成亲王", "script": "草书", "dynasty": "清代", "source": "碑", "stroke_style": "圆转流畅", "structure": "结构规整，端庄典雅", "desc": "流畅圆转，规矩中见功力。典型的“馆阁体”最高水准，富贵典雅。", "quality": "clear", "img": "imgs/26469/成亲王.png", "mask": "", "bbox": {"w": 174, "h": 230}}, {"master": "王福庵", "script": "篆书", "dynasty": "民国", "source": "碑", "stroke_style": "笔画粗细匀一", "structure": "圆润劲健，结体极度工整对称", "desc": "端庄杂流丽，刚健含婀娜。精研“铁线篆”。笔画粗细匀一，圆润劲健，结体极度工整对称，既有秦篆的严谨，又有金石的质感。", "quality": "blurry", "img": "imgs/26469/王福庵.png", "mask": "", "bbox": {"w": 159, "h": 231}}, {"master": "刘墉", "script": "行书", "dynasty": "清代", "source": "帖", "stroke_style": "藏锋厚重", "structure": "结体内敛，敦厚稳重", "desc": "如绵裹铁，墨色厚重，人称“墨猪”，实则“棉里裹针”。初看丰肥，内含筋骨，结体虽然不够舒展，但有一种含蓄敦厚的静气。", "quality": "blurry", "img": "imgs/26469/刘墉.png", "mask": "", "bbox": {"w": 163, "h": 206}}, {"master": "欧阳询", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "瘦劲方折", "structure": "中宫收敛，结体紧密", "desc": "严整险劲，结体紧密，中宫收敛，笔画瘦劲而劲健，转折分明，行气克制，不尚流便而重法度。", "quality": "clear", "img": "imgs/26469/欧阳询.png", "mask": "", "bbox": {"w": 194, "h": 249}}, {"master": "赵之谦", "script": "隶书", "dynasty": "清代", "source": "帖", "stroke_style": "圆转流畅", "structure": "结构匀称，自然舒展", "desc": "以行笔为主，线条圆转，波磔柔和，结构匀称。整体风格偏于雅正，书写性强而刻石感弱。", "quality": "blurry", "img": "imgs/26469/赵之谦.png", "mask": "", "bbox": {"w": 225, "h": 175}}, {"master": "陈道复", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "迅疾纵逸", "structure": "结体多变，欹侧奔放", "desc": "纵逸奔放，线条迅疾，结构多变，节奏感强烈，强调情绪表达与书写速度。", "quality": "blurry", "img": "imgs/26469/陈道复.png", "mask": "", "bbox": {"w": 123, "h": 231}}, {"master": "颜真卿", "script": "行书", "dynasty": "唐代", "source": "帖", "stroke_style": "篆籀中锋", "structure": "结构稳健，宽博雄浑", "desc": "以楷法入行，笔力雄浑，结构稳健，不尚轻逸而重气骨。纵横奔逸，气势连贯。笔意激切，真情流露。行笔跌宕，痛快淋漓。通篇气脉贯注，一气呵成。", "quality": "blurry", "img": "imgs/26469/颜真卿.png", "mask": "", "bbox": {"w": 157, "h": 233}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26469/张即之.png", "mask": "", "bbox": {"w": 108, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26469/智永.png", "mask": "", "bbox": {"w": 117, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26469/柳公权.png", "mask": "", "bbox": {"w": 114, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26469/沈尹默.png", "mask": "", "bbox": {"w": 124, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26469/虞世南.png", "mask": "", "bbox": {"w": 123, "h": 138}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26469/赵孟頫.png", "mask": "", "bbox": {"w": 104, "h": 138}}]}