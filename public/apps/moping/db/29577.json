{"char": "玉", "samples": [{"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "blurry", "img": "imgs/29577/蔡襄.png", "mask": "", "bbox": {"w": 171, "h": 208}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐代", "source": "碑", "stroke_style": "圆润内刚", "structure": "结构沉静，外柔内刚", "desc": "字里金生，行间玉润。笔法圆润，外柔内刚，结构沉静，有一种君子温玉般的冲和之美。", "quality": "blurry", "img": "imgs/29577/虞世南.png", "mask": "", "bbox": {"w": 224, "h": 222}}, {"master": "宋高宗", "script": "楷书", "dynasty": "宋代", "source": "帖", "stroke_style": "圆润精到", "structure": "结构端庄，平正匀稳", "desc": "圆润流利，规范端庄，用笔精到，具有典型的皇家富贵气和晋唐法度。", "quality": "blurry", "img": "imgs/29577/宋高宗.png", "mask": "", "bbox": {"w": 211, "h": 160}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29577/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 130}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29577/张即之.png", "mask": "", "bbox": {"w": 138, "h": 135}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29577/智永.png", "mask": "", "bbox": {"w": 103, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29577/柳公权.png", "mask": "", "bbox": {"w": 133, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/29577/沈尹默.png", "mask": "", "bbox": {"w": 126, "h": 135}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "