{"char": "勤", "samples": [{"master": "蔡襄", "script": "楷书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋遒劲", "structure": "结体端严，庄重伟丽", "desc": "或横逸飘发，或劲重端严，体趣虽殊，而各极其妙。大字庄重遒劲，巍巍若巨鳌之载，崑崙翩翩如大鹏之戁溟海。观其用笔，特遒劲，伟丽。", "quality": "clear", "img": "imgs/21220/蔡襄.png", "mask": "", "bbox": {"w": 208, "h": 223}}, {"master": "傅山", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转纵肆", "structure": "结体缠绕奇肆", "desc": "粗头乱服式线条，强调自然率真与生拙之美，笔势跌宕，墨法枯涩，极具反规范倾向。主张“宁拙毋巧”。连绵缠绕，圆转不休，气势磅礴，有一种乱头粗服、不加修饰的狂放之美。", "quality": "clear", "img": "imgs/21220/傅山.png", "mask": "", "bbox": {"w": 183, "h": 237}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "blurry", "img": "imgs/21220/米芾.png", "mask": "", "bbox": {"w": 147, "h": 240}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21220/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 128}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21220/张即之.png", "mask": "", "bbox": {"w": 138, "h": 134}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21220/智永.png", "mask": "", "bbox": {"w": 114, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21220/柳公权.png", "mask": "", "bbox": {"w": 132, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21220/沈尹默.png", "mask": "", "bbox": {"w": 119, "h": 137}}, {"maste