{"char": "乌", "samples": [{"master": "伊秉绶", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "波磔内敛", "structure": "结构方正充实，横平竖直", "desc": "宽博平正，波磔内敛，结构端庄肃穆。结体方正充实，横平竖直，减省蚕头燕尾，具有强烈的装饰感和建筑美，气象博大。", "quality": "blurry", "img": "imgs/20044/伊秉绶.png", "mask": "", "bbox": {"w": 226, "h": 223}}, {"master": "傅山", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "率意纵肆", "structure": "结体奇特，纵逸不拘", "desc": "与草书类似，强调直抒胸臆。结体奇特，墨色淋漓，不拘成法，真气弥满。", "quality": "clear", "img": "imgs/20044/傅山.png", "mask": "", "bbox": {"w": 197, "h": 233}}, {"master": "王福庵", "script": "篆书", "dynasty": "民国", "source": "碑", "stroke_style": "笔画粗细匀一", "structure": "圆润劲健，结体极度工整对称", "desc": "端庄杂流丽，刚健含婀娜。精研“铁线篆”。笔画粗细匀一，圆润劲健，结体极度工整对称，既有秦篆的严谨，又有金石的质感。", "quality": "blurry", "img": "imgs/20044/王福庵.png", "mask": "", "bbox": {"w": 133, "h": 234}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "blurry", "img": "imgs/20044/米芾.png", "mask": "", "bbox": {"w": 218, "h": 236}}, {"master": "董其昌", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "轻灵含蓄", "structure": "结体疏朗平正", "desc": "疏淡清远，强调空间经营，行书节奏舒缓，连带自然，用笔轻灵，行气疏通。字形多取平正，不刻意追求速度与张力。", "quality": "clear", "img": "imgs/20044/董其昌.png", "mask": "", "bbox": {"w": 152, "h": 239}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20044/颜真卿.png", "mask": "", "bbox": {"w": 114, "h": 137}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20044/张即之.png", "mask": "", "bbox": {"w": 115, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": 