{"char": "早", "samples": [{"master": "唐玄宗", "script": "隶书", "dynasty": "唐代", "source": "碑", "stroke_style": "波磔丰满", "structure": "结构严整，方正丰腴", "desc": "虽有唐人习气，而端严庄重。字形肥硕，笔画丰满，挑法明显，结构严整，尽显盛唐丰腴之美。", "quality": "clear", "img": "imgs/26089/唐玄宗.png", "mask": "", "bbox": {"w": 213, "h": 130}}, {"master": "王献之", "script": "行书", "dynasty": "晋代", "source": "碑", "stroke_style": "连绵外拓", "structure": "结体秀逸，外拓奔放", "desc": "运笔连绵不绝，气势豪迈，外露和奔放，挺然秀出，极草纵之致。", "quality": "blurry", "img": "imgs/26089/王献之.png", "mask": "", "bbox": {"w": 140, "h": 228}}, {"master": "董其昌", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "平稳含蓄", "structure": "中宫虚和，结体疏朗", "desc": "楷书结构疏朗，中宫虚和，用笔平稳含蓄，点画不尚锋芒而重整体气息。强调字内空间与章法呼应，追求“淡而有味”的审美取向，弱化力量感而突出文人书卷气。", "quality": "blurry", "img": "imgs/26089/董其昌.png", "mask": "", "bbox": {"w": 165, "h": 175}}, {"master": "苏轼", "script": "楷书", "dynasty": "宋代", "source": "帖", "stroke_style": "藏锋丰腴", "structure": "结体宽博，丰腴稳重", "desc": "以淳古重。东坡丰艳，脱尽绳墨，藏锋敛锷。重而肉稍肥。匀稳妍妙，风神在披拂间，而微欲近碑侧，记行稍自结，虽有墨猪之诮，最为淳古。肉丰而骨劲，态浓而意淡，巧于拙，特为秀伟。", "quality": "blurry", "img": "imgs/26089/苏轼.png", "mask": "", "bbox": {"w": 156, "h": 238}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26089/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 136}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26089/张即之.png", "mask": "", "bbox": {"w": 138, "h": 125}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26089/智永.png", "mask": "", "bbox": {"w": 115, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/26089/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 130}}, {"master": "沈尹默", "script": 