{"char": "惜", "samples": [{"master": "孙过庭", "script": "草书", "dynasty": "唐代", "source": "碑", "stroke_style": "笔法精微，提按清晰", "structure": "结体疏朗简约", "desc": "法度严谨而流美自然，笔法精微，提按清晰，结体疏朗。工于用笔，俊拔刚断，尚异好奇，凌越险阻。如丹崖绝壑，笔势坚劲。", "quality": "clear", "img": "imgs/24796/孙过庭.png", "mask": "", "bbox": {"w": 194, "h": 219}}, {"master": "傅山", "script": "草书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转纵肆", "structure": "结体缠绕奇肆", "desc": "粗头乱服式线条，强调自然率真与生拙之美，笔势跌宕，墨法枯涩，极具反规范倾向。主张“宁拙毋巧”。连绵缠绕，圆转不休，气势磅礴，有一种乱头粗服、不加修饰的狂放之美。", "quality": "clear", "img": "imgs/24796/傅山.png", "mask": "", "bbox": {"w": 210, "h": 228}}, {"master": "唐寅", "script": "行书", "dynasty": "明代", "source": "帖", "stroke_style": "圆转妍美", "structure": "结体俊逸，疏朗妍美", "desc": "笔法圆转妍美，结体俊逸，书卷气浓，潇洒流落，风流倜傥。", "quality": "clear", "img": "imgs/24796/唐寅.png", "mask": "", "bbox": {"w": 238, "h": 232}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24796/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 115}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24796/张即之.png", "mask": "", "bbox": {"w": 138, "h": 117}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24796/智永.png", "mask": "", "bbox": {"w": 138, "h": 131}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24796/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 133}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/24796/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 123}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "