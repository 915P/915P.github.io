{"char": "糠", "samples": [{"master": "智永", "script": "楷书", "dynasty": "隋代", "source": "帖", "stroke_style": "笔划极富变化，线条有弹性", "structure": "结体宽博灵动，多姿多态，空灵飞动", "desc": "虽气骨清健，大小相杂，如十四五贯贵胄，褊性方循绳墨，忽越规矩。骨气深稳，体兼众妙，精能之至，反造疏淡。每用笔必曲折，其笔，宛转回向，沉着收束，所谓当其下笔，欲透过纸背者。", "quality": "blurry", "img": "imgs/31968/智永.png", "mask": "", "bbox": {"w": 214, "h": 202}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31968/张即之.png", "mask": "", "bbox": {"w": 138, "h": 123}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31968/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 129}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31968/沈尹默.png", "mask": "", "bbox": {"w": 138, "h": 125}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31968/虞世南.png", "mask": "", "bbox": {"w": 138, "h": 126}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31968/赵之谦.png", "mask": "", "bbox": {"w": 138, "h": 114}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31968/赵孟頫.png", "mask": "", "bbox": {"w": 138, "h": 133}}, {"master": "魏碑", "script": "楷书", "dynasty": "南北朝", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/31968/魏碑.png", "mask": "", "bbox": {"w": 137, "h": 102}}]}