{"char": "乃", "samples": [{"master": "康里巎巎", "script": "草书", "dynasty": "元代", "source": "碑", "stroke_style": "悬腕迅疾", "structure": "结体纵逸，欹侧多变", "desc": "运笔极快，如疾风骤雨。悬腕行笔，线条爽利锋锐，节奏明快，既有流美，又有北方民族的豪爽。", "quality": "clear", "img": "imgs/20035/康里巎巎.png", "mask": "", "bbox": {"w": 169, "h": 241}}, {"master": "徐渭", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "疾涩纵肆", "structure": "结体纵逸，大小错落", "desc": "八法之散圣，字林之侠客。笔墨如骤雨狂风，恣肆汪洋，点画狼藉，不计工拙，主要表现激越的情感。", "quality": "clear", "img": "imgs/20035/徐渭.png", "mask": "", "bbox": {"w": 212, "h": 175}}, {"master": "王宠", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "用笔含蓄克制，连带不多", "structure": "结体多呈欹正相生之态", "desc": "清疏一路，行而不纵，动而能收，行气平缓，用笔含蓄克制，连带不多，字字分明，结体多呈欹正相生之态。", "quality": "blurry", "img": "imgs/20035/王宠.png", "mask": "", "bbox": {"w": 140, "h": 238}}, {"master": "王羲之", "script": "楷书", "dynasty": "晋代", "source": "碑", "stroke_style": "藏锋精到", "structure": "结构严谨，中和端正", "desc": "用笔内振而收敛，故森严而有法度，点画精到，结构完美，不激不厉，中和之美。", "quality": "blurry", "img": "imgs/20035/王羲之.png", "mask": "", "bbox": {"w": 151, "h": 200}}, {"master": "邓石如", "script": "隶书", "dynasty": "清代", "source": "碑", "stroke_style": "篆意圆劲", "structure": "结构自然舒展", "desc": "融篆入隶，线条圆劲流畅，结构自然舒展，波磔不事夸张，整体呈现古朴而生动的面貌。", "quality": "blurry", "img": "imgs/20035/邓石如.png", "mask": "", "bbox": {"w": 225, "h": 156}}, {"master": "钟繇", "script": "楷书", "dynasty": "三国", "source": "碑", "stroke_style": "结构严谨", "structure": "笔势遒劲雄强，如壮士拔剑，森然有威", "desc": "妙绝古法，笔势刚劲，笔势遒劲，结构严谨，精妙绝伦，姿态万千。如云鹄游天，群鸿戏海。笔力遒劲，如壮士拔剑，森然有威。笔势雄强，气韵生动，如龙腾虎跃，气势磅礴。", "quality": "blurry", "img": "imgs/20035/钟繇.png", "mask": "", "bbox": {"w": 218, "h": 195}}, {"master": "王宠", "script": "楷书", "dynasty": "明代", "source": "帖", "stroke_style": "中锋细劲", "structure": "中宫疏朗，骨架分明", "desc": "清润雅正，疏朗而不散，清瘦而不弱，中宫不紧而骨架分明，用笔细劲含蓄，多以中锋行笔，转折自然。", "quality": "blurry", "img": "imgs/20035/王宠.png", "mask": "", "bbox": {"w": 175, "h": 215}}, {"master": "米芾", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "八面出锋", "structure": "结体侧欹，欹正相生", "desc": "用笔八面出锋，变化莫测，结体侧欹，势如天马行空，沉着痛快。如快剑斫阵，强弩射千里，所当穿彻，善书家笔势，亦穷於此，然亦似仲由未见孔子时风气耳。回旋曲折，气古而韵高，于侧掠，掣趨，劲循，古法，度无一笔妄作。而墨在毫中，挤于纸上，浓淡重轻，亦依稀若见。", "quality": "clear", "img": "imgs/20035/米芾.png", "mask": "", "bbox": {"w": 147, "h": 233}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20035/颜真卿.png", "mask": "", "bbox": {"w": 126, "h": 138}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20035/张即之.png", "mask": "", "bbox": {"w": 103, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20035/智永.png", "mask": "", "bbox": {"w": 120, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20035/柳公权.png", "mask": "", "bbox": {"w": 136, "h": 138}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20035/沈尹默.png", "mask": "", "bbox": {"w": 120, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20035/虞世南.png", "mask": "", "bbox": {"w": 120, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20035/赵之谦.png", "mask": "", "bbox": {"w": 137, "h": 138}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/20035/赵孟頫.png", "mask": "", "bbox": {"w": 138, "h": 129}}]}