{"char": "涂", "samples": [{"master": "何绍基", "script": "楷书", "dynasty": "清代", "source": "碑", "stroke_style": "回腕颤涩", "structure": "结体内敛，古拙苍茫", "desc": "以篆隶笔法写楷书，线条迟涩，结体内敛，古拙苍茫。运笔强调悬臂回腕，线条有颤动感（涩笔），圆浑高古。", "quality": "blurry", "img": "imgs/28034/何绍基.png", "mask": "", "bbox": {"w": 207, "h": 208}}, {"master": "倪元璐", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "渴笔涩行", "structure": "结体险绝，欹侧奇崛", "desc": "用笔多用渴墨（枯笔），线条生涩，结体险绝。", "quality": "blurry", "img": "imgs/28034/倪元璐.png", "mask": "", "bbox": {"w": 153, "h": 247}}, {"master": "徐渭", "script": "行书", "dynasty": "明代", "source": "碑", "stroke_style": "疾涩纵肆", "structure": "结体纵逸，大小错落", "desc": "八法之散圣，字林之侠客。笔墨如骤雨狂风，恣肆汪洋，点画狼藉，不计工拙，主要表现激越的情感。", "quality": "clear", "img": "imgs/28034/徐渭.png", "mask": "", "bbox": {"w": 233, "h": 223}}, {"master": "文征明", "script": "楷书", "dynasty": "明代", "source": "碑", "stroke_style": "中锋秀劲", "structure": "结体严谨，疏朗秀美", "desc": "小楷精绝。温润秀劲，法度严谨，笔笔不苟，有晋唐遗风。", "quality": "blurry", "img": "imgs/28034/文征明.png", "mask": "", "bbox": {"w": 205, "h": 226}}, {"master": "苏轼", "script": "行书", "dynasty": "宋代", "source": "碑", "stroke_style": "藏锋雄健", "structure": "结体欹侧，姿态横生", "desc": "笔力雄健，不能居人后，故其临帖，物色牝牡，不复可以形似较量，而其英气逸韵，高视古人，未知其孰为先后也。用笔凌厉风驰，纵横斜直，虽率意而成，无不如意。姿态横生，不矜而妍，不束而严，不轶而豪，萧散容与，霏霏如甘雨之霖，森森竦映，熠熠如从月之星，纡余宛转，缠缠如茧之丝。每波画尽处，隐隐有聚墨痕，如黍米珠。", "quality": "clear", "img": "imgs/28034/苏轼.png", "mask": "", "bbox": {"w": 227, "h": 214}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/28034/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 131}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/28034/张即之.png", "mask": "", "bbox": {"w": 114, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/28034/智永.png",