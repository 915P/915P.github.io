{"char": "勦", "samples": [{"master": "黄庭坚", "script": "行书", "dynasty": "宋代", "source": "帖", "stroke_style": "提按纵横", "structure": "结体开张，纵横奇崛", "desc": "见长年荡桨，乃悟笔法。清圆妙丽，引绳贯珠。虽昂藏郁拔，而神闲，意秾。变态纵横，势若飞鹤之名书，法妍媚，笔势纵横。无一笔不自空中，荡漾而又沈著痛快。", "quality": "clear", "img": "imgs/21222/黄庭坚.png", "mask": "", "bbox": {"w": 237, "h": 196}}, {"master": "颜真卿", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21222/颜真卿.png", "mask": "", "bbox": {"w": 138, "h": 136}}, {"master": "张即之", "script": "楷书", "dynasty": "宋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21222/张即之.png", "mask": "", "bbox": {"w": 131, "h": 138}}, {"master": "智永", "script": "楷书", "dynasty": "隋", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21222/智永.png", "mask": "", "bbox": {"w": 138, "h": 138}}, {"master": "柳公权", "script": "楷书", "dynasty": "唐", "source": "碑", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21222/柳公权.png", "mask": "", "bbox": {"w": 138, "h": 131}}, {"master": "沈尹默", "script": "楷书", "dynasty": "民国", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21222/沈尹默.png", "mask": "", "bbox": {"w": 134, "h": 138}}, {"master": "虞世南", "script": "楷书", "dynasty": "唐", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21222/虞世南.png", "mask": "", "bbox": {"w": 127, "h": 138}}, {"master": "赵之谦", "script": "楷书", "dynasty": "清", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21222/赵之谦.png", "mask": "", "bbox": {"w": 116, "h": 138}}, {"master": "赵孟頫", "script": "楷书", "dynasty": "元", "source": "墨", "stroke_style": null, "structure": null, "desc": null, "quality": "ccd", "img": "imgs/21222/赵孟頫.png", "mask": "", "bbox": {"w": 128, "h": 138}}]}